---
/**
 * Section, Piano layout primitiv (sekce stránky)
 *
 *   background: "default" | "alt" | "invert" | "primary"   (default "default")
 *   space:      "sm" | "md" | "lg"                          vertikální padding (default "md")
 *   container:  "default" | "narrow" | "wide" | "full" | false
 *               false = bez Containeru (full-bleed obsah)   (default "default")
 *   as:         HTML tag (default "section")
 *   id:         kotva pro odkazy
 *
 * Pozadí je full-bleed (přes celou šířku), obsah uvnitř drží Container.
 * Tmavá pozadí (invert/primary) automaticky přepnou text na světlou barvu.
 */
import Container from './Container.astro';

interface Props {
  background?: 'default' | 'alt' | 'warm' | 'invert' | 'primary' | 'gradient' | 'cyan' | 'yellow' | 'pink';
  space?: 'sm' | 'md' | 'lg';
  container?: 'default' | 'narrow' | 'wide' | 'full' | false;
  decor?: boolean | 'top' | 'bottom' | 'both';   // dekorativní kruh na hranici sekce (brandový styl)
  reveal?: boolean;   // scroll reveal při nájezdu do viewportu (default true)
  revealFrom?: 'bottom' | 'left' | 'right' | 'top';  // směr nájezdu (default "bottom")
  as?: string;
  id?: string;
  class?: string;
  [key: string]: any;
}

const {
  background = 'default',
  space = 'md',
  container = 'default',
  decor = false,
  reveal = true,
  revealFrom = 'bottom',
  as = 'section',
  id,
  class: className,
  ...rest
} = Astro.props;

const Tag = as;
const decorTop = decor === true || decor === 'both' || decor === 'top';
const decorBottom = decor === true || decor === 'both' || decor === 'bottom';
const classes = [
  'section',
  `section--bg-${background}`,
  `section--space-${space}`,
  decorTop && 'section--decor-top',
  decorBottom && 'section--decor-bottom',
  className,
]
  .filter(Boolean)
  .join(' ');

/* Směr nájezdu podle kompozice: zdola je výchozí, ostatní přidají variantu. */
const revealClass = ['reveal', revealFrom !== 'bottom' && `reveal--from-${revealFrom}`]
  .filter(Boolean)
  .join(' ');
---

{/* Scroll reveal jde na OBSAH, ne na sekci.
    Kdyby byl na sekci, animovala by se i celá barevná plocha pásu: tmavý nebo
    barevný blok by nabíhal z bílé, což se nečte jako „obsah přišel", ale jako
    blafnutí. Navíc je to plocha přes celé okno, takže se každý frame přepočítá
    obří vrstva a animace seká. Takhle pás zůstane plný a hýbe se jen obsah.
    Sekce, které jsou při načtení už nad spouštěcí linkou (hero), odkryje
    reveal.js bez animace. */}
<Tag class={classes} id={id} {...rest}>
  {container === false
    ? (reveal ? <div class={revealClass}><slot /></div> : <slot />)
    : <Container size={container} class={reveal ? revealClass : undefined}><slot /></Container>}
</Tag>

<style>
  .section { position: relative; }

  /* Vertikální rytmus (responzivní) */
  .section--space-sm { padding-block: clamp(32px, 5vw, 48px); }
  .section--space-md { padding-block: clamp(48px, 7vw, 80px); }
  .section--space-lg { padding-block: clamp(64px, 10vw, 120px); }

  /* Pozadí */
  .section--bg-default { background: var(--color-bg); }
  .section--bg-alt     { background: var(--color-bg-alt); }
  /* „warm" je dnes varianta jen pro Piano, jen ono definuje --color-bg-warm
     (26 stránek). Fallback byl zadrátovaná krémová #FFF5E8, tedy barva Piana,
     která na brandovém webu svítila jako cizí prvek. Teď spadne na vlastní
     plochu značky. Odhalilo se to při srovnání variant pozadí vedle sebe. */
  .section--bg-warm    { background: var(--color-bg-warm, var(--color-bg-alt)); }
  .section--bg-invert  { background: var(--color-neutral-900); color: var(--color-text-on-dark); }
  .section--bg-primary { background: var(--color-primary-bg); color: var(--color-text-on-dark); }
  .section--bg-gradient { background: var(--color-bg-gradient, var(--color-primary-bg)); color: var(--color-text-on-dark); }

  /* Brandové celoplošné barvy (themeable per web) */
  .section--bg-cyan   { background: var(--color-bg-cyan, var(--color-bg-alt)); color: var(--color-text); }
  .section--bg-yellow { background: var(--color-bg-yellow, var(--color-bg-alt)); color: var(--color-text); }
  .section--bg-pink   { background: var(--color-bg-pink, var(--color-bg-alt)); color: var(--color-text); }

  /* Dekorativní kruh na hranici sekce (brandový styl Grason).
     Dvě sousední dekorované sekce sdílejí JEDNU kružnici na společné hranici:
     horní sekce kreslí spodní půlkruh (::after), dolní sekce horní půlkruh
     (::before). Stejná geometrie => oba cípy na sebe plynule navazují v jeden
     kruh. Tint je poloprůhledná tmavá => v každé sekci ztmaví její barvu. */
  .section--decor-top,
  .section--decor-bottom {
    overflow: hidden;
    --blob-d: clamp(420px, 62vw, 640px);
    --blob-x: -9vw;
    --blob-tint: rgba(0, 0, 0, 0.06);
  }
  .section--decor-top::before,
  .section--decor-bottom::after {
    content: ""; position: absolute; z-index: 0; pointer-events: none;
    left: var(--blob-x); width: var(--blob-d); aspect-ratio: 1; border-radius: 50%;
    background: var(--blob-tint);
  }
  .section--decor-top::before   { top:    calc(var(--blob-d) / -2); }
  .section--decor-bottom::after  { bottom: calc(var(--blob-d) / -2); }
  .section--decor-top > :global(*),
  .section--decor-bottom > :global(*) { position: relative; z-index: 1; }

  /* Na tmavých sekcích (invert/primary) musí být kruh světlý, jinak zanikne. */
  .section--bg-invert.section--decor-top,
  .section--bg-invert.section--decor-bottom,
  .section--bg-primary.section--decor-top,
  .section--bg-primary.section--decor-bottom { --blob-tint: rgba(255, 255, 255, 0.06); }
</style>
