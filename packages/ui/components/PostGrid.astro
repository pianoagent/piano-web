---
/**
 * PostGrid: SDÍLENÝ výpis článků v kartách (blog Piano, novinky Pecosta).
 * Tři sloupce, obrázek 16:9, meta řádek s kategorií a datem, perex a odkaz.
 *
 *   posts: [{ href, title, description?, image?, category?, date }]
 *   headingAs: úroveň nadpisu karty, 'h2' (default) | 'h3'
 *   more: text odkazu na konci karty (default „Číst článek")
 *
 * Datum se formátuje česky uvnitř komponenty, stránka posílá jen Date.
 */
import Heading from './Heading.astro';
import Text from './Text.astro';
import Icon from './Icon.astro';

interface Post {
  href: string;
  title: string;
  description?: string;
  image?: string;
  category?: string;
  date: Date;
}
interface Props { posts: Post[]; headingAs?: 'h2' | 'h3'; more?: string; }
const { posts, headingAs = 'h2', more = 'Číst článek' } = Astro.props;

const fmtDate = (d: Date) => d.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="blog-grid">
  {posts.map((p) => (
    <a class="blog-card" href={p.href}>
      {p.image && <div class="blog-card__media"><img src={p.image} alt={p.title} loading="lazy" /></div>}
      <div class="blog-card__body">
        <div class="blog-card__meta">
          {p.category && <span class="blog-card__cat">{p.category}</span>}
          <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
        </div>
        <Heading as={headingAs} size="h3">{p.title}</Heading>
        {p.description && <Text size="small" color="muted" class="blog-card__desc">{p.description}</Text>}
        <span class="blog-card__more">{more} <Icon name="lucide:arrow-right" size="xs" /></span>
      </div>
    </a>
  ))}
</div>

<style>
  .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .blog-card { display: flex; flex-direction: column; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; text-decoration: none; color: var(--color-text); transition: var(--transition); }
  .blog-card:hover { border-color: var(--color-primary); transform: translateY(-4px); box-shadow: var(--shadow-lg, 0 18px 40px rgba(0, 0, 0, 0.1)); }
  .blog-card__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg-alt); }
  .blog-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .blog-card__body { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5); flex: 1; }
  .blog-card__meta { display: flex; align-items: center; gap: var(--space-3); font-size: var(--font-size-caption); color: var(--color-text-muted); }
  .blog-card__cat { color: var(--color-text-accent); font-weight: var(--font-weight-medium); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); }
  .blog-card__desc { flex: 1; }
  .blog-card__more { display: inline-flex; align-items: center; gap: var(--space-1); margin-top: var(--space-2); color: var(--color-text-accent); font-weight: var(--font-weight-medium); font-size: var(--font-size-small); }
  @media (max-width: 860px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
