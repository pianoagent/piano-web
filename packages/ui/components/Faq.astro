---
/**
 * Faq: SDÍLENÁ sekce často kladených otázek (accordion <details>).
 * Skládá Section/Heading/Text.
 *
 *   items: [{ q, a }]                         (plochý seznam)
 *   groups: [{ title, items: [{ q, a }] }]     (seskupené, např. per produkt)
 *   eyebrow: návěs nad nadpisem (Hugo má „Než se rozhodneš")
 *   title: nadpis sekce (default „Často kladené dotazy")
 *   lead: volitelný perex pod nadpisem
 *   background: 'default' | 'alt'
 *   id: ukotvení sekce (Harsys má v navigaci odkaz #faq)
 */
import Section from './Section.astro';
import Heading from './Heading.astro';
import Text from './Text.astro';

interface Item { q: string; a: string; }
interface Group { title: string; items: Item[]; }
interface Props { items?: Item[]; groups?: Group[]; eyebrow?: string; title?: string; lead?: string; background?: 'default' | 'alt'; id?: string; }
const { items = [], groups, eyebrow, title = 'Často kladené dotazy', lead, background = 'default', id } = Astro.props;

const resolvedGroups: Group[] = groups && groups.length > 0 ? groups : [{ title: '', items }];
---

<Section background={background} space="lg" id={id}>
  <div class="head head--center">
    {eyebrow && <Text size="label" color="accent" align="center">{eyebrow}</Text>}
    <Heading as="h2" size="h2" align="center">{title}</Heading>
    {lead && <Text size="lead" color="muted" align="center">{lead}</Text>}
  </div>
  <div class="faqwrap">
    {resolvedGroups.map((g) => (
      <div class="faqgroup">
        {g.title && <p class="faqgroup__title">{g.title}</p>}
        <div class="faq">
          {g.items.map((f) => (
            <details class="faq__item">
              <summary class="faq__q">{f.q}</summary>
              <div class="faq__a"><Text color="muted">{f.a}</Text></div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); text-align: center; }
  .head > * + * { margin-top: var(--space-3); }
  .faqwrap { max-width: 760px; margin-inline: auto; }
  .faqgroup + .faqgroup { margin-top: var(--space-7); }
  .faqgroup__title { font-size: var(--font-size-label); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-accent); margin-bottom: var(--space-4); }
  .faq { display: flex; flex-direction: column; gap: var(--space-3); }
  .faq__item { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); padding: 0 var(--space-5); }
  .faq__q { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) 0; cursor: pointer; font-weight: var(--font-weight-semibold); list-style: none; }
  .faq__q::-webkit-details-marker { display: none; }
  /* Signál rozbalení je plus a minus, ne šipka. Rozhodnuto 13. 8. 2026.
     Vzor je z piano.cz a eet2027, kde to tak bylo od začátku; sdílená
     komponenta měla otáčející se chevron a sjednotilo se to na tenhle. */
  .faq__q::after { content: "+"; color: var(--color-text-accent); font-size: 1.4em; line-height: 1; flex-shrink: 0; }
  .faq__item[open] .faq__q::after { content: "\2212"; }
  .faq__a { padding-bottom: var(--space-5); }
</style>
