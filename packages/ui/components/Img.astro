---
/**
 * Img: responsive image. A path like '/images/x.webp' resolves to
 * src/assets/images/x.webp and renders as <picture> with AVIF + WebP srcset
 * (½×, 1× and 2× `width`, never beyond the source). A site that still keeps the
 * file in public/ gets a plain <img>.
 *
 *   src    '/images/…' path or an imported image
 *   width  largest rendered width in CSS px
 *   height used only by the plain <img> fallback; the picture keeps the source ratio
 *   sizes  optional, defaults to "(min-width: {width}px) {width}px, 100vw"
 */
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Picture } from 'astro:assets';
import { defaultSizes, findImage, responsiveWidths } from '../lib/images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src: string | ImageMetadata;
  alt: string;
  width: number;
  height?: number;
}

const { src, width, height, sizes = defaultSizes(width), ...attributes } = Astro.props;
const image = typeof src === 'string' ? findImage(src) : src;
---

{image
  ? <Picture src={image} width={width} widths={responsiveWidths(width)} sizes={sizes}
             formats={['avif']} fallbackFormat="webp" {...attributes} />
  : <img src={src as string} width={width} height={height} loading="lazy" decoding="async" {...attributes} />}
