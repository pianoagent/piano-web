      note="Tady je ta komponenta, kterou chceme odgenerizovat. Dnes má čtyři reálně používané varianty a všechny jsou v jednom souboru. Rozpad použití v repozitáři: split s médiem 100x, single left 40x, single center 6x, carousel 4x. Pátá varianta cover je nová a je zatím nasazená jen na homepage Pecosty. Cover počítá s průhlednou hlavičkou, stránka tedy musí předat <Header transparent /> nebo <SiteHeader transparent />, jinak lišta zůstane v toku a hero začne pod ní. Odsazení o výšku hlavičky si drží sekce sama. Brandový odstín závoje řídí token --hero-cover-tint v theme.css, bez něj je závoj neutrálně černý."
      props={[
        { prop: 'eyebrow', type: 'string', note: 'návěs nad nadpisem' },
        { prop: 'title', type: 'string', note: 'alternativa ke slotu title' },
        { prop: 'lead', type: 'string' },
        { prop: 'align', type: "'left' | 'center'", def: "'left'", note: 'jen bez média' },
        { prop: 'background', type: "'default' | 'alt' | 'warm' | 'invert' | 'primary' | 'gradient'", def: "'default'" },
        { prop: 'space', type: "'sm' | 'md' | 'lg'", def: "'lg'" },
        { prop: 'usp', type: 'string[] | { text, icon? }[]', def: '[]', note: 'proužek bodů pod CTA' },
        { prop: 'slides', type: 'HeroSlide[]', def: '[]', note: '2 a více = carousel' },
        { prop: 'carouselLabel', type: 'string', def: "'Přepnout sdělení'" },
        { prop: 'variant', type: "'split' | 'cover'", def: "'split'", note: 'cover = médium na plnou šířku jako pozadí' },
      ]}
      slots={[
        { slot: 'title', note: 'nadpis, když potřebuješ akcent nebo vynucené zalomení' },
        { slot: 'actions', note: 'CTA tlačítka' },
        { slot: 'media', note: 'obrázek nebo grafika vpravo' },
      ]}>
      <Demo label="varianta 1: split, s médiem (100x v repozitáři)" bleed code='<Hero> + slot="media"'>
        <Hero eyebrow="Návěs" background="gradient"
              lead="Perex hero sekce na dva až tři řádky, který rozvede nadpis a řekne, co z toho zákazník má."
              usp={[{ text: 'První bod', icon: 'lucide:check' }, { text: 'Druhý bod', icon: 'lucide:check' }, { text: 'Třetí bod', icon: 'lucide:check' }]}>
          <Heading slot="title" as="p" size="display" color="on-dark">Nadpis hero sekce na dva řádky</Heading>
          <Fragment slot="actions">
            <Button href="#">Hlavní CTA</Button>
            <Button href="#" variant="secondary" onDark>Doplňkové</Button>
          </Fragment>
          {heroImage
            ? <img slot="media" src={heroImage} alt="" width="1100" height="733" />
            : <div slot="media" class="gal__ph">slot media</div>}
        </Hero>
      </Demo>
      <Demo label="varianta 2: single left, bez média (40x)" bleed code='<Hero background="alt">'>
        <Hero eyebrow="Návěs" background="alt" lead="Perex bez média. Text drží maximální šířku, aby se dobře čtl.">
          <Heading slot="title" as="p" size="display">Nadpis bez média</Heading>
          <Fragment slot="actions"><Button href="#">CTA</Button></Fragment>
        </Hero>
      </Demo>
      <Demo label="varianta 3: single center (6x)" bleed code='align="center"'>
        <Hero eyebrow="Návěs" background="warm" align="center" lead="Centrovaná varianta. Používá se na servisních a rozcestníkových stránkách.">
          <Heading slot="title" as="p" size="display" align="center">Centrovaný nadpis</Heading>
          <Fragment slot="actions"><Button href="#">CTA</Button></Fragment>
        </Hero>
      </Demo>
      <Demo label="varianta 5: cover, médium na plnou šířku jako pozadí (nová)" bleed code='variant="cover"'>
        <Hero variant="cover" background="invert" eyebrow="Návěs"
              lead="Perex přes fotku. Závoj drží kontrast: černý gradient je základ, brandový odstín se přidává tokenem --hero-cover-tint.">
          <Heading slot="title" as="p" size="display" color="on-dark">Vizuálnější hero přes celou šířku</Heading>
          <Fragment slot="actions"><Button href="#">Hlavní CTA</Button></Fragment>
          <div slot="media" class="gal__phcover">slot media na pozadí</div>
        </Hero>
      </Demo>
      <Demo label="varianta 4: carousel, rotující sdělení (4x)" bleed code="slides={[...]}">
        <Hero background="gradient"
              slides={[
                { eyebrow: 'První sdělení', title: 'Nadpis prvního slidu', lead: 'Perex prvního slidu.' },
                { eyebrow: 'Druhé sdělení', title: 'Nadpis druhého slidu', lead: 'Perex druhého slidu.' },
              ]}
              usp={[{ text: 'CTA a USP zůstávají', icon: 'lucide:check' }]}>
          <Fragment slot="actions"><Button href="#">CTA</Button></Fragment>
        </Hero>
      </Demo>
