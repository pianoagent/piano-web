---
/**
 * Gallery: živý katalog všech komponent @piano/ui.
 *
 * Renderuje se SKUTEČNÝMI komponentami, ne obrázky, a nasazuje se jako route
 * /styleguide do každé appky. Každá značka tak vidí katalog ve svých vlastních
 * tokenech a fontech, protože tokens.css a theme.css se berou z té appky.
 * Katalog proto nemůže odejít od reality: když se komponenta změní, změní se tu.
 *
 *   brand:      název značky do hlavičky stránky
 *   logos?:     názvy souborů log pro ukázku LogoWall (per web, jinak se ukázka
 *               vynechá, protože soubory jsou v public/ každé appky jiné)
 *   heroImage?: cesta k obrázku pro ukázku hero se médiem; bez ní se použije
 *               zástupná plocha, což pro posouzení layoutu stačí
 *
 * Počty „N souborů" u komponent jsou z inventury repozitáře k 13. 8. 2026.
 */
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Card from '../components/Card.astro';
import Field from '../components/Field.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Hero from '../components/Hero.astro';
import USPGrid from '../components/USPGrid.astro';
import Split from '../components/Split.astro';
import PricingTiers from '../components/PricingTiers.astro';
import StatsBand from '../components/StatsBand.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import LogoWall from '../components/LogoWall.astro';
import LeadForm from '../components/LeadForm.astro';
import PostGrid from '../components/PostGrid.astro';
import CategoryChips from '../components/CategoryChips.astro';
import Spec from './Spec.astro';
import Demo from './Demo.astro';
import Tokens from './Tokens.astro';

interface Props { brand: string; logos?: string[]; heroImage?: string; }
const { brand, logos, heroImage } = Astro.props;

/* Ukázková data. Záměrně neutrální, ne reálné claimy značek, aby si to nikdo
   nezkopíroval z katalogu do produkčního copy. */
const uspItems = [
  { icon: 'lucide:zap', title: 'Krátký titulek', text: 'Dvě až tři řádky textu, které rozvedou titulek karty.' },
  { icon: 'lucide:shield-check', title: 'Druhá karta', text: 'Mřížka se sama zalomí podle minItemWidth a šířky okna.' },
  { icon: 'lucide:clock', title: 'Třetí karta', text: 'Ikona je volitelná, bez ní zůstane jen titulek a text.' },
];
const statItems = [
  { num: '25 %', lbl: 'popisek pod číslem' },
  { num: '960+', lbl: 'druhý údaj' },
  { num: '48 h', lbl: 'třetí údaj' },
  { num: '0 Kč', lbl: 'čtvrtý údaj' },
];
const quotes = [
  { quote: 'Citace klienta na dva až čtyři řádky. Konkrétní výsledek řekne víc než přídavná jména.', author: 'Jméno Klienta', role: 'Pozice, Firma', initials: 'JK', headline: 'Nadpis citace' },
  { quote: 'Druhá citace. Vejdou se tři na řádek, čtvrtá se zalomí na další.', author: 'Druhé Jméno', role: 'Pozice, Firma', initials: 'DJ', headline: 'Nadpis citace' },
  { quote: 'Třetí citace. Bez pole headline zůstane jen text a podpis.', author: 'Třetí Jméno', role: 'Pozice, Firma', initials: 'TJ' },
];
const faqItems = [
  { q: 'Otázka, kterou se zákazník opravdu ptá?', a: 'Odpověď v jazyce provozu, ne v jazyce dodavatele. Krátce a bez vytáček.' },
  { q: 'Druhá otázka?', a: 'Druhá odpověď. Accordion je nativní details a summary, funguje i bez JS.' },
];
const posts = [
  { href: '#', title: 'Titulek článku na dva řádky', description: 'Perex článku, dvě věty.', category: 'Kategorie', date: new Date(2026, 6, 27) },
  { href: '#', title: 'Druhý článek', description: 'Bez obrázku se karta jen zkrátí.', category: 'Kategorie', date: new Date(2026, 5, 1) },
  { href: '#', title: 'Třetí článek', description: 'Mřížka je tři sloupce, na tabletu dva, na mobilu jeden.', category: 'Kategorie', date: new Date(2026, 4, 12) },
];

const OBSAH = [
  { id: 'skladani', label: 'Jak skládat stránku' },
  { id: 'tokeny', label: 'Tokeny značky' },
  { id: 'section', label: 'Section' },
  { id: 'container', label: 'Container' },
  { id: 'heading', label: 'Heading' },
  { id: 'text', label: 'Text' },
  { id: 'button', label: 'Button' },
  { id: 'badge', label: 'Badge' },
  { id: 'icon', label: 'Icon' },
  { id: 'card', label: 'Card' },
  { id: 'field', label: 'Field' },
  { id: 'breadcrumb', label: 'Breadcrumb' },
  { id: 'hero', label: 'Hero' },
  { id: 'uspgrid', label: 'USPGrid' },
  { id: 'split', label: 'Split' },
  { id: 'pricingtiers', label: 'PricingTiers' },
  { id: 'statsband', label: 'StatsBand' },
  { id: 'testimonials', label: 'Testimonials' },
  { id: 'faq', label: 'Faq' },
  { id: 'logowall', label: 'LogoWall' },
  { id: 'leadform', label: 'LeadForm' },
  { id: 'postgrid', label: 'PostGrid' },
  { id: 'articledetail', label: 'ArticleDetail' },
  { id: 'categorychips', label: 'CategoryChips' },
  { id: 'header-footer', label: 'Header a Footer' },
  { id: 'herocarousel', label: 'HeroCarousel' },
  { id: 'reveal', label: 'Scroll reveal' },
  { id: 'otevrene', label: 'Otevřené otázky' },
];
---

<div class="gal">
  <Container>
    <header class="gal__head">
      <p class="gal__kicker">Katalog komponent</p>
      <h1 class="gal__h1">{brand}</h1>
      <p class="gal__lead">
        Všech 25 sdílených komponent z <code>packages/ui</code>, jejich varianty a props.
        Renderuje se skutečnými komponentami v tokenech značky {brand}, takže co je tady,
        to je na webu. Stejná stránka existuje na každém webu skupiny, takže se dá porovnat,
        jak stejná komponenta vypadá v jiné značce.
      </p>
      <nav class="gal__toc" aria-label="Obsah katalogu">
        {OBSAH.map((o) => <a href={`#${o.id}`}>{o.label}</a>)}
      </nav>
    </header>

    {/* ============================================================ */}
    <section class="gal__block" id="skladani">
      <h2 class="gal__h2">Jak skládat stránku</h2>
      <p class="gal__p">
        Stránka je vždycky posloupnost sekcí. <strong>Section</strong> dělá vodorovný pás:
        drží pozadí, svislé mezery a uvnitř sebe <strong>Container</strong>, který drží
        šířku a odsazení od okrajů. Komponenta typu blok (Hero, USPGrid, StatsBand,
        Testimonials, Faq, LeadForm) už Section obsahuje v sobě, takže se do další Section
        nezanořuje. Prvky (Heading, Text, Button, Badge, Icon, Card, Field) Section neobsahují
        a patří dovnitř sekce nebo bloku.
      </p>
      <pre class="gal__pre"><code>{`<Base title="Text | ${brand}" description="...">
  <SiteHeader />
  <main>
    <Hero eyebrow="..." background="gradient" usp={[...]}>
      <Heading slot="title" as="h1" size="display">Nadpis</Heading>
      <Fragment slot="actions"><Button href="/kontakt">CTA</Button></Fragment>
      <img slot="media" src="..." alt="..." />
    </Hero>

    <LogoWall logos={[...]} />
    <USPGrid eyebrow="..." title="..." items={[...]} />
    <StatsBand items={[...]} />
    <Testimonials items={[...]} />
    <Faq items={[...]} />
    <LeadForm id="poptavka" proofs={${brand.toLowerCase()}LeadProofs} />
  </main>
  <SiteFooter />
</Base>`}</code></pre>
      <p class="gal__p gal__p--muted">
        Dvě pravidla, která drží weby pohromadě: <strong>hodnoty se mění v tokens.css
        značky, nikdy v komponentě</strong>, a <strong>proofs u LeadFormu si dodává každý
        web sám</strong> ze svého <code>config/leadProofs.ts</code>, protože skupinová čísla
        Piana nejsou čísla jedné značky.
      </p>
    </section>

    {/* ============================================================ */}
    <Tokens />

    {/* ============================================================ */}
    <Spec id="section" name="Section" count={159}
      what="Vodorovný pás stránky. Drží pozadí, svislé mezery, šířku obsahu a scroll reveal."
      when="Vždycky, když zakládáš nový pás obsahu. Bloky jako Hero nebo USPGrid ji už mají v sobě."
      props={[
        { prop: 'background', type: "'default' | 'alt' | 'warm' | 'invert' | 'primary' | 'gradient' | 'cyan' | 'yellow' | 'pink'", def: "'default'", note: 'cyan, yellow a pink jsou barevné pásy Grasonu' },
        { prop: 'space', type: "'sm' | 'md' | 'lg'", def: "'md'", note: 'svislé odsazení' },
        { prop: 'container', type: "'default' | 'narrow' | 'wide' | 'full' | false", def: "'default'", note: 'false = obsah bez kontejneru' },
        { prop: 'decor', type: "boolean | 'top' | 'bottom' | 'both'", def: 'false', note: 'dekorativní kruh na hranici pásu' },
        { prop: 'reveal', type: 'boolean', def: 'true', note: 'vypnout, když si blok animuje části sám' },
        { prop: 'revealFrom', type: "'bottom' | 'left' | 'right' | 'top'", def: "'bottom'" },
        { prop: 'as', type: 'string', def: "'section'" },
        { prop: 'id', type: 'string', note: 'ukotvení pro odkazy' },
      ]}>
      <Demo label="pozadí default, alt, warm" bleed code='<Section background="alt">'>
        <Section background="default"><Text>background="default"</Text></Section>
        <Section background="alt"><Text>background="alt"</Text></Section>
        <Section background="warm"><Text>background="warm" (token má jen Piano, jinde spadne na alt)</Text></Section>
      </Demo>
      <Demo label="pozadí invert, primary, gradient" bleed>
        <Section background="invert"><Text color="on-dark">background="invert"</Text></Section>
        <Section background="primary"><Text color="on-dark">background="primary"</Text></Section>
        <Section background="gradient"><Text color="on-dark">background="gradient"</Text></Section>
      </Demo>
      <Demo label="barevné pásy Grasonu (na ostatních značkách se nepoužívají)" bleed>
        <Section background="cyan"><Text>background="cyan"</Text></Section>
        <Section background="yellow"><Text>background="yellow"</Text></Section>
        <Section background="pink"><Text>background="pink"</Text></Section>
      </Demo>
      <Demo label="dekorativní kruh na hranici" bleed code='decor="both"'>
        <Section background="alt" decor="both"><Text>decor="both"</Text></Section>
      </Demo>
    </Spec>

    <Spec id="container" name="Container" count={2}
      what="Šířka a odsazení obsahu od okrajů okna. Používá ji Section a Breadcrumb, přímo ve stránkách skoro nikdy."
      when="Sám o sobě jen tehdy, když potřebuješ jinou šířku uvnitř pásu bez kontejneru."
      props={[
        { prop: 'size', type: "'default' | 'narrow' | 'wide' | 'full'", def: "'default'" },
        { prop: 'as', type: 'string', def: "'div'" },
      ]}>
      <Demo label="čtyři šířky">
        <div class="gal__widths">
          <Container size="narrow"><span>narrow</span></Container>
          <Container size="default"><span>default</span></Container>
          <Container size="wide"><span>wide</span></Container>
          <Container size="full"><span>full</span></Container>
        </div>
      </Demo>
    </Spec>

    <Spec id="heading" name="Heading" count={176}
      what="Nadpis. Velikost je oddělená od úrovně, takže h2 může vypadat jako display."
      when="Na každý nadpis. Úroveň (as) vybírej podle struktury dokumentu, velikost (size) podle vzhledu."
      props={[
        { prop: 'as', type: "'h1' | 'h2' | 'h3' | 'h4' | 'p'", def: "'h2'", note: 'úroveň v dokumentu' },
        { prop: 'size', type: "'display' | 'h1' | 'h2' | 'h3'", note: 'vzhled, bez ní podle as' },
        { prop: 'align', type: "'left' | 'center' | 'right'", def: "'left'" },
        { prop: 'color', type: "'default' | 'muted' | 'accent' | 'on-dark'", def: "'default'" },
        { prop: 'balance', type: 'boolean', def: 'true', note: 'vyrovnané zalomení řádků' },
      ]}>
      <Demo label="velikosti">
        <Heading as="p" size="display">display</Heading>
        <Heading as="p" size="h1">h1</Heading>
        <Heading as="p" size="h2">h2</Heading>
        <Heading as="p" size="h3">h3</Heading>
      </Demo>
      <Demo label="akcentní slovo v nadpisu" code="<em> nebo <span class='accent'>">
        <Heading as="p" size="h2">Nadpis s <em>akcentem</em> uvnitř</Heading>
        <Heading as="p" size="h2">Nadpis s <span class="accent">akcentem</span> uvnitř</Heading>
      </Demo>
    </Spec>

    <Spec id="text" name="Text" count={146}
      what="Odstavec a všechny nenadpisové velikosti textu včetně popisků a návěsů."
      when="Na běžný text, perex, popisek i na návěs nad nadpisem (size='label')."
      props={[
        { prop: 'as', type: "'p' | 'span' | 'div' | 'li'", def: "'p'" },
        { prop: 'size', type: "'lead' | 'body' | 'small' | 'caption' | 'label'", def: "'body'" },
        { prop: 'color', type: "'default' | 'muted' | 'accent' | 'on-dark' | 'on-dark-muted'", def: "'default'" },
        { prop: 'weight', type: "'regular' | 'medium' | 'semibold' | 'bold'" },
        { prop: 'align', type: "'left' | 'center' | 'right'", def: "'left'" },
        { prop: 'balance', type: 'boolean', def: 'false' },
      ]}>
      <Demo label="velikosti">
        <Text size="lead">lead, perex pod nadpisem</Text>
        <Text size="body">body, běžný text</Text>
        <Text size="small">small, doplňkový text</Text>
        <Text size="caption">caption, popisek</Text>
        <Text size="label">label, návěs nad nadpisem</Text>
      </Demo>
      <Demo label="barvy">
        <Text color="default">default</Text>
        <Text color="muted">muted</Text>
        <Text color="accent">accent</Text>
      </Demo>
    </Spec>

    <Spec id="button" name="Button" count={144}
      what="Tlačítko nebo odkaz vypadající jako tlačítko. S href renderuje <a>, bez něj <button>."
      when="Primary jen jednou v sekci, na hlavní akci. Secondary na doplňkovou, ghost na potlačenou."
      props={[
        { prop: 'variant', type: "'primary' | 'secondary' | 'ghost'", def: "'primary'" },
        { prop: 'size', type: "'sm' | 'md' | 'lg'", def: "'md'" },
        { prop: 'href', type: 'string', note: 'renderuje <a> místo <button>' },
        { prop: 'full', type: 'boolean', def: 'false', note: 'na plnou šířku' },
        { prop: 'onDark', type: 'boolean', def: 'false', note: 'čitelnost na tmavém pásu' },
        { prop: 'type', type: "'button' | 'submit' | 'reset'", def: "'button'" },
      ]}>
      <Demo label="varianty">
        <div class="gal__row">
          <Button href="#">primary</Button>
          <Button href="#" variant="secondary">secondary</Button>
          <Button href="#" variant="ghost">ghost</Button>
        </div>
      </Demo>
      <Demo label="velikosti">
        <div class="gal__row">
          <Button href="#" size="sm">sm</Button>
          <Button href="#" size="md">md</Button>
          <Button href="#" size="lg">lg</Button>
        </div>
      </Demo>
      <Demo label="na tmavém pásu" bleed code="onDark">
        <Section background="primary">
          <div class="gal__row">
            <Button href="#">primary</Button>
            <Button href="#" variant="secondary" onDark>secondary onDark</Button>
          </div>
        </Section>
      </Demo>
    </Spec>

    <Spec id="badge" name="Badge" count={5}
      what="Malý štítek pro stav nebo příznak."
      when="Na příznak u karty nebo v ceníku. Ne jako dekoraci."
      props={[
        { prop: 'variant', type: "'neutral' | 'primary' | 'success' | 'warning' | 'info'", def: "'neutral'" },
        { prop: 'tone', type: "'soft' | 'solid'", def: "'soft'" },
        { prop: 'size', type: "'sm' | 'md'", def: "'md'" },
        { prop: 'icon', type: 'string', note: 'název ikony, např. lucide:check' },
      ]}>
      <Demo label="varianty, tón soft">
        <div class="gal__row">
          <Badge>neutral</Badge><Badge variant="primary">primary</Badge>
          <Badge variant="success">success</Badge><Badge variant="warning">warning</Badge>
          <Badge variant="info">info</Badge>
        </div>
      </Demo>
      <Demo label="tón solid a s ikonou">
        <div class="gal__row">
          <Badge variant="primary" tone="solid">solid</Badge>
          <Badge variant="success" icon="lucide:check">s ikonou</Badge>
          <Badge size="sm">sm</Badge>
        </div>
      </Demo>
    </Spec>

    <Spec id="icon" name="Icon" count={113}
      what="Ikona ze sady Lucide. Jméno se zapisuje jako lucide:nazev."
      when="Vždy s textem, nikdy jako jediný nositel významu. Dekorativní ikona nemá title."
      props={[
        { prop: 'name', type: 'string', note: 'např. lucide:zap', req: true },
        { prop: 'size', type: "'xs' | 'sm' | 'md' | 'lg' | 'xl' | number", def: "'md'" },
        { prop: 'color', type: "'inherit' | 'default' | 'muted' | 'accent' | 'on-dark'", def: "'inherit'" },
        { prop: 'title', type: 'string', note: 'jen když ikona nese význam sama' },
      ]}>
      <Demo label="velikosti">
        <div class="gal__row gal__row--mid">
          <Icon name="lucide:zap" size="xs" /><Icon name="lucide:zap" size="sm" />
          <Icon name="lucide:zap" size="md" /><Icon name="lucide:zap" size="lg" />
          <Icon name="lucide:zap" size="xl" />
        </div>
      </Demo>
      <Demo label="barvy">
        <div class="gal__row gal__row--mid">
          <Icon name="lucide:shield-check" size="lg" color="default" />
          <Icon name="lucide:shield-check" size="lg" color="muted" />
          <Icon name="lucide:shield-check" size="lg" color="accent" />
        </div>
      </Demo>
    </Spec>

    <Spec id="card" name="Card" count={9}
      what="Kontejner karty. Sám nic neobsahuje, obsah jde slotem, obrázek slotem media."
      when="Když potřebuješ obsah v rámečku a není na to hotový blok. Na mřížku výhod použij USPGrid."
      props={[
        { prop: 'variant', type: "'default' | 'elevated' | 'bordered' | 'filled'", def: "'default'" },
        { prop: 'padding', type: "'none' | 'sm' | 'md' | 'lg'", def: "'md'" },
        { prop: 'chamfer', type: 'boolean', def: 'false', note: 'seříznutý levý horní roh' },
        { prop: 'href', type: 'string', note: 'klikací karta s hoverem' },
        { prop: 'as', type: "'div' | 'article' | 'li'", def: "'div'" },
      ]}
      slots={[{ slot: 'media', note: 'obrázek nahoře, bez paddingu' }]}>
      <Demo label="varianty">
        <div class="gal__cards">
          <Card><Text weight="semibold">default</Text><Text size="small" color="muted">1px rámeček</Text></Card>
          <Card variant="elevated"><Text weight="semibold">elevated</Text><Text size="small" color="muted">stín místo rámečku</Text></Card>
          <Card variant="bordered"><Text weight="semibold">bordered</Text><Text size="small" color="muted">silnější linka</Text></Card>
          <Card variant="filled"><Text weight="semibold">filled</Text><Text size="small" color="muted">plocha bez rámečku</Text></Card>
        </div>
      </Demo>
      <Demo label="chamfer a klikací karta">
        <div class="gal__cards">
          <Card chamfer><Text weight="semibold">chamfer</Text><Text size="small" color="muted">signature seříznutý roh</Text></Card>
          <Card href="#"><Text weight="semibold">href</Text><Text size="small" color="muted">celá karta je odkaz</Text></Card>
        </div>
      </Demo>
    </Spec>

    <Spec id="field" name="Field" count={1}
      what="Jedno pole formuláře: popisek, vstup, nápověda, stav povinnosti."
      when="Uvnitř vlastního formuláře. Poptávkový formulář má hotový LeadForm."
      props={[
        { prop: 'label', type: 'string', req: true },
        { prop: 'name', type: 'string', req: true },
        { prop: 'type', type: "'text' | 'email' | 'tel'", def: "'text'" },
        { prop: 'required', type: 'boolean', def: 'false' },
        { prop: 'prefix', type: 'string', note: 'např. předvolba' },
        { prop: 'icon', type: 'string' },
        { prop: 'helper', type: 'string', note: 'nápověda pod polem' },
        { prop: 'multiline', type: 'boolean', def: 'false', note: 'renderuje textarea' },
        { prop: 'rows', type: 'number', def: '4' },
      ]}>
      <Demo label="typy polí">
        <div class="gal__fields">
          <Field label="Jméno" name="g-name" required />
          <Field label="E-mail" name="g-email" type="email" placeholder="info@podnik.cz" />
          <Field label="Telefon" name="g-tel" type="tel" prefix="+420" helper="Zavoláme vám zpět." />
          <Field label="Zpráva" name="g-msg" multiline rows={3} />
        </div>
      </Demo>
    </Spec>

    <Spec id="breadcrumb" name="Breadcrumb" count={42}
      what="Drobečková navigace. Poslední položka bez href je aktuální stránka."
      when="Na podstránkách hlouběji než druhá úroveň. Na homepage ne."
      note="Nese si vlastní Container, takže je určený jako samostatný pás NAD sekcí. Uvnitř Section by vznikl vnořený kontejner s dvojím odsazením; tam použij lokální Breadcrumb webu, jako to dělá ArticleDetail."
      props={[
        { prop: 'items', type: '{ label, href? }[]', req: true },
        { prop: 'background', type: "'default' | 'alt'", def: "'default'" },
      ]}>
      <Demo label="tři úrovně" bleed>
        <Breadcrumb items={[{ label: 'Domů', href: '/' }, { label: 'Rubrika', href: '#' }, { label: 'Aktuální stránka' }]} />
      </Demo>
    </Spec>

    {/* ---------- BLOKY ---------- */}
    <Spec id="hero" name="Hero" count={150}
      what="Úvodní blok stránky. Nese návěs, nadpis, perex, CTA, proužek USP a volitelně médium."
