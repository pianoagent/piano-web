---
/**
 * Spec: rámec jedné položky v galerii komponent.
 * Nadpis, k čemu komponenta je, kdy ji použít, tabulka props a pak živé ukázky
 * ve slotu. Ukázky se renderují SKUTEČNOU komponentou v tokenech dané značky,
 * takže galerie nemůže odejít od reality.
 *
 *   name:   název komponenty ("Hero")
 *   what:   jednou větou, co to je
 *   when:   kdy to použít, kdy ne
 *   props:  [{ prop, type, def, note }]
 *   slots:  [{ slot, note }]
 *   count:  na kolika souborech se dnes používá (z inventury)
 *   note:   volitelná poznámka nebo otevřená otázka pro grafika
 */
interface Prop { prop: string; type: string; def?: string; req?: boolean; note?: string; }
interface Slot { slot: string; note: string; }
interface Props {
  id: string;
  name: string;
  what: string;
  when?: string;
  props?: Prop[];
  slots?: Slot[];
  count?: number;
  note?: string;
}
const { id, name, what, when, props = [], slots = [], count, note } = Astro.props;
---

<article class="spec" id={id}>
  <header class="spec__head">
    <h3 class="spec__name">{name}</h3>
    {count !== undefined && (
      <span class="spec__count">{count === 0 ? 'nikde se nepoužívá' : `${count} souborů`}</span>
    )}
  </header>
  <p class="spec__what">{what}</p>
  {when && <p class="spec__when"><strong>Kdy:</strong> {when}</p>}
  {note && <p class="spec__note">{note}</p>}

  {props.length > 0 && (
    <div class="spec__tablewrap">
      <table class="spec__table">
        <thead><tr><th>prop</th><th>hodnoty</th><th>default</th><th>poznámka</th></tr></thead>
        <tbody>
          {props.map((p) => (
            <tr>
              <td><code>{p.prop}</code></td>
              <td><code class="spec__type">{p.type}</code></td>
              <td>{p.def ? <code>{p.def}</code> : <span class="spec__dash">{p.req ? 'povinné' : 'volitelné'}</span>}</td>
              <td>{p.note ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {slots.length > 0 && (
    <ul class="spec__slots">
      {slots.map((s) => <li><code>&lt;slot name="{s.slot}"&gt;</code> {s.note}</li>)}
    </ul>
  )}

  <div class="spec__demos"><slot /></div>
</article>

<style>
  .spec {
    scroll-margin-top: 90px;
    padding-top: 48px;
    border-top: 2px solid var(--color-border);
  }
  .spec__head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .spec__name {
    font-family: var(--font-display, var(--font-sans));
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    line-height: 1.1;
  }
  .spec__count {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    white-space: nowrap;
  }
  .spec__what { margin-top: 8px; color: var(--color-text); max-width: 70ch; }
  .spec__when, .spec__note { margin-top: 6px; font-size: var(--font-size-small); color: var(--color-text-muted); max-width: 70ch; }
  .spec__note { border-left: 3px solid var(--color-warning, var(--color-primary)); padding-left: 12px; }

  .spec__tablewrap { overflow-x: auto; margin-top: 20px; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .spec__table { width: 100%; border-collapse: collapse; font-size: var(--font-size-small); background: var(--color-bg); }
  .spec__table th, .spec__table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .spec__table thead th { background: var(--color-bg-alt); font-size: var(--font-size-caption); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); }
  .spec__table tbody tr:last-child td { border-bottom: none; }
  .spec__table code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.92em; }
  .spec__type { color: var(--color-text-muted); }
  .spec__dash { color: var(--color-text-muted); font-size: var(--font-size-caption); }

  .spec__slots { margin-top: 14px; padding-left: 18px; font-size: var(--font-size-small); color: var(--color-text-muted); }
  .spec__slots li + li { margin-top: 4px; }
  .spec__slots code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--color-text); }

  .spec__demos { margin-top: 24px; }
</style>
