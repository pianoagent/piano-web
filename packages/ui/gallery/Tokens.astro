---
/**
 * Tokens: vzorníky tokenů dané značky. Nic tu není napsané ručně, všechno se
 * kreslí z živých CSS proměnných, takže vzorník vždycky odpovídá tomu, co web
 * skutečně používá. Názvy jsou ty, které konzumují komponenty (po bridge.css);
 * zdrojová vrstva se jmenuje jinak (--bg, --ink, --accent) a je v tokens.css.
 */
const BARVY = [
  { grp: 'Značka', items: ['--color-primary', '--color-primary-hover', '--color-primary-active', '--color-primary-bg', '--color-secondary', '--color-secondary-gold', '--color-secondary-terracotta'] },
  { grp: 'Text', items: ['--color-text', '--color-text-muted', '--color-text-accent', '--color-text-on-dark', '--color-text-on-dark-muted'] },
  { grp: 'Pozadí', items: ['--color-bg', '--color-bg-alt', '--color-bg-warm', '--color-bg-invert', '--color-bg-hover', '--color-bg-cyan', '--color-bg-yellow', '--color-bg-pink'] },
  { grp: 'Linky', items: ['--color-border', '--color-border-strong', '--color-border-on-dark'] },
  { grp: 'Stavy', items: ['--color-success', '--color-warning', '--color-error', '--color-info'] },
];
const TYPO = ['--font-size-display', '--font-size-h1', '--font-size-h2', '--font-size-h3', '--font-size-lead', '--font-size-body', '--font-size-small', '--font-size-caption', '--font-size-label'];
const MEZERY = ['--space-1', '--space-2', '--space-3', '--space-4', '--space-5', '--space-6', '--space-7', '--space-8', '--space-9', '--space-10'];
const RADIUS = ['--radius-sm', '--radius-md', '--radius-lg', '--radius-full'];
const STINY = ['--shadow-sm', '--shadow-md', '--shadow-lg'];
const VAHY = ['--font-weight-regular', '--font-weight-medium', '--font-weight-semibold', '--font-weight-bold'];
---

<section class="tok" id="tokeny">
  <h2 class="tok__h2">Tokeny značky</h2>
  <p class="tok__lead">
    Hodnoty se kreslí z živých CSS proměnných téhle stránky, takže vzorník nemůže
    zestárnout. Jména jsou ta, která berou komponenty. Zdrojová vrstva se jmenuje
    jinak (<code>--bg</code>, <code>--ink</code>, <code>--accent</code>) a mapuje ji
    <code>bridge.css</code>. Měnit se tedy má vždycky <code>tokens.css</code> dané
    značky, nikdy komponenta.
  </p>

  <h3 class="tok__h3">Barvy</h3>
  {BARVY.map((g) => (
    <>
      <p class="tok__grp">{g.grp}</p>
      <ul class="tok__swatches">
        {g.items.map((t) => (
          <li class="tok__sw">
            <span class="tok__chip" style={`background: var(${t})`}></span>
            <code class="tok__name">{t.replace('--color-', '')}</code>
            <span class="tok__val" data-token={t}></span>
          </li>
        ))}
      </ul>
    </>
  ))}

  <h3 class="tok__h3">Typografická škála</h3>
  <ul class="tok__type">
    {TYPO.map((t) => (
      <li class="tok__typerow">
        <span class="tok__sample" style={`font-size: var(${t})`}>Aa Šť 123</span>
        <code class="tok__name">{t.replace('--font-size-', '')}</code>
        <span class="tok__val" data-token={t}></span>
      </li>
    ))}
  </ul>

  <h3 class="tok__h3">Řezy písma</h3>
  <ul class="tok__type">
    {VAHY.map((t) => (
      <li class="tok__typerow">
        <span class="tok__sample tok__sample--w" style={`font-weight: var(${t})`}>Příliš žluťoučký kůň</span>
        <code class="tok__name">{t.replace('--font-weight-', '')}</code>
        <span class="tok__val" data-token={t}></span>
      </li>
    ))}
  </ul>

  <h3 class="tok__h3">Mezery</h3>
  <ul class="tok__spaces">
    {MEZERY.map((t) => (
      <li class="tok__sprow">
        <code class="tok__name">{t.replace('--space-', 'space-')}</code>
        <span class="tok__bar" style={`width: var(${t})`}></span>
        <span class="tok__val" data-token={t}></span>
      </li>
    ))}
  </ul>

  <h3 class="tok__h3">Zaoblení a stíny</h3>
  <ul class="tok__boxes">
    {RADIUS.map((t) => (
      <li class="tok__box">
        <span class="tok__boxdemo" style={`border-radius: var(${t})`}></span>
        <code class="tok__name">{t.replace('--radius-', 'radius-')}</code>
        <span class="tok__val" data-token={t}></span>
      </li>
    ))}
    {STINY.map((t) => (
      <li class="tok__box">
        <span class="tok__boxdemo tok__boxdemo--shadow" style={`box-shadow: var(${t})`}></span>
        <code class="tok__name">{t.replace('--shadow-', 'shadow-')}</code>
      </li>
    ))}
  </ul>

  <h3 class="tok__h3">Písma</h3>
  <ul class="tok__fonts">
    <li><code class="tok__name">--font-display</code> <span class="tok__val" data-token="--font-display"></span></li>
    <li><code class="tok__name">--font-sans</code> <span class="tok__val" data-token="--font-sans"></span></li>
    <li><code class="tok__name">--font-serif</code> <span class="tok__val" data-token="--font-serif"></span></li>
  </ul>
</section>

{/* Dopsání skutečných hodnot. Bez JS zůstane vzorník i tak čitelný, chybí jen
    číselné hodnoty vedle názvů, samotné vzorky kreslí CSS. */}
<script is:inline>
  (function () {
    var cs = getComputedStyle(document.documentElement);
    var els = document.querySelectorAll('.tok__val[data-token]');
    for (var i = 0; i < els.length; i++) {
      var v = cs.getPropertyValue(els[i].getAttribute('data-token')).trim();
      els[i].textContent = v || 'není definován';
      if (!v) els[i].classList.add('tok__val--missing');
    }
  })();
</script>

<style>
  .tok { scroll-margin-top: 90px; }
  .tok__h2 { font-family: var(--font-display, var(--font-sans)); font-size: var(--font-size-h1); font-weight: var(--font-weight-bold); line-height: 1.1; }
  .tok__h3 { font-family: var(--font-display, var(--font-sans)); font-size: var(--font-size-h3); font-weight: var(--font-weight-bold); margin-top: 40px; }
  .tok__lead { margin-top: 10px; color: var(--color-text-muted); max-width: 74ch; }
  .tok__lead code, .tok__name, .tok__val { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
  .tok__grp { margin-top: 20px; font-size: var(--font-size-caption); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }

  .tok__swatches, .tok__type, .tok__spaces, .tok__boxes, .tok__fonts { list-style: none; margin-top: 10px; }
  .tok__swatches { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .tok__sw { display: flex; align-items: center; gap: 10px; }
  .tok__chip { width: 34px; height: 34px; flex-shrink: 0; border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
  .tok__name { color: var(--color-text); }
  .tok__val { color: var(--color-text-muted); font-size: var(--font-size-caption); }
  .tok__val--missing { color: var(--color-error, #b00); }

  .tok__typerow { display: flex; align-items: baseline; gap: 14px; padding: 6px 0; border-bottom: 1px solid var(--color-border); flex-wrap: wrap; }
  .tok__sample { font-family: var(--font-display, var(--font-sans)); font-weight: var(--font-weight-bold); line-height: 1.1; }
  .tok__sample--w { font-family: var(--font-sans); font-size: var(--font-size-lead); }

  .tok__sprow { display: flex; align-items: center; gap: 14px; padding: 4px 0; }
  .tok__sprow .tok__name { min-width: 90px; }
  .tok__bar { height: 14px; background: var(--color-primary); border-radius: 2px; }

  .tok__boxes { display: flex; flex-wrap: wrap; gap: 22px; }
  .tok__box { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .tok__boxdemo { display: block; width: 74px; height: 54px; background: var(--color-primary); }
  .tok__boxdemo--shadow { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }

  .tok__fonts li { padding: 4px 0; }
</style>
