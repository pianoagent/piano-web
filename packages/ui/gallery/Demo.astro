---
/**
 * Demo: jedna ukázka uvnitř Spec. Popisek nad ní říká, co je na ní vidět,
 * a volitelně jak se to zapisuje.
 *
 *   label: název varianty ("split, s médiem")
 *   code:  jak se to volá, jednořádkově
 *   bleed: ukázka na plnou šířku bez rámečku (pro sekce a pásy, které mají
 *          vlastní pozadí a v rámečku by vypadaly rozbitě)
 */
interface Props { label: string; code?: string; bleed?: boolean; }
const { label, code, bleed = false } = Astro.props;
---

<div class="demo">
  <div class="demo__bar">
    <span class="demo__label">{label}</span>
    {code && <code class="demo__code">{code}</code>}
  </div>
  <div class:list={['demo__stage', bleed && 'demo__stage--bleed']}><slot /></div>
</div>

<style>
  .demo { margin-top: 20px; }
  .demo__bar {
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    padding-bottom: 8px;
  }
  .demo__label {
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .demo__code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }
  /* Rámeček kolem ukázky, ať je vidět, kde komponenta začíná a končí. */
  .demo__stage {
    border: 1px dashed var(--color-border-strong, var(--color-border));
    border-radius: var(--radius-md);
    padding: 20px;
    background: var(--color-bg);
  }
  /* Sekce a pásy mají vlastní pozadí na plnou šířku, rámeček i padding by je
     rozbily. Vylezou tedy z kontejneru galerie do plné šířky okna. */
  .demo__stage--bleed {
    border: none; padding: 0; background: none; border-radius: 0;
    margin-inline: calc(50% - 50vw);
    outline: 1px dashed var(--color-border-strong, var(--color-border));
  }
</style>
