---
/**
 * ABX HARSYS - Reference. Obsah z obsah/pokladni-system-pro-restaurace-harsys-reference.md.
 * Komponenty z @piano/ui.
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Testimonials from '@piano/ui/components/Testimonials.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';
import { harsysNav, harsysCta, harsysFooter } from '../config/nav';

const reference = [
  { photo: '/images/ref/jan-poloch.webp', author: 'Ing. Jan Poloch', role: 'Startronic Gastro Ostrava, 27+ provozoven', quote: 'Pokladní systém pro restaurace Harsys mi pomáhá úplně se vším. Mám ho rád! Je přehledný a spolehlivý.' },
  { photo: '/images/ref/aneta-srncova.webp', author: 'Bc. Aneta Srncová', role: 'Třebovický mlýn, Ostrava', quote: 'Pokladní systém Harsys využíváme pro jeho přehlednost a snadné pochopení jeho fungování.' },
  { photo: '/images/ref/long-story-short.webp', author: 'Petr Heneš', role: 'Long story short, Olomouc', quote: 'S firmou ABX spolupracujeme již celých 6 let. V celém našem podniku vždy maximálně využíváme všechny vychytávky, které jejich pokladní systém nabízí.' },
  { photo: '/images/ref/hana-ztratilova.webp', author: 'Hana Ztratilová', role: 'Restaurace Na Špici, Radošov', quote: 'Harsys používáme od roku 2009 a opravdu nám vyhovuje. Systém nabízí spoustu užitečných funkcí, které nám usnadňují provoz. Oceňujeme také podporu, která je vždy připravena nám pomoci.' },
  { photo: '/images/ref/fabrika-pizzerie.webp', author: 'Pavel Marek', role: 'FABRIKA pizzerie, Havlíčkův Brod', quote: 'Spolehlivý a efektivní software pro podnikání. Ideální pro každého, kdo chce zefektivnit svůj podnik.' },
];

const stats = [
  { num: '4 108', lbl: 'zákazníků nám dalo důvěru' },
  { num: '11 535', lbl: 'registrovaných licencí' },
  { num: '27+', lbl: 'let zkušeností s vývojem' },
];

const leadProofs = [
  { icon: 'lucide:map-pin', title: 'Po celé ČR', text: 'Restaurace, bary i hotely v celé republice.' },
  { icon: 'lucide:heart-handshake', title: 'Dlouhodobá spolupráce', text: 'Zákazníci s námi zůstávají roky.' },
  { icon: 'lucide:headset', title: 'Nejlepší podpora', text: 'K nám se dovoláte snadno.' },
];
---

<Base title="Reference pokladního systému Harsys | ABX HARSYS"
      description="Pokladní systém Harsys má spokojené zákazníky po celé České republice. Podívejte se na reference restaurací, barů a hotelů.">
  <Header brand="ABX HARSYS" logoSrc="/logos/abx_logo.svg" logoHeight="26px" homeHref="/" nav={harsysNav} cta={harsysCta} />

  <main>

  <Hero eyebrow="Reference" background="gradient"
        lead="Naše spokojené uživatele najdete po celé České republice. Během let nám dalo důvěru přes 4 100 zákazníků a registrováno je více než 11 500 licencí.">
    <Heading slot="title" as="h1" size="display" color="on-dark">Co říkají <span class="accent">naši zákazníci</span></Heading>
  </Hero>

  <Testimonials
    header={false}
    background="default"
    items={reference}
    attribution="bottom" />
  <Section background="invert" space="md">
    <ul class="stats">
      {stats.map((s) => (
        <li class="stats__item">
          <span class="stats__num">{s.num}</span>
          <span class="stats__lbl">{s.lbl}</span>
        </li>
      ))}
    </ul>
  </Section>

  <LeadForm id="poptavka" variant="callback" background="primary"
            title="Přidejte se ke spokojeným provozům"
            lead="Zanechte číslo a my se vám ozveme. Rádi vám Harsys předvedeme přímo ve vašem provozu."
            proofs={leadProofs} successUrl="/dekujeme" />

  </main>

  <Footer {...harsysFooter} />
</Base>

<style>

  .stats { list-style: none; display: grid; gap: var(--space-5); grid-template-columns: repeat(3, 1fr); text-align: center; }
  .stats__item { display: flex; flex-direction: column; gap: var(--space-1); }
  .stats__num { font-size: var(--font-size-h1); font-weight: var(--font-weight-bold); line-height: 1; color: #fff; }
  .stats__lbl { font-size: var(--font-size-small); color: var(--color-text-on-dark-muted); }
  @media (max-width: 720px) { .stats { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
