---
/**
 * Katalog komponent: ABX HARSYS.
 *
 * Obsah je sdílená Gallery z @piano/ui, takže katalog je na všech webech stejný
 * a renderuje se vždycky v tokenech a fontech té které značky. Stránka je
 * noindex a je vyřazená ze sitemapy, není určená pro vyhledávače ani zákazníky.
 * Slouží k ladění s grafikem a jako referenci, z čeho se skládají stránky.
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Footer from '@piano/ui/components/Footer.astro';
import { harsysNav, harsysCta, harsysFooter } from '../config/nav';
import Gallery from '@piano/ui/gallery/Gallery.astro';
---

<Base title="Katalog komponent | ABX HARSYS" noindex
      description="Interní katalog sdílených komponent, jejich variant a tokenů značky ABX HARSYS.">
  <Header brand="ABX HARSYS" logoSrc="/logos/abx_logo.svg" logoHeight="26px" homeHref="/" nav={harsysNav} cta={harsysCta} />
  <main>
    <Gallery brand="ABX HARSYS"
      logos={["ref-100-chuti-brna", "ref-420-restaurant", "ref-O2-arena"]}
      />
  </main>
  <Footer {...harsysFooter} />
</Base>
