    { f: 'Delivery (Wolt, Foodora, Bolt)', v: ['NE', 'WIP', 'ANO*'] },
    { f: 'Kuchyňský displej (KDS)', v: ['NE', 'WIP', 'PARTNER'] },
    { f: 'Více poboček z jednoho místa', v: ['NE', 'WIP', 'ANO'] },
    { f: 'Pokročilé reporty', v: ['NE', 'NE', 'ANO'] },
  ]},
];

const markMeta = {
  'ANO':     { cls: 'ok', ico: 'lucide:check', t: 'Ano' },
  'ANO*':    { cls: 'ok', ico: 'lucide:check', t: 'Ano, s poznámkou', star: true },
  'NE':      { cls: 'no', ico: 'lucide:minus', t: 'Ne' },
  'WIP':     { cls: 'wip', ico: 'lucide:clock', t: 'Připravujeme' },
  'PARTNER': { cls: 'partner', ico: 'lucide:handshake', t: 'Přes partnera' },
};

// Blue ocean: hospoda dnes vs hospoda pripravena na budoucnost (obecne benefity, neutralni)
const dnes = [
  'Ruční výkazy a papírování po zavíračce',
  'Rozhodování od oka, bez dat',
  'Tržby a marže zjistíte se zpožděním',
  'Sklad a objednávky podle paměti',
  'Směny a personál řešíte na telefonu',
  'Víc dodavatelů, víc faktur, víc chaosu',
];
const zitra = [
  'Administrativa a účtenky odbaví systém',
  'Rozhodnutí opřená o reálná data',
  'Přehled o tržbách i maržích v reálném čase',
  'Systém hlídá zásoby a připomene objednávku',
  'Chytré plánování směn podle provozu',
  'Jedno řešení, jedno vyúčtování, klid',
];

// Co se meni
const zmeny = [
  { icon: 'lucide:receipt', title: 'Účtenka jen na vyžádání', text: 'Konec povinného tisku. Účtenku vydáte, jen když ji zákazník chce, klidně i digitálně.' },
  { icon: 'lucide:credit-card', title: 'Eviduje se osobní platba', text: 'Hotovost, karta, QR kód i stravenky přijaté při osobním kontaktu se zákazníkem.' },
  { icon: 'lucide:cpu', title: 'Stačí softwarový update', text: 'Moderní pokladní systém zvládne nová pravidla aktualizací. Nové vybavení obvykle není potřeba.' },
  { icon: 'lucide:file-text', title: 'Minimum údajů', text: 'Stát po vás chce méně dat než u prvního EET. Evidence je jednodušší.' },
  { icon: 'lucide:hand-coins', title: 'Výhodnější spropitné', text: 'Dobrovolné spropitné do 7 % tržeb bude osvobozeno od daní i odvodů.' },
  { icon: 'lucide:percent', title: 'Nižší DPH na nealko', text: 'Daň u nealkoholických nápojů klesá z 21 % na 12 %.' },
