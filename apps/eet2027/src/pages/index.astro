---
/**
 * EET 2027 - homepage (jednostranka).
 * Samostatny informacni web k navratu elektronicke evidence trzeb od roku 2027.
 * Hero = kontrola pripravenosti pokladny; vysledek = 3 sloupce (vas system + Hugo + Septim Air).
 * Vse ze SDILENYCH komponent @piano/ui; tema resi src/styles/theme.css.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import USPGrid from '@piano/ui/components/USPGrid.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';

// Situace stavajiciho systemu (vyhodnoceni na strane prohlizece, bez jmenovane konkurence).
const situations = {
  cloud: {
    label: 'Moderní cloudová pokladna',
    status: 'Pravděpodobně připraveno',
    tone: 'ok',
    desc: 'Moderní cloudové pokladny novou evidenci obvykle zvládnou aktualizací. Ověřte si u svého dodavatele, že update na EET 2.0 chystá a stihne ho před 1. 1. 2027.',
    feats: [
      { state: 'ok', text: 'Online evidence tržeb' },
      { state: 'ok', text: 'Účtenka i v digitální podobě' },
      { state: 'ok', text: 'Aktualizace zpravidla od dodavatele' },
      { state: 'q', text: 'Ověřte konkrétní podporu EET 2.0' },
    ],
  },
  legacy: {
    label: 'Starší lokální systém',
    status: 'Nemusí stačit',
    tone: 'warn',
    desc: 'Starší lokální systémy nemusí EET 2.0 zvládnout, nebo jen za příplatek za upgrade. Zjistěte, zda dodavatel podporu chystá, ať nepřecházíte na poslední chvíli.',
    feats: [
      { state: 'ok', text: 'Základní pokladna a tisk účtenek' },
      { state: 'no', text: 'Často bez cloudu a vzdáleného přístupu' },
      { state: 'no', text: 'Aktualizace na EET 2.0 nejistá' },
    ],
  },
  none: {
    label: 'Papír, blok nebo žádný systém',
    status: 'Nevyhovuje',
    tone: 'bad',
    desc: 'Bez pokladního systému EET 2.0 nesplníte. Budete potřebovat řešení, které eviduje tržby online. Dobrá zpráva: moderní systém rozjedete během chvíle.',
    feats: [
      { state: 'no', text: 'Žádná online evidence tržeb' },
      { state: 'no', text: 'Bez elektronických účtenek' },
      { state: 'ok', text: 'Snadné pořízení moderního systému' },
    ],
  },
};

const products = [
  {
    tag: 'Mobilní pokladna',
    name: 'Hugo',
    sub: 'Pokladna přímo v telefonu',
    feats: [
      'Připraveno na EET 2027',
      'Tap to Pay na iPhonu i NFC na Androidu, bez čtečky',
      'Funguje i offline, tržby se dorovnají',
      'Rozúčtování účtu a spropitné jedním ťuknutím',
      'Bez smlouvy, peníze další pracovní den',
    ],
    priceMain: '0 Kč',
    priceNote: 'za aplikaci, když platby berete přes Hugo',
    cta: 'Chci Hugo',
  },
  {
    tag: 'Cloudová pokladna',
    name: 'Septim Air',
    sub: 'All-in-one pokladna pro kamenné provozy',
    feats: [
      'Připraveno na EET 2027, legislativní aktualizace v ceně',
      'All-in-one pokladna s integrovanou tiskárnou',
      'Data i zálohy v cloudu, bez vlastního serveru',
      'Mobilní číšník zdarma',
      'Instalace a školení zdarma, podpora 24/7',
    ],
    priceMain: 'od 1 990 Kč',
    priceNote: 'měsíčně, bez jednorázových nákladů',
    cta: 'Chci Septim Air',
  },
];

// Co se meni
const zmeny = [
  { icon: 'lucide:receipt', title: 'Účtenka jen na vyžádání', text: 'Konec povinného tisku. Účtenku vydáte, jen když ji zákazník chce, klidně i digitálně.' },
  { icon: 'lucide:credit-card', title: 'Eviduje se osobní platba', text: 'Hotovost, karta, QR kód i stravenky přijaté při osobním kontaktu se zákazníkem.' },
  { icon: 'lucide:cpu', title: 'Stačí softwarový update', text: 'Moderní pokladní systém zvládne nová pravidla aktualizací. Nové vybavení obvykle není potřeba.' },
  { icon: 'lucide:file-text', title: 'Minimum údajů', text: 'Stát po vás chce méně dat než u prvního EET. Evidence je jednodušší.' },
  { icon: 'lucide:hand-coins', title: 'Výhodnější spropitné', text: 'Dobrovolné spropitné do 7 % tržeb bude osvobozeno od daní i odvodů.' },
  { icon: 'lucide:percent', title: 'Nižší DPH na nealko', text: 'Daň u nealkoholických nápojů klesá z 21 % na 12 %.' },
];

// Harmonogram (legislativni milniky) - sjednoceno s webem piano.cz/eet
const timeline = [
  { date: 'Únor 2026', title: 'Zahájení připomínkového řízení', state: 'done' },
  { date: 'Duben 2026', title: 'Vypořádání připomínek', state: 'done' },
  { date: 'Květen 2026', title: 'Návrh prošel prvním čtením', state: 'done' },
  { date: 'Červen 2026', title: 'Zveřejnění technické specifikace', state: 'done' },
  { date: '15. července 2026', title: 'EET 2.0 schváleno Sněmovnou', state: 'current' },
  { date: 'Červenec 2026', title: 'Zpřístupnění testovacího prostředí', state: 'future' },
  { date: 'Listopad 2026', title: 'Generování certifikátů v prostředí DIS+', state: 'future' },
  { date: 'Prosinec 2026', title: 'Spuštění aplikace MOJE EET', state: 'future' },
  { date: '1. ledna 2027', title: 'Zahájení běžného provozu EET 2.0', state: 'future' },
  { date: 'Leden 2027', title: 'Zkušební režim projektu', state: 'future' },
];

// Koho se to tyka
const koho = [
  { icon: 'lucide:utensils-crossed', title: 'Restaurace', text: 'Od bister po velké podniky a sítě provozoven.' },
  { icon: 'lucide:coffee', title: 'Kavárny a bary', text: 'Kavárny, vinárny, koktejlové i pivní bary.' },
  { icon: 'lucide:bed-double', title: 'Hotely a penziony', text: 'Recepce, restaurace i room service na jednom účtu.' },
  { icon: 'lucide:truck', title: 'Stánky a street food', text: 'Mobilní prodej, food trucky a sezónní provozy.' },
];

// Jak se pripravit (kroky)
const kroky = [
  { icon: 'lucide:search-check', title: 'Ověřte připravenost pokladny', text: 'Zjistěte, zda váš stávající systém EET 2.0 zvládne, nebo zda potřebujete jiné řešení.' },
  { icon: 'lucide:list-checks', title: 'Zvolte systém připravený na EET', text: 'Vyberte pokladní systém, který nová pravidla splní spolehlivě a bez improvizace.' },
  { icon: 'lucide:settings', title: 'Instalace a nastavení do konce 2026', text: 'Nechte systém nainstalovat a nastavit s dostatečnou rezervou před spuštěním.' },
  { icon: 'lucide:graduation-cap', title: 'Zaškolte obsluhu', text: 'Projděte si nové rozhraní a postupy, ať jste 1. ledna 2027 v klidu.' },
];

const faqs = [
  { q: 'Kdy začne EET 2.0 platit a musím to řešit už teď?', a: 'Od 1. ledna 2027. Do té doby je potřeba mít funkční pokladní systém připravený na nová pravidla, včetně instalace, nastavení a zaškolení obsluhy. Příprava se vyplatí s předstihem, protože ke konci roku 2026 bývají kapacity dodavatelů plné.' },
  { q: 'Koho se EET 2.0 týká?', a: 'Prakticky každé restaurace, kavárny, baru nebo hotelu. Evidovat se budou všechny platby přijaté při osobním kontaktu se zákazníkem: hotovost, karta, QR kód i stravenky. Výjimku mají pouze OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně.' },
  { q: 'Musím si pořizovat nový pokladní systém?', a: 'Záleží na tom, co dnes používáte. Moderní systémy zvládnou EET 2.0 softwarovým updatem. Zastaralý nebo nevhodný systém ale může přechod prodražit a času na výměnu ubývá.' },
  { q: 'Co mi hrozí, když nebudu evidovat?', a: 'Pokuta až 500 000 Kč. Finanční správa navíc bude porovnávat tržby podnikatelů ve stejném oboru a regionu, takže odchylky automaticky přitáhnou pozornost kontrolorů.' },
  { q: 'Je EET 2.0 složitější než to první?', a: 'Ne, naopak. Funguje pouze v online režimu bez výjimek a variant, účtenku vydáváte jen na vyžádání i digitálně a stát po vás chce méně dat než dřív. S vhodným systémem většinu změn nepoznáte.' },
  { q: 'Co se změní u spropitného?', a: 'Dobrovolné spropitné bude osvobozeno od daně i odvodů až do výše 7 % měsíčních tržeb. Detailní pravidla pro evidenci se zatím upřesňují.' },
];

const leadProofs = [
  { icon: 'lucide:gift', title: 'Konzultace zdarma', text: 'Nezávazně a bez rizika.' },
  { icon: 'lucide:search-check', title: 'Ověření vaší pokladny', text: 'Zjistíme, zda je systém na EET připravený.' },
  { icon: 'lucide:calendar-check', title: 'Stihnete deadline', text: 'Připraveno před 1. 1. 2027.' },
  { icon: 'lucide:shield-check', title: 'Bez stresu a pokut', text: 'Provedeme vás přechodem krok za krokem.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title="Je vaše pokladna připravená na EET?"
      description="Ověřte si během chvíle, jestli je vaše pokladna připravená na EET 2.0 od roku 2027. Porovnejte svůj systém s pokladnami připravenými na nová pravidla. Konzultace zdarma."
      schema={faqSchema}>
  <SiteHeader />

  <main>

  <!-- HERO: kontrola pripravenosti -->
  <Hero background="gradient"
        eyebrow="EET 2027 · kontrola připravenosti"
        lead="Od 1. ledna 2027 musí pokladna zvládnout novou evidenci tržeb. Zjistěte během chvíle, jestli ta vaše stačí, nebo co s tím."
        usp={[
          { text: 'Platí od 2027', icon: 'lucide:calendar-clock' },
          { text: 'Připravte se včas', icon: 'lucide:clock' },
          { text: 'Bez stresu a pokut', icon: 'lucide:shield-check' },
        ]}>
    <Heading slot="title" as="h1" size="display" color="on-dark">Je vaše pokladna připravená na <em>EET</em>?</Heading>
    <Fragment slot="actions">
      <Button href="#co-se-meni" variant="secondary" onDark>Co se mění</Button>
    </Fragment>

    <div slot="media" class="checker">
      <p class="checker__eyebrow">Rychlá kontrola</p>
      <form id="checker-form" class="checker__form">
        <label class="checker__label" for="pos-situation">Jaký pokladní systém teď používáte?</label>
        <div class="checker__control">
          <Icon name="lucide:monitor-check" size="sm" class="checker__ico" />
          <select id="pos-situation" class="checker__select" name="pos-situation">
            <option value="cloud">Moderní cloudová pokladna</option>
            <option value="legacy">Starší lokální systém</option>
            <option value="none">Papír, blok nebo žádný systém</option>
          </select>
        </div>
        <button type="submit" class="checker__btn">Zkontrolovat připravenost</button>
        <p class="checker__hint">Zdarma a bez závazku. Výsledek uvidíte hned.</p>
      </form>
    </div>
  </Hero>

  <!-- CO SE MENI -->
  <div id="co-se-meni">
    <USPGrid eyebrow="Co se mění" title="Nová pravidla v kostce"
             lead="EET 2.0 je jednodušší než první vlna. Tady jsou změny, které se vás dotknou nejvíc."
             items={zmeny} columns={3} background="default" space="lg" />
  </div>

  <!-- HARMONOGRAM -->
  <Section background="alt" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Časová osa</Text>
      <Heading as="h2" size="h2" align="center">Harmonogram zavedení</Heading>
    </div>
    <div class="tl">
      <span class="tl__line" aria-hidden="true"></span>
      {timeline.map((m) => (
        <div class:list={['tl__item', `tl__item--${m.state}`]}>
          <span class="tl__dot" aria-hidden="true"></span>
          <div class="tl__card">
            <span class="tl__date">{m.date}</span>
            <p class="tl__title">{m.title}</p>
            {m.state === 'current' && <span class="tl__badge">Aktuálně</span>}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- KOHO SE TO TYKA -->
  <Section id="koho" background="default" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Koho se to týká</Text>
      <Heading as="h2" size="h2" align="center">Týká se prakticky <em>celé gastronomie</em></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Evidovat se budou všechny platby přijaté při osobním kontaktu se zákazníkem: hotovost, karta, QR kód i stravenky.
      </Text>
    </div>
    <div class="who">
      {koho.map((k) => (
        <article class="who__card">
          <span class="who__ico"><Icon name={k.icon} size="md" /></span>
          <Heading as="h3" size="h3">{k.title}</Heading>
          <Text size="small" color="muted">{k.text}</Text>
        </article>
      ))}
    </div>
    <p class="note">
      <span class="note__ico"><Icon name="lucide:info" size="sm" /></span>
      Výjimku mají pouze OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně.
    </p>
  </Section>

  <!-- JAK SE PRIPRAVIT -->
  <Section id="priprava" background="alt" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Jak se připravit</Text>
      <Heading as="h2" size="h2" align="center">Čtyři kroky k <em>klidnému</em> startu</Heading>
      <Text size="lead" color="muted" align="center" balance>
        Nečekejte na poslední chvíli. S předstihem je příprava otázkou několika kroků.
      </Text>
    </div>
    <ol class="steps">
      {kroky.map((s, i) => (
        <li class="step">
          <span class="step__num">{i + 1}</span>
          <span class="step__ico"><Icon name={s.icon} size="md" /></span>
          <Heading as="h3" size="h3">{s.title}</Heading>
          <Text size="small" color="muted">{s.text}</Text>
        </li>
      ))}
    </ol>
  </Section>

  <!-- FAQ -->
  <Section id="faq" background="default" space="lg" container="narrow">
    <Heading as="h2" size="h2" align="center">Časté dotazy</Heading>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">{f.q}</summary>
          <div class="faq__a"><Text color="muted">{f.a}</Text></div>
        </details>
      ))}
    </div>
  </Section>

  <!-- VYSLEDEK: 3 sloupce (na konci, barevne odlisena sekce) -->
  <Section id="vysledek" background="primary" space="lg">
    <div class="head-center">
      <Text size="label" color="on-dark-muted" align="center">Výsledek kontroly</Text>
      <Heading as="h2" size="h2" align="center" color="on-dark">Váš systém a pokladny <em>připravené na EET</em></Heading>
      <Text size="lead" color="on-dark-muted" align="center" balance>
        Vlevo najdete zhodnocení vašeho stávajícího systému. Vedle dvě pokladny, které EET 2.0 zvládají a přidají navíc.
      </Text>
    </div>

    <div class="tiles">
      <!-- Sloupec 1: vas system (plni JS) -->
      <article class="tile tile--result">
        <span class="tile__tag tile__tag--muted">Váš systém</span>
        <h3 class="tile__name">Váš stávající systém</h3>
        <p class="tile__sub" data-r-label>Vyberte typ systému v kontrole nahoře.</p>

        <div class="tile__statusbar" data-r-statusbar hidden>
          <span class="tile__status" data-r-status></span>
        </div>

        <hr class="tile__hr" />

        <p class="tile__desc" data-r-desc>Po spuštění kontroly tu uvidíte, jestli váš systém EET 2.0 zvládne a jaké má základní funkce.</p>

        <ul class="tile__feats" data-r-feats></ul>

        <div class="tile__foot">
          <a href="#konzultace" class="tile__link">Poradíme, co dál <Icon name="lucide:arrow-right" size="xs" /></a>
        </div>
      </article>

      <!-- Sloupce 2 a 3: nase produkty -->
      {products.map((p) => (
        <article class="tile tile--product">
          <span class="tile__tag">{p.tag}</span>
          <h3 class="tile__name">{p.name}</h3>
          <p class="tile__sub">{p.sub}</p>

          <div class="tile__statusbar">
            <span class="tile__status tile__status--ok"><Icon name="lucide:badge-check" size="sm" /> Připraveno na EET 2027</span>
          </div>

          <hr class="tile__hr" />

          <ul class="tile__feats">
            {p.feats.map((f) => (
              <li class="tile__feat tile__feat--ok"><span class="tile__fico"><Icon name="lucide:check" size="sm" /></span>{f}</li>
            ))}
          </ul>

          <div class="tile__price">
            <span class="tile__price-main">{p.priceMain}</span>
            <span class="tile__price-note">{p.priceNote}</span>
          </div>

          <div class="tile__foot">
            <Button href="#konzultace" full>{p.cta}</Button>
          </div>
        </article>
      ))}
    </div>

    <p class="tiles__note">Zhodnocení stávajícího systému je obecné a platí i pro řešení jiných dodavatelů. Přesnou připravenost vždy ověřte u svého dodavatele.</p>
  </Section>

  <!-- KONZULTACE -->
  <LeadForm id="konzultace" variant="full" background="alt"
            action="/api/lead"
            title="Nezávazná konzultace zdarma"
            lead="Nechte nám kontakt. Ozveme se vám, ověříme připravenost vaší pokladny a poradíme, jak EET 2.0 zvládnout v klidu."
            proofs={leadProofs} />

  </main>

  <SiteFooter />
</Base>

<style>
  .head-center { max-width: 720px; margin: 0 auto var(--space-7); text-align: center; }
  .head-center :global(h2) { margin-top: var(--space-2); }

  /* CHECKER (bily panel na tmavem hero) */
  .checker { background: var(--color-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: var(--space-6); }
  .checker__eyebrow { font-size: var(--font-size-label); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-accent); margin-bottom: var(--space-4); }
  .checker__form { display: flex; flex-direction: column; gap: var(--space-3); }
  .checker__label { font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); color: var(--color-text); }
  .checker__control { position: relative; display: flex; align-items: center; }
  .checker__ico { position: absolute; left: var(--space-4); color: var(--color-text-muted); pointer-events: none; }
  .checker__select {
    width: 100%; appearance: none; -webkit-appearance: none;
    font: var(--text-body); font-family: var(--font-sans); color: var(--color-text);
    background: var(--color-bg-alt); border: 1px solid var(--color-border-strong);
    border-radius: var(--field-radius); padding: var(--space-4) var(--space-6) var(--space-4) 44px;
    cursor: pointer;
  }
  .checker__select:focus-visible { outline: none; box-shadow: var(--shadow-focus); border-color: var(--color-primary); }
  .checker__control::after { content: ""; position: absolute; right: var(--space-5); width: 8px; height: 8px; border-right: 2px solid var(--color-text-muted); border-bottom: 2px solid var(--color-text-muted); transform: rotate(45deg) translateY(-2px); pointer-events: none; }
  .checker__btn {
    font: var(--text-label); font-family: var(--font-sans); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase;
    background: var(--color-primary); color: var(--color-text-on-dark);
    border: none; border-radius: var(--btn-radius); padding: var(--space-4) var(--space-6); cursor: pointer;
    transition: var(--transition);
  }
  .checker__btn:hover { background: var(--color-primary-hover); }
  .checker__btn:focus-visible { outline: none; box-shadow: var(--shadow-focus); }
  .checker__hint { font-size: var(--font-size-caption); color: var(--color-text-muted); text-align: center; }

  /* TILES (3 sloupce vysledku) */
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); align-items: stretch; }
  .tile { display: flex; flex-direction: column; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm); }
  .tile--product { border-color: var(--color-border-strong); }
  .tile__tag { align-self: flex-start; font-size: var(--font-size-caption); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-on-dark); background: var(--color-primary); padding: 4px var(--space-3); border-radius: var(--radius-full); margin-bottom: var(--space-4); }
  .tile__tag--muted { color: var(--color-text-muted); background: var(--color-neutral-100); }
  .tile__name { font-family: var(--font-sans); font-size: var(--font-size-h3); font-weight: var(--font-weight-bold); color: var(--color-text); }
  .tile__sub { margin-top: var(--space-1); font-size: var(--font-size-small); color: var(--color-text-muted); }
  .tile__statusbar { margin-top: var(--space-4); min-height: 28px; }
  .tile__status { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); padding: 5px var(--space-3); border-radius: var(--radius-full); }
  .tile__status--ok { color: var(--color-success); background: color-mix(in srgb, var(--color-success) 12%, #fff); }
  .tile__status--warn { color: var(--color-warning); background: color-mix(in srgb, var(--color-warning) 14%, #fff); }
  .tile__status--bad { color: var(--color-error); background: color-mix(in srgb, var(--color-error) 12%, #fff); }
  .tile__hr { border: none; border-top: 1px solid var(--color-border); margin: var(--space-5) 0; }
  .tile__desc { font-size: var(--font-size-small); color: var(--color-text-muted); line-height: var(--line-height-body); }
  .tile__feats { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-4); }
  .tile__feat { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--font-size-small); color: var(--color-text); }
  .tile__fico { display: inline-flex; flex-shrink: 0; margin-top: 1px; }
  .tile__feat--ok .tile__fico { color: var(--color-success); }
  .tile__feat--no { color: var(--color-text-muted); }
  .tile__feat--no .tile__fico { color: var(--color-error); }
  .tile__feat--q .tile__fico { color: var(--color-text-muted); }
  .tile__price { margin-top: var(--space-5); padding: var(--space-4) var(--space-5); background: var(--color-bg-alt); border-radius: var(--radius-md); }
  .tile__price-main { display: block; font-size: var(--font-size-h3); font-weight: var(--font-weight-bold); color: var(--color-secondary); }
  .tile__price-note { display: block; margin-top: 2px; font-size: var(--font-size-caption); color: var(--color-text-muted); }
  .tile__foot { margin-top: auto; padding-top: var(--space-6); }
  .tile__link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-text-accent); font-weight: var(--font-weight-medium); font-size: var(--font-size-small); text-decoration: none; }
  .tile__link:hover { text-decoration: underline; }
  .tiles__note { margin-top: var(--space-6); font-size: var(--font-size-caption); color: var(--color-text-on-dark-muted); text-align: center; max-width: 760px; margin-inline: auto; }
  @media (max-width: 900px) { .tiles { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }

  /* Harmonogram */
  .tl { position: relative; max-width: 620px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4); padding-left: var(--space-1); }
  .tl__line { position: absolute; left: 8px; top: 10px; bottom: 10px; width: 2px; background: var(--color-border); }
  .tl__item { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: var(--space-4); align-items: start; }
  .tl__dot { width: 18px; height: 18px; border-radius: var(--radius-full); background: var(--color-bg); border: 2px solid var(--color-border); margin-top: 2px; position: relative; z-index: 1; }
  .tl__item--done .tl__dot { background: var(--color-primary); border-color: var(--color-primary); }
  .tl__item--current .tl__dot { border-color: var(--color-primary); box-shadow: 0 0 0 4px var(--color-bg-alt), 0 0 0 6px var(--color-primary); }
  .tl__item--current .tl__dot::after { content: ''; position: absolute; inset: 3px; border-radius: var(--radius-full); background: var(--color-primary); }
  .tl__card { padding: var(--space-4) var(--space-5); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .tl__item--current .tl__card { border-color: var(--color-primary); box-shadow: 0 8px 24px rgba(26,79,139,.12); }
  .tl__item--future .tl__card { background: transparent; border-style: dashed; }
  .tl__date { font-size: var(--font-size-caption); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-accent); }
  .tl__item--future .tl__date { color: var(--color-text-muted); }
  .tl__title { margin: var(--space-1) 0 0; font-size: var(--font-size-body); font-weight: var(--font-weight-semibold); line-height: var(--line-height-tight); }
  .tl__badge { display: inline-block; margin-top: var(--space-2); font-size: var(--font-size-caption); font-weight: var(--font-weight-medium); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: #fff; background: var(--color-primary); padding: 1px var(--space-2); border-radius: var(--radius-sm); }

  /* Koho se to tyka */
  .who { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .who__card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-6) var(--space-5); }
  .who__card > * + * { margin-top: var(--space-3); }
  .who__ico { display: inline-flex; color: var(--color-text-accent); }
  .note { display: flex; align-items: center; justify-content: center; gap: var(--space-2); margin-top: var(--space-6); font-size: var(--font-size-small); color: var(--color-text-muted); text-align: center; }
  .note__ico { display: inline-flex; color: var(--color-text-accent); flex-shrink: 0; }
  @media (max-width: 880px) { .who { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .who { grid-template-columns: 1fr; } }

  /* Kroky */
  .steps { list-style: none; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .step { position: relative; padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .step > * + * { margin-top: var(--space-3); }
  .step__num { position: absolute; top: var(--space-4); right: var(--space-5); font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); color: var(--color-neutral-200); line-height: 1; }
  .step__ico { display: inline-flex; color: var(--color-text-accent); }

  /* FAQ */
  .faq { margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .faq__item { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); }
  .faq__q { cursor: pointer; font-family: var(--font-sans); font-weight: var(--font-weight-semibold); color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: "+"; color: var(--color-text-accent); font-size: 1.4em; line-height: 1; flex-shrink: 0; }
  .faq__item[open] .faq__q::after { content: "\2212"; }
  .faq__a { margin-top: var(--space-3); }
</style>

<script define:vars={{ situations }}>
  const form = document.getElementById('checker-form');
  const select = document.getElementById('pos-situation');
  const label = document.querySelector('[data-r-label]');
  const statusbar = document.querySelector('[data-r-statusbar]');
  const status = document.querySelector('[data-r-status]');
  const desc = document.querySelector('[data-r-desc]');
  const feats = document.querySelector('[data-r-feats]');

  const icons = {
    ok: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
    no: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>',
    q: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
  };

  function render(key) {
    const s = situations[key];
    if (!s) return;
    label.textContent = s.label;
    status.textContent = s.status;
    status.className = 'tile__status tile__status--' + s.tone;
    statusbar.hidden = false;
    desc.textContent = s.desc;
    feats.innerHTML = s.feats.map((f) =>
      '<li class="tile__feat tile__feat--' + f.state + '"><span class="tile__fico">' + icons[f.state] + '</span>' + f.text + '</li>'
    ).join('');
  }

  if (form && select) {
    render(select.value);
    select.addEventListener('change', () => render(select.value));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      render(select.value);
      document.getElementById('vysledek')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
