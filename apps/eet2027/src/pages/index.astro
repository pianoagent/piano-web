// Leadgen: co klientovi na soucasne pokladne chybi (multi-vyber) -> nabidka reseni.
// tier = nejnizsi nase edice, ktera funkci resi (air / enterprise); zdroj: mapa_funkci.
const gaps = [
  { label: 'Karta přes telefon (Tap to Pay)', tier: 'hugo' },
  { label: 'Rychlý start bez instalace', tier: 'hugo' },
  { label: 'Skladové hospodářství', tier: 'air' },
  { label: 'Receptury a inventura', tier: 'air' },
  { label: 'Mobilní číšník', tier: 'air' },
  { label: 'Práce bez internetu (offline)', tier: 'air' },
  { label: 'Stravenky a faktura', tier: 'air' },
  { label: 'Věrnostní program (CRM)', tier: 'enterprise' },
  { label: 'Rozvoz (Wolt, Foodora, Bolt)', tier: 'enterprise' },
