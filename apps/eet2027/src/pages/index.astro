  .sub__proof { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--font-size-body); color: var(--color-text-on-dark); }
  .sub__pico { display: inline-flex; flex-shrink: 0; margin-top: 2px; color: var(--color-secondary-gold); }
  .sub__form { background: var(--color-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); }
  .sub__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
