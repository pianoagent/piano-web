---
/**
 * EET 2027 - homepage (jednostranka).
 * Samostatny informacni web k navratu elektronicke evidence trzeb od roku 2027.
 * Hero = kontrola pripravenosti pokladny + verdikt; dale info o EET a odber novinek.
 * Zadne produkty ani baliccky (zatim ciste informacni web).
 * Vse ze SDILENYCH komponent @piano/ui; tema resi src/styles/theme.css.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import USPGrid from '@piano/ui/components/USPGrid.astro';
import Field from '@piano/ui/components/Field.astro';

// Co odberatel ziska (duvody pro prihlaseni)
const odberBody = [
  { icon: 'lucide:bell', text: 'Zprávy o schválení, termínech a technických detailech' },
  { icon: 'lucide:list-checks', text: 'Praktický checklist přípravy, ať na nic nezapomenete' },
  { icon: 'lucide:sparkles', text: 'Tipy, jak z povinnosti udělat náskok pro váš provoz' },
  { icon: 'lucide:mail-x', text: 'Žádný spam, odhlásíte se jedním kliknutím' },
];

// Typy podniku pro prihlaseni k odberu (kvalifikace kontaktu)
const podniky = [
  'Restaurace',
  'Kavárna nebo bistro',
  'Bar nebo vinárna',
  'Hotel nebo penzion',
  'Jídelna nebo kantýna',
  'Stánek nebo food truck',
  'Něco jiného',
];

// Blue ocean: hospoda dnes vs hospoda pripravena na budoucnost (obecne benefity, neutralni)
const dnes = [
  'Ruční výkazy a papírování po zavíračce',
  'Rozhodování od oka, bez dat',
  'Tržby a marže zjistíte se zpožděním',
  'Sklad a objednávky podle paměti',
  'Směny a personál řešíte na telefonu',
  'Víc dodavatelů, víc faktur, víc chaosu',
];
const zitra = [
  'Administrativa a účtenky odbaví systém',
  'Rozhodnutí opřená o reálná data',
  'Přehled o tržbách i maržích v reálném čase',
  'Systém hlídá zásoby a připomene objednávku',
  'Chytré plánování směn podle provozu',
  'Jedno řešení, jedno vyúčtování, klid',
];

// Co se meni
const zmeny = [
  { icon: 'lucide:receipt', title: 'Účtenka jen na vyžádání', text: 'Konec povinného tisku. Účtenku vydáte, jen když ji zákazník chce, klidně i digitálně.' },
  { icon: 'lucide:credit-card', title: 'Eviduje se osobní platba', text: 'Hotovost, karta, QR kód i stravenky přijaté při osobním kontaktu se zákazníkem.' },
  { icon: 'lucide:cpu', title: 'Stačí softwarový update', text: 'Moderní pokladní systém zvládne nová pravidla aktualizací. Nové vybavení obvykle není potřeba.' },
  { icon: 'lucide:file-text', title: 'Minimum údajů', text: 'Stát po vás chce méně dat než u prvního EET. Evidence je jednodušší.' },
  { icon: 'lucide:hand-coins', title: 'Výhodnější spropitné', text: 'Dobrovolné spropitné do 7 % tržeb bude osvobozeno od daní i odvodů.' },
  { icon: 'lucide:percent', title: 'Nižší DPH na nealko', text: 'Daň u nealkoholických nápojů klesá z 21 % na 12 %.' },
];

// Harmonogram (legislativni milniky) - sjednoceno s webem piano.cz/eet
const timeline = [
  { date: 'Únor 2026', title: 'Zahájení připomínkového řízení', state: 'done' },
  { date: 'Duben 2026', title: 'Vypořádání připomínek', state: 'done' },
  { date: 'Květen 2026', title: 'Návrh prošel prvním čtením', state: 'done' },
  { date: 'Červen 2026', title: 'Zveřejnění technické specifikace', state: 'done' },
  { date: '15. července 2026', title: 'EET 2.0 schváleno Sněmovnou', state: 'current' },
  { date: 'Červenec 2026', title: 'Zpřístupnění testovacího prostředí', state: 'future' },
  { date: 'Listopad 2026', title: 'Generování certifikátů v prostředí DIS+', state: 'future' },
  { date: 'Prosinec 2026', title: 'Spuštění aplikace MOJE EET', state: 'future' },
  { date: '1. ledna 2027', title: 'Zahájení běžného provozu EET 2.0', state: 'future' },
  { date: 'Leden 2027', title: 'Zkušební režim projektu', state: 'future' },
];

// Koho se to tyka
const koho = [
  { icon: 'lucide:utensils-crossed', title: 'Restaurace', text: 'Od bister po velké podniky a sítě provozoven.' },
  { icon: 'lucide:coffee', title: 'Kavárny a bary', text: 'Kavárny, vinárny, koktejlové i pivní bary.' },
  { icon: 'lucide:bed-double', title: 'Hotely a penziony', text: 'Recepce, restaurace i room service na jednom účtu.' },
  { icon: 'lucide:truck', title: 'Stánky a street food', text: 'Mobilní prodej, food trucky a sezónní provozy.' },
];

// Jak se pripravit (kroky)
const kroky = [
  { icon: 'lucide:search-check', title: 'Ověřte připravenost pokladny', text: 'Zjistěte, zda váš stávající systém EET 2.0 zvládne, nebo zda potřebujete jiné řešení.' },
  { icon: 'lucide:list-checks', title: 'Zvolte systém připravený na EET', text: 'Vyberte pokladní systém, který nová pravidla splní spolehlivě a bez improvizace.' },
  { icon: 'lucide:settings', title: 'Instalace a nastavení do konce 2026', text: 'Nechte systém nainstalovat a nastavit s dostatečnou rezervou před spuštěním.' },
  { icon: 'lucide:graduation-cap', title: 'Zaškolte obsluhu', text: 'Projděte si nové rozhraní a postupy, ať jste 1. ledna 2027 v klidu.' },
];

// FAQ dle analyzy klicovych slov (data/2026-06-24-aks-skupina-sluzeb-piano.xlsx, list "eet").
// Poradi = velikost klastru hledanosti: termin (2060) > pokladna (1020) > definice (1040)
// > zruseni a EET OFF (490) > koho se tyka (210). Otazky drzi formulace, ktere lide hledaji.
const faqs = [
  { q: 'Co je EET 2.0 a jak funguje?',
    a: 'EET 2.0 je nová podoba elektronické evidence tržeb, která v Česku začíná platit od 1. ledna 2027. Pokladní systém odešle údaje o platbě online Finanční správě a ta obratem vrátí potvrzení. Funguje pouze v online režimu, bez dřívějších výjimek a variant, a stát po vás chce méně údajů než u prvního EET.' },
  { q: 'Odkdy EET 2.0 platí a co je potřeba stihnout v roce 2026?',
    a: 'Běžný provoz EET 2.0 startuje 1. ledna 2027. Do konce roku 2026 musíte mít pokladní systém připravený na nová pravidla, nainstalovaný, nastavený a obsluhu zaškolenou. Na podzim 2026 bývají kapacity dodavatelů plné, takže se vyplatí přípravu neodkládat.' },
  { q: 'Potřebuji na EET novou pokladnu? Kolik stojí a existuje EET pokladna zdarma?',
    a: 'Záleží na tom, co dnes používáte. Moderní pokladní systémy zvládnou EET 2.0 běžnou aktualizací a nové vybavení kupovat nemusíte. Starší nebo nevhodný systém může znamenat upgrade za příplatek, nebo výměnu. Levné pokladny i aplikace zdarma existují, vždy si ale ověřte, že skutečně umí online evidenci a elektronickou účtenku.' },
  { q: 'Koho se EET 2.0 týká? Platí i pro OSVČ, živnostníky a e-shopy?',
    a: 'Týká se prakticky každého, kdo přijímá platby při osobním kontaktu se zákazníkem, tedy hotovost, kartu, QR kód i stravenky. Platí pro firmy, OSVČ, živnostníky i řemeslníky bez ohledu na obor. Platby na dálku, například v e-shopu, se neevidují. Výjimku mají také OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně.' },
  { q: 'EET bylo zrušené. Proč se vrací a dá se evidenci vyhnout?',
    a: 'První EET stát zrušil na konci roku 2022 kvůli administrativní zátěži. Vrací se od roku 2027 v jednodušší podobě: jen online, s menším rozsahem údajů a účtenkou na vyžádání. Vyhnout se dá jen výjimkami, například režimem EET OFF pro OSVČ v prvním pásmu paušální daně, kde místo evidence platíte vyšší paušál.' },
  { q: 'Musím tisknout účtenky a vyvěsit informační ceduli?',
    a: 'Povinný tisk účtenek končí. Účtenku vydáte jen tehdy, když si ji zákazník vyžádá, a klidně digitálně, takže pokladnu bez tiskárny lze používat. Rozsah dalších povinností, včetně informačního oznámení v provozovně, se dolaďuje v prováděcích pravidlech.' },
  { q: 'Co mi hrozí, když nebudu tržby evidovat?',
    a: 'Pokuta až 500 000 Kč. Finanční správa navíc bude porovnávat tržby podnikatelů ve stejném oboru a regionu, takže výrazné odchylky samy přitáhnou pozornost kontrolorů.' },
  { q: 'Co se u EET 2.0 mění u spropitného a DPH na nealko?',
    a: 'Dobrovolné spropitné bude osvobozeno od daně i odvodů až do výše 7 % měsíčních tržeb. Zároveň klesá DPH u nealkoholických nápojů z 21 % na 12 %. Detailní pravidla pro evidenci spropitného v pokladně se zatím upřesňují.' },
];


const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title="Návrat EET od roku 2027, co se mění a jak se připravit"
      description="Přehledný průvodce návratem elektronické evidence tržeb od 1. ledna 2027. Co se mění, koho se to týká, harmonogram a jak se včas připravit. Novinky k EET 2.0 zdarma na e-mail."
      schema={faqSchema}>
  <SiteHeader />

  <main>

  <!-- HERO: info o EET + prihlaseni k odberu -->
  <Hero background="gradient"
        eyebrow="Elektronická evidence tržeb · od 1. ledna 2027"
        lead="Od 1. ledna 2027 musí každá pokladna zvládnout novou evidenci tržeb. Tady najdete přehledně, co se mění, koho se to týká a jak se v klidu připravit. Novinky vám pošleme na e-mail."
        usp={[
          { text: 'Platí od 2027', icon: 'lucide:calendar-clock' },
          { text: 'Připravte se včas', icon: 'lucide:clock' },
          { text: 'Bez stresu a pokut', icon: 'lucide:shield-check' },
        ]}>
    <Heading slot="title" as="h1" size="display" color="on-dark">EET se vrací. Buďte <em>o krok napřed</em></Heading>

    <div slot="media" class="hs">
      <p class="hs__eyebrow">Zůstaňte v obraze</p>
      <p class="hs__lead">Přihlaste se k odběru a nezmeškáte žádnou důležitou změnu k EET 2.0.</p>
      <form class="hs__form" action="/api/lead.php" method="POST" data-subscribe novalidate>
        <input type="hidden" name="form_variant" value="odber-hero" />
        <input type="hidden" name="page" data-page />
        <div class="hs__hp" aria-hidden="true">
          <label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <Field label="Váš e-mail" name="email" type="email" placeholder="info@podnik.cz" autocomplete="email" required />

        <label class="sub__check">
          <input type="checkbox" name="consent" required />
          <span class="sub__box" aria-hidden="true"></span>
          <span class="sub__check-text">
            Souhlasím se zpracováním údajů dle <a href="/ochrana-udaju">zásad ochrany údajů</a>.
          </span>
        </label>

        <Button type="submit" full data-sub-submit>Přihlásit se k odběru</Button>
        <p class="hs__hint">Žádný spam. Odhlásíte se kdykoli jedním kliknutím.</p>

        <p class="sub__status sub__status--ok" data-sub-ok hidden>Děkujeme, jste v obraze.</p>
        <p class="sub__status sub__status--err" data-sub-err hidden>Něco se nepovedlo. Zkuste to prosím znovu.</p>
      </form>
    </div>
  </Hero>

  <!-- BLUE OCEAN: hospoda dnes vs zitra -->
  <Section id="budoucnost" background="alt" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Nejen kvůli zákonu</Text>
      <Heading as="h2" size="h2" align="center">EET zvládne každý. Vy můžete být <em>o krok dál</em></Heading>
      <Text size="lead" color="muted" align="center" balance>
        EET 2.0 je moment, kdy stejně sáhnete na pokladnu. Udělejte z povinnosti odrazový můstek. Budoucnost gastra bude neúprosná k těm, kdo zůstanou u papíru, ale hodně světlá pro připravené. Hospoda nemusí být řehole.
      </Text>
    </div>
    <div class="vs">
      <div class="vs__col vs__col--now">
        <p class="vs__head"><span class="vs__tag vs__tag--now">Dnes</span> Hospoda jako řehole</p>
        <ul class="vs__list">
          {dnes.map((d) => (
            <li class="vs__item vs__item--now"><span class="vs__ico"><Icon name="lucide:x" size="sm" /></span>{d}</li>
          ))}
        </ul>
      </div>
      <div class="vs__col vs__col--next">
        <p class="vs__head"><span class="vs__tag vs__tag--next">Zítra</span> Hospoda připravená na budoucnost</p>
        <ul class="vs__list">
          {zitra.map((z) => (
            <li class="vs__item vs__item--next"><span class="vs__ico"><Icon name="lucide:check" size="sm" /></span>{z}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="vs__cta">
      <Button href="#odber">Takovou hospodu chci</Button>
      <p class="vs__note">Technologie za vás počítá, plánuje a hlídá. EET 2.0 je jen první krok.</p>
    </div>
  </Section>

  <!-- CO SE MENI -->
  <div id="co-se-meni">
    <USPGrid eyebrow="Co se mění" title="Nová pravidla v kostce"
             lead="EET 2.0 je jednodušší než první vlna. Tady jsou změny, které se vás dotknou nejvíc."
             items={zmeny} columns={3} background="default" space="lg" />
  </div>

  <!-- HARMONOGRAM -->
  <Section background="alt" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Časová osa</Text>
      <Heading as="h2" size="h2" align="center">Harmonogram zavedení</Heading>
    </div>
    <div class="tl">
      <span class="tl__line" aria-hidden="true"></span>
      {timeline.map((m) => (
        <div class:list={['tl__item', `tl__item--${m.state}`]}>
          <span class="tl__dot" aria-hidden="true"></span>
          <div class="tl__card">
            <span class="tl__date">{m.date}</span>
            <p class="tl__title">{m.title}</p>
            {m.state === 'current' && <span class="tl__badge">Aktuálně</span>}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- KOHO SE TO TYKA -->
  <Section id="koho" background="default" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Koho se to týká</Text>
      <Heading as="h2" size="h2" align="center">Týká se prakticky <em>celé gastronomie</em></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Evidovat se budou všechny platby přijaté při osobním kontaktu se zákazníkem: hotovost, karta, QR kód i stravenky.
      </Text>
    </div>
    <div class="who">
      {koho.map((k) => (
        <article class="who__card">
          <span class="who__ico"><Icon name={k.icon} size="md" /></span>
          <Heading as="h3" size="h3">{k.title}</Heading>
          <Text size="small" color="muted">{k.text}</Text>
        </article>
      ))}
    </div>
    <p class="note">
      <span class="note__ico"><Icon name="lucide:info" size="sm" /></span>
      Výjimku mají pouze OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně.
    </p>
  </Section>

  <!-- JAK SE PRIPRAVIT -->
  <Section id="priprava" background="alt" space="lg">
    <div class="head-center">
      <Text size="label" color="accent" align="center">Jak se připravit</Text>
      <Heading as="h2" size="h2" align="center">Čtyři kroky k <em>klidnému</em> startu</Heading>
      <Text size="lead" color="muted" align="center" balance>
        Nečekejte na poslední chvíli. S předstihem je příprava otázkou několika kroků.
      </Text>
    </div>
    <ol class="steps">
      {kroky.map((s, i) => (
        <li class="step">
          <span class="step__num">{i + 1}</span>
          <span class="step__ico"><Icon name={s.icon} size="md" /></span>
          <Heading as="h3" size="h3">{s.title}</Heading>
          <Text size="small" color="muted">{s.text}</Text>
        </li>
      ))}
    </ol>
  </Section>

  <!-- FAQ -->
  <Section id="faq" background="default" space="lg" container="narrow">
    <Heading as="h2" size="h2" align="center">Časté dotazy</Heading>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">{f.q}</summary>
          <div class="faq__a"><Text color="muted">{f.a}</Text></div>
        </details>
      ))}
    </div>
  </Section>

  <!-- ODBER: prihlaseni k informacim o EET -->
  <Section id="odber" background="primary" space="lg">
    <div class="head-center">
      <Text size="label" color="on-dark-muted" align="center">Novinky o EET</Text>
      <Heading as="h2" size="h2" align="center" color="on-dark">Držte se v obraze, <em>ať vás nic nezaskočí</em></Heading>
      <Text size="lead" color="on-dark-muted" align="center" balance>
        Přihlaste se k odběru. Pošleme vám všechny důležité informace k EET 2.0: co se mění, termíny, technické detaily i praktické tipy, jak se připravit včas.
      </Text>
    </div>

    <div class="sub">
      <ul class="sub__proofs">
        {odberBody.map((b) => (
          <li class="sub__proof"><span class="sub__pico"><Icon name={b.icon} size="sm" /></span>{b.text}</li>
        ))}
      </ul>

      <form class="sub__form" action="/api/lead.php" method="POST" data-subscribe novalidate>
        <input type="hidden" name="form_variant" value="odber-eet" />
        <input type="hidden" name="page" data-page />
        <div class="sub__hp" aria-hidden="true">
          <label>Web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <Field label="Váš e-mail" name="email" type="email" placeholder="info@podnik.cz" autocomplete="email" required />

        <div class="sub__field">
          <label class="sub__label" for="typ-podniku">Typ podniku</label>
          <div class="sub__control">
            <select id="typ-podniku" class="sub__select" name="typ_podniku">
              <option value="">Vyberte, co provozujete</option>
              {podniky.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>

        <label class="sub__check">
          <input type="checkbox" name="chci_vic_z_pos" value="ano" />
          <span class="sub__box" aria-hidden="true"></span>
          <span class="sub__check-text">Chtěl bych od svého pokladního systému víc. Ozvěte se mi.</span>
        </label>

        <label class="sub__check">
          <input type="checkbox" name="consent" required />
          <span class="sub__box" aria-hidden="true"></span>
          <span class="sub__check-text">
            Souhlasím se zpracováním údajů dle <a href="/ochrana-udaju">zásad ochrany údajů</a>.
          </span>
        </label>

        <Button type="submit" full data-sub-submit>Chci novinky o EET</Button>
        <p class="sub__hint">Žádný spam. Odhlásit se můžete kdykoli jedním kliknutím.</p>

        <p class="sub__status sub__status--ok" data-sub-ok hidden>Děkujeme, jste v obraze. Potvrzení jsme poslali na e-mail.</p>
        <p class="sub__status sub__status--err" data-sub-err hidden>Něco se nepovedlo. Zkuste to prosím znovu.</p>
      </form>
    </div>
  </Section>

  </main>

  <SiteFooter />
</Base>

<style>
  .head-center { max-width: 720px; margin: 0 auto var(--space-7); text-align: center; }
  .head-center :global(h2) { margin-top: var(--space-2); }

  /* CHECKER (bily panel na tmavem hero) */
  /* HERO SIGNUP (prihlaseni k odberu v hero karte) */
  .hs { background: var(--color-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: var(--space-6); }
  .hs__eyebrow { font-size: var(--font-size-label); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-accent); }
  .hs__lead { margin-top: var(--space-2); font-size: var(--font-size-small); color: var(--color-text-muted); line-height: var(--line-height-body); }
  .hs__form { margin-top: var(--space-5); display: flex; flex-direction: column; gap: var(--space-4); }
  .hs__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
