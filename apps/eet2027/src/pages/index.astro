const srovnaniCols = [
  { name: 'Hugo', sub: 'Mikro a malý provoz' },
  { name: 'Septim Air', sub: 'Střední provoz' },
  { name: 'Septim Enterprise', sub: 'Velký provoz a sítě' },
];
const srovnani = [
  { theme: 'Legislativa a základ', rows: [
    { f: 'EET 2.0 ready', v: ['ANO', 'ANO', 'ANO'] },
    { f: 'Elektronická účtenka', v: ['ANO', 'ANO', 'ANO'] },
