  /* FAQ */
  .faq { margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .faq__item { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); }
  .faq__q { cursor: pointer; font-family: var(--font-sans); font-weight: var(--font-weight-semibold); color: var(--color-text); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: "+"; color: var(--color-text-accent); font-size: 1.4em; line-height: 1; flex-shrink: 0; }
  .faq__item[open] .faq__q::after { content: "\2212"; }
  .faq__a { margin-top: var(--space-3); }
</style>

<!-- Globalni styly pro prvky vkladane pres JS (innerHTML) - scoped styly na ne nedosahnou -->
<style is:global>
</style>

<script>
  // Odber novinek: odeslani pres fetch (progressive enhancement)
  document.querySelectorAll('[data-subscribe]').forEach((subForm) => {
    const subBtn = subForm.querySelector('[data-sub-submit]');
    const subOk = subForm.querySelector('[data-sub-ok]');
    const subErr = subForm.querySelector('[data-sub-err]');

    subForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (subOk) subOk.hidden = true;
      if (subErr) subErr.hidden = true;
      if (!subForm.checkValidity()) { subForm.reportValidity(); return; }

      const pageField = subForm.querySelector('input[name="page"]');
      if (pageField) pageField.value = window.location.href;

      const hp = subForm.querySelector('input[name="website"]');
      if (hp && hp.value) { subForm.reset(); if (subOk) subOk.hidden = false; return; }

      const original = subBtn ? subBtn.textContent : '';
      if (subBtn) { subBtn.disabled = true; subBtn.textContent = 'Odesílám…'; }

      try {
        const res = await fetch(subForm.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(subForm),
        });
        if (!res.ok) throw new Error(String(res.status));
        subForm.reset();
        window.location.assign('/dekujeme');
      } catch {
        if (subErr) subErr.hidden = false;
      } finally {
        if (subBtn) { subBtn.disabled = false; subBtn.textContent = original; }
      }
    });
  });
</script>
