---
/**
 * Katalog komponent: Savarin.
 *
 * Obsah je sdílená Gallery z @piano/ui, takže katalog je na všech webech stejný
 * a renderuje se vždycky v tokenech a fontech té které značky. Stránka je
 * noindex a je vyřazená ze sitemapy, není určená pro vyhledávače ani zákazníky.
 * Slouží k ladění s grafikem a jako referenci, z čeho se skládají stránky.
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Footer from '@piano/ui/components/Footer.astro';
import { savarinNav, savarinCta } from '../config/nav';
import Gallery from '@piano/ui/gallery/Gallery.astro';
---

<Base title="Katalog komponent | Savarin" noindex
      description="Interní katalog sdílených komponent, jejich variant a tokenů značky Savarin.">
  <Header brand="Savarin" logoSrc="/logos/savarin_logo.svg" logoHeight="36px" homeHref="/" nav={savarinNav} cta={savarinCta} />
  <main>
    <Gallery brand="Savarin"
      logos={["ref-100-chuti-brna", "ref-420-restaurant", "ref-O2-arena"]}
      />
  </main>
  <Footer legal={[{ label: 'Ochrana osobních údajů', href: '/ochrana-udaju' }]} logoSrc="/logos/savarin_by_piano.svg" logoAlt="Savarin by Piano" parentNote={{ text: 'Savarin je součástí skupiny Piano', href: 'https://piano.cz' }} />
</Base>
