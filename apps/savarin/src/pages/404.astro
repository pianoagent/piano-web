---
/**
 * 404: stránka nenalezena. Statický build vygeneruje dist/404.html,
 * Apache ji servíruje přes ErrorDocument (viz public/.htaccess).
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import { savarinNav, savarinCta, savarinMobileCta, savarinFooter } from '../config/nav';
---

<Base title="Stránka nenalezena | Savarin"
      description="Tuto stránku se nepodařilo najít. Vraťte se na úvod a podívejte se na restaurační a hotelový software Savarin." noindex>
  <Header brand="Savarin" logoSrc="/logos/savarin_by_piano.svg" logoHeight="44px" homeHref="/" nav={savarinNav} cta={savarinCta} mobileCta={savarinMobileCta} />

  <main>
    <Section background="default" space="lg" container="narrow">
      <div class="nf">
        <span class="nf__icon"><Icon name="lucide:file-question" size="lg" /></span>
        <Heading as="h1" size="h2" align="center">Tuhle stránku jsme nenašli</Heading>
        <Text size="lead" color="muted" align="center" balance>
          Odkaz je nejspíš zastaralý nebo obsahuje překlep. Na úvodní stránce najdete vše o pokladně,
          recepci i skladech Savarin.
        </Text>
        <div class="nf__actions">
          <Button href="/">Zpět na úvod</Button>
          <Button href="/kontakt" variant="secondary">Kontakt</Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer {...savarinFooter} />
</Base>

<style>
  .nf { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .nf__icon { display: inline-flex; color: var(--color-primary); }
  .nf__actions {
    margin-top: var(--space-4);
    display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center;
  }
</style>
