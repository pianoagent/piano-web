---
/**
 * Pro brigádníky, worker-facing stránka.
 * Obsah z grason-web-develop/pages/index.vue + page_hp_* (cs.json).
 * Sdílené komponenty @piano/ui.
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Testimonials from '@piano/ui/components/Testimonials.astro';
import StatsBand from '@piano/ui/components/StatsBand.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import Faq from '@piano/ui/components/Faq.astro';
import { grasonNav, grasonCta, grasonFooter, grasonLogin } from '../config/nav';
import { brigadniciFaqs } from '../config/faq';
import { workerQuotes } from '../config/reference';

const steps = [
  { title: 'Zaregistrujete se', text: 'Stačí vám 3 minuty, mobil a naše aplikace.' },
  { title: 'Přihlásíte se na směny', text: 'Vyberete si, kdy a kde budete pracovat.' },
  { title: 'Vše vám potvrdíme', text: 'Potvrzení směny přijde v SMS. Den předem vám ji pro jistotu připomeneme.' },
  { title: 'Pracujete', text: 'Za svou práci dostanete zaplaceno tolik, kolik jste si sami řekli.' },
];

/* Ilustrace rolí jsou původní assety Grasonu z live webu (_nuxt/img/*@2x.png),
   převedené na WebP a přebarvené na navy podle styleguidu. */
const jobs = [
  { img: '/images/roles/hosteska.webp', label: 'Hosteska' },
  { img: '/images/roles/kuryr.webp', label: 'Kurýr' },
  { img: '/images/roles/pokladni.webp', label: 'Pokladní' },
  { img: '/images/roles/cisnik.webp', label: 'Číšník / Servírka' },
  { img: '/images/roles/skladnik.webp', label: 'Skladník' },
  { img: '/images/roles/bednak.webp', label: 'Bedňák' },
];

/* Devět jmenovaných měst + zbytek, stejně jako live grason.cz.
   Celkem 91 lokalit (grason-context.md). */
const cities = ['Praha', 'Brno', 'Ostrava', 'Liberec', 'Olomouc', 'Přerov', 'Most', 'Plzeň', 'Ústí nad Labem'];

/* Jen čísla doložená v contexty/. Show-up rate 97 % je v bázi vedený jako
   neověřený a bez kvalifikátoru „bez omluvy" tvrdí víc než zdroj, proto tady
   není; celé znění zůstává ve FAQ, kde má kolem sebe kontext. */
const stats = [
  { num: '5 500', lbl: 'ověřených brigádníků' },
  { num: '91', lbl: 'míst po celé ČR' },
  { num: '220 000+', lbl: 'naplánovaných směn' },
  { num: '4,75', lbl: 'průměrné hodnocení grasona' },
];

const STORE_IOS = 'https://apps.apple.com/cz/app/grason/id1367384162';
const STORE_ANDROID = 'https://play.google.com/store/apps/details?id=com.thefuntasty.grason';

const perks = [
  { icon: 'lucide:wallet', title: 'Mzdu si určujete vy', text: 'Při přihlašování uvidíte, jakou částku podnik preferuje. Je ale jen na vás, za kolik chcete pracovat.' },
  { icon: 'lucide:calendar-heart', title: 'Buďte pány svého času', text: 'Sami si naplánujete, kdy a jak často budete pracovat. Záleží jen na vás, kolik směn si vezmete.' },
  { icon: 'lucide:banknote', title: 'Výplata ihned po směně', text: 'Žádné čekání na výplatní termín, peníze máte hned, jak odpracujete.' },
];

---

<Base title="Flexibilní práce pro brigádníky | Grason"
      description="Vaše řešení pro flexibilní práci. Pracujte ještě dnes, směny v čase a místě, kdy a kde zrovna můžete. Výplata ihned po směně.">
  <Header brand="Grason" logoSrc="/logos/grason_logo.svg" logoHeight="28px" homeHref="/" nav={grasonNav} cta={grasonCta} login={grasonLogin} />

  <main class="pb">

  <!-- HERO -->
  <Hero eyebrow="Pro brigádníky" background="gradient"
        lead="Pracujte ještě dnes. Směny v čase a místě, kdy a kde zrovna můžete. Sami si určíte, co, pro koho a za kolik budete dělat.">
    <Heading slot="title" as="h1" size="display" color="on-dark">Vaše řešení pro <span class="accent">flexibilní práci</span></Heading>
    <Fragment slot="actions">
      <Button href="https://www.grason.cz/stahnout">Stáhnout aplikaci</Button>
    </Fragment>
    <figure slot="media" class="hero-figure">
      <img src="/images/hp-hero.webp" alt="Grason, aplikace s nabídkami směn pro brigádníky" width="720" height="560" loading="eager" />
    </figure>
  </Hero>

  <!-- JAK TO FUNGUJE -->
  <Section background="cyan" decor="bottom" space="lg">
    <div class="head head--center">
      <Text size="label" color="default" align="center">Jak to funguje</Text>
      <Heading as="h2" size="h2" align="center">Od stažení appky <span class="accent">k první výplatě</span></Heading>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num">{i + 1}</span>
          <Heading as="h3" size="h3">{s.title}</Heading>
          <Text size="small" color="muted">{s.text}</Text>
        </li>
      ))}
    </ol>
  </Section>

  <!-- OBORY -->
  <Section background="yellow" decor="top" space="lg">
    <div class="head head--center">
      <Text size="label" color="default" align="center">Obory</Text>
      <Heading as="h2" size="h2" align="center">Vyberte si z řady <span class="accent">firem a oborů</span></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Číšník, kuchař nebo třeba kurýr. Sami si svobodně zvolíte, co a pro koho budete dělat.
      </Text>
    </div>
    <ul class="jobs">
      {jobs.map((j) => (
        <li class="job"><img class="job__art" src={j.img} alt="" width="32" height="32" loading="lazy" />{j.label}</li>
      ))}
    </ul>
  </Section>

  <!-- ČÍSLA -->
  <StatsBand items={stats} background="alt" space="md" />

  <!-- VÝHODY -->
  <Section background="default" decor="bottom" space="lg">
    <ul class="perks">
      {perks.map((p) => (
        <li class="perk">
          <span class="perk__icon"><Icon name={p.icon} size="md" /></span>
          <Heading as="h3" size="h3">{p.title}</Heading>
          <Text size="small" color="muted">{p.text}</Text>
        </li>
      ))}
    </ul>
  </Section>

  <!-- MÍSTA -->
  <Section background="pink" decor="top" space="lg">
    <div class="head head--center">
      <Text size="label" color="default" align="center">Kde pracovat</Text>
      <Heading as="h2" size="h2" align="center">Pracujte <span class="accent">kdekoliv</span></Heading>
      <Text size="lead" color="muted" align="center" balance>
        V pondělí v Praze, v úterý v Mostu, ve čtvrtek v Liberci. Pracujte tam, kde se vám to hodí.
      </Text>
    </div>
    <ul class="cities">
      {cities.map((c) => <li class="city">{c}</li>)}
      <li class="city city--more">+ 82 dalších míst</li>
    </ul>
  </Section>

  <!-- FAQ -->
  <Faq items={brigadniciFaqs} background="alt"
       title="Časté dotazy brigádníků"
       lead="Vše, co potřebujete vědět, než se přihlásíte na první směnu." />

  <!-- REFERENCE -->
  <Testimonials
    eyebrow="Co říkají grasoni"
    eyebrowColor="default"
    background="cyan"
    items={workerQuotes}
    decor="bottom"
    titleHtml={'Práce, <span class="accent">jak ji chcete žít</span>'} />
  <!-- STÁHNOUT -->
  <!-- Žlutý pás, ne navy: odznaky obchodů jsou černá kresba na průhledném
       pozadí, na tmavém pruhu by zanikly. Live web to má stejně. -->
  <Section id="stahnout" background="yellow" decor="top" space="lg">
    <div class="head head--center">
      <Text size="label" color="default" align="center">Mobilní aplikace</Text>
      <Heading as="h2" size="h2" align="center">Mějte Grason <span class="accent">stále po ruce</span></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Stáhněte si appku a přihlaste se na první směnu ještě dnes. iOS i Android, zdarma.
      </Text>
      <div class="store">
        <a class="store__badge" href={STORE_IOS} target="_blank" rel="noopener" aria-label="Stáhnout Grason v App Store">
          <img src="/images/badge-app-store.webp" alt="" width="400" height="134" loading="lazy" />
        </a>
        <a class="store__badge" href={STORE_ANDROID} target="_blank" rel="noopener" aria-label="Stáhnout Grason na Google Play">
          <img src="/images/badge-google-play.webp" alt="" width="400" height="134" loading="lazy" />
        </a>
      </div>
    </div>
  </Section>

  </main>

  <Footer {...grasonFooter} />
</Base>

<style>
  /* Brandové barevné sekce: akcentní slovo navy na světlém, bílé na tmavém hero */
  .pb .accent { color: var(--color-secondary); }
  .pb :global(.heading--on-dark) .accent { color: #fff; }


  .hero-figure { margin: 0; width: 100%; line-height: 0; }
  .hero-figure img { width: 100%; height: auto; display: block; filter: drop-shadow(0 24px 48px rgba(7, 7, 7, 0.22)); }

  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); }
  .head--center { text-align: center; }
  .head > * + * { margin-top: var(--space-3); }

  /* Steps */
  .steps { list-style: none; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .step { position: relative; padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .step > * + * { margin-top: var(--space-3); }
  .step__num { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-full); background: var(--color-secondary-azure); color: var(--color-text-on-azure); font-size: var(--font-size-lead); font-weight: var(--font-weight-bold); }

  /* Bílá pilulka má na žluté 1,35:1 a na růžové 2,83:1, tedy hrana mizí.
     Obrys z brandové navy ji vrátí, aniž by se sáhlo na barvu pásu. */
  .pb { --pill-edge: color-mix(in srgb, var(--color-secondary) 20%, transparent); }

  /* Jobs, pilulky s původní kresbou role (48px, ať zůstanou v jedné řadě) */
  .jobs { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; }
  .job { display: inline-flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-5) var(--space-2) var(--space-3); background: var(--color-bg); border: 1px solid var(--pill-edge); border-radius: var(--radius-full); font-weight: var(--font-weight-medium); box-shadow: var(--shadow-sm); }
  .job__art { width: 32px; height: 32px; display: block; flex-shrink: 0; }

  /* Města */
  .cities { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .city { display: inline-flex; align-items: center; padding: var(--space-3) var(--space-5); background: var(--color-bg); border: 1px solid var(--pill-edge); border-radius: var(--radius-full); font-weight: var(--font-weight-medium); box-shadow: var(--shadow-sm); }
  .city--more { background: transparent; box-shadow: none; color: var(--color-text-muted); }

  /* Perks */
  .perks { list-style: none; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .perk { padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .perk > * + * { margin-top: var(--space-3); }
  .perk__icon { display: inline-flex; width: 56px; height: 56px; align-items: center; justify-content: center; border-radius: var(--radius-full); background: color-mix(in srgb, var(--color-secondary-azure) 16%, #fff); color: var(--color-text-accent); }

  /* Odznaky obchodů, originální assety Grasonu v české mutaci */
  .store { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); }
  .store__badge { display: block; line-height: 0; border-radius: var(--radius-full); transition: var(--transition); }
  .store__badge img { width: 180px; height: auto; display: block; }
  .store__badge:hover { transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .store__badge:hover { transform: none; } }

  /* Reference */
</style>
