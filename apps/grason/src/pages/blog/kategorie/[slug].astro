---
/**
 * Blog: hub stránka kategorie (grason.cz/blog/kategorie/<slug>).
 * Indexovatelná, unikátní title/description/úvod (SEO). Články zůstávají na
 * plochých URL /blog/<slug>; sem se jen filtrují a odkazují.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import PostGrid from '@piano/ui/components/PostGrid.astro';
import CategoryChips from '@piano/ui/components/CategoryChips.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { grasonNav, grasonCta, grasonFooter, grasonLogin } from '../../../config/nav';
import { BLOG_CATEGORIES } from '../../../blog-categories';

export async function getStaticPaths() {
  return BLOG_CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const posts = allPosts.filter((p) => (p.data.categories ?? []).includes(category.name));

// Nabídka kategorií jen pro ty s alespoň jedním článkem
const used = new Set(allPosts.flatMap((p) => p.data.categories ?? []));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.name));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.title,
  description: category.description,
  url: `https://grason.cz/blog/kategorie/${category.slug}`,
};
---

<Base title={`${category.title} | Grason blog`} description={category.description} schema={collectionSchema}>
  <Header brand="Grason" logoSrc="/logos/grason_by_piano.svg" logoHeight="44px" homeHref="/" nav={grasonNav} cta={grasonCta} login={grasonLogin} />

  <main>
    <Hero eyebrow="Blog" background="alt" space="md" lead={category.intro}>
      <Heading slot="title" as="h1" size="display">{category.name}</Heading>
    </Hero>

    <Section background="default" space="lg">
      <Breadcrumb items={[
        { label: 'Domů', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: category.name },
      ]} />

      <CategoryChips
          items={[{ label: 'Vše', href: '/blog' }, ...categories.map((c) => ({ label: c.name, href: `/blog/kategorie/${c.slug}` }))]}
          activeHref={`/blog/kategorie/${category.slug}`} />

      <PostGrid posts={posts.map((p) => ({
          href: `/blog/${p.id}`,
          title: p.data.title,
          description: p.data.description,
          image: p.data.image,
          category: category.name,
          date: p.data.pubDate,
        }))} />
    </Section>
  </main>

  <Footer {...grasonFooter} />
</Base>
