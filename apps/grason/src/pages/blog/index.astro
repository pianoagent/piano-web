---
/**
 * Blog: výpis článků (grason.cz/blog). Obsah převzat z blog.grason.cz (WordPress).
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import PostGrid from '@piano/ui/components/PostGrid.astro';
import CategoryChips from '@piano/ui/components/CategoryChips.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import { grasonNav, grasonCta, grasonFooter, grasonLogin } from '../../config/nav';
import { BLOG_CATEGORIES } from '../../blog-categories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Kategorie s alespoň jedním článkem (pevné pořadí dle blog-categories) → odkazy na hub stránky.
const used = new Set(posts.flatMap((p) => p.data.categories ?? []));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.name));
---

<Base title="Blog | Grason"
      description="Rady pro podniky, změny v legislativě, data o mzdách a novinky z Grasonu. Vše o personálu, brigádnících a směnách.">
  <Header brand="Grason" logoSrc="/logos/grason_by_piano.svg" logoHeight="44px" homeHref="/" nav={grasonNav} cta={grasonCta} login={grasonLogin} />

  <main>
    <Hero eyebrow="Blog" background="alt" space="md"
          lead="Rady pro podniky, změny v legislativě, data o mzdách a novinky z Grasonu.">
      <Heading slot="title" as="h1" size="display">Vše o personálu a směnách</Heading>
    </Hero>

    <Section background="default" space="lg">
      <CategoryChips
          items={[{ label: 'Vše', href: '/blog' }, ...categories.map((c) => ({ label: c.name, href: `/blog/kategorie/${c.slug}` }))]}
          activeHref="/blog" />
      <PostGrid posts={posts.map((p) => ({
          href: `/blog/${p.id}`,
          title: p.data.title,
          description: p.data.description,
          image: p.data.image,
          category: p.data.categories?.[0],
          date: p.data.pubDate,
        }))} />
    </Section>
  </main>

  <Footer {...grasonFooter} />
</Base>
