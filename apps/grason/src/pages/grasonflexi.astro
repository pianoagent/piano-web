---
/**
 * GrasonFlexi, dedikovaná produktová stránka (brigádníci na směnu).
 * Obsah z for-companies.vue / page_for-companies_* (cs.json) + grason-context.md.
 */
import Base from '../layouts/Base.astro';
import Header from '@piano/ui/components/Header.astro';
import PricingTable from '@piano/ui/components/PricingTable.astro';
import Testimonials from '@piano/ui/components/Testimonials.astro';
import Footer from '@piano/ui/components/Footer.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import Faq from '@piano/ui/components/Faq.astro';
import { grasonNav, grasonCta, grasonFooter, grasonLogin, grasonFlexiRegister } from '../config/nav';
import { flexiFaqs } from '../config/faq';

const rows = [
  { img: '/images/for-companies-choose-candidates.webp', title: 'Vybírejte si podle zkušeností a hodnocení', text: 'Vždycky víte, kdo k vám přijde pracovat. Pracovníky vybíráte podle jejich profilů, zkušeností a hodnocení od jiných firem.' },
  { img: '/images/for-companies-choose-favourite-workers.webp', title: 'Vytvořte si tým oblíbených a spolupracujte dlouhodobě', text: 'Vaši oblíbení pracovníci přehledně na jednom místě. Dejte jim o směně vědět dřív než ostatním a zvěte je opakovaně, bez stálého zaškolování nových lidí.' },
  { img: '/images/for-companies-feedback.webp', title: 'Zpětná vazba po každé směně', text: 'Dejte vědět, jak jste byli spokojeni. Napište pracovníkům hodnocení a získejte zpětnou vazbu i vy.' },
];

const steps = [
  { title: 'Vypíšete směnu', text: 'V appce nebo webovém rozhraní zadáte kdy, kde a koho potřebujete. Trvá to 2 minuty.' },
  { title: 'Brigádníci se hlásí', text: 'Ověření pracovníci z vašeho okolí dostanou notifikaci a zájemci se přihlásí.' },
  { title: 'Potvrdíte výběr', text: 'Vyberete vhodného kandidáta. Zaměstnavatelem jste vy, DPP můžete podepsat i přes appku (za příplatek).' },
  { title: 'Odpracováno a ohodnoceno', text: 'Pracovník dorazí na směnu, vy mu připravíte výplatu z podkladů a po směně ho ohodnotíte.' },
];

const testimonials = [
  { initials: 'MP', quote: 'Pracovníci nalezení přes Grason byli sice dražší, ale mnohem motivovanější a ochotní makat než lidé z jiných kanálů.', author: 'Ing. Michal Prádl', role: 'Vedoucí skladu DATART Jirny' },
  { initials: 'JK', quote: 'Velkou výhodu vidím v úspoře času, protože Grason za mě řeší byrokratické papírování.', author: 'Josef Kubíček', role: 'Manažer, Likér' },
];

const leadProofs = [
  { icon: 'lucide:gift', title: '14 dní zdarma', text: 'Bez platební karty, nezávazně.' },
  { icon: 'lucide:zap', title: 'Směna za pár minut', text: 'Pozici obsadíte dřív než konkurence.' },
  { icon: 'lucide:users', title: '5 500 brigádníků', text: 'Ověření pracovníci napříč 82+ městy.' },
  { icon: 'lucide:badge-check', title: 'Podpis přes appku', text: 'DPP podepíšete i online (příplatek).' },
];

// Ceník GrasonFlexi, přepínač délky předplatného (3/6/12 měsíců)
const pricePeriods = [
  { id: '3', label: '3 měsíců' },
  { id: '6', label: '6 měsíců' },
  { id: '12', label: '12 měsíců' },
];
const priceTiers = [
  { name: 'Trial', fixed: '14 dní zdarma', cta: 'Vyzkoušet zdarma', href: grasonFlexiRegister },
  { name: 'Lite', price: { '3': '3 330 Kč', '6': '2 490 Kč', '12': '1 990 Kč' }, unit: '/měsíc', cta: 'Vybrat tarif', href: grasonFlexiRegister },
  { name: 'Standard', featured: true, badge: 'Nejoblíbenější', price: { '3': '8 990 Kč', '6': '7 490 Kč', '12': '4 990 Kč' }, unit: '/měsíc', cta: 'Vybrat tarif', href: grasonFlexiRegister },
  { name: 'Enterprise', fixed: 'Na vyžádání', cta: 'Zanechat kontakt', href: '/kontakt' },
];
const priceFeatures = [
  { label: 'Počet obsazených směn', vals: ['Neomezeně', '30', 'Neomezeně', 'Neomezeně'] },
  { label: 'Pobočky', vals: ['1', '1', '1', 'Neomezeně'] },
  { label: 'Role správce', vals: ['5', '5', '5', 'Neomezeně'] },
  { label: 'Zákaznická linka', vals: [true, true, true, true] },
  { label: 'Dedikovaný account manager', vals: [false, false, false, true] },
  { label: 'Automatizace dokumentů', vals: [false, 'Na vyžádání', 'Na vyžádání', true] },
  { label: 'Zpracování mezd', vals: [false, 'Na vyžádání', 'Na vyžádání', true] },
  { label: 'Vyplácení mezd', vals: [false, 'Na vyžádání', 'Na vyžádání', true] },
];
---

<Base title="GrasonFlexi, brigádníci na směnu | Grason"
      description="GrasonFlexi je nejrychlejší cesta k brigádníkům: vypíšete směnu, ověření pracovníci se přihlásí a vy vyberete. Zaměstnavatelem zůstáváte vy.">
  <Header brand="Grason" logoSrc="/logos/grason_logo.svg" logoHeight="28px" homeHref="/" nav={grasonNav} cta={grasonCta} login={grasonLogin} />

  <main class="pa-flexi">
  <Hero eyebrow="GrasonFlexi" background="gradient"
        lead="Vypíšete směnu, ověření brigádníci se přihlásí a vy vyberete. Zaměstnavatelem zůstáváte vy, Grason lidi zprostředkuje a připraví podklady.">
    <Heading slot="title" as="h1" size="display" color="on-dark">Brigádníci <span class="accent">na jedno kliknutí</span></Heading>
    <Fragment slot="actions">
      <Button href={grasonFlexiRegister}>Zaregistrovat firmu zdarma</Button>
      <Button href="/kontakt" variant="secondary" onDark>Konzultace zdarma</Button>
    </Fragment>
    <figure slot="media" class="hero-figure">
      <img src="/images/for-companies-hero.webp" alt="GrasonFlexi, výběr brigádníků na směnu" width="720" height="560" loading="eager" />
    </figure>
  </Hero>

  <Section background="alt" space="sm">
    <ul class="hero-list">
      <li><Icon name="lucide:check" size="sm" class="hl-check" />Nepotřebujete platební kartu</li>
      <li><Icon name="lucide:check" size="sm" class="hl-check" />Za pár minut máte vypsanou směnu</li>
      <li><Icon name="lucide:check" size="sm" class="hl-check" />Žádné poplatky odvozené ze mzdy</li>
    </ul>
  </Section>

  <Section background="default" space="lg">
    <div class="head head--center">
      <Heading as="h2" size="h2" align="center">Co <span class="accent">GrasonFlexi</span> umí</Heading>
    </div>
    <div class="rows">
      {rows.map((r, i) => (
        <div class={`row ${i % 2 === 1 ? 'row--reverse' : ''}`}>
          <figure class="row__media"><img src={r.img} alt="" loading="lazy" /></figure>
          <div class="row__text">
            <Heading as="h3" size="h3">{r.title}</Heading>
            <Text color="muted">{r.text}</Text>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="jak" background="invert" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Jak to funguje</Text>
      <Heading as="h2" size="h2" align="center" color="on-dark">Od potřeby k obsazené <span class="accent">směně za minuty</span></Heading>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step step--dark">
          <span class="step__num">{i + 1}</span>
          <Heading as="h3" size="h3" color="on-dark">{s.title}</Heading>
          <Text size="small" color="on-dark-muted">{s.text}</Text>
        </li>
      ))}
    </ol>
  </Section>

  <PricingTable id="cenik" background="alt" space="lg"
    eyebrow="Ceník"
    titleHtml={'Vyberte plán <span class="accent">pro váš provoz</span>'}
    lead="Předplatné na 3, 6 nebo 12 měsíců. Čím delší závazek, tím nižší měsíční cena."
    periods={pricePeriods}
    tiers={priceTiers}
    features={priceFeatures}
    footnote="Ceny jsou uvedeny bez DPH. Automatizace dokumentů a mzdové služby jsou u tarifů Lite a Standard na vyžádání." />

  <Testimonials
    eyebrow="Reference"
    eyebrowColor="default"
    background="pink"
    items={testimonials}
    titleHtml={'Co říkají <span class="accent">naši klienti</span>'} />
  <Faq items={flexiFaqs} title="Časté dotazy ke GrasonFlexi" background="default" />
  </main>

  <Footer {...grasonFooter} />
</Base>

<style>
  /* GrasonFlexi brand: růžová jako akcent (sekundární), navy primární */
  .pa-flexi { --color-secondary-azure: #F24D83; --color-text-accent: #D63A70; }
  .pa-flexi :global(.heading--on-dark) .accent { color: #FA80A8; }
  .pa-flexi .step__num { color: #fff; }
  /* Primární tlačítka růžová (brand Flexi) */
  .pa-flexi :global(.btn--primary) { background: #F24D83; border-color: #F24D83; color: #fff; }
  .pa-flexi :global(.btn--primary:hover) { background: #D63A70; border-color: #D63A70; }
  .pa-flexi .ptier__cta { background: #F24D83; }
  .pa-flexi .ptier__cta:hover { background: #D63A70; }

  .hero-figure { margin: 0; width: 100%; line-height: 0; }
  .hero-figure img { width: 100%; height: auto; display: block; filter: drop-shadow(0 24px 48px rgba(7, 7, 7, 0.22)); }
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); }
  .head--center { text-align: center; }
  .head > * + * { margin-top: var(--space-3); }
  .hero-list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-5); justify-content: center; }
  .hero-list li { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--font-size-small); color: var(--color-text); }
  .hl-check { color: var(--color-secondary-azure); flex-shrink: 0; }
  .rows { display: flex; flex-direction: column; gap: var(--space-8); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  .row--reverse .row__media { order: 2; }
  .row__media { margin: 0; line-height: 0; background: var(--color-bg-alt); border-radius: var(--radius-lg); padding: var(--space-6); }
  .row__media img { width: 100%; height: auto; display: block; }
  .row__text > * + * { margin-top: var(--space-3); }
  @media (max-width: 880px) { .row { grid-template-columns: 1fr; gap: var(--space-5); } .row--reverse .row__media { order: 0; } }
  .steps { list-style: none; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .step { position: relative; padding: var(--space-6); border-radius: var(--radius-md); }
  .step--dark { background: rgba(255,255,255,0.04); border: 1px solid var(--color-border-on-dark); }
  .step > * + * { margin-top: var(--space-3); }
  .step__num { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-full); background: var(--color-secondary-azure); color: var(--color-text-on-azure); font-size: var(--font-size-lead); font-weight: var(--font-weight-bold); }
  .checklist { list-style: none; display: grid; gap: var(--space-2); }
  .checklist li { display: flex; align-items: flex-start; gap: var(--space-2); color: var(--color-text); }
  .ptable th, .ptable td { padding: var(--space-4); text-align: center; }
  .ptier__price small { font-weight: var(--font-weight-regular); color: var(--color-text-muted); font-size: var(--font-size-small); }
  .ptier__cta:hover { background: var(--color-primary-hover); }
  .ptable tbody tr { border-bottom: 1px solid var(--color-border); }
  .ptable tbody tr:last-child .ptable__cell.is-featured { border-bottom-left-radius: var(--radius-lg); border-bottom-right-radius: var(--radius-lg); }
</style>

