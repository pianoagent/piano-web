---
/**
 * VideoFacade: náhled videa, který teprve po kliknutí načte přehrávač.
 *
 * Proč fasáda a ne rovnou <iframe>: embed YouTube stáhne skoro megabajt
 * skriptů a kontaktuje třetí stranu ještě dřív, než návštěvník o video
 * projeví zájem. To sype LCP a znamená cookies třetí strany bez souhlasu.
 * Do kliknutí se tady servíruje jen lokální WebP z public/images.
 *
 * Doména je youtube-nocookie.com, stejně jako na live grason.cz.
 * Komponenta je zatím lokální (používá ji jen /pro-firmy). Až ji bude
 * chtít další web, patří do packages/ui, ne zkopírovat.
 *
 *   id: ID videa na YouTube
 *   poster: cesta k náhledu v public/
 *   title: titulek pro <iframe> a aria-label tlačítka
 */
interface Props {
  id: string;
  poster: string;
  title: string;
}
const { id, poster, title } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
---

<div class="vf" data-video-src={src} data-video-title={title}>
  <button class="vf__btn" type="button" aria-label={`Přehrát video: ${title}`}>
    <img class="vf__poster" src={poster} alt="" width="1280" height="720" loading="lazy" />
    <span class="vf__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll('.vf').forEach((el) => {
    const btn = el.querySelector('.vf__btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = el.getAttribute('data-video-src') || '';
      frame.title = el.getAttribute('data-video-title') || '';
      frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.loading = 'lazy';
      frame.className = 'vf__frame';
      el.replaceChildren(frame);
      /* Tlačítko, na kterém byl fokus, právě zmizelo. Bez tohohle by fokus
         spadl na <body> a klávesnicová navigace by začala zase od začátku. */
      frame.setAttribute('tabindex', '-1');
      frame.focus();
    }, { once: true });
  });
</script>

<style>
  .vf { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); background: var(--color-bg-alt); }
  .vf__btn { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .vf__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vf__play {
    position: absolute; inset: 0; margin: auto;
    width: 76px; height: 76px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-full);
    background: var(--color-accent, #F24D83); color: #fff;
    box-shadow: 0 8px 24px rgba(32, 29, 61, 0.35);
    transition: var(--transition);
  }
  /* Ikona je opticky doprava, aby trojúhelník seděl v kruhu */
  .vf__play svg { margin-left: 4px; }
  .vf__btn:hover .vf__play { transform: scale(1.06); }
  .vf__btn:focus-visible { outline: 3px solid var(--color-secondary-azure); outline-offset: 3px; }
  .vf :global(.vf__frame) { width: 100%; height: 100%; border: 0; display: block; }
  @media (prefers-reduced-motion: reduce) { .vf__btn:hover .vf__play { transform: none; } }
</style>
