# Noindex jen na *.pages.dev (preview i produkční alias septim-web.pages.dev),
# aby se duplicitní kopie webu neindexovala. Vlastní doména www.septim.cz tuhle
# hlavičku NEDOSTANE, i když poběží z Cloudflare Pages.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Převzaté assety živého webu se nemění → dlouhá cache
/files/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
