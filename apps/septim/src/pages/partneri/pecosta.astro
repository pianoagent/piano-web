---
// https://www.septim.cz/partneri/pecosta (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from '../../layouts/Base.astro';
import BlokKolikZaplatim_71a6 from '../../components/blocks/BlokKolikZaplatim_71a6.astro';
import BlokDokonalyPrehledVMobilni_ffbc from '../../components/blocks/BlokDokonalyPrehledVMobilni_ffbc.astro';
import Mezera_fd60 from '../../components/blocks/Mezera_fd60.astro';
import Blok30Let_9e65 from '../../components/blocks/Blok30Let_9e65.astro';
import Mezera_bb6d from '../../components/blocks/Mezera_bb6d.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
import Novinky from '../../components/blocks/Novinky.astro';
---
<Base
  title="Pecosta a Septim: automatické naskladňování | Septim"
  description="Pecosta je partnerem Septim v oblasti automatického naskladňování. Propojte nákupy a sklad s vaším provozním systémem."
  path="/partneri/pecosta"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-septim-pecosta.jpg"
>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1>Pecosta<span class="text-highlight">:</span> partner systému Septim</h1>
<p class="text-large">Společnost Pecosta je partnerem provozního systému Septim v oblasti automatického naskladňování.</p>
</div></div></div></div><div class="section-background container-fit container-fit--cover" style="background-color:rgb(235, 252, 255)"><img alt="" decoding="async" sizes="(orientation: portrait) 416.47vw, 100vw" src="/files/r/1280/hdr-tapeta-septim-pecosta-blue.webp" srcset="/files/r/720/hdr-tapeta-septim-pecosta-blue.webp 720w, /files/r/1280/hdr-tapeta-septim-pecosta-blue.webp 1280w, /files/r/1920/hdr-tapeta-septim-pecosta-blue.webp 1920w" style="object-position:50% 0%"/></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:76.92307692307693%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/2553-integrovany-produkt-pecosta.webp" srcset="/files/r/720/2553-integrovany-produkt-pecosta.webp 720w, /files/r/1280/2553-integrovany-produkt-pecosta.webp 1280w, /files/r/1920/2553-integrovany-produkt-pecosta.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Co pro vás přináší Pecosta v systému Septim?</h2>
<p></p>
<p>Společnost Pecosta se dlouhodobě zaměřuje na zvýšení efektivity restaurace ve dvou oblastech:</p>
<ul>
<li>automatizace práce</li>
<li>snížení nákupních cen</li>
</ul>
</div></div></div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Respektované provozy, které využívají služby partnera Pecosta<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div><div><div class="grid gallery-container" style="--gap:75px"><div class="gallery-item grid-col-5"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo CPI Hotels" decoding="async" loading="lazy" src="/files/ref-cpi-hotels.svg"/></div></div></div><div class="gallery-item grid-col-5"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Clarion Hotel" decoding="async" loading="lazy" src="/files/ref-clarion-hotel.svg"/></div></div></div><div class="gallery-item grid-col-5"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Kolkovna" decoding="async" loading="lazy" src="/files/ref-kolkovna.svg"/></div></div></div><div class="gallery-item grid-col-5"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Tatry Mountain Resorts" decoding="async" loading="lazy" src="/files/ref-tmr.svg"/></div></div></div><div class="gallery-item grid-col-5"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Mamaison" decoding="async" loading="lazy" src="/files/ref-mamaison.svg"/></div></div></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(240, 252, 255)"></div></div>
<BlokKolikZaplatim_71a6 />
<BlokDokonalyPrehledVMobilni_ffbc />
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image block-image--3-1"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-middle align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/pecosta-vyhody.webp" srcset="/files/r/720/pecosta-vyhody.webp 720w, /files/r/1280/pecosta-vyhody.webp 1280w, /files/r/1920/pecosta-vyhody.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large">Co za produkty nabízí partner Pecosta v restauraci?</h3>
<p>Systém Pecosta má připravenou domluvu se všemi většími dodavateli v Česku. Stačí podpis na smlouvu o zprostředkování vašich dat a tito dodavatelé začnou s dodaným zbožím posílat data dodacích listů do systému Pecosta. Ten je zpracuje a předá díky připravenému napojení do pokladního systému.</p>
<p><a href="https://www.pecosta.cz/" target="_blank">Oficiální stránky partnera Pecosta</a></p>
</div></div></div></div></div></div></div></div></div></div></div>
<Mezera_fd60 />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-5-12"><div class="block block-inline"><h3>Často kladené otázky u partnera Pecosta<span class="text-highlight">.</span></h3>
</div></div> <div class="col col-6-12 grid-1-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-accordion">
<div class="accordion"><div class="accordion__title"><span class="accordion__title-label">Jaký je hlavní přínos Pecosta pro provoz restaurace?</span><span class="accordion__title-arrow"><div class="cssicon cssicon--chevron cssicon--size-parent"></div></span></div><div class="container accordion__content"><div class="container-body">
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Přínosem automatického naskladňování v systému Septim je úspora času. Prakticky přestanete přepisovat dodací listy. Budete je jen kontrolovat a ušetříte 95% času.</p>
</div></div></div>
</div></div></div>
<div class="accordion"><div class="accordion__title"><span class="accordion__title-label">Jaký je první krok pro využití služeb partnera Pecosta v našem provozu?</span><span class="accordion__title-arrow"><div class="cssicon cssicon--chevron cssicon--size-parent"></div></span></div><div class="container accordion__content"><div class="container-body">
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Zkontrolujeme, jestli je napojení automatického naskladňování připravené pro vaši verzi systému a můžeme začít. <a href="/chci-septim">Kontaktujte naše konzultanty</a>.</p>
</div></div></div>
</div></div></div>
</div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
