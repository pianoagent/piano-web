---
// /eet-2027: návrat EET (SEO, 27. 10. 2026). Obsah 1:1 ze /eet-20 (port ze Solid Pixels),
// stará URL přesměrovaná 301 v public/_redirects. Rozcestník tématu je /eet.
import Base from './../layouts/Base.astro';
import Trustbox from './../components/blocks/Trustbox.astro';

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Mám Septim. Jsem na EET 2.0 připravený?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ano. Pokud máte Septim ve verzi 4.1.40 nebo vyšší, platnou servisní smlouvu a pokladnu připojenou k našemu monitoringu, získáte funkci EET 2.0 automaticky. Aktualizaci nasadíme za vás v dostatečném předstihu. Vy jen nahrajete certifikát od finanční správy."
      }
    },
    {
      "@type": "Question",
      "name": "Budu za EET 2.0 v Septimu něco platit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ne. Žádný příplatek, žádná nová licence. EET je součástí vašeho stávajícího Septimu."
      }
    },
    {
      "@type": "Question",
      "name": "Potřebuji novou pokladnu nebo hardware?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Se Septimem ne. Stačí pokladna i tiskárna, které máte. Obecně platí, že moderní pokladní systémy zvládnou EET 2.0 aktualizací. U starších systémů jiných dodavatelů to může znamenat upgrade za příplatek nebo výměnu. Levné pokladny a aplikace zdarma existují, vždy si ale ověřte, že skutečně umí online evidenci a elektronickou účtenku."
      }
    },
    {
      "@type": "Question",
      "name": "Co musím udělat já?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nahrát do Septimu certifikát. Finanční správa ho začne vydávat 1. listopadu 2026 v portálu DIS+. Hned potom vám pošleme e-mailem jednoduchý návod, jak certifikát nahrát a případně upravit nastavení."
      }
    },
    {
      "@type": "Question",
      "name": "Jak zjistím, jakou verzi Septimu mám?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zavolejte na helpdesk +420 257 011 101. Ověříme za vás verzi i připojení k monitoringu."
      }
    },
    {
      "@type": "Question",
      "name": "Co když podmínky nesplňuji?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ozvěte se nám na obchod@septim.cz nebo +420 257 011 100. Projdeme s vámi, co je potřeba, a pokladnu na EET připravíme."
      }
    },
    {
      "@type": "Question",
      "name": "Změní se něco na účtence?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Na účtence se nic o EET tisknout nebude, žádný kód jako v roce 2016. Text „nefiskální doklad“ z účtenek zmizí automaticky. Účtenku navíc vydáváte jen tehdy, když o ni host požádá."
      }
    },
    {
      "@type": "Question",
      "name": "Od kdy platí EET 2027?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Od 1. ledna 2027 běží zkušební režim. Povinnost evidovat tržby platí od 1. února 2027. Certifikáty vydává finanční správa od 1. listopadu 2026. Uživatelé Septimu nemusí nic instalovat ani nastavovat předem, návod na certifikát jim pošleme."
      }
    },
    {
      "@type": "Question",
      "name": "Nemám Septim. Stihnu se na EET připravit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ano, ale nenechávejte to na poslední chvíli. Na podzim bývají kapacity dodavatelů plné. Napište nám na obchod@septim.cz nebo zavolejte na +420 257 011 100 a pomůžeme vám s přechodem, instalací i zaškolením obsluhy."
      }
    },
    {
      "@type": "Question",
      "name": "Koho se EET 2.0 týká? Platí i pro OSVČ, živnostníky a e-shopy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Týká se prakticky každého, kdo přijímá platby při osobním kontaktu se zákazníkem, tedy hotovost, kartu, QR kód i stravenky. Platí pro firmy, OSVČ, živnostníky i řemeslníky bez ohledu na obor. Platby na dálku, například v e-shopu, se neevidují. Výjimku mají OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně."
      }
    },
    {
      "@type": "Question",
      "name": "EET bylo zrušené. Proč se vrací a dá se evidenci vyhnout?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "První EET stát zrušil na konci roku 2022 kvůli administrativní zátěži. Od roku 2027 se vrací v jednodušší podobě: jen online, s menším rozsahem údajů a účtenkou na vyžádání. Vyhnout se dá jen výjimkami, například režimem EET OFF pro OSVČ v prvním pásmu paušální daně, kde místo evidence platíte vyšší paušál."
      }
    },
    {
      "@type": "Question",
      "name": "Co mi hrozí, když nebudu tržby evidovat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pokuta až 500 000 Kč. Finanční správa navíc bude porovnávat tržby podnikatelů ve stejném oboru a regionu, takže výrazné odchylky samy přitáhnou pozornost kontrolorů."
      }
    },
    {
      "@type": "Question",
      "name": "Co se mění u spropitného a DPH na nealko?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dobrovolné spropitné bude osvobozeno od daně i odvodů až do výše 7 % měsíčních tržeb. Zároveň klesá DPH u nealkoholických nápojů z 21 % na 12 %. Obojí v Septimu připravíme, abyste nemuseli nic nastavovat ručně. Osvobození spropitného má ale dopad na mzdy, dovolenou a nemocenskou vašich zaměstnanců, proto doporučujeme projít si to ještě letos s mzdovou účetní. Víc v článku EET je zpátky. Co to znamená."
      }
    }
  ]
};

