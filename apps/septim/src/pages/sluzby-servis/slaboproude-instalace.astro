---
// https://www.septim.cz/sluzby-servis/slaboproude-instalace (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from '../../layouts/Base.astro';
import BlokKolikZaplatim_71a6 from '../../components/blocks/BlokKolikZaplatim_71a6.astro';
import Blok30Let_9e65 from '../../components/blocks/Blok30Let_9e65.astro';
import Novinky from '../../components/blocks/Novinky.astro';
---
<Base
  title="Slaboproudé instalace pro gastro a hotely | Septim"
  description="Zajišťujeme kompletní slaboproudé instalace pro hotely a restaurace, od kabeláže po sítě. Spolehlivý základ pro systém Septim."
  path="/sluzby-servis/slaboproude-instalace"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-slaboproud.jpg"
>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:76.92307692307693%"><img alt="Slaboproudé instalace" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-slaboproud.webp" srcset="/files/r/720/hdr-slaboproud.webp 720w, /files/r/1280/hdr-slaboproud.webp 1280w, /files/r/1920/hdr-slaboproud.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h1>Slaboproudé instalace<span class="text-highlight">.</span></h1>
<p class="text-large">Pro naše zákazníky ze sektoru hotelů a restaurací zajišťujeme kompletní slaboproudé instalace.</p>
</div></div></div></div></div></div></div></div></div></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image block-image--3-1"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-middle align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Slaboproudé instalace v restauraci" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/slaboproud.webp" srcset="/files/r/720/slaboproud.webp 720w, /files/r/1280/slaboproud.webp 1280w, /files/r/1920/slaboproud.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large">Slaboproudé instalace v restauraci<span class="text-highlight">.</span></h3>
<h3>Kamery</h3>
<p>Pracujeme se všemi dostupnými technologiemi analogového HD, běžného PAL, ale i IP kamerami. Naším hlavním cílem je maximalizace efektu kamerového systému.</p>
<h3>Ozvučení</h3>
<p>Instalace realizujeme se skvělými značkami jako BOSE, Bang &amp; Olufsen, ale i Apart, LD, RH Sound, Dexon, tak aby byl vždy naplněn konkrétní účel ozvučení.</p>
<h3>Zabezpečovací systémy</h3>
<p>Dodáváme zabezpečovací a přístupové systémy Paradox a Jablotron.</p>
<h3>Sítě a kabeláže</h3>
<p>Realizujeme návrhy kabeláží, jejich pokládku jak v metalických, tak i optických variantách. Zároveň pracujeme i s pokročilými wifi technologiemi na bázi zařízení Mikrotik a Ubiquity.</p>
</div></div></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:30px"></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div><div><div class="center"><a class="btn btn-default" href="/chci-septim"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Kontaktovat konzultanty Septim</span></a></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div></div></div>
