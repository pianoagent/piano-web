---
// https://www.septim.cz/produkty/planovani-smen (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from '../../layouts/Base.astro';
import BlokKolikZaplatim_71a6 from '../../components/blocks/BlokKolikZaplatim_71a6.astro';
import Blok30Let_9e65 from '../../components/blocks/Blok30Let_9e65.astro';
import Mezera_bb6d from '../../components/blocks/Mezera_bb6d.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
import Novinky from '../../components/blocks/Novinky.astro';
---
<Base
  title="Plánování směn pro restaurace | Septim"
  description="Díky partnerství s Grasonem pomáhá Septim s plánováním směn a docházkou. Budujte organizovaný a spolehlivý tým bez chaosu v rozpisech."
  path="/produkty/planovani-smen"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-septim-grason-plan.jpg"
>
<div class="section height--low align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p><strong><a href="/produkty">P R O D U K T Y</a></strong></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1>Plánování směn<span class="text-highlight">.</span></h1>
<p class="text-large">Díky partnerství se společností Grason pomáháme budovat organizované a spolehlivé týmy v gastronomii.</p>
</div></div></div></div><div class="section-background" style="background-color:rgb(235, 252, 255)"></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:76.92307692307693%"><img alt="Změňte způsob, jak řídíte své zaměstnance" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/integrovany-produkt-grasonplan.webp" srcset="/files/r/720/integrovany-produkt-grasonplan.webp 720w, /files/r/1280/integrovany-produkt-grasonplan.webp 1280w, /files/r/1920/integrovany-produkt-grasonplan.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Změňte způsob, jak řídíte své zaměstnance.</h2>
<p>V GrasonPlan máte vše na jednom místě. Naplánujete směny, rozdělíte i zkontrolujete zadané úkoly, schválíte docházku a report pro účetní vygenerujete na dvě kliknutí.</p>
</div><div class="image-btn"><a class="btn btn-primary" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">MÁM ZÁJEM</span></a></div></div></div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Respektované provozy, které využívají GrasonPlan<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div><div><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Grandhotel Pupp" decoding="async" loading="lazy" src="/files/ref-grandhotel-pupp.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Turnovská pivnice" decoding="async" loading="lazy" src="/files/ref-turnovska-pivnice.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Perfect Canteen" decoding="async" loading="lazy" src="/files/ref-perfect-canteen.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Potrefená husa" decoding="async" loading="lazy" src="/files/ref-potrefena-husa.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Kolkovna" decoding="async" loading="lazy" src="/files/ref-kolkovna.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/chci-septim"><img alt="Vaše logo" decoding="async" loading="lazy" src="/files/ref-vase.svg"/></a></div></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(240, 252, 255)"></div></div>
<BlokKolikZaplatim_71a6 />
<div class="section height--low align--middle color--default" id="funkce"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image block-image--3-1"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-middle align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/grason-smena.webp" srcset="/files/r/720/grason-smena.webp 720w, /files/r/1280/grason-smena.webp 1280w, /files/r/1920/grason-smena.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large">Jak funguje plánování směn?</h3>
<p>Kdy a kdo pracuje vidíte na počítači i v mobilní aplikaci. Dejte sbohem zmatkům ve Whatsappech, Messengerech a přečmáraných tabulích.</p>
<p>Lidé si sami navolí, kdy nemohou pracovat. Chytré notifikace navíc připomenou směnu i najdou náhradníka, když někdo onemocní.</p>
</div></div></div></div></div></div></div></div></div></div></div>
<div class="section height--low align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-divider"><div><div><hr class="divider divider--normal divider--align-left"/></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image block-image--3-1"><div><div><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-middle align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/grason-plan-vyhody.webp" srcset="/files/r/720/grason-plan-vyhody.webp 720w, /files/r/1280/grason-plan-vyhody.webp 1280w, /files/r/1920/grason-plan-vyhody.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large">Jaké jsou výhody GrasonPlanu?<span class="text-highlight">.</span></h3>
<ul>
<li>Zobrazení směn podle názvu eventu</li>
<li>Chytré notifikace na vše upozorní</li>
<li>Šablony směn snadno zkopírujete na další týdny</li>
<li>Pohlídá kolizní směny pracovníků</li>
<li>Sdílení personálu mezi svými podniky</li>
<li>Najde náhradu za nemocného kolegu</li>
</ul>
</div></div></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:#fff"></div></div>
<Blok30Let_9e65 />
<Mezera_bb6d />
<KontaktniFormular />
<Novinky />
</Base>
