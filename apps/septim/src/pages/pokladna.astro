const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Jakou pokladnu do restaurace vybrat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Takovou, která zvládne špičku a napojí se na kuchyň i sklad. Sestavu vybíráme podle provozu: jinou potřebuje bistro s jedním pultem, jinou restaurace se zahrádkou a mobilními číšníky. Rádi vám ji sestavíme."
      }
    },
    {
      "@type": "Question",
      "name": "Potřebuji k pokladně tiskárnu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ano. Bez pokladní tiskárny se neobejde žádný provoz. U pokladny tiskne účty pro hosty, v kuchyni a na baru bony s objednávkami. Tiskáren může být v systému víc, každá na svém místě."
      }
    },
    {
      "@type": "Question",
      "name": "Funguje pokladna i bez internetu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ano. Septim má online i offline režim, takže při výpadku internetu markujete dál."
      }
    },
    {
      "@type": "Question",
      "name": "Kolik stojí pokladna?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Záleží na počtu pokladen, zvolené licenci a hardwaru. Ceny najdete v ceníku, nabídku na míru vám připravíme zdarma."
      }
    }
  ]
};
