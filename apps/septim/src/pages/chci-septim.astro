---
// https://www.septim.cz/chci-septim (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from './../layouts/Base.astro';
import BlokDemoZdarma_4546 from './../components/blocks/BlokDemoZdarma_4546.astro';
---
<Base
  title="Chci Septim: nezávazná konzultace zdarma | Septim"
  description="Získejte nezávaznou konzultaci k systému Septim pro restaurace, jídelny, kavárny i hotely. Poradíme s výběrem řešení na míru."
  path="/chci-septim"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority i-want-septim"
  image="/files/nahled-chci-septim.jpg"
>
<div class="section height--low align--middle color--default section-has-background" id="lead-form"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-5-12"><div class="block block-inline"><h1>Zjistěte, proč je Septim již 30 let tak oblíbený a jaké velké výhody může přinést do vašeho provozu. <u><a href="#chci-ziskat-vyhody-septimu">Kontaktujte nás</a></u><span class="text-highlight">.</span></h1>
</div> <div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div>
<form action="/api/lead" autocomplete="off" class="block block-form form-background" data-lead-form="chci-ziskat-vyhody-septimu" id="chci-ziskat-vyhody-septimu" method="post">
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_text" id="field-wrapper-jmeno">
<div class="field-wrapper">
<label class="visually-hidden" for="field-jmeno" id="label-jmeno">
            Jméno
          </label>
<input class="field-control" id="field-jmeno" name="chci-ziskat-vyhody-septimu[jmeno]" placeholder="Jméno" type="text" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_email" id="do-sveho-provozu">
<div class="field-wrapper">
<label class="visually-hidden" for="field-email" id="label-email">
            Email <span>*</span>
</label>
<input class="field-control" id="field-email" name="chci-ziskat-vyhody-septimu[email]" placeholder="E-mail" required="" type="email" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_tel" id="field-wrapper-telefon">
<div class="field-wrapper">
<label class="visually-hidden" for="field-telefon" id="label-telefon">
            Telefon
          </label>
<input class="field-control" id="field-telefon" name="chci-ziskat-vyhody-septimu[telefon]" placeholder="Telefon" type="tel" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_text" id="field-wrapper-nazev-podniku">
<div class="field-wrapper">
<label class="visually-hidden" for="field-nazev-podniku" id="label-nazev-podniku">
            Název podniku
          </label>
<input class="field-control" id="field-nazev-podniku" name="chci-ziskat-vyhody-septimu[nazev-podniku]" placeholder="Název podniku" type="text" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_text" id="field-wrapper-mesto">
<div class="field-wrapper">
<label class="visually-hidden" for="field-mesto" id="label-mesto">
            Město
          </label>
<input class="field-control" id="field-mesto" name="chci-ziskat-vyhody-septimu[mesto]" placeholder="Město" type="text" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="block block-inline"><p>Vaše osobní údaje budou zpracovány podle <a href="/informace-o-zpracovani-osobnich-udaju-formular">Podmínek zpracování osobních údajů</a>.</p>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_button" id="field-wrapper-chci-ziskat-vyhody-septimu">
<div class="field-wrapper">
<div class="left">
<button class="btn btn-a btn-primary" id="field-chci-ziskat-vyhody-septimu" name="chci-ziskat-vyhody-septimu[chci-ziskat-vyhody-septimu]" type="submit" value="submit"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CHCI ZÍSKAT VÝHODY SEPTIMU</span></button>
</div>
</div>
</div>
</div>
</div>

<input name="form_variant" type="hidden" value="chci-ziskat-vyhody-septimu"/><input name="page" type="hidden" value=""/><div aria-hidden="true" class="visually-hidden"><label>Web <input autocomplete="off" name="website" tabindex="-1" type="text"/></label></div></form>
</div> <div class="col col-6-12 grid-1-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:121.95121951219512%"><img alt="" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/chci-septim-audrey-piano-30-let.webp" srcset="/files/r/720/chci-septim-audrey-piano-30-let.webp 720w, /files/r/1280/chci-septim-audrey-piano-30-let.webp 1280w, /files/r/1920/chci-septim-audrey-piano-30-let.webp 1920w"/></div></div></div></div></div><div class="section-background" style="background-color:#fff"></div></div>
<BlokDemoZdarma_4546 />
</Base>
