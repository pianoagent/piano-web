---
// https://www.septim.cz/piano-terminal (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from './../layouts/Base.astro';
import Mezera_bdbd from './../components/blocks/Mezera_bdbd.astro';
---
<Base
  title="Piano Terminál: terminál, který ví víc | Septim"
  description="Piano Terminál je platební terminál, který toho ví víc než ostatní. Data o hostech, platby bez hotovosti, srovnání s ostatními terminály a cenová nabídka."
  path="/piano-terminal"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-chci-septim.jpg"
>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-lg align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/group-1000003154.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h1>Terminál, který toho<br/>
<span class="text-highlight">ví víc</span> než ostatní</h1>
<p class="text-large">Získejte data o všech hostech – nejen těch, kteří platí<br/>
přes Qerko. A plaťte dodavatelům bezhotovostně přímo z<br/>
terminálu.</p>
</div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-5-12"><div class="block block-button"><div class="left"><a class="btn btn-default" href="/chci-septim"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CHCI PIANO TERMINÁL</span></a></div></div></div> <div class="col col-6-12 grid-7-12"><div class="block block-button"><div class="left"><a class="btn btn-primary"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Zjistit více ↓</span></a></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="image image-mask ratio-standard"><img alt="" decoding="async" sizes="(min-width:1390px) 824px, (min-width:720px) 59.26vw, 118.52vw" src="/files/r/1280/terminal-landing.webp" srcset="/files/r/720/terminal-landing.webp 720w, /files/r/1280/terminal-landing.webp 1280w, /files/r/1920/terminal-landing.webp 1920w"/></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="h1-style">Co Piano Terminál <span class="text-highlight">umí navíc</span>? </h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:75px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/rectangle-1729-1.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Bezstarostné platby</span></h3>
<p class="text-large">Zapomeňte na hotovost pro závozníky a hlídání splatnosti faktur. Zaplatíte za zboží online na jedno kliknutí.</p>
</div></div></div></div></div></div> <div class="col col-4-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/group.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Data, která vydělávají</span></h3>
<p class="text-large">Zjistěte, jak často se k vám hosté vrací a kdo u vás utrácí nejvíc. Vidíte loajalitu zákazníků v čase.</p>
</div></div></div></div></div></div> <div class="col col-7-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/group-1.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Česká podpora 24/7</span></h3>
<p class="text-large">Připojíme se na dálku a dotaz vyřešíme obratem.<br/>
S námi na to nejste sami.</p>
</div></div></div></div></div></div> <div class="col col-10-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/group-2.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Vyplácíme každý pracovní den</span></h3>
<p class="text-large">Připojíme se na dálku a dotaz vyřešíme obratem.<br/>
S námi na to nejste sami.</p>
</div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(240, 252, 255)"></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="h1-style">Získejte <span class="text-highlight">unikátní data</span><br/>
o vašich hostech</h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="text-large">Sledujte v reálném čase, kolik lidí k vám přišlo poprvé<br/>
a kdo se k vám pravidelně vrací. Piano Terminál s leduje všechny hosty, i ty, kteří platí<br/>
kartou přímo na terminálu. Konečně kompletní obrázek o vašem podniku.</p>
</div></div></div></div></div>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-gem.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Konec dohadů</span></h3>
<p>Poznáte své věrné hosty<br/>
a včas zjistíte, když k vám<br/>
někdo přestane chodit –<br/>
abyste na to mohli reagovat.</p>
</div></div></div></div></div> <div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-gem.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Klíčoví zákazníci</span></h3>
<p>Systém sám vytipuje hosty,<br/>
kteří u vás nechávají nejvíc<br/>
peněz a zaslouží si vaši<br/>
pozornost.</p>
</div></div></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-stats.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Jasné trendy</span></h3>
<p>Vidíte černé na bílém, které<br/>
dny táhnou nové tváře<br/>
a které drží stálá parta.<br/>
 </p>
</div></div></div></div></div> <div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-info.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3>Včasné varování</h3>
<p>Identifikujete propad dřív,<br/>
než ho pocítíte na tržbách.<br/>
Buďte napřed.</p>
</div></div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-image"><div class="image image-mask ratio-standard"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 463px, (min-width:720px) 33.33vw, 100.00vw" src="/files/r/1280/frame-4845.webp" srcset="/files/r/720/frame-4845.webp 720w, /files/r/1280/frame-4845.webp 1280w, /files/r/1920/frame-4845.webp 1920w"/></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="h1-style">A navíc - zapomeňte <span class="text-highlight">na hotovost</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Piano Terminál umožní vám platit faktury dodavatelům bezhotovostně přímo<br/>
z terminálu. Pátek ráno. Přijede Plzeňský Prazdroj. Žádné shánění hotovosti.<br/>
Autorizovaná osoba zaplatí přímo přes terminál a částka se automaticky<br/>
odečte z vyúčtování.</p>
</div></div></div></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/union.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Platíte z toho,<br/>
co vyděláte</span></h3>
<p>Žádné návštěvy bankomatu,<br/>
žádná hotovost. Platby<br/>
dodavatelům probíhají zcela bezhotovostně.</p>
</div></div></div></div></div></div> <div class="col col-4-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-lock.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Bez přístupu k<br/>
bankovnímu účtu</span></h3>
<p>Autorizujete jen osoby, které<br/>
mohou převzít zboží a zaplatit<br/>
– bez přístupu k vaší kartě<br/>
nebo bankovnímu účtu.</p>
</div></div></div></div></div></div> <div class="col col-7-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ic-receipt.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Jedno vyúčtování</span></h3>
<p>Všechny transakce<br/>
z terminálu, Qerka i plateb<br/>
dodavatelům na jednom<br/>
místě.</p>
</div></div></div></div></div></div> <div class="col col-10-12 grid-3-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-sm align-left"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/vector-23-stroke.webp"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3><span class="text-highlight">Vše automaticky</span></h3>
<p>Žádné dodatečné poplatky<br/>
za přímé bezhotovostní<br/>
platby dodavatelům.</p>
</div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-html"><style is:inline>
.piano-steps {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: min(100%, 1020px);
  margin: 0 auto;
}

.piano-steps::before {
  content: "";
  position: absolute;
  left: 56px;
  right: 56px;
  top: 50%;
  height: 4px;
  background: #10069f;
  transform: translateY(-50%);
}

.piano-step {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 113px;
  height: 113px;
  box-sizing: border-box;
  border: 9px solid #fff;
  border-radius: 50%;
  background: #10069f;
  color: #fff;
  font: 700 40px/1 Arial, sans-serif;
}

@media (max-width: 719px) {
  .piano-step {
    width: 64px;
    height: 64px;
    border-width: 5px;
    font-size: 24px;
  }

  .piano-steps::before {
    left: 32px;
    right: 32px;
    height: 2px;
  }
}
</style>
<div class="piano-steps">
<div class="piano-step">1</div>
<div class="piano-step">2</div>
<div class="piano-step">3</div>
</div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-inline"><h3 class="center"><span class="text-highlight">Dodavatel dodá zboží</span></h3>
<p class="center">Rozvoz přijede jako obvykle, žádná<br/>
změna v zavedeném procesu.</p>
</div></div> <div class="col col-5-12 grid-4-12"><div class="block block-inline"><h3 class="center"><span class="text-highlight">Autorizovaná osoba zaplatí přes Qerko</span></h3>
<p class="center">Platba proběhne přímo na terminálu,<br/>
bez hotovosti a bez karty.</p>
</div></div> <div class="col col-9-12 grid-4-12"><div class="block block-inline"><h3 class="center"><span class="text-highlight">Částka se automaticky<br/>
odečte z vyúčtování</span></h3>
<p class="center">Vše uvidíte přehledně v jednom<br/>
vyúčtování.</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="/chci-septim"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Chci platit bez hotovosti →</span></a></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="h1-style">V čem je Piano Terminál <span class="text-highlight">lepší</span>?</h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-html"><style is:inline>
.piano-table-wrap {
  width: 100%;
  max-width: 1276px;
  height: 696px;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 11px;
  background: #fff;
  box-sizing: border-box;
}

.piano-table {
  width: 100%;
  height: 696px;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
  font-family: Poppins, Arial, sans-serif;
}

.piano-table col:first-child {
  width: 62.5%;
}

.piano-table col:nth-child(2) {
  width: 15%;
}

.piano-table col:nth-child(3) {
  width: 22.5%;
}

.piano-table thead tr,
.piano-table th {
  height: 90px;
}

.piano-table th {
  padding: 0 30px;
  background: #08abe2;
  color: #fff;
  font-family: Inter, Arial, sans-serif;
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
  text-align: center;
  vertical-align: middle;
  box-sizing: border-box;
}

.piano-table th:first-child {
  padding-left: 76px;
  text-align: left;
}

.piano-table th:nth-child(2) {
  padding-right: 6px;
  padding-left: 6px;
}

.piano-table tbody tr,
.piano-table td {
  height: 60.6px;
}

.piano-table td {
  padding: 0 30px;
  text-align: center;
  vertical-align: middle;
  box-sizing: border-box;
}

.piano-table td:first-child {
  padding-left: 76px;
  color: #06038d;
  font-size: 20px;
  font-weight: 600;
  line-height: 27px;
  text-align: left;
}

.piano-table td:nth-child(2) {
  background: #e9f9f5;
}

.piano-table__logo {
  display: block;
  width: 179px;
  height: auto;
  max-width: 100%;
  margin: 0 auto;
}

.piano-status-icon {
  display: block;
  object-fit: contain;
  margin: 0 auto;
}

.piano-status-icon--yes {
  width: 19px;
  height: 15px;
}

.piano-status-icon--no {
  width: 11px;
  height: 12px;
}

.piano-status-icon--unknown {
  width: 11px;
  height: 18px;
}

/* Mobil bez scrollování */
@media (max-width: 719px) {
  .piano-table-wrap {
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: 7px;
  }

  .piano-table {
    width: 100%;
    min-width: 0;
    height: auto;
    table-layout: fixed;
  }

  .piano-table col:first-child {
    width: 56%;
  }

  .piano-table col:nth-child(2) {
    width: 21%;
  }

  .piano-table col:nth-child(3) {
    width: 23%;
  }

  .piano-table thead tr,
  .piano-table th {
    height: 64px;
  }

  .piano-table th {
    padding: 4px;
    font-size: 10px;
    line-height: 14px;
    overflow-wrap: anywhere;
  }

  .piano-table th:first-child {
    padding-left: 12px;
    text-align: left;
  }

  .piano-table th:nth-child(2) {
    padding: 4px;
  }

  .piano-table tbody tr,
  .piano-table td {
    height: 56px;
  }

  .piano-table td {
    padding: 6px 4px;
  }

  .piano-table td:first-child {
    padding: 7px 8px 7px 12px;
    font-size: 12px;
    line-height: 16px;
    overflow-wrap: break-word;
  }

  .piano-table__logo {
    width: 86px;
    max-width: 100%;
  }

  .piano-status-icon--yes {
    width: 17px;
    height: 14px;
  }
}
</style>
<div class="piano-table-wrap">
<table class="piano-table">
<colgroup>
<col/>
<col/>
<col/>
</colgroup>
<thead>
<tr>
<th>VLASTNOSTI</th>
<th>
<img alt="Piano Terminal" class="piano-table__logo" decoding="async" loading="lazy" src="/files/group-1000003154.svg"/>
</th>
<th>Ostatní terminály</th>
</tr>
</thead>
<tbody>
<tr>
<td>Unikátní data o hostech v čase</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><img alt="Ne" class="piano-status-icon piano-status-icon--no" decoding="async" loading="lazy" src="/files/vector-1.webp"/></td>
</tr>
<tr>
<td>Platby dodavatelům na kliknutí</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><img alt="Ne" class="piano-status-icon piano-status-icon--no" decoding="async" loading="lazy" src="/files/vector-1.webp"/></td>
</tr>
<tr>
<td>Expresní servis</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><img alt="Ne" class="piano-status-icon piano-status-icon--no" decoding="async" loading="lazy" src="/files/vector-1.webp"/></td>
</tr>
<tr>
<td>Osobní Account Manažer</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><img alt="Ne" class="piano-status-icon piano-status-icon--no" decoding="async" loading="lazy" src="/files/vector-1.webp"/></td>
</tr>
<tr>
<td>Celoevropská licence ČNB</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><span aria-label="Neznámé" class="piano-status-icon piano-status-icon--unknown" role="img">?</span></td>
</tr>
<tr>
<td>Česká podpora 24/7</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><span aria-label="Neznámé" class="piano-status-icon piano-status-icon--unknown" role="img">?</span></td>
</tr>
<tr>
<td>Plná integrace s pokladnou</td>
<td><img alt="Ano" class="piano-status-icon piano-status-icon--yes" decoding="async" loading="lazy" src="/files/vector-1.svg"/></td>
<td><span aria-label="Neznámé" class="piano-status-icon piano-status-icon--unknown" role="img">?</span></td>
</tr>
<tr>
