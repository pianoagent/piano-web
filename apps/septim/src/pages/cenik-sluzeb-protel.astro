---
// https://www.septim.cz/cenik-sluzeb-protel (Solid Pixels), port 1:1 skriptem port-septim.py
import Base from './../layouts/Base.astro';

---
<Base
  title="Ceník služeb Protel | Septim"
  description="Přehled cen služeb k hotelovému systému Protel. Ceny zahrnují slevy pro zákazníky se systémovou podporou. Prohlédněte si ceník."
  path="/cenik-sluzeb-protel"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-protel-cenik.jpg"
>
<div class="section height--medium align--middle color--default section-width-narrow no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Ceník služeb Protel<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div></div><div class="section-background container-fit container-fit--cover" style="background-color:rgb(255, 255, 255)"><img alt="" decoding="async" sizes="(orientation: portrait) 416.47vw, 100vw" src="/files/r/1280/hdr-tapeta-septim-white.webp" srcset="/files/r/720/hdr-tapeta-septim-white.webp 720w, /files/r/1280/hdr-tapeta-septim-white.webp 1280w, /files/r/1920/hdr-tapeta-septim-white.webp 1920w" style="object-position:50% 0%"/></div></div>
<div class="section height--low align--middle color--default section-width-narrow no-pb"><div class="section-body"><div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-image"><div><div><a class="image image-mask ratio-original" href="https://www.protelsystems.cz/cenik-licenci" rel="noopener" style="padding-bottom:76.92307692307693%" target="_blank"><img alt="" decoding="async" loading="lazy" sizes="(min-width:972px) 648px, (min-width:720px) 66.67vw, 100.00vw" src="/files/r/1280/1572-hdr-reseni-pro-hotely.webp" srcset="/files/r/720/1572-hdr-reseni-pro-hotely.webp 720w, /files/r/1280/1572-hdr-reseni-pro-hotely.webp 1280w, /files/r/1920/1572-hdr-reseni-pro-hotely.webp 1920w"/></a></div></div></div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-button"><div><div><div class="center"><a class="btn btn-default btn-lg" href="https://www.protelsystems.cz/cenik-licenci" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Přejít na ceník licencí hotelového systému</span></a></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:30px"></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:30px"></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div><div><div class="block-spacer-element" style="--height:30px"></div></div></div></div></div></div></div></div>
</Base>
