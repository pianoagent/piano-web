---
// Děkovací stránka po odeslání formuláře (na živém webu není, přidaná kvůli měření:
// konverze v GTM = pageview /dekujeme). Noindex, mimo sitemapu.
import Base from '../layouts/Base.astro';
---
<Base
  title="Děkujeme | Septim"
  description="Děkujeme za zprávu. Ozveme se vám co nejdříve."
  path="/dekujeme"
  noindex
>
<div class="section height--high align--middle color--default section-has-background">
  <div class="section-body">
    <div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline">
      <h1 class="center">Děkujeme<span class="text-highlight">.</span></h1>
      <p class="text-large center">Zpráva k nám dorazila. Ozveme se vám co nejdříve.</p>
      <p class="center">Spěcháte? Zavolejte nám na <a href="tel:+420257011100">+420&nbsp;257 011 100</a>.</p>
    </div></div></div>
    <div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center">
      <a class="btn btn-primary" href="/"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">Zpět na hlavní stránku</span></a>
    </div></div></div></div>
  </div>
  <div class="section-background container-fit container-fit--cover" style="background-color:rgb(235, 252, 255)">
    <img alt="" src="/files/r/1920/hdr-tapeta-septim-blue.webp" decoding="async" />
  </div>
</div>
</Base>
