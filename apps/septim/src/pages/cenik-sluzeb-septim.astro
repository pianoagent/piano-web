</tr>
<tr>
<td>Diagnostika hardwaru</td>
<td class="right">1 ks</td>
<td class="right">1 500 Kč</td>
<td class="right">60 EUR</td>
</tr>
<tr>
<td>Opravy hardwaru</td>
<td class="right">1 hod</td>
<td class="right">1 500 Kč</td>
<td class="right">60 EUR</td>
</tr>
