---
// https://www.septim.cz/cenik (Solid Pixels), port 1:1 skriptem port-septim.py
import DomluvitUkazku from './../components/blocks/DomluvitUkazku.astro';
import Base from './../layouts/Base.astro';
---
<Base
  title="Ceník pokladního systému Septim | Septim"
  description="Přemýšlíte o pořízení pokladního systému Septim? Poradíme s výběrem řešení a připravíme ceník na míru. Nezávazná konzultace zdarma."
  path="/cenik"
  bodyClass="use-header-transparent use-menu-primary-uppercase use-menu-secondary-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority"
  image="/files/nahled-produkty.jpg"
>
<div class="section height--low align--middle color--default section-width-boxed no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Ceník licencí<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-inline"><p class="text-large center">Naše licenční nabídky jsou uspořádány přehledně za sebou, abyste snadno našli to, co hledáte. Bez velkých vstupních poplatků můžete používat to, co je top pro české a slovenské gastro provozy. Nebo hledáte ceník servisních služeb?</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default btn-sm" href="/cenik-sluzeb-septim"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CENÍK SERVISNÍCH SLUŽEB</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<!-- Ceník (2. 10. 2026): tarify vedle sebe místo záložek; texty a ceny beze změny z původních záložek -->
<div class="section height--low align--middle color--default price-compare"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12">
<div class="price-compare__grid">
<article class="price-card">
<h2 class="price-card__name">Flex<span class="text-highlight">.</span>licence</h2>
<p class="price-card__scope">provozy s 1 až 5 pokladnami</p>
<p class="price-card__price"><strong>2 990 Kč</strong> / měsíc</p>
<p class="price-card__note">cena za pokladnu, 10% sleva při roční platbě, druhá a další pokladna s 50% slevou</p>
<ul class="price-card__list">
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Skvělou pokladní aplikaci</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Pokročilé skladové hospodářství</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Moderního mobilního číšníka s platbou</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Integraci s hotelovým systémem Protel</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Integraci s Qerko</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Integraci s Autset (import dodacích listů)</li>
<li><img alt="" class="price-card__ico" src="/files/ico-check-univerzal.svg" width="20" height="20" loading="lazy"/>Online přístup k datům</li>
</ul>
<div class="price-card__cta"><a class="btn btn-primary" href="#domluvit-ukazku"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">MÁM ZÁJEM</span></a></div>
</article>
<article class="price-card">
<h2 class="price-card__name">Prime<span class="text-highlight">.</span>licence</h2>
<p class="price-card__scope">provozy s 1 až 5 pokladnami</p>
<p class="price-card__price"><strong>3 990 Kč</strong> / měsíc</p>
<p class="price-card__note">cena za pokladnu, 10% sleva při roční platbě, druhá a další pokladna s 50% slevou</p>
<p class="price-card__intro">Všechny položky Flex.licence a navíc:</p><ul class="price-card__list">
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Integraci na kuchyňské displeje</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>VIP podporu</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Septim WebCare, rozhraní pro zákazníky</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Hromadnou výrobu jídel</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Více středisek a offline provoz / replikace</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Zakázkový reporting</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Integraci na účetnictví</li>
</ul>
<div class="price-card__cta"><a class="btn btn-primary" href="#domluvit-ukazku"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">MÁM ZÁJEM</span></a></div>
</article>
<article class="price-card">
<h2 class="price-card__name">Elite<span class="text-highlight">.</span>licence</h2>
<p class="price-card__scope">provozy s více než 5 pokladnami</p>
<p class="price-card__price"><strong>na vyžádání</strong></p>
<p class="price-card__note"></p>
<p class="price-card__intro">Všechny položky Prime.licence a navíc:</p><ul class="price-card__list">
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Ostatní existující integrace</li>
<li><img alt="" class="price-card__ico" src="/files/ico-plus-univerzal.svg" width="20" height="20" loading="lazy"/>Zakázkový vývoj</li>
</ul>
<div class="price-card__cta"><a class="btn btn-primary" href="#domluvit-ukazku"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">MÁM ZÁJEM</span></a></div>
</article>
</div>
</div></div></div></div>
<DomluvitUkazku />
</Base>
