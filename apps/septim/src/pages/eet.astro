const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Co je EET?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elektronická evidence tržeb. Pokladna při každé platbě s osobním kontaktem odešle údaje o tržbě online finanční správě. Po zrušení na konci roku 2022 se vrací jako EET 2.0, zkušební provoz začíná 1. ledna 2027 a povinnost evidovat platí od 1. února 2027."
      }
    },
    {
      "@type": "Question",
      "name": "Co je EET 2.0?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nová, jednodušší podoba elektronické evidence tržeb. Funguje jen online, eviduje méně údajů, účtenku vydáváte jen na vyžádání a místo plošných kontrol nastupuje cílená analytika. Moderní pokladní systémy ji zvládnou aktualizací."
      }
    },
    {
      "@type": "Question",
      "name": "Jak EET funguje?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Od finanční správy získáte certifikát v portálu DIS+ (vydává je od 1. listopadu 2026) a nahrajete ho do pokladny. Pokladna pak údaje o tržbách odesílá sama na pozadí. Vy markujete jako dřív."
      }
    },
    {
      "@type": "Question",
      "name": "Koho se EET týká?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prakticky každého, kdo přijímá platby při osobním kontaktu se zákazníkem: firem, OSVČ, živnostníků i řemeslníků bez ohledu na obor. Platby na dálku, například v e-shopu, se neevidují. Výjimku mají OSVČ v prvním pásmu paušálního režimu s příjmy do 1 milionu Kč ročně."
      }
    },
    {
      "@type": "Question",
      "name": "Jaká je pokuta za neevidování tržeb?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Až 500 000 Kč. Kdo přijímá platby při osobním kontaktu a nespadá pod výjimku, musí od 1. února 2027 evidovat."
      }
    }
  ]
};
