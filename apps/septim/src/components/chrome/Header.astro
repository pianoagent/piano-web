---
// Hlavička: rámec ze živého septim.cz (port-septim.py), menu od 2. 10. 2026 z config/menu.ts
// (mega panely, záložka Piano, telefon). Chování menu a aktivní položky: src/scripts/septim.js
import LangSwitch from './LangSwitch.astro';
import { menu } from '../../config/menu';
import type { Locale } from '../../i18n/config';
interface Props { path: string; locale: Locale }
const { path, locale } = Astro.props;
---
<div class="header" id="header" role="banner">
<div class="row-main">
<div class="menu menu--with-language menu--bar menu--sm-nav-primary-left menu--bar-logo-left menu--bar-primary-center menu--bar-secondary-right menu--bar-misc-right submenu--fullrow menu--sm-logo-left menu--sm-toggle-right menu--sm-misc-bottom menu--sm-nav-primary-left menu--sm-nav-secondary-left menu--sm-overlay menu--lg-priority">
<div class="menu__region menu__toggle">
<button aria-expanded="false" class="nav-toggle nav-toggle--cross" data-lg-type="priority" data-sm-type="overlay" data-target="#menu-main" data-toggle="nav" id="nav-toggle" type="button">
<span class="nav-toggle-icon cssicon cssicon--size-parent cssicon--hamburger"><span></span></span>
<span class="nav-toggle-label">Menu</span>
</button>
</div>
<div class="menu__region menu__header">
<div class="logo logo--image">
<a class="logo__element" href="/" title="www.septim.cz">
<img alt="Septim" class="logo__image logo__image--primary" decoding="async" src="/files/logo-original.svg"/>
</a>
</div>
</div>

<div class="menu__region menu__special">

<LangSwitch path={path} locale={locale} />
</div>
<div class="menu__wrapper">
<div class="menu__region menu__inner">
<div class="menu__region menu__primary" data-nav="priority" data-submenu="doubleTap">
<nav aria-label="Hlavní" class="nav nav--primary" id="menu-main">
<ul class="nav__list nav__list--level-0" id="menu-1">
{menu.map((item, i) => item.panel ? (
  <li class="nav__item has-children mega-item">
    <span class="nav__link" role="button" tabindex="0" aria-expanded="false" aria-controls={`mega-${i}`}><span class="nav__label">{item.label}</span><span class="cssicon cssicon--chevron-down submenu-trigger" aria-hidden="true"></span></span>
    <div class="submenu submenu--level-0 mega" id={`mega-${i}`}>
      <div class="mega__inner">
        <div class="mega__main">
          <div class="mega__groups" style={`--mega-cols:${item.panel.groups.length}`}>
            {item.panel.groups.map((g) => (
              <div class="mega__group">
                <p class:list={['mega__heading', { 'mega__heading--blank': !g.heading.trim() }]} aria-hidden={!g.heading.trim() ? 'true' : undefined}>{g.heading}</p>
                <ul class="mega__list">
                  {g.links.map((l) => (
                    <li><a class:list={['mega__link', { 'mega__link--desc': l.desc }]} href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}><span class="mega__label">{l.label}</span>{l.desc && <span class="mega__desc">{l.desc}</span>}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {item.panel.more && <a class="mega__more" href={item.panel.more.href} target={item.panel.more.external ? '_blank' : undefined} rel={item.panel.more.external ? 'noopener' : undefined}>{item.panel.more.label} →</a>}
        </div>
        {item.panel.aside === 'sales' && (
          <aside class="mega__aside">
            <p class="mega__aside-title">Ukážeme vám Septim v praxi</p>
            <p class="mega__aside-text">Nezávazná ukázka s konzultantem, který zná gastro provoz.</p>
            <a class="btn btn-primary mega__aside-btn" href="/chci-septim"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">DOMLUVIT UKÁZKU</span></a>
            <p class="mega__aside-contact"><a href="tel:+420257011100">+420&nbsp;257 011 100</a><br /><a href="mailto:obchod@septim.cz">obchod@septim.cz</a></p>
          </aside>
        )}
        {item.panel.aside === 'support' && (
          <aside class="mega__aside">
            <p class="mega__aside-title">Jste už v rodině Septim?</p>
            <p class="mega__aside-contact"><span class="mega__aside-label">Helpdesk (Po až Pá 8:30 až 17:00)</span><a href="tel:+420257011101">+420&nbsp;257 011 101</a></p>
            <p class="mega__aside-contact"><span class="mega__aside-label">Hotline mimo pracovní dobu</span><a href="tel:+420777737846">+420&nbsp;777 737 846</a></p>
            <p class="mega__aside-contact"><a href="mailto:servis@septim.cz">servis@septim.cz</a></p>
          </aside>
        )}
        {item.panel.aside === 'piano' && (
          <aside class="mega__aside">
            <p class="mega__aside-title">Síla je v propojení</p>
            <p class="mega__aside-text">Septim spolupracuje s dalšími nástroji skupiny Piano: platby, nákupy, směny i hotelový systém v jednom ekosystému.</p>
          </aside>
        )}
      </div>
    </div>
  </li>
) : (
  <li class="nav__item"><a class:list={['nav__link', { 'nav__link--badge': item.badge }]} href={item.href}><span class="nav__label">{item.label}</span></a></li>
))}
</ul>
</nav>

<LangSwitch path={path} locale={locale} />
</div>
<div class="menu__region menu__secondary">
<nav class="nav nav--secondary" id="menu-secondary"><ul class="nav__list nav__list--level-0" id="menu-33"><li class="nav__item nav__item--phone"><a class="nav__link nav__link--phone" href="tel:+420257011100"><span class="nav__label">+420&nbsp;257 011 100</span></a></li><li class="nav__item nav__item--btn"><a class="nav__link nav__link--btn" href="/chci-septim"><span class="nav__label">Chci Septim</span></a></li></ul></nav>
</div>
</div>
</div>
</div>
</div>
</div>
