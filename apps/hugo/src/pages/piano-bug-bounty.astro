---
// https://hugopos.eu/piano-bug-bounty/, port 1:1 skriptem port-hugo.py (scrape 13. 10. 2026)
import Base from '../layouts/Base.astro';
import '../styles/bug-bounty.css';
---
<Base
  title={"Poznej Huga · Bug Bounty"}
  lang={"cs"}
  gtm={false}
  noindex
>
<Fragment slot="head">
<script is:inline>(function(){var p=location.pathname;if(!p.endsWith("/")&&!/\.[a-z0-9]+$/i.test(p.split("/").pop())){history.replaceState(null,"",p+"/"+location.search+location.hash);}})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<script is:inline id="hugo-gate-script">
(function(){
  // HUGO-743 – plain password gate: salted one-way SHA-256 fingerprint, no content
  // encryption. The page markup ships in plaintext; this only keeps casual visitors
  // and crawlers out (same bar as the staging gate, HUGO-671). Rotate the password
  // with: node deploy/staging-gate/make-hash.mjs "<new password>" and paste S/H below.
  var S="xddri5G4pOf2B6wB", H="nnD+vowDR6Kpvy1hZtWX+OR0+/lNH6xljvgYCYgu9rw=";
  var doc=document, root=doc.documentElement;
  try{ if(sessionStorage.getItem("hugo-bugbounty-unlocked")==="1") return; }catch(e){}
  root.className += " hugo-gated";
  function b64(buf){ var u=new Uint8Array(buf),s=""; for(var i=0;i<u.length;i++)s+=String.fromCharCode(u[i]); return btoa(s); }
  async function digest(str){ var b=await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str)); return b64(b); }
  function reveal(){ var g=doc.getElementById("hugo-gate"); if(g)g.parentNode.removeChild(g); root.className=root.className.replace(/\bhugo-gated\b/g,"").trim(); if(location.hash){ var t=doc.getElementById(location.hash.slice(1)); if(t) t.scrollIntoView(); } }
  function build(){
    if(doc.getElementById("hugo-gate")) return;
    var g=doc.createElement("div"); g.id="hugo-gate"; g.setAttribute("role","dialog"); g.setAttribute("aria-modal","true");
    g.innerHTML='<div class="card"><div class="lock">🐞</div><div class="eyebrow">Bug Bounty · Poznej Huga</div><h2>Zadej heslo a pojď dovnitř</h2><p>Tahle stránka je interní. Heslo jsi dostal/a spolu s pozvánkou – kdyby ne, napiš si o ně.</p><form><div class="pw-wrap"><input id="hugo-gate-pw" type="password" placeholder="Heslo" autocomplete="off" autofocus /><button type="button" class="pw-toggle" id="hugo-gate-eye" aria-label="Zobrazit heslo" aria-pressed="false">👁</button></div><button type="submit">Odemknout</button><div class="err" id="hugo-gate-err">Špatné heslo, zkus to znovu.</div></form></div>';
    root.appendChild(g);
    var f=g.querySelector("form"), pw=g.querySelector("#hugo-gate-pw"), err=g.querySelector("#hugo-gate-err"), eye=g.querySelector("#hugo-gate-eye");
    eye.addEventListener("click", function(){
      var show = pw.type==="password";
      pw.type = show ? "text" : "password";
      eye.textContent = show ? "🙈" : "👁";
      eye.setAttribute("aria-pressed", show ? "true" : "false");
      eye.setAttribute("aria-label", show ? "Skrýt heslo" : "Zobrazit heslo");
      try{ pw.focus(); }catch(_){ }
    });
    f.addEventListener("submit", async function(e){
      e.preventDefault();
      try{
        if((await digest(S+pw.value))===H){ try{ sessionStorage.setItem("hugo-bugbounty-unlocked","1"); }catch(_){ } reveal(); }
        else { err.style.display="block"; pw.value=""; pw.focus(); }
      }catch(_){ err.style.display="block"; }
    });
    try{ pw.focus(); }catch(_){ }
  }
  // documentElement always exists during <head> parse; append the overlay there (NOT
  // to <body>, which is visibility:hidden while gated) so the gate paints with no flash.
  build();
})();
</script>
</Fragment>
<nav class="nav">
  <div class="in">
    <a class="brand" href="#top"><img src="assets/hugo-icon.png" alt="Hugo" /> Hugo POS</a>
    <button class="burger" aria-label="Menu" onclick="document.getElementById('navlinks').classList.toggle('open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="links" id="navlinks">
      <a href="#zapojit">Jak se zapojit</a>
      <a href="#kdo">Kdo je Hugo</a>
      <a href="#tech">Pod kapotou</a>
    </div>
  </div>
</nav>

<a id="top"></a>

<header class="hero" data-screen-label="Hero">
  <div class="wrap">
    <span class="tag"><span class="d"></span> Pro celou firmu – potřebujeme tvoji pomoc</span>
    <div class="eyebrow">🐞 Bug Bounty · interní lov na chyby</div>
    <h1 class="hero-t">Rozbij <span class="hl">Huga</span> dřív, než to udělá zákazník.</h1>
    <p class="lead">Projeď appku i web, klikej jako šílenec a dělej věci, co „přece nikdo nedělá“. Všechno, co se rozbije, opravíme. <b>Kdo najde nejvíc chyb, vyhrává odměnu.</b></p>
    <div class="btns">
      <a class="btn btn-primary" href="#zapojit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7"/></svg> Chci se zapojit</a>
      <a class="btn btn-ghost" href="#kdo">Kdo je Hugo?</a>
    </div>

    <div class="prize">
      <div class="big">
        <div class="plbl">Hlavní odměna</div>
        <div class="num"><span class="bug">🏆</span> #1</div>
        <div class="sub">Nejvíc nahlášených chyb = <b>odměna</b>. Detaily a žebříček doplníme.</div>
      </div>
      <div class="vsep"></div>
      <div class="side">
        <div class="q">„Když to najdeš ty, je to <b>vychytávka.</b> Když to najde zákazník, je to <b>průšvih.</b>“</div>
      </div>
    </div>
  </div>
</header>

<section class="band" id="zapojit" data-screen-label="Jak se zapojit">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-kicker"><span class="n">01</span> Jak se zapojit</div>
        <h2 class="sec-t">Tři kroky a jsi ve hře.</h2>
      </div>
      <p class="sec-lead">Založ si účet, nahoď appku a hlas, co se rozbije. Zabere to pár minut.</p>
    </div>

    <div class="steps-grid">
      <div class="scard">
        <div class="sh">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M2 10h20M6 18h12"/></svg></span>
          <h3>Administrace (web)</h3>
        </div>
        <span class="pill">Začni tady</span>
        <ol class="steps">
          <li><span class="txt">Jdi na <a class="lnk" href="https://www.hugopos.cz" target="_blank" rel="noopener">hugopos.cz</a></span></li>
          <li><span class="txt">Založ si účet přes velké <span class="btn-inline">žluté tlačítko</span> :)</span></li>
          <li><span class="txt">Projdi <b>onboardingem</b></span></li>
          <li><span class="txt"><span class="tada">Tadááá!</span> You're in.</span></li>
          <li><span class="txt">Chceš zkusit i aplikaci? Vem si mobil →</span></li>
        </ol>
      </div>

      <div class="scard">
        <div class="sh">
          <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.9c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.6.7 2.8.7 1.9-1.1 2.6-2.2c.8-1.2 1.2-2.4 1.2-2.5-.1 0-2.3-.9-2.3-3.5zM14.3 6.1c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1 1.6-.9 2.6 1 .1 2-.5 2.6-1.2z"/></svg></span>
          <h3>iOS aplikace</h3>
        </div>
        <span class="pill">Přes TestFlight</span>
        <ol class="steps">
          <li><span class="txt">Stáhni si aplikaci <a class="lnk" href="https://apps.apple.com/app/testflight/id899247664" target="_blank" rel="noopener">TestFlight</a></span></li>
          <li><span class="txt">V iPhonu nebo iPadu otevři <a class="lnk" href="https://testflight.apple.com/join/Ym6jXbkA" target="_blank" rel="noopener">tenhle odkaz</a></span></li>
          <li><span class="txt">Stáhni appku <b>Hugo</b></span></li>
          <li><span class="txt"><b>Spáruj</b> ji s adminem</span></li>
        </ol>
      </div>

      <div class="scard">
        <div class="sh">
          <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 9.5l1.8-3.1c.1-.2 0-.4-.1-.5-.2-.1-.4 0-.5.1l-1.8 3.2c-1.4-.6-2.9-1-4.6-1s-3.2.3-4.6 1L6 5.9c-.1-.2-.3-.2-.5-.1-.2.1-.2.3-.1.5l1.8 3.1C4.1 11.3 2 14.5 2 18h20c0-3.5-2.1-6.7-4.4-8.5zM7.5 15.2c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9zm9 0c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9z"/></svg></span>
          <h3>Android aplikace</h3>
        </div>
        <span class="pill">Přes Google Play</span>
        <ol class="steps">
          <li><span class="txt">Přidej se do skupiny <a class="lnk" href="https://groups.google.com/g/hugo-testers" target="_blank" rel="noopener">https://groups.google.com/g/hugo-testers</a> („join group“)</span></li>
          <li><span class="txt">V Androidu otevři <a class="lnk" href="https://play.google.com/store/apps/details?id=com.piano.hugo" target="_blank" rel="noopener">tenhle odkaz</a> a přidej se k testovací skupině</span></li>
          <li><span class="txt">Stáhni appku <b>Hugo</b></span></li>
          <li><span class="txt"><b>Spáruj</b> jí s adminem</span></li>
        </ol>
      </div>
    </div>

    <div class="report-hero">
      <span class="rh-badge"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg> Tady to celé začíná</span>
      <h3>Našel/našla jsi chybu? Takhle nám ji pošleš.</h3>
      <p class="rh-sub">Jádro celého bug bounty: kdykoliv něco zaskřípe, <b>nahlas to přímo tam, kde zrovna jsi</b> – pár kliků a je to u nás i s diagnostikou.</p>
      <div class="rh-grid">
        <div class="rh-card">
          <div class="rh-top">
            <span class="rh-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M2 10h20M6 18h12"/></svg></span>
            <div class="rh-where">Ve webu <span class="sm">administrace</span></div>
          </div>
          <div class="rh-path"><span class="step">Profil</span> <span class="arr">›</span> <span class="step">Nahlásit problém</span></div>
        </div>
        <div class="rh-card">
          <div class="rh-top">
            <span class="rh-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="3"/><path d="M12 18h0"/></svg></span>
            <div class="rh-where">V aplikaci <span class="sm">kasa</span></div>
          </div>
          <div class="rh-path"><span class="step">Menu</span> <span class="arr">›</span> <span class="step">Nahlásit problém</span></div>
        </div>
      </div>
    </div>

    <div class="flow">
      <div class="fh">
        <span class="bolt"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg></span>
        <h3>Co se stane s tvým reportem</h3>
        <span class="r">Skoro všechno běží samo</span>
      </div>
      <div class="row">
        <div class="fcard">
          <h4>Přijde diagnostika</h4>
          <p>S hlášením nám dorazí i technická diagnostika – nemusíš nic vyplňovat navíc.</p>
        </div>
        <div class="farr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></div>
        <div class="fcard">
          <h4>Systém vyhodnotí</h4>
          <p>Sám určí, kde chyba je, a <b>připraví návrh fixu</b>.</p>
        </div>
        <div class="farr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></div>
        <div class="fcard">
          <h4>Review vývojářů</h4>
          <p>Fix projde kontrolou vývojářů – <b>jednou denně</b>.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="band alt" id="proc" data-screen-label="Proč to děláme">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-kicker"><span class="n">★</span> Proč nás to zajímá</div>
        <h2 class="sec-t">Proč to děláme</h2>
      </div>
      <p class="sec-lead">Hugo vznikl extrémně agilně a díky AI i levně – je to náš první test nového workflow.</p>
    </div>

    <div class="why-grid">
      <div class="wcard hl">
        <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg></span>
        <h3>Postaveno agilně &amp; levně</h3>
        <p>Huga jsme rozjeli rychle a s pomocí AI za zlomek obvyklých nákladů. <b>Věříme tomuhle způsobu práce</b> – a tohle je jeho první ostrý test.</p>
      </div>
      <div class="wcard">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg></span>
        <h3>Nový způsob workflow</h3>
        <p>Měníme, jak vyvíjíme produkt. Aby to fungovalo, potřebujeme vědět, kde to <b>skřípe</b> – a opravit to, dokud jsme mezi sebou.</p>
      </div>
      <div class="wcard">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
        <h3>Než vyrazíme za zákazníky</h3>
        <p>Teď máme šanci najít největší fuckupy <b>v klidu</b>. Potřebujeme vaši pomoc je odhalit, než nás uvidí první ostří zákazníci.</p>
      </div>
      <div class="wcard">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V9l9-6 9 6v12M3 21h18M9 21v-6h6v6"/></svg></span>
        <h3>Hraje se o 8 000 podniků</h3>
        <p>Tohle je naše šance dostat Huga k <b>8 000 podnikům</b>. Když to teď doladíme, bude to pecka.</p>
      </div>
    </div>

    <div class="dday">
      <div class="d">
        <div class="num">1. 8.</div>
        <div class="lbl">D-Day · první zákazníci</div>
      </div>
      <div class="sep"></div>
      <div class="dt"><b>1. srpna</b> jdeme za prvními zákazníky. Do té doby chceme mít co nejvíc chyb nahlášených a opravených. <b>Každý report se počítá.</b></div>
    </div>
  </div>
</section>

<section class="band" id="kdo" data-screen-label="Kdo je Hugo">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-kicker"><span class="n">02</span> Kdo je Hugo</div>
        <h2 class="sec-t">Trochu drzý, ale nápomocný parťák.</h2>
      </div>
      <p class="sec-lead">Pokladna pro menší a střední provozy, kterou ovládáš přirozeně – hlasem nebo psaním.</p>
    </div>

    <div class="who-grid">
      <div class="who-card">
        <div class="av"><img src="assets/hugo-icon.png" alt="Hugo" /></div>
        <div>
          <div class="name">Hugo</div>
          <div class="role">nový parťák pro gastro</div>
        </div>
      </div>
      <div class="who-txt">
        <p class="big-q">Žádné dlouhé školení. Řekneš mu, co potřebuješ – a on to udělá.</p>
        <p>Hugo je tvůj <b>parťák do menších a středních provozů</b>. Můžeš ho ovládat hlasem, nebo mu prostě psát – tak, jak to znáš z klasických LLM. <b>Rozjedeš ho během 5 minut</b> a bez příručky.</p>
        <div class="chips">
          <span class="c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg> Ovládej hlasem</span>
          <span class="c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Nebo mu piš jako LLM</span>
          <span class="c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Rozjedeš za 5 minut</span>
          <span class="c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="3"/><path d="M12 18h0"/></svg> iOS i Android</span>
          <span class="c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="3"/><path d="M1 10h22"/></svg> Napojeno na Piano Payments</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="band dark" id="tech" data-screen-label="Pod kapotou">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-kicker"><span class="n">03</span> Pod kapotou</div>
        <h2 class="sec-t">Vypadá jednoduše. Uvnitř je to pořádný stroj.</h2>
      </div>
      <p class="sec-lead">Jak je Hugo postavený a jak ho vyvíjíme – trochu techničtěji, ale pořád bez tajných detailů.</p>
    </div>

    <div class="stack">
      <div class="srow"><div class="lyr">iOS + Android</div><div class="val">Jedna <b>Flutter / Dart</b> codebase pro obě platformy, s nativním hlasovým mostem (<code>Swift</code> / <code>Kotlin</code>) pro streamování audia. Offline-first (šifrovaný).</div></div>
      <div class="srow"><div class="lyr">Backend (BE)</div><div class="val"><b>Node.js 22 + Express</b>, jediný zapisovatel do DB. <b>PostgreSQL 18</b> přes <code>Prisma</code> ORM (~85 modelů). Real-time sync kasy přes <b>WebSockety</b>.</div></div>
      <div class="srow"><div class="lyr">Web Admin (FE)</div><div class="val"><b>React 19 + Vite</b>, Tailwind v4, react-router. SPA komunikuje s BE přes REST + WS. 17 jazyků (i18next), výchozí čeština.</div></div>
      <div class="srow"><div class="lyr">Monorepo</div><div class="val">Jedno úložiště, <b>čtyři produkční služby</b> (API, Admin, Landing, POS) + sdílené balíčky. Sazby DPH a jednotky jsou <b>byte-identické kopie</b> napříč službami, aby kasa a účtárna počítaly totožně.</div></div>
      <div class="srow"><div class="lyr">Peníze</div><div class="val"><b>Jediný zdroj pravdy</b> – jeden modul počítá DPH i součty v celočíselných jednotkách; POS je <b>bit-for-bit zrcadlo</b> backendu (pinnuté golden fixture). Žádná „ztracená koruna“ v přiznání.</div></div>
      
    </div>

    <div class="subhead">– A takhle to vyvíjíme –</div>

    <div class="hl-grid">
      <div class="hlcard">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg></span>
        <h3>Adversariální AI review</h3>
        <p>Než se kód mergne, <b>orchestruje ho Claude</b> a pod ním se v <b>loopu klidně desítek agentů</b> hádají další Claude a Codex – jeden píše, druhý trhá návrh na kusy. Točí se to tak dlouho, <b>dokud se neshodnou</b>.</p>
      </div>
      <div class="hlcard">
        <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg></span>
        <h3>Self-healing triage</h3>
        <p>Tvůj report → <b>Claude ho zanalyzuje izolovaně</b> (čte ho jen jako data) → oddělený „broker“ bez přístupu k AI výstup ověří a <b>založí Jira ticket</b>. Oprava pak projde review vývojářů.</p>
