---
// https://hugopos.eu/cenik/, port 1:1 skriptem port-hugo.py (scrape 13. 10. 2026)
import Base from '../layouts/Base.astro';
import hugoAbUrl from '../scripts/hugo-ab.js?url';
import '../styles/sub.css';
import hugoI18nUrl from '../scripts/hugo-i18n.js?url';
import hugoNavUrl from '../scripts/hugo-nav.js?url';
---
<Base
  title={"Ceník: 190 Kč měsíčně, všechno v ceně"}
  lang={"cs"}
  description={"Ceník pokladny Hugo: 190 Kč měsíčně bez DPH, karty 1,1 % (MIF++), terminál 4 900 Kč nebo tvůj telefon zdarma. Bez výpovědní lhůty, 14 dní zdarma. Srovnání nákladů s Dotykačkou, KASA FIK a SumUp."}
  ogDescription={"Jeden tarif, všechny ceny na jedné stránce a srovnání s ostatními pokladnami."}
  image={"/assets/og/og-cs.png"}
  imageAlt={"Ceník: 190 Kč měsíčně, všechno v ceně | Hugo"}
  alternates={{ cs: '/cenik/', en: '/en/pricing/' }}
>
<Fragment slot="head">
<script is:inline src={hugoAbUrl}></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<script is:inline src={hugoI18nUrl} defer></script>
<script is:inline src={hugoNavUrl} defer></script>
</Fragment>
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand"><img src="/assets/hugo-icon.svg" alt="" /><span>Hugo</span></a>
    
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Menu"><span></span><span></span><span></span></button>
    <nav class="nav-links" id="navLinks">
      <a href="/#product">Produkt</a>
      <a href="/jak-zacit/">Jak začít</a>
      <a href="/srovnani/">Srovnání</a>
      <a href="/cenik/" class="is-on">Ceník</a>
      <a href="/#reference">Reference</a>
    </nav>
    <div class="nav-cta">
      <div class="lang" id="langToggle"><a href="/cenik/" hreflang="cs" lang="cs" data-lang-link class="is-on" aria-current="true">CZ</a><a href="/en/pricing/" hreflang="en" lang="en" data-lang-link>EN</a></div>
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary">Začít zdarma</a>
    </div>
  </div>
</header>

<main>
<section class="phero phero-art">
  <div class="container phero-grid">
    <div class="phero-text">
    <span class="eyebrow">Ceník</span>
    <h1>190 Kč měsíčně. <span class="hl">A tím ceník končí.</span></h1>
    <p class="lead">Jeden tarif pro food truck i pro restauraci. Žádné tarify, žádná pásma podle obratu, žádné „pošleme vám nabídku“. Všechno je níž, včetně toho, kolik si účtují ostatní pokladny.</p>
    </div>
    <div class="ctas">
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Začít 14 dní zdarma <svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      <a href="#srovnani" class="btn btn-ghost btn-lg">Srovnat s ostatními</a>
    </div>
    <img class="phero-img" src="/assets/cenik-barista.png" alt="" width="480" height="954" decoding="async" />
  </div>
</section>

<section class="sec" id="cenik">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Ceník Hugo</span>
      <h2>Všechno, co nám kdy zaplatíš. <em>Jedna tabulka.</em></h2>
    </div>
    <div class="ptable" role="table" aria-label="Ceník Hugo">
      <div class="prow head" role="row"><div role="columnheader">Co</div><div role="columnheader">Cena (bez DPH)</div></div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Pokladna Hugo, všechno v ceně</b><span>Objednávky, menu, sklad, směny, reporty, DPH i účtenky. Když karty přijímáš s námi.</span></div>
        <div class="v" role="cell"><span>190 Kč / měsíc</span></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Platba kartou, náš poplatek</b><span>Stejný při jakémkoli obratu. Peníze na účtu do 2 dnů, banku neměníš.</span></div>
        <div class="v" role="cell">1,1 %<small>z každé platby kartou</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Poplatky bance a karetní asociaci (MIF++)</b><span>Neurčujeme je a nejsou naším příjmem, posíláme je dál beze změny. U spotřebitelských karet z EHP je strop daný nařízením EU.</span></div>
        <div class="v" role="cell">beze změny<small>mezibankovní max. 0,2 % debetní / 0,3 % kreditní</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Telefon nebo tablet, co už máš</b><span>Hugo na iOS i Androidu. Karty přijmeš na Androidu.</span></div>
        <div class="v" role="cell">0 Kč</div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Terminál Hugo all-in-one</b><span>Platební terminál, tiskárna účtenek a Hugo v jedné krabici. Jednorázově.</span></div>
        <div class="v" role="cell">4 900 Kč<small>jednorázově; připravuje se daňový bonus 5 000 Kč</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Zařízení, obsluha, položky v menu</b><span>Přidej tablet na bar nebo telefon každé obsluze.</span></div>
        <div class="v" role="cell">neomezeně<small>žádný poplatek za zařízení</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Přechod z jiné pokladny</b><span>Menu naimportujeme, obě pokladny běží vedle sebe, dokud nepřepneš.</span></div>
        <div class="v" role="cell">0 Kč<small>migrace je zdarma</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Výpovědní lhůta</b><span>Zrušíš kdykoli, žádné placené měsíce navíc.</span></div>
        <div class="v" role="cell">žádná</div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Zkušební doba</b><span>Nesedne ti to? Vrátíme peníze. Bez formulářů, bez výslechu.</span></div>
        <div class="v" role="cell">14 dní zdarma</div>
      </div>
    </div>
    <p class="note">Všechny ceny a poplatky jsou bez DPH. Sazby se liší podle typu karty, u stravenkových karet a karet AMEX a Diners se přidává dodatečný poplatek. <a href="/#mif" style="text-decoration:underline">Co přesně je MIF++?</a></p>
  </div>
</section>

<section class="sec sec-alt" id="srovnani">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Hugo proti ostatním pokladnám</span>
      <h2>Modelová kavárna, čtyři pokladny. <em>Software a platby kartou.</em></h2>
      <p class="comparison-date">Stav srovnání: 1. 10. 2026. Ceny a podmínky se mohou měnit.</p>
      <p class="lead">Modelové srovnání k 1. 10. 2026: jedna provozovna, 100 000 Kč měsíčně v kartách, průměrná účtenka 250 Kč (400 plateb). Vybrané tarify se skladem a mapou stolů; běžné spotřebitelské karty. Software a odhad karetních poplatků, bez DPH a hardwaru. Pro jiný provoz může vyjít levněji jiný systém.</p>
    </div>

    <div class="scen-tabs" role="tablist">
      <button type="button" role="tab" data-months="1" class="is-on">Měsíčně</button>
      <button type="button" role="tab" data-months="12">Za 12 stejných měsíců</button>
    </div>
    <div class="bars" id="bars"><div class="bar is-hugo"><span class="nm">Hugo</span><span class="track"><span class="fill" style="display:block;width:63.3%"></span></span><span class="amt">1&nbsp;690&nbsp;Kč</span></div><div class="bar"><span class="nm">Dotykačka</span><span class="track"><span class="fill" style="display:block;width:82.5%"></span></span><span class="amt">2&nbsp;200&nbsp;Kč</span></div><div class="bar"><span class="nm">KASA FIK</span><span class="track"><span class="fill" style="display:block;width:97.9%"></span></span><span class="amt">2&nbsp;612&nbsp;Kč</span></div><div class="bar"><span class="nm">SumUp</span><span class="track"><span class="fill" style="display:block;width:100.0%"></span></span><span class="amt">2&nbsp;668&nbsp;Kč</span></div></div>

    <div class="tbl-wrap" style="margin-top:28px;">
      <table class="tbl" style="min-width:640px;">
        <thead>
          <tr>
            <th scope="col">Pokladna</th>
            <th scope="col">Tarif</th>
            <th scope="col">Licence / měs.</th>
            <th scope="col">Nejlevnější zařízení</th>
            <th scope="col">Poplatek za kartu</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row" class="is-hugo">Hugo</th><td class="is-hugo">jeden tarif</td><td class="is-hugo">190 Kč</td><td class="is-hugo">tvůj Android 0 Kč<small>terminál Hugo 4 900 Kč</small></td><td class="is-hugo">1,1 %<small>+ MIF++</small></td></tr>
          <tr><th scope="row">KASA FIK</th><td>PREMIUM</td><td>721,65 Kč<small>při roční platbě</small></td><td>3 499 Kč<small>ORANGE 4G</small></td><td>1,49 % + MIF++<small>prémioví klienti od 0,69 %</small></td></tr>
          <tr><th scope="row">Dotykačka</th><td>NAPLNO</td><td>910 Kč<small>při roční platbě a obratu 60–120 tis.</small></td><td>6 990 Kč<small>Payment 5,5" 3in1 PRO</small></td><td>0,89 % + MIF++<small>Dotypay</small></td></tr>
          <tr><th scope="row">SumUp</th><td>POS Plus</td><td>1 199 Kč</td><td>9 599 Kč<small>Pokladna SumUp</small></td><td>1,95 % vč. všeho<small>0,95 % s Platby Plus (519 Kč/měs.)</small></td></tr>
        </tbody>
      </table>
    </div>

    <p class="note">Výpočet: měsíční licence + případné předplatné plateb + procentní poplatky z obratu 100 000 Kč. Hugo: 190 + 1 100 + odhad 400 = <b>1 690 Kč/měsíc</b>. Dotykačka: 910 + 890 + odhad 400 = 2 200 Kč; KASA FIK: 721,65 + 1 490 + odhad 400 = 2 611,65 Kč; SumUp: POS Plus 1 199 + Platby Plus 519 + 950 = 2 668 Kč. Graf zaokrouhluje na celé koruny; roční pohled násobí nezaokrouhlený měsíční model dvanácti, nepředpovídá budoucí ceny. <a href="#metodika">Předpoklady, omezení a zdroje</a>.</p>
  </div>
</section>

<section class="sec">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Zkus to 14 dní. <em>Za nula korun.</em></h2>
        <p>Bez karty na start, prodáváš za 5 minut. A když ti Hugo nesedne, vrátíme peníze.</p>
      </div>
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Začít zdarma</a>
    </div>
  </div>
</section>

<section class="sec comparison-methodology" id="metodika" aria-labelledby="methodology-title">
  <div class="container">
    <div class="sec-head"><h2 id="methodology-title">Jak jsme to spočítali.</h2></div>
    <p class="comparison-intro">Náš právník slíbil jednu krátkou poznámku. Výsledek vidíš níž. A teď lidsky: každá hospoda má jiné účty. Proto ukazujeme, s čím jsme počítali, odkud máme ceny a co v součtu není. Ať si můžeš přepočítat svůj provoz – klidně ti vyjde líp někdo jiný. Ceníky se mění, tak je každý měsíc kontrolujeme.</p>
    <p><b>Rozsah a zdroje.</b> <a href="/srovnani/#tabulka">Tabulka šesti systémů</a> srovnává vybrané měsíční paušály a gastro funkce podle oficiálních veřejných ceníků a produktových stránek k 1. 10. 2026. Balíčky nejsou totožné a tabulka nepokrývá celý trh. „Nenalezeno“ znamená, že údaj nebyl v podkladech pro toto srovnání nalezen; není to tvrzení, že dodavatel službu nenabízí nebo že cena nemůže být výhodnější.</p>
    <p><b>Model, nikoli nabídka pro každý podnik.</b> <a href="/cenik/#srovnani">Modelová kavárna</a> počítá s jednou provozovnou, obratem 100 000 Kč měsíčně v kartách a 400 platbami po 250 Kč. Zahrnuje software a odhad poplatků za běžné spotřebitelské karty. Licence Dotykačky a KASA FIK jsou přepočtené z roční platby; SumUp POS Plus a Platby Plus jsou placené měsíčně. Nejde o nejlevnější možnou kombinaci všech nabídek. Hardware, další zařízení, individuální slevy, doplňky, zaváděcí akce a DPH do součtů nepatří. Roční pohled je 12 stejných měsíců, bez předpovědi cen.</p>
    <p><b>Karty a MIF++.</b> Hugo účtuje 1,1 % bez pevného příplatku za transakci, navíc mezibankovní a asociační poplatky beze změny. V modelu pro Hugo, Dotypay a KASA PAY odhadujeme tyto dvě složky společně na 0,4 % obratu; nejde o garantovanou sazbu. SumUp má souhrnnou sazbu (blended); model používá 0,95 % s Platby Plus za 519 Kč měsíčně pro příslušné spotřebitelské karty. U jiných karet či online plateb mohou platit jiné sazby. Skutečný výsledek závisí na obratu, skladbě karet a smlouvě.</p>
    <p><b>Kdy může vyjít lépe jiná varianta?</b> Pokud nepotřebuješ sklad a mapu stolů, základní aplikace SumUp má podle podkladů k 1. 10. 2026 paušál 0 Kč a sazbu 1,95 % za osobní platby. Při nízkém obratu může vyjít levněji než placený gastro tarif. Výsledek mohou změnit také roční předplatné, individuální nabídka nebo hardware, který už vlastníš. Proto z modelu nelze dovodit nejnižší cenu pro každého zákazníka.</p>
    <p><b>Kontroly a opravy.</b> Veřejné podklady kontrolujeme na měsíční bázi. Datum stavu měníme až po ověření srovnávaných údajů; nejde o živý ceník dodavatelů. Před rozhodnutím si ověř aktuální nabídku přímo u nich. Našel jsi změnu nebo zastupuješ některý ze systémů? Napiš na <a href="mailto:hugo@piano.cz">hugo@piano.cz</a> s odkazem na podklad. Podnět ověříme a případnou nepřesnost opravíme.</p>
    <h3>Oficiální zdroje pro ověření aktuální nabídky</h3>
    <ul class="comparison-sources">
      <li><a href="https://dotykacka.cz/cenik/">Dotykačka / Dotypay</a></li>
      <li><a href="https://www.storyous.com/cs/faq">Storyous / Teya</a></li>
      <li><a href="https://www.kasafik.cz/web/cs/cenik/">KASA FIK</a></li>
      <li><a href="https://kilomayo.com/">KiloMayo</a></li>
      <li><a href="https://www.sumup.com/cs-cz/ceny/">SumUp</a></li>
    </ul>
  </div>
</section>
</main>

<footer class="foot">
  <div class="container foot-in">
    <div>&copy; 2026 Hugo &middot; <span>český produkt od Piano</span> &middot; <a href="mailto:hugo@piano.cz">hugo@piano.cz</a></div>
    <div class="links">
      <a href="/">Domů</a>
      <a href="/srovnani/">Srovnání</a>
      <a href="/vseobecne-obchodni-podminky/">Obchodní podmínky</a>
      <a href="https://piano.cz/gdpr/" target="_blank" rel="noopener">GDPR</a>
    </div>
  </div>
</footer>

<script is:inline>
  /* Fixed scenario (owner decision, HUGO-1828): 100 000 Kč card turnover / month, 250 Kč average bill
     = 400 payments, MIF++ pass-through estimated at 0,4 % for the MIF++ providers. Software + card fees,
     excl. VAT, prices as of 2026-10-01. Same figures as the internal calculator. */
  (function () {
    var T = 100000, MIF = 0.004;
    var ROWS = [
      { n: 'Hugo', hugo: true, sw: 190, card: 0.011 * T + MIF * T },
      { n: 'Dotykačka', sw: 910, card: 0.0089 * T + MIF * T },
      { n: 'KASA FIK', sw: 721.65, card: 0.0149 * T + MIF * T },
      { n: 'SumUp', sw: 1199 + 519, card: 0.0095 * T }
    ];
    var months = 1;
    var box = document.getElementById('bars');
    function kc(v) { return Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0') + '\u00a0Kč'; }
    function render() {
      var data = ROWS.map(function (r) { return { r: r, t: (r.sw + r.card) * months }; });
      var max = Math.max.apply(null, data.map(function (d) { return d.t; }));
      box.innerHTML = data.map(function (d) {
        return '<div class="bar' + (d.r.hugo ? ' is-hugo' : '') + '"><span class="nm">' + d.r.n + '</span>'
          + '<span class="track"><span class="fill" style="display:block;width:' + Math.max(3, d.t / max * 100).toFixed(1) + '%"></span></span>'
          + '<span class="amt">' + kc(d.t) + '</span></div>';
      }).join('');
    }
    document.querySelector('.scen-tabs').addEventListener('click', function (e) {
      var b = e.target.closest('button[data-months]');
      if (!b) return;
      months = +b.dataset.months;
      document.querySelectorAll('.scen-tabs button').forEach(function (x) { x.classList.toggle('is-on', x === b); });
      render();
    });
    render();
  })();
</script>
</Base>
