  ogDescription={"Pokladna, co se vejde do kapsy. Objednávky, karty, spropitné a účtenky v jedné appce. Spustíš ji za 5 minut."}
  image={"/assets/og/og-cs.png"}
  imageAlt={"Pokladna do mobilu pro stánky, food trucky a kavárny | Hugo"}
  alternates={{ cs: '/', en: '/en/' }}
  htmlAttrs={{"data-ab-home": ""}}
  schemas={[{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://hugopos.eu/#organization", "name": "Hugo", "url": "https://hugopos.eu/", "logo": "https://hugopos.eu/assets/og/hugo-logo-512.png", "email": "hugo@piano.cz", "sameAs": ["https://www.linkedin.com/showcase/hugopos/", "https://www.facebook.com/jsemhugopos", "https://www.instagram.com/jsem_hugo_pos/"], "parentOrganization": {"@type": "Organization", "name": "Piano Solutions s.r.o.", "identifier": "19780974"}}, {"@type": "WebSite", "@id": "https://hugopos.eu/#website", "url": "https://hugopos.eu/", "name": "Hugo", "inLanguage": ["cs", "en"], "publisher": {"@id": "https://hugopos.eu/#organization"}}, {"@type": "SoftwareApplication", "name": "Hugo", "url": "https://hugopos.eu/", "inLanguage": "cs", "applicationCategory": "BusinessApplication", "applicationSubCategory": "Point of sale", "operatingSystem": "iOS, Android", "publisher": {"@id": "https://hugopos.eu/#organization"}, "offers": {"@type": "Offer", "url": "https://hugopos.eu/cenik/", "description": "190 Kč měsíčně bez DPH, když platby kartou přijímáš přes Hugo; karty 1,1 % (MIF++).", "price": "190", "priceCurrency": "CZK", "priceSpecification": {"@type": "UnitPriceSpecification", "price": "190", "priceCurrency": "CZK", "valueAddedTaxIncluded": false, "unitCode": "MON"}}}]}]}
>
<Fragment slot="head">
