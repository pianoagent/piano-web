            <td>425–502 Kč<small>SNADNO při roční platbě; čím větší obrat přes Dotypay, tím levnější</small></td>
            <td>cenu ověř u dodavatele<small>veřejný ceník jsme k 1. 10. 2026 nenašli</small></td>
            <td>297 Kč<small>LITE, max. 60 položek</small></td>
            <td>cenu ověř u dodavatele<small>veřejný ceník jsme k 1. 10. 2026 nenašli</small></td>
            <td>0 Kč<small>základní aplikace</small></td>
          </tr>
          <tr>
            <th scope="row">Tarif se skladem a mapou stolů</th>
            <td class="is-hugo">190 Kč<small>pořád ten samý tarif</small></td>
            <td>858,50–1 012 Kč<small>NAPLNO při roční platbě, podle obratu kartou</small></td>
            <td>ověř u dodavatele<small>údaj v podkladech k 1. 10. 2026 neuveden</small></td>
            <td>849 Kč<small>PREMIUM; při roční platbě 721,65 Kč</small></td>
            <td>ověř u dodavatele<small>údaj v podkladech k 1. 10. 2026 neuveden</small></td>
            <td>1 199 Kč<small>POS Plus (mapa stolů)</small></td>
          </tr>
          <tr>
