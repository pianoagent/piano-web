---
// Děkovací stránka po odeslání formuláře „Ozvi se mi“ (konverze v GTM = pageview /dekujeme).
// Hlavička a patička z podstránek živého hugopos.eu, generuje port-hugo.py.
import Base from '../../layouts/Base.astro';
import '../../styles/sub.css';
import hugoAbUrl from '../../scripts/hugo-ab.js?url';
import hugoI18nUrl from '../../scripts/hugo-i18n.js?url';
import hugoNavUrl from '../../scripts/hugo-nav.js?url';
---
<Base title={"Thanks, we'll be in touch soon"} lang="en" noindex>
<Fragment slot="head">
<script is:inline src={hugoAbUrl}></script>
<script is:inline src={hugoI18nUrl} defer></script>
<script is:inline src={hugoNavUrl} defer></script>
</Fragment>
<header class="nav">
  <div class="container nav-inner">
    <a href="/en/" class="brand"><img src="/assets/hugo-icon.svg" alt="" /><span>Hugo</span></a>
    
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Menu"><span></span><span></span><span></span></button>
    <nav class="nav-links" id="navLinks">
      <a href="/en/#product">Product</a>
      <a href="/en/getting-started/">How to start</a>
      <a href="/en/compare/">Compare</a>
      <a href="/en/pricing/">Pricing</a>
      <a href="/en/#reference">Customers</a>
    </nav>
    <div class="nav-cta">
      <div class="lang" id="langToggle"><a href="/dekujeme/" hreflang="cs" lang="cs" data-lang-link>CZ</a><a href="/en/dekujeme/" hreflang="en" lang="en" data-lang-link class="is-on" aria-current="true">EN</a></div>
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary">Start free</a>
    </div>
  </div>
</header>

<main>
<section class="phero">
  <div class="container phero-grid">
    <div class="phero-text">
    <span class="eyebrow">Done</span>
    <h1>Thanks, <span class="hl">we'll be in touch soon.</span></h1>
    <p class="lead">Someone from the Hugo team will get in touch. Want to start right away? Download the app.</p>
    <p><a href="/en/">Back to the homepage</a></p>
    </div>
    <div class="ctas">
      <a href="https://apps.apple.com/cz/app/hugo-pos/id6766202332" target="_blank" rel="noopener" class="btn btn-primary btn-lg">App Store</a>
      <a href="https://play.google.com/store/apps/details?id=com.piano.hugo" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">Google Play</a>
    </div>
  </div>
</section>
</main>

<footer class="foot">
  <div class="container foot-in">
    <div>&copy; 2026 Hugo &middot; <span>a Czech product by Piano</span> &middot; <a href="mailto:hugo@piano.cz">hugo@piano.cz</a></div>
    <div class="links">
      <a href="/en/">Home</a>
      <a href="/en/compare/">Compare</a>
      <a href="/vseobecne-obchodni-podminky/">Terms & conditions</a>
      <a href="https://piano.cz/gdpr/" target="_blank" rel="noopener">GDPR</a>
    </div>
  </div>
</footer>
</Base>
