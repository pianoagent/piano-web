---
// https://hugopos.eu/en/pricing/, port 1:1 skriptem port-hugo.py (scrape 13. 10. 2026)
import Base from '../../layouts/Base.astro';
import hugoAbUrl from '../../scripts/hugo-ab.js?url';
import '../../styles/sub.css';
import hugoI18nUrl from '../../scripts/hugo-i18n.js?url';
import hugoNavUrl from '../../scripts/hugo-nav.js?url';
---
<Base
  title={"Pricing: 190 Kč a month, everything included"}
  lang={"en"}
  description={"Hugo pricing: 190 Kč a month excl. VAT, cards 1,1 % (MIF++), terminal 4 900 Kč or your own phone for free. No notice period, 14 days free. Cost comparison with Dotykačka, KASA FIK and SumUp."}
  ogDescription={"One plan, every price on one page and a comparison with other tills."}
  image={"/assets/og/og-en.png"}
  imageAlt={"Pricing: 190 Kč a month, everything included | Hugo"}
  alternates={{ cs: '/cenik/', en: '/en/pricing/' }}
>
<Fragment slot="head">
<script is:inline src={hugoAbUrl}></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<script is:inline src={hugoI18nUrl} defer></script>
<script is:inline src={hugoNavUrl} defer></script>
</Fragment>
<header class="nav">
  <div class="container nav-inner">
    <a href="/en/" class="brand"><img src="/assets/hugo-icon.svg" alt="" /><span>Hugo</span></a>
    
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Menu"><span></span><span></span><span></span></button>
    <nav class="nav-links" id="navLinks">
      <a href="/en/#product">Product</a>
      <a href="/en/getting-started/">How to start</a>
      <a href="/en/compare/">Compare</a>
      <a href="/en/pricing/" class="is-on">Pricing</a>
      <a href="/en/#reference">Customers</a>
    </nav>
    <div class="nav-cta">
      <div class="lang" id="langToggle"><a href="/cenik/" hreflang="cs" lang="cs" data-lang-link>CZ</a><a href="/en/pricing/" hreflang="en" lang="en" data-lang-link class="is-on" aria-current="true">EN</a></div>
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary">Start free</a>
    </div>
  </div>
</header>

<main>
<section class="phero phero-art">
  <div class="container phero-grid">
    <div class="phero-text">
    <span class="eyebrow">Pricing</span>
    <h1>190 Kč a month. <span class="hl">That’s the whole price list.</span></h1>
    <p class="lead">One plan for a food truck and a full restaurant. No tiers, no turnover bands, no “we’ll send you an offer”. Everything is below – including what other tills charge.</p>
    </div>
    <div class="ctas">
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Start 14 days free</a>
      <a href="#srovnani" class="btn btn-ghost btn-lg">Compare with others</a>
    </div>
    <img class="phero-img" src="/assets/cenik-barista.png" alt="" width="480" height="954" decoding="async" />
  </div>
</section>

<section class="sec" id="cenik">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Hugo price list</span>
      <h2>Everything you could pay us. <em>One table.</em></h2>
    </div>
    <div class="ptable" role="table" aria-label="Hugo pricing">
      <div class="prow head" role="row"><div role="columnheader">What</div><div role="columnheader">Price (excl. VAT)</div></div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Hugo POS – everything included</b><span>Orders, menu, stock, shifts, reports, VAT and receipts. When you take card payments with us.</span></div>
        <div class="v" role="cell"><span>190 Kč / month</span></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Card payment – our fee</b><span>The same at any revenue. Money in your account within 2 days, no bank change.</span></div>
        <div class="v" role="cell">1,1 %<small>per card payment</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Bank & card-scheme fees (MIF++)</b><span>We don’t set or keep them – they pass through at cost. EEA consumer cards are capped by EU law.</span></div>
        <div class="v" role="cell">at cost<small>interchange max. 0,2 % debit / 0,3 % credit</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>The phone or tablet you already own</b><span>Hugo on iOS and Android. Card payments on Android.</span></div>
        <div class="v" role="cell">0 Kč</div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Hugo all-in-one terminal</b><span>Card terminal, receipt printer and Hugo in one box. One-off.</span></div>
        <div class="v" role="cell">4 900 Kč<small>one-off; a 5 000 Kč tax bonus is being prepared</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Devices, staff, menu items</b><span>Add a tablet to the bar or a phone for every waiter.</span></div>
        <div class="v" role="cell">unlimited<small>no per-device fee</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Switching from another till</b><span>We import your menu; both tills run side by side until you switch.</span></div>
        <div class="v" role="cell">0 Kč<small>migration is free</small></div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Notice period</b><span>Cancel any time, no extra paid months.</span></div>
        <div class="v" role="cell">none</div>
      </div>
      <div class="prow" role="row">
        <div class="k" role="cell"><b>Trial</b><span>Not happy? We refund you. No forms, no interrogation.</span></div>
        <div class="v" role="cell">14 days free</div>
      </div>
    </div>
    <p class="note">All prices and fees excl. VAT. Card rates differ by card type; meal-voucher, AMEX and Diners cards carry an extra fee. <a href="/en/#mif" style="text-decoration:underline">What exactly is MIF++?</a></p>
  </div>
</section>

<section class="sec sec-alt" id="srovnani">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Hugo vs. other tills</span>
      <h2>A model café, four tills. <em>Software and card payments.</em></h2>
      <p class="comparison-date">Comparison as of 1 October 2026. Prices and terms may change.</p>
      <p class="lead">Model comparison as of 1 October 2026: one venue, 100 000 Kč a month in card payments, 250 Kč average bill (400 payments). Selected plans with stock and a table map; standard consumer cards. Software and estimated card fees, excluding VAT and hardware. A different system may cost less for a different venue.</p>
    </div>

    <div class="scen-tabs" role="tablist">
      <button type="button" role="tab" data-months="1" class="is-on">Per month</button>
      <button type="button" role="tab" data-months="12">For 12 identical months</button>
    </div>
    <div class="bars" id="bars"><div class="bar is-hugo"><span class="nm">Hugo</span><span class="track"><span class="fill" style="display:block;width:63.3%"></span></span><span class="amt">1&nbsp;690&nbsp;Kč</span></div><div class="bar"><span class="nm">Dotykačka</span><span class="track"><span class="fill" style="display:block;width:82.5%"></span></span><span class="amt">2&nbsp;200&nbsp;Kč</span></div><div class="bar"><span class="nm">KASA FIK</span><span class="track"><span class="fill" style="display:block;width:97.9%"></span></span><span class="amt">2&nbsp;612&nbsp;Kč</span></div><div class="bar"><span class="nm">SumUp</span><span class="track"><span class="fill" style="display:block;width:100.0%"></span></span><span class="amt">2&nbsp;668&nbsp;Kč</span></div></div>

    <div class="tbl-wrap" style="margin-top:28px;">
      <table class="tbl" style="min-width:640px;">
        <thead>
          <tr>
            <th scope="col">Till</th>
            <th scope="col">Plan</th>
            <th scope="col">Licence / month</th>
            <th scope="col">Cheapest device</th>
            <th scope="col">Card fee</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row" class="is-hugo">Hugo</th><td class="is-hugo">one plan</td><td class="is-hugo">190 Kč</td><td class="is-hugo">your Android 0 Kč<small>Hugo terminal 4 900 Kč</small></td><td class="is-hugo">1,1 %<small>+ MIF++</small></td></tr>
          <tr><th scope="row">KASA FIK</th><td>PREMIUM</td><td>721,65 Kč<small>billed annually</small></td><td>3 499 Kč<small>ORANGE 4G</small></td><td>1,49 % + MIF++<small>premium clients from 0,69 %</small></td></tr>
          <tr><th scope="row">Dotykačka</th><td>NAPLNO</td><td>910 Kč<small>billed annually, 60–120k card turnover</small></td><td>6 990 Kč<small>Payment 5,5" 3in1 PRO</small></td><td>0,89 % + MIF++<small>Dotypay</small></td></tr>
          <tr><th scope="row">SumUp</th><td>POS Plus</td><td>1 199 Kč</td><td>9 599 Kč<small>SumUp till</small></td><td>1,95 % all-in<small>0,95 % with Platby Plus (519 Kč/month)</small></td></tr>
        </tbody>
      </table>
    </div>

    <p class="note">Calculation: monthly licence + any payments subscription + percentage fees on 100 000 Kč card turnover. Hugo: 190 + 1 100 + estimated 400 = <b>1 690 Kč/month</b>. Dotykačka: 910 + 890 + estimated 400 = 2 200 Kč; KASA FIK: 721,65 + 1 490 + estimated 400 = 2 611,65 Kč; SumUp: POS Plus 1 199 + Payments Plus 519 + 950 = 2 668 Kč. The chart rounds to whole crowns; the annual view multiplies the unrounded monthly model by twelve, not a forecast of future prices. <a href="#metodika">Assumptions, limitations and sources</a>.</p>
  </div>
</section>

<section class="sec">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Try it for 14 days. <em>Pay nothing.</em></h2>
        <p>No card to start, live in 5 minutes. And if Hugo isn’t for you, we give your money back.</p>
      </div>
      <a href="https://admin.hugopos.eu/login?start=1" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Start free</a>
    </div>
  </div>
</section>

<section class="sec comparison-methodology" id="metodika" aria-labelledby="methodology-title">
  <div class="container">
    <div class="sec-head"><h2 id="methodology-title">How we did the maths.</h2></div>
    <p class="comparison-intro">Our lawyer promised one short note. You can see how that went below. In plain English: every venue has different bills. So we show our assumptions, where the prices come from and what the totals leave out. Run the numbers for your own place – another provider might work out cheaper. Prices change, so we check them every month.</p>
    <p><b>Scope and sources.</b> The <a href="/en/compare/#tabulka">six-system table</a> compares selected monthly subscriptions and hospitality features using official public price lists and product pages as of 1 October 2026. Packages are not identical and the table does not cover the whole market. “Not found” means the information was not found in the sources used for this comparison; it does not mean the provider lacks the service or cannot offer a better price.</p>
    <p><b>A model, not a quote for every business.</b> The <a href="/en/pricing/#srovnani">model café</a> has one venue, 100 000 Kč monthly card turnover and 400 payments of 250 Kč. It includes software and estimated fees for standard consumer cards. Dotykačka and KASA FIK licences are monthly equivalents of annual billing; SumUp POS Plus and Payments Plus use monthly billing. This is not the cheapest possible combination of every offer. Totals exclude hardware, extra devices, individual discounts, add-ons, introductory offers and VAT. The annual view is twelve identical months, not a price forecast.</p>
    <p><b>Cards and MIF++.</b> Hugo charges 1,1 % with no fixed per-transaction surcharge, plus interchange and scheme fees passed through at cost. For Hugo, Dotypay and KASA PAY, the model estimates these two components together at 0,4 % of turnover; this is not a guaranteed rate. SumUp uses a blended rate; the model uses 0,95 % with Payments Plus at 519 Kč per month for eligible consumer cards. Other cards or online payments may carry different rates. Actual costs depend on turnover, card mix and contract terms.</p>
    <p><b>When might another option cost less?</b> If you do not need stock and a table map, SumUp’s basic app has a 0 Kč subscription and a 1,95 % card-present rate in the sources as of 1 October 2026. At low turnover it may cost less than a paid hospitality plan. Annual subscriptions, individual offers or hardware you already own may also change the result. The model therefore does not establish the lowest price for every customer.</p>
    <p><b>Checks and corrections.</b> We review public sources monthly. We change the comparison date only after verifying the compared information; this is not a live supplier price list. Check the provider’s current offer before deciding. Found a change, or represent one of the systems? Email <a href="mailto:hugo@piano.cz">hugo@piano.cz</a> with a source link. We will verify it and correct any inaccuracy.</p>
    <h3>Official sources for checking current offers</h3>
    <ul class="comparison-sources">
      <li><a href="https://dotykacka.cz/cenik/">Dotykačka / Dotypay</a></li>
      <li><a href="https://www.storyous.com/cs/faq">Storyous / Teya</a></li>
      <li><a href="https://www.kasafik.cz/web/cs/cenik/">KASA FIK</a></li>
      <li><a href="https://kilomayo.com/">KiloMayo</a></li>
      <li><a href="https://www.sumup.com/cs-cz/ceny/">SumUp</a></li>
    </ul>
  </div>
</section>
</main>

<footer class="foot">
  <div class="container foot-in">
    <div>&copy; 2026 Hugo &middot; <span>a Czech product by Piano</span> &middot; <a href="mailto:hugo@piano.cz">hugo@piano.cz</a></div>
    <div class="links">
      <a href="/en/">Home</a>
      <a href="/en/compare/">Compare</a>
      <a href="/vseobecne-obchodni-podminky/">Terms & conditions</a>
      <a href="https://piano.cz/gdpr/" target="_blank" rel="noopener">GDPR</a>
    </div>
  </div>
</footer>

<script is:inline>
  /* Fixed scenario (owner decision, HUGO-1828): 100 000 Kč card turnover / month, 250 Kč average bill
     = 400 payments, MIF++ pass-through estimated at 0,4 % for the MIF++ providers. Software + card fees,
     excl. VAT, prices as of 2026-10-01. Same figures as the internal calculator. */
  (function () {
    var T = 100000, MIF = 0.004;
    var ROWS = [
      { n: 'Hugo', hugo: true, sw: 190, card: 0.011 * T + MIF * T },
      { n: 'Dotykačka', sw: 910, card: 0.0089 * T + MIF * T },
      { n: 'KASA FIK', sw: 721.65, card: 0.0149 * T + MIF * T },
      { n: 'SumUp', sw: 1199 + 519, card: 0.0095 * T }
    ];
    var months = 1;
    var box = document.getElementById('bars');
    function kc(v) { return Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0') + '\u00a0Kč'; }
    function render() {
      var data = ROWS.map(function (r) { return { r: r, t: (r.sw + r.card) * months }; });
      var max = Math.max.apply(null, data.map(function (d) { return d.t; }));
      box.innerHTML = data.map(function (d) {
        return '<div class="bar' + (d.r.hugo ? ' is-hugo' : '') + '"><span class="nm">' + d.r.n + '</span>'
          + '<span class="track"><span class="fill" style="display:block;width:' + Math.max(3, d.t / max * 100).toFixed(1) + '%"></span></span>'
          + '<span class="amt">' + kc(d.t) + '</span></div>';
      }).join('');
    }
    document.querySelector('.scen-tabs').addEventListener('click', function (e) {
      var b = e.target.closest('button[data-months]');
      if (!b) return;
      months = +b.dataset.months;
      document.querySelectorAll('.scen-tabs button').forEach(function (x) { x.classList.toggle('is-on', x === b); });
      render();
    });
    render();
  })();
</script>
</Base>
