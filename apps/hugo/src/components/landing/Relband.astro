---
/* Relband: sekce landing page Hugo, port 1:1 z hugopos.eu. Texty jsou v src/i18n/landing.ts. */
import type { Lang } from '../../i18n/landing';
import { dict } from '../../i18n/landing';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
---
<section class="relband">
  <div class="container">
    <div class="section-head" style="margin-bottom: 32px;">
      <span class="eyebrow" set:html={t['relband-section-head-eyebrow']}></span>
      <h2 set:html={t['relband-section-head-h2']}></h2>
    </div>
    <div class="rel-grid">
      <div class="rel-item">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l22 22"></path><path d="M16.7 11.7A6 6 0 0 1 19 13M5 13a6 6 0 0 1 4-1.7M8.5 16.5a2.5 2.5 0 0 1 3 0"></path><path d="M12 20h.01"></path></svg></span>
        <h4 set:html={t['rel-item-h4-0']}></h4>
        <p set:html={t['rel-item-p-0']}></p>
      </div>
      <div class="rel-item">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="12" height="7" rx="1"></rect><path d="M6 9V4h12v5"></path><path d="M6 16h12v4H6z"></path><path d="M9 13h.01"></path></svg></span>
        <h4 set:html={t['rel-item-h4-1']}></h4>
        <p set:html={t['rel-item-p-1']}></p>
      </div>
      <div class="rel-item">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="3"></rect><path d="M9 6h6"></path><circle cx="12" cy="16" r="2"></circle></svg></span>
        <h4 set:html={t['rel-item-h4-2']}></h4>
        <p set:html={t['rel-item-p-2']}></p>
      </div>
      <div class="rel-item">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="M8 11l4 4 4-4"></path><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path></svg></span>
        <h4 set:html={t['rel-item-h4-3']}></h4>
        <p set:html={t['rel-item-p-3']}></p>
      </div>
    </div>
  </div>
</section>
