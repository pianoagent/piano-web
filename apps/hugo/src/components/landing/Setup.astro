---
/* Setup: sekce landing page Hugo, port 1:1 z hugopos.eu. Texty jsou v src/i18n/landing.ts. */
import type { Lang } from '../../i18n/landing';
import { dict } from '../../i18n/landing';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
---
<section id="setup" class="setup">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" set:html={t['setup-section-head-eyebrow']}></span>
      <h2 set:html={t['setup-section-head-h2']}></h2>
      <p class="lead" set:html={t['setup-section-head-p-lead']}></p>
    </div>

    <div class="setup-grid">
      <!-- TAP -->
      <div class="setup-card">
        <div class="num">1</div>
        <h3 set:html={t['setup-card-h3-0']}></h3>
        <p set:html={t['setup-card-p-0']}></p>
        <div class="setup-art tap-art">
          <div class="tap-card">Pivo Plzeň 0,5 l<br><span style="font-weight:500; font-size:13px;">79 Kč</span></div>
          <div class="tap-card small">Smažený sýr · 189 Kč</div>
          <div class="tap-finger">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11V5a2 2 0 1 1 4 0v6"></path><path d="M13 11h4a3 3 0 0 1 3 3v4a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4v-3"></path></svg>
          </div>
        </div>
      </div>

      <!-- TALK -->
      <div class="setup-card">
        <div class="num">2</div>
        <h3 set:html={t['setup-card-h3-1']}></h3>
        <p set:html={t['setup-card-p-1']}></p>
        <div class="setup-art talk-art">
          <div class="bubble user" set:html={t['bubble-user']}></div>
          <div class="bubble ai" set:html={t['bubble-ai']}></div>
        </div>
      </div>

      <!-- AUTO -->
      <div class="setup-card">
        <div class="num">3</div>
        <h3 set:html={t['setup-card-h3-2']}></h3>
        <p set:html={t['setup-card-p-2']}></p>
        <div class="setup-art auto-art">
          <div class="auto-row">
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
            <span class="name" set:html={t['auto-art-auto-row-name-0']}></span><span class="meta" set:html={t['auto-art-auto-row-meta-0']}></span>
          </div>
          <div class="auto-row">
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
            <span class="name" set:html={t['auto-art-auto-row-name-1']}></span><span class="meta" set:html={t['auto-art-auto-row-meta-1']}></span>
          </div>
          <div class="auto-row">
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
            <span class="name" set:html={t['auto-art-auto-row-name-2']}></span><span class="meta" set:html={t['auto-art-auto-row-meta-2']}></span>
          </div>
          <div class="auto-row pending">
            <span class="check"></span>
            <span class="name" set:html={t['auto-art-auto-row-name-3']}></span><span class="meta" set:html={t['auto-art-auto-row-meta-3']}></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
