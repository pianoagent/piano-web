---
/* Waitlist: sekce landing page Hugo, port 1:1 z hugopos.eu. Texty jsou v src/i18n/landing.ts. */
import type { Lang } from '../../i18n/landing';
import { dict } from '../../i18n/landing';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
---
<section class="waitlist" id="waitlist" hidden="">
  <div class="container">
    <div class="waitlist-grid">
      <div class="waitlist-copy">
        <span class="eyebrow" set:html={t['waitlist-eyebrow']}></span>
        <h2 set:html={t['waitlist-h2']}></h2>
        <p class="lead" set:html={t['waitlist-lead']}></p>
        <ul class="waitlist-perks">
          <li set:html={t['waitlist-perks-li-0']}></li>
          <li set:html={t['waitlist-perks-li-1']}></li>
          <li set:html={t['waitlist-perks-li-2']}></li>
        </ul>
      </div>

      <form class="waitlist-form" id="waitlistForm" action="/api/lead.php" method="post"><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <input type="hidden" name="form_variant" value="hugo-waitlist" />
        <input type="hidden" name="lang" value={lang} />
        <span class="waitlist-counter" set:html={t['waitlist-counter']}></span>
        <h3 set:html={t['waitlist-form-h3']}></h3>
        <p set:html={t['waitlist-form-h3-p']}></p>
        <div class="waitlist-fields">
          <input type="email" required="" placeholder={t['ph-waitlist-fields-input-0']} name="email" autocomplete="email">
          <input type="text" placeholder={t['ph-waitlist-fields-input-1']} name="name" autocomplete="name">
          <button class="btn" type="submit" set:html={t['waitlist-fields-button-btn']}></button>
        </div>
        <div class="form-alt">
          <span class="form-alt-or" set:html={t['form-alt-or']}></span>
          <div class="store-badges">
            <a href="https://apps.apple.com/cz/app/hugo-pos/id6766202332" target="_blank" rel="noopener" class="store-badge"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.6c0-2.6 2.1-3.9 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.2-.5 7.9 1.3 10.4.9 1.2 1.9 2.6 3.3 2.5 1.3 0 1.8-.8 3.4-.8 1.6 0 2.1.8 3.4.8 1.4 0 2.3-1.3 3.2-2.5.9-1.2 1.3-2.4 1.3-2.5-.1 0-2.9-1.1-2.9-4.6zM13.9 4.6c.7-.9 1.2-2.1 1.1-3.3-1 .1-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3-1.5z"></path></svg> App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.piano.hugo" target="_blank" rel="noopener" class="store-badge"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3l14 9-14 9V3z"></path></svg> Google Play</a>
          </div>
        </div>
        <div class="waitlist-spots">
          <span class="spots-label" style="margin:0 auto;" set:html={t['waitlist-spots-spots-label']}></span>
        </div>
        <p class="waitlist-fineprint" set:html={t['waitlist-fineprint']}></p>
        <p class="form-call" set:html={t['form-call']}></p>
      </form>
    </div>
  </div>
</section>
