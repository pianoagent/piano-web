---
/**
 * Base: layout webu Hugo (hugopos.eu).
 * Hlavička 1:1 se živým webem: Spline Sans + Inter, GTM (Cookiebot se načítá přes GTM),
 * přesměrování hugopos.cz → hugopos.eu. SEO meta a JSON-LD dodává sdílený BaseHead.
 * Styl si načítá každá stránka sama (landing: styles/hugo.css, VOP: styles/vop.css).
 */
import BaseHead from '@piano/ui/layouts/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: 'cs' | 'en';
  noindex?: boolean;
  /** cesty jazykových mutací stránky, např. { cs: '/', en: '/en/' } */
  alternates?: { cs: string; en: string };
}

const SITE_NAME = 'Hugo';
const SITE_URL = 'https://hugopos.eu';

const {
  title,
  description = 'Hugo je pokladna pro kavárny, bary a restaurace. Objednávky, menu, spropitné i účtenky v jedné appce na zařízení, které už máš. Kartu přijmeš na Androidu nebo na terminálu Hugo. Spustíš ji za 5 minut.',
  image = '/og-default.jpg',
  lang = 'cs',
  noindex = false,
  alternates,
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hugo',
  url: SITE_URL,
  logo: `${SITE_URL}/assets/hugo-icon.svg`,
  email: 'hugo@piano.cz',
  sameAs: [
    'https://www.instagram.com/jsem_hugo_pos/',
    'https://www.linkedin.com/showcase/hugopos/',
    'https://www.facebook.com/jsemhugopos',
  ],
  parentOrganization: { '@type': 'Organization', name: 'Piano Solutions', url: 'https://piano.cz' },
};

const hreflang = alternates
  ? [
      { lang: 'cs', href: new URL(alternates.cs, SITE_URL).href },
      { lang: 'en', href: new URL(alternates.en, SITE_URL).href },
      { lang: 'x-default', href: new URL(alternates.cs, SITE_URL).href },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NC3PW2KC');</script>
    <!-- End Google Tag Manager -->
    <!-- Značková doména hugopos.cz míří na stejný web, kanonická je hugopos.eu -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        if (h === 'hugopos.cz' || h.slice(-11) === '.hugopos.cz') {
          location.replace('https://hugopos.eu' + location.pathname + location.search + location.hash);
        }
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      locale={lang === 'en' ? 'en_US' : 'cs_CZ'}
      alternates={hreflang}
      schemas={[organizationSchema]}
    />
    <meta name="theme-color" content="#14110D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NC3PW2KC"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
