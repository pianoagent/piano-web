---
/**
 * Base: layout webu Hugo (hugopos.eu), kopie živého webu 1:1.
 * Stránky generuje weby/podklady-migrace/port-hugo.py ze scrapu živého webu.
 *
 * Layout dává jen společnou hlavičku: GTM (Cookiebot se načítá přes GTM),
 * přesměrování hugopos.cz → hugopos.eu, SEO meta a JSON-LD přes sdílený BaseHead.
 * Všechno, co má každá stránka jinak (fonty, styly, skripty), si stránka posílá
 * do slotu "head" ve stejném pořadí jako živý web.
 */
import BaseHead from '@piano/ui/layouts/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  /** og:/twitter:description, když se na živém webu liší od meta description */
  ogDescription?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  lang?: 'cs' | 'en';
  noindex?: boolean;
  /** cesty jazykových mutací stránky, např. { cs: '/cenik/', en: '/en/pricing/' } */
  alternates?: { cs: string; en: string };
  themeColor?: string;
  /** atributy <html> ze živého webu (např. data-ab-home na homepage) */
  htmlAttrs?: Record<string, string>;
  /** JSON-LD ze živého webu */
  schemas?: object[];
  gtm?: boolean;
}

const SITE_NAME = 'Hugo';
const SITE_URL = 'https://hugopos.eu';

const {
  title,
  description,
  ogDescription,
  image,
  imageAlt,
  type = 'website',
  lang = 'cs',
  noindex = false,
  alternates,
  themeColor = '#14110D',
  htmlAttrs = {},
  schemas = [],
  gtm = true,
} = Astro.props;

const hreflang = alternates
  ? [
      { lang: 'cs', href: new URL(alternates.cs, SITE_URL).href },
      { lang: 'en', href: new URL(alternates.en, SITE_URL).href },
      { lang: 'x-default', href: new URL(alternates.cs, SITE_URL).href },
    ]
  : [];
---

<!doctype html>
<html lang={lang} {...htmlAttrs}>
  <head>
    <meta charset="utf-8" />
    {gtm && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://consent.cookiebot.com" />
        <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NC3PW2KC');</script>
      </>
    )}
    <!-- Značková doména hugopos.cz míří na stejný web, kanonická je hugopos.eu -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        if (h === 'hugopos.cz' || h.slice(-11) === '.hugopos.cz') {
          location.replace('https://hugopos.eu' + location.pathname + location.search + location.hash);
        }
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      ogDescription={ogDescription}
      image={image}
      type={type}
      noindex={noindex}
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      locale={lang === 'en' ? 'en_GB' : 'cs_CZ'}
      alternates={hreflang}
      schemas={schemas}
    />
    {alternates && <meta property="og:locale:alternate" content={lang === 'en' ? 'cs_CZ' : 'en_GB'} />}
    {image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
      </>
    )}
    <meta name="theme-color" content={themeColor} />
    <slot name="head" />
  </head>
  <body>
    {gtm && (
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NC3PW2KC"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <slot />
  </body>
</html>
