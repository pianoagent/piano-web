---
/**
 * LogoWall: tenký wrapper nad @piano/ui/LogoWall.
 * Jen definuje pecostí sadu log (src/assets/images/logos), label a menší velikost pruhu.
 * Vzhled a markup řeší sdílená komponenta. NEFORKOVAT.
 */
import UiLogoWall from '@piano/ui/components/LogoWall.astro';
import { klientiGastro, type Klient } from '../config/klienti';

interface Props { label?: string; background?: 'default' | 'alt'; logos?: Klient[]; id?: string; duration?: string; }
const { label = 'Naši klienti', background = 'alt', logos = klientiGastro, id, duration = '60s' } = Astro.props;
---

<UiLogoWall logos={logos} label={label} background={background} ext="webp" id={id} logoHeight="60px" gap="var(--space-8)" duration={duration} />
