---
/**
 * LogoWall: tenký wrapper nad @piano/ui/LogoWall.
 * Jen definuje pecostí sadu log (public/logos), label a menší velikost pruhu.
 * Vzhled a markup řeší sdílená komponenta. NEFORKOVAT.
 */
import UiLogoWall from '@piano/ui/components/LogoWall.astro';
import { klientiGastro } from '../config/klienti';

interface Props { label?: string; background?: 'default' | 'alt'; logos?: string[]; id?: string; }
const { label = 'Naši klienti', background = 'alt', logos = klientiGastro, id } = Astro.props;
---

<UiLogoWall logos={logos} label={label} background={background} ext="webp" id={id} logoHeight="44px" gap="var(--space-8)" duration="60s" />
