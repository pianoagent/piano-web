---
/**
 * Breadcrumb: drobečková navigace + BreadcrumbList JSON-LD.
 * Poslední položka je aktuální stránka (bez odkazu).
 */
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const SITE = 'https://pecosta.cz';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: new URL(it.href, SITE).href } : {}),
  })),
};
---

<nav class="breadcrumb" aria-label="Drobečková navigace">
  <ol>
    {items.map((it, i) => (
      <li class="breadcrumb__item">
        {it.href && i < items.length - 1
          ? <a href={it.href}>{it.label}</a>
          : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .breadcrumb { margin-bottom: var(--space-5); }
  .breadcrumb ol {
    list-style: none; display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--space-2); font-size: var(--font-size-small); color: var(--color-text-muted);
  }
  .breadcrumb__item { display: inline-flex; align-items: center; gap: var(--space-2); }
  .breadcrumb__item:not(:last-child)::after { content: "›"; color: var(--color-text-muted); }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-text-accent); }
  .breadcrumb span[aria-current] { color: var(--color-text); }
</style>
