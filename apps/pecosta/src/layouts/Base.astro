---
/**
 * Base: layout webu Pecosta.
 * Načte téma Pecosta + sdílenou SEO hlavičku. Definuje Organization schema.
 */
/* reveal.css MUSI byt pred tematem: ma v :root fallback hodnoty
   (--reveal-shift a spol.), ktere by jinak prebily tokeny produktu. */
import '@piano/ui/styles/reveal.css';
import '../styles/theme.css';
import revealUrl from '@piano/ui/scripts/reveal.js?url';
import BaseHead from '@piano/ui/layouts/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object;
}

const SITE_NAME = 'Pecosta';
const SITE_URL = 'https://pecosta.cz';

const {
  title,
  description = 'Pecosta: chytrý nákup potravin a energií pro gastro. Aukční nákupy, úspora až 16 % a automatické naskladňování.',
  image = '/og-default.jpg',
  type = 'website',
  noindex = false,
  schema,
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Pecosta',
  legalName: 'PECOSTA, a.s.',
  url: SITE_URL,
  logo: `${SITE_URL}/logos/pecosta_logo.svg`,
  email: 'pecosta@pecosta.cz',
  telephone: '+420 734 442 683',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kořenského 1262/40',
    addressLocality: 'Ostrava-Vítkovice',
    postalCode: '703 00',
    addressCountry: 'CZ',
  },
  parentOrganization: { '@type': 'Organization', name: 'Piano Solutions', url: 'https://piano.cz' },
};

const schemas = [organizationSchema, ...(schema ? [schema] : [])];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <!-- Scroll reveal: bez defer, trida .js musi byt na <html> driv nez obsah -->
    <script is:inline src={revealUrl}></script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      schemas={schemas}
    />
    <!-- Preload: text Open Sans 400, nadpisy Cabin 700; čeština potřebuje i latin-ext -->
    <link rel="preload" href="/fonts/opensans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/opensans-ext-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabin-ext-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
