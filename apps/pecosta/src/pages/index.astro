---
/**
 * Pecosta: homepage (první verze).
 * Obsah z pecosta-context.md + blok #page-pecosta (piano-web-2026.html).
 * Vše ze SDÍLENÝCH komponent @piano/ui; téma řeší src/styles/theme.css.
 * Sekce bez vlastní komponenty (Stats, Steps, Integrace, Reference, Logo wall,
 * FAQ) jsou složené z primitivů (Section/Heading/Text/Button/Icon)
 * komponenty se NEFORKUJÍ.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import Faq from '@piano/ui/components/Faq.astro';
import Testimonials from '@piano/ui/components/Testimonials.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import USPGrid from '@piano/ui/components/USPGrid.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';
import LogoWall from '@piano/ui/components/LogoWall.astro';
import { pecostaLeadProofs } from '../config/leadProofs';
import { klientiGastro } from '../config/klienti';


const steps = [
  { icon: 'lucide:calculator', title: 'Analýza zdarma', text: 'Připravíme cenové porovnání a kalkulaci úspor bez závazků. Vidíte reálná čísla ještě před podpisem.' },
  { icon: 'lucide:plug', title: 'Napojení dodavatelů', text: 'Napojíme vaše stávající dodavatele na náš nákupní portál. Nemusíte je měnit, soutěží o vaši přízeň.' },
  { icon: 'lucide:shopping-cart', title: 'Nakupujete z jednoho místa', text: 'Nakupujete od všech svých dodavatelů z jednoho portálu za ceny z aukcí.' },
  { icon: 'lucide:package-check', title: 'Automatické naskladnění', text: 'Dodací listy jdou automaticky do vašeho skladového systému přes Autset.' },
];

const features = [
  { icon: 'lucide:gavel', title: 'Aukční nákupy surovin', text: 'E-aukce od ověřených dodavatelů. Ceny srovnané u stovek dodavatelů najednou.' },
  { icon: 'lucide:zap', title: 'Energie pro gastro', text: 'Úspora až 25 % na elektřině a plynu. Energie sdružíme a vyjednáme lepší ceny.' },
  { icon: 'lucide:package', title: 'Autset: automatické naskladnění', text: 'Dodací listy od 450+ dodavatelů se automaticky přenesou do vašeho skladového systému.' },
  { icon: 'lucide:bar-chart-3', title: 'Přehled nákladů', text: 'Jeden portál pro všechny nákupy. Vidíte, kde utrácíte a kde šetříte.' },
  { icon: 'lucide:shield-check', title: 'Ověření dodavatelé', text: 'Nakupujete od prověřených partnerů. Kvalita se nemění, cena jde dolů.' },
  { icon: 'lucide:badge-percent', title: 'Analýza zdarma', text: 'Víte, kolik ušetříte, ještě před zahájením spolupráce. Bez závazků.' },
];

const integrations = [
  'Chytrý nákup za aukční ceny',
  'Automatické naskladnění dodacích listů',
  'Přímé napojení na skladový systém',
];

const testimonials = [
  { initials: 'CPI', headline: 'Šetříme miliony ročně', quote: 'Díky automatickému naskladňování v každém z našich hotelů každý den ušetříme svým lidem minimálně hodinu práce. 80 % nákupů realizujeme přes Pecostu a šetříme několik milionů ročně.', author: 'Maroš Šivec', role: 'Executive F&B Director, CPI Hotels' },
  { initials: 'PH', headline: 'Úspora času je nedocenitelná', quote: 'Úspora času je nedocenitelná. Pecosta nám pomáhá mít náklady pod kontrolou a soustředit se na to, co nás baví.', author: 'Michaela Bakrlíková', role: 'Finanční ředitelka, Pytloun Hotels' },
  { initials: 'HP', headline: 'Zlomili jsme tříletý trend', quote: 'Zlomili jsme tříletý trend růstu nákladů. Výsledky překonaly naše očekávání.', author: 'Tomáš Šico', role: 'HP Tronic' },
];


const faqs = [
  { q: 'Jak funguje aukční nákup?', a: 'Pecosta pravidelně sdružuje poptávky stovek provozů a vyjednává hromadné ceny, dostanete ceny, na které byste jako jednotlivec nedosáhli. Dodavatelé soutěží, vy vyděláváte.' },
  { q: 'Kolik reálně ušetřím?', a: 'V průměru až 16 % na surovinách a 25 % na energiích. Konkrétní číslo pro váš provoz spočítáme v bezplatné analýze.' },
  { q: 'Musím měnit dodavatele?', a: 'Není třeba. Nákupy řešíte z jednoho místa a Pecosta vám nabízí nejlepší ceny od ověřených dodavatelů. S největší pravděpodobností zde najdete i 90 % těch svých. Nakupovat však můžete i nadále od svých lokálních dodavatelů a na nákupní portál je dodatečně zařadit.' },
  { q: 'Co je automatické naskladnění?', a: 'Dodací listy se naskladní automaticky (přes Autset), bez ručního přepisování, ušetříte hodiny administrativy každý měsíc.' },
  { q: 'Hodí se Pecosta i pro menší provoz?', a: 'Ano. Automatické naskladňování šetří čas menší kavárně stejně jako hotelovým sítím. Aukční nákupy pak doporučujeme hlavně provozům, jejichž objem nákupů přesahuje 5 mil. Kč ročně. Čím víc nakupujete, tím víc ušetříte.' },
];

---

<Base title="Nákupčí pro váš podnik | Pecosta"
      description="Pecosta vám díky aukčním nákupům ušetří až 16 % na surovinách i energiích a Autset zvládne zboží automaticky naskladnit.">
  <SiteHeader />

  <main>

  <!-- HERO -->
  <Hero eyebrow="Jednoduše chytrý nákup" background="gradient"
        lead="Poskytujeme nástroje, se kterými ušetříte až 16 % nákladů na suroviny, 25 % na energie a až 30 hodin práce spojené s naskladňováním zboží."
        usp={[{ text: '-16 % na surovinách', icon: 'lucide:badge-percent' }, { text: '-25 % na energiích', icon: 'lucide:zap' }, { text: '-30 hodin měsíčně', icon: 'lucide:clock' }]}>
    <Heading slot="title" as="h1" size="display" color="on-dark">Šetříme náklady vašemu provozu</Heading>
    <Fragment slot="actions">
      <Button href="#poptavka">Chci aukční nákupy</Button>
      <Button href="#poptavka" variant="secondary" onDark>Kolik ušetřím?</Button>
    </Fragment>
    <figure slot="media" class="hero-figure">
      <video src="/videos/hero-pecosta.mp4" poster="/images/hero-pecosta.webp"
             autoplay loop muted playsinline width="1280" height="720"
             aria-label="Pecosta: chytrý nákup surovin a energií"></video>
    </figure>
  </Hero>

  <!-- LOGA KLIENTŮ: hned pod hero -->
  <LogoWall id="zakaznici" background="default" label="Naši klienti" logos={klientiGastro} ext="webp" logoHeight="44px" />

  <!-- JAK TO FUNGUJE -->
  <Section id="jak-to-funguje" background="default" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Jak to funguje</Text>
      <Heading as="h2" size="h2" align="center">Začínáme <em>analýzou zdarma</em></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Nejprve vám ukážeme, kolik ušetříte. Až pak se rozhodnete. Bez závazků, bez rizika.
      </Text>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num">{i + 1}</span>
          <span class="step__icon"><Icon name={s.icon} size="lg" /></span>
          <Heading as="h3" size="h3">{s.title}</Heading>
          <Text size="small" color="muted">{s.text}</Text>
        </li>
      ))}
    </ol>
  </Section>

  <!-- FUNKCE (USPGrid neforwarduje id → kotva na wrapperu) -->
  <div id="funkce">
    <USPGrid eyebrow="Co Pecosta umí" title="Nakupujte chytřeji. Nakupujte za míň."
             lead="Aukční nákupy surovin, výhodnější energie a automatické naskladnění: vše z jednoho místa."
             items={features} minItemWidth="280px" background="alt" space="lg" />
  </div>

  <!-- INTEGRACE -->
  <Section background="invert" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Integrace</Text>
      <Heading as="h2" size="h2" align="center" color="on-dark">Pecosta + Autset = <em>nákup bez práce</em></Heading>
      <Text size="lead" color="on-dark-muted" align="center">Od objednávky po naskladnění bez ručního přepisování.</Text>
      <Text color="on-dark-muted" align="center" balance>
        Naše řešení je propojeno s 15 skladovými systémy na českém a slovenském trhu a s více než 450 dodavateli potravin a nápojů.
      </Text>
    </div>
    <ul class="chips">
      {integrations.map((i) => (
        <li class="chip"><span class="chip__dot"></span>{i}</li>
      ))}
    </ul>
  </Section>

  <!-- REFERENCE -->
  <Testimonials
    background="alt"
    id="reference"
    items={testimonials}
    eyebrow="Reference"
    titleHtml="Spoří s námi <em>ti nejlepší</em>"
    lead="Od hotelových skupin po michelinské restaurace. Pecosta drží náklady pod kontrolou.">
    <Button href="#zakaznici" variant="secondary">Naši zákazníci</Button>
  </Testimonials>
  <!-- CTA -->
  <Section background="primary" space="lg">
    <div class="head head--center">
      <Text size="label" color="on-dark-muted" align="center">Začít s Pecostou</Text>
      <Heading as="h2" size="h2" align="center" color="on-dark">Zjistěte, kolik ušetříte</Heading>
      <Text size="lead" color="on-dark-muted" align="center" balance>
        Analýza nákladů je zdarma a bez závazků. Výsledek máte do 48 hodin.
      </Text>
      <div class="cta-actions">
        <Button href="#poptavka">Chci analýzu zdarma</Button>
        <Button href="tel:+420734442683" variant="secondary">+420 734 442 683</Button>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Faq
    background="default"
    items={faqs}
    title="Často kladené dotazy"
    lead="Nenašli jste odpověď? Ozvěte se nám, rádi vám poradíme." />
  <!-- POPTÁVKA -->
  <LeadForm id="poptavka" variant="full" background="alt"
            title="Zjistěte, kolik ušetříte"
            lead="Nechte nám kontakt, připravíme cenové porovnání a kalkulaci úspor. Zdarma a bez závazků."
            submitLabel="Chci analýzu zdarma"
            proofs={pecostaLeadProofs} />

  </main>

  <SiteFooter />
</Base>

<style>
  /* Hero video */
  .hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    line-height: 0;
  }
  .hero-figure video { width: 100%; height: auto; display: block; }

  /* Sdílená hlavička sekce */
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); }
  .head--center { text-align: center; }
  .head > * + * { margin-top: var(--space-3); }

  /* Steps */
  .steps {
    list-style: none; display: grid; gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .step {
    position: relative; padding: var(--space-6);
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); box-shadow: var(--shadow-sm);
  }
  .step > * + * { margin-top: var(--space-3); }
  .step__num {
    position: absolute; top: var(--space-4); right: var(--space-5);
    font-size: var(--font-size-h2); font-weight: var(--font-weight-bold);
    color: var(--color-neutral-200); line-height: 1;
  }
  .step__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-primary) 10%, #fff);
    color: var(--color-primary);
  }

  /* Integrace chips */
  .chips {
    list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3);
    justify-content: center;
  }
  .chip {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-3) var(--space-5); border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06); border: 1px solid var(--color-border-on-dark);
    color: var(--color-text-on-dark); font-size: var(--font-size-small);
  }
  .chip__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); flex-shrink: 0; }

  /* Logo wall: marquee */
  .logos__label { margin-bottom: var(--space-5); }
  .logos { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .logos__track { display: flex; align-items: center; gap: var(--space-8); width: max-content; animation: logos-scroll 48s linear infinite; }
  .logos__track img { height: 34px; width: auto; opacity: 0.62; filter: grayscale(1); flex-shrink: 0; }
  @keyframes logos-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .logos__track { animation: none; flex-wrap: wrap; justify-content: center; } }

  /* CTA */
  .cta-actions { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--space-5); }

  /* FAQ */
</style>
