---
/**
 * Novinky: detail článku (pecosta.cz/novinky/<slug>).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleDetail from '@piano/ui/components/ArticleDetail.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { slugForCategory } from '../../blog-categories';
import { findImage, optimizeHtmlImages } from '@piano/ui/lib/images';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const content = await optimizeHtmlImages(post.rendered?.html ?? '', 720);
const fmtDate = (d: Date) => d.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });

const primaryCat = post.data.categories?.[0];
const catSlug = primaryCat ? slugForCategory(primaryCat) : undefined;
const crumbs = [
  { label: 'Domů', href: '/' },
  { label: 'Novinky', href: '/novinky' },
  ...(primaryCat && catSlug ? [{ label: primaryCat, href: `/novinky/kategorie/${catSlug}` }] : []),
  { label: post.data.title },
];

const coverAsset = post.data.image ? findImage(post.data.image) : undefined;
const cover = coverAsset ? await getImage({ src: coverAsset, width: 1200, format: 'jpg' }) : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.description ? { description: post.data.description } : {}),
  ...(cover ? { image: new URL(cover.src, Astro.site).href } : {}),
  author: { '@type': 'Organization', name: 'Pecosta' },
};
---

<Base title={`${post.data.title} | Pecosta`} description={post.data.description} type="article" image={cover?.src} schema={articleSchema}>
  <SiteHeader />
  <main>
    <ArticleDetail
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      image={post.data.image}
      category={primaryCat}
      categoryHref={catSlug ? `/novinky/kategorie/${catSlug}` : undefined}
      cta={{ label: 'Chci analýzu zdarma', href: '/kontakt' }}>
      <Breadcrumb slot="breadcrumb" items={crumbs} />
      <Fragment set:html={content} />
    </ArticleDetail>
  </main>
  <SiteFooter />
</Base>

