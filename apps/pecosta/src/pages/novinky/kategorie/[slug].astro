---
/**
 * Novinky: hub stránka kategorie (pecosta.cz/novinky/kategorie/<slug>).
 * Indexovatelná, unikátní title/description/úvod. Články zůstávají na /novinky/<slug>.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import PostGrid from '@piano/ui/components/PostGrid.astro';
import CategoryChips from '@piano/ui/components/CategoryChips.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { BLOG_CATEGORIES, categoryBySlug } from '../../../blog-categories';

export async function getStaticPaths() {
  return BLOG_CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const posts = allPosts.filter((p) => (p.data.categories ?? []).includes(category.name));

const used = new Set(allPosts.flatMap((p) => p.data.categories ?? []));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.name));


const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.title,
  description: category.description,
  url: `https://pecosta.cz/novinky/kategorie/${category.slug}`,
};
---

<Base title={`${category.title} | Pecosta`} description={category.description} schema={collectionSchema}>
  <SiteHeader />
  <main>
    <Hero eyebrow="Akce a novinky" background="alt" lead={category.intro}>
      <Heading slot="title" as="h1" size="display">{category.name}</Heading>
    </Hero>

    <Section background="default" space="lg">
      <Breadcrumb items={[
        { label: 'Domů', href: '/' },
        { label: 'Novinky', href: '/novinky' },
        { label: category.name },
      ]} />

      <CategoryChips
        items={[{ label: 'Vše', href: '/novinky' }, ...categories.map((c) => ({ label: c.name, href: `/novinky/kategorie/${c.slug}` }))]}
        activeHref={`/novinky/kategorie/${category.slug}`} />

      <PostGrid posts={posts.map((p) => ({
        href: `/novinky/${p.id}`,
        title: p.data.title,
        description: p.data.description,
        image: p.data.image,
        category: category.name,
        date: p.data.pubDate,
      }))} />
    </Section>
  </main>
  <SiteFooter />
</Base>

