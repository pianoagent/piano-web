---
/**
 * Novinky: výpis článků (pecosta.cz/novinky). Obsah migrovaný ze starého webu.
 * Struktura dle blogu piano.cz; vše ze sdílených @piano/ui + lokální hlavička/patička.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import PostGrid from '@piano/ui/components/PostGrid.astro';
import CategoryChips from '@piano/ui/components/CategoryChips.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import { BLOG_CATEGORIES } from '../../blog-categories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const used = new Set(posts.flatMap((p) => p.data.categories ?? []));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.name));

---

<Base title="Akce, novinky a case studies | Pecosta"
      description="Novinky, případové studie a mediální výstupy Pecosty. Jak hotely, restaurace a instituce šetří na surovinách, energiích a čase.">
  <SiteHeader />
  <main>
    <Hero eyebrow="Akce a novinky" background="alt"
          lead="Případové studie z provozů, novinky ze služeb a mediální výstupy. Z první ruky od lidí, kteří gastro nákupu rozumí.">
      <Heading slot="title" as="h1" size="display">Co je u nás <em>nového</em></Heading>
    </Hero>

    <Section background="default" space="lg">
      <CategoryChips
        items={[{ label: 'Vše', href: '/novinky' }, ...categories.map((c) => ({ label: c.name, href: `/novinky/kategorie/${c.slug}` }))]}
        activeHref="/novinky" />
      <PostGrid posts={posts.map((p) => ({
        href: `/novinky/${p.id}`,
        title: p.data.title,
        description: p.data.description,
        image: p.data.image,
        category: p.data.categories?.[0],
        date: p.data.pubDate,
      }))} />
    </Section>
  </main>
  <SiteFooter />
</Base>

