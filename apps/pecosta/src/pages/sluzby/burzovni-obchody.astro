---
/** Pecosta: Služba: Burzovní obchody. Obsah: pecosta-context.md. */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import USPGrid from '@piano/ui/components/USPGrid.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';
import Faq from '@piano/ui/components/Faq.astro';
import LogoWall from '../../components/LogoWall.astro';
import { pecostaLeadProofs } from '../../config/leadProofs';
import { klientiVerejnySektor } from '../../config/klienti';

const features = [
  'Nákup energií přes Komoditní burzu Praha (KBP)', 'Pro školy, školky, DPS, města, obce a kraje',
  'Objem stovek subjektů na vaší straně', 'Načasování nákupu podle vývoje trhu',
  'Transparentní burzovní mechanismus', 'Bez nutnosti vlastní expertízy na burzu',
];
const benefits = [
  { icon: 'lucide:landmark', title: 'Komoditní burza Praha', text: 'Obchodujeme na regulované burze, transparentní ceny a jasná pravidla, v souladu s veřejnou správou.' },
  { icon: 'lucide:building-2', title: 'Pro veřejný sektor', text: 'Školní jídelny, menzy, domovy seniorů, města i obce. Řešení respektuje pravidla veřejných nákupů.' },
  { icon: 'lucide:users', title: 'Síla objemu', text: 'Stojíte na straně stovek subjektů. Objem otevírá ceny, na které jednotlivec nedosáhne.' },
  { icon: 'lucide:timer', title: 'Správné načasování', text: 'Nakupujeme ve vhodný okamžik podle vývoje trhu, ne když zrovna dojde smlouva.' },
];
const faqs = [
  { q: 'Pro koho jsou burzovní obchody?', a: 'Pro subjekty veřejné správy: školy, školky, domovy seniorů (DPS), města, obce a kraje. Zajišťujeme nákup energií podle pravidel veřejného sektoru.' },
  { q: 'Potřebuji vlastní znalost burzy?', a: 'Ne. Celý nákup řeší Pecosta za vás, vy jen čerpáte výslednou cenu a přehled.' },
  { q: 'Liší se to od Energií pro gastro?', a: 'Ano. Burzovní obchody jsou určeny veřejné správě. Běžné gastro podniky (restaurace, kavárny, hotely) řeší energie službou Energie pro gastro.' },
];
---
<Base title="Burzovní obchody a nákup energií | Pecosta"
      description="Burzovní obchody Pecosta: nákup energií přes Komoditní burzu Praha pro gastro provozy ve veřejné správě, školy, školky, domovy seniorů, města a obce.">
  <SiteHeader />
  <main>
    <Hero eyebrow="Služba Pecosta · veřejná správa" background="alt"
          lead="Řešení pro gastro provozy ve veřejné správě, školní jídelny, menzy, domovy seniorů. Energie nakupujeme přes Komoditní burzu Praha (KBP), kde díky objemu a načasování získáte ceny, na které sami nedosáhnete.">
      <Heading slot="title" as="h1" size="display"><em>Burzovní</em> obchody</Heading>
      <Fragment slot="actions">
        <Button href="#poptavka">Chci analýzu zdarma</Button>
        <Button href="/sluzby/energie" variant="secondary">Energie pro gastro</Button>
      </Fragment>
    </Hero>

    <Section background="default" space="lg">
      <div class="prose">
        <Heading as="h2" size="h2">Energie pro veřejný sektor přes burzu</Heading>
        <Text size="lead" color="muted">
          Školy, školky, domovy seniorů, města, obce i kraje nakupují energie podle pravidel
          veřejné správy. Pecosta pro ně obchoduje na Komoditní burze Praha, kde rozhoduje objem
          a načasování: s transparentními cenami a jasnými pravidly.
        </Text>
        <Text color="muted">
          Nepotřebujete žádnou vlastní expertízu na burzu. Nákup, načasování i administrativu
          řešíme za vás. Pozn.: burzovní obchod je určen veřejné správě, běžným gastro podnikům
          (restaurace, kavárny, hotely) slouží služba <a href="/sluzby/energie">Energie pro gastro</a>.
        </Text>
      </div>
    </Section>

    <Section background="alt" space="lg">
      <div class="head head--center">
        <Text size="label" color="accent" align="center">Co služba zahrnuje</Text>
        <Heading as="h2" size="h2" align="center">Burzovní obchody v kostce</Heading>
      </div>
      <ul class="checklist">
        {features.map((f) => (<li><Icon name="lucide:check" size="sm" class="checklist__icon" />{f}</li>))}
      </ul>
    </Section>

    <USPGrid eyebrow="Výhody" title="Proč nakupovat přes burzu" items={benefits} background="default" space="lg" minItemWidth="240px" />
    <LogoWall logos={klientiVerejnySektor} label="Naši klienti" background="alt" />
    <Faq items={faqs} title="Časté otázky k burzovním obchodům" background="default" />
    <LeadForm id="poptavka" variant="full" background="default"
              title="Zjistěte, kolik ušetříte na energiích"
              lead="Nechte nám kontakt, připravíme kalkulaci podle vaší spotřeby. Zdarma a bez závazků."
              submitLabel="Chci analýzu zdarma" proofs={pecostaLeadProofs} />
  </main>
  <SiteFooter />
</Base>

<style>
  .prose { max-width: 760px; }
  .prose > * + * { margin-top: var(--space-4); }
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); text-align: center; }
  .head > * + * { margin-top: var(--space-3); }
  .checklist { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); max-width: 960px; margin-inline: auto; }
  .checklist li { display: flex; align-items: flex-start; gap: var(--space-2); font-size: var(--font-size-small); }
  .checklist__icon { color: var(--color-primary); flex-shrink: 0; margin-top: 2px; }
</style>
