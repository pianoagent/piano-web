---
/**
 * Blog: výpis článků (piano.cz/blog). Obsah převzat ze stávajícího webu.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '@piano/ui/components/Section.astro';
import PostGrid from '@piano/ui/components/PostGrid.astro';
import CategoryChips from '@piano/ui/components/CategoryChips.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import { BLOG_CATEGORIES, slugForCategory } from '../../blog-categories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Kategorie s alespoň jedním článkem (pevné pořadí dle blog-categories) → odkazy na hub stránky.
const used = new Set(posts.flatMap((p) => p.data.categories ?? []));
const categories = BLOG_CATEGORIES.filter((c) => used.has(c.name));

---

<Base title="Blog | Piano"
      description="Trendy, rady a tipy ze světa gastronomie a hotelnictví, z provozu pro provoz.">

  <Hero eyebrow="Blog" background="warm"
        lead="Trendy, rady a tipy ze světa gastronomie a hotelnictví, od lidí, kteří provozu rozumí.">
    <Heading slot="title" as="h1" size="display">Co se děje v gastru</Heading>
  </Hero>

  <Section background="default" space="lg">
    <CategoryChips
        items={[{ label: 'Vše', href: '/blog' }, ...categories.map((c) => ({ label: c.name, href: `/blog/kategorie/${c.slug}` }))]}
        activeHref="/blog" />
    <PostGrid posts={posts.map((p) => ({
        href: `/blog/${p.id}`,
        title: p.data.title,
        description: p.data.description,
        image: p.data.image,
        category: p.data.categories?.[0],
        date: p.data.pubDate,
      }))} />
  </Section>
</Base>

