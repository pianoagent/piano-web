---
/**
 * Hugo — produktová stránka piano.cz/hugo.
 * Obsah dle oficiálního letáku (malá pokladna 190 Kč/měs + Piano Terminál 0,9 % + 1 Kč + Pilot AI).
 * Vizuál laděn do brandu Hugo (ink #14110D, cream #F3EFE6, signature yellow #FFDF2C) —
 * paleta se přebíjí scoped proměnnými na .hugo, sdílené komponenty @piano/ui se NEforkují.
 */
import Base from '../layouts/Base.astro';
import Section from '@piano/ui/components/Section.astro';
import Hero from '@piano/ui/components/Hero.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Button from '@piano/ui/components/Button.astro';
import Icon from '@piano/ui/components/Icon.astro';
import USPGrid from '@piano/ui/components/USPGrid.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';

const stats = [
  { num: '190 Kč', lbl: 'měsíčně za pokladnu — Hugo i Pilot v ceně' },
  { num: '0,9 % + 1 Kč', lbl: 'férová sazba za platbu kartou' },
  { num: '5 000 Kč', lbl: 'daňová sleva od státu na terminál' },
  { num: 'pár minut', lbl: 'aktivace přímo na terminálu, bez technika' },
];

const proc = [
  { icon: 'lucide:rocket', title: 'Spustíte sami', text: 'Aktivace za pár minut přímo na terminálu. Bez obchodníka a bez čekání na schůzku.' },
  { icon: 'lucide:credit-card', title: 'Terminál na míru', text: 'Uzpůsobený pro bezproblémové přijetí plateb. Pokladna a platby v jednom zařízení.' },
  { icon: 'lucide:wrench', title: 'Bez technika', text: 'Žádná instalace, žádné zásahy na provozovně. Vybalíte, přihlásíte se a účtujete.' },
  { icon: 'lucide:trending-up', title: 'Roste s vámi', text: 'Od stánku po menší provoz. Přímočaré řešení pro ty, kdo potřebují spolehlivě účtovat — ne rozsáhlý systém.' },
];

const payments = [
  { icon: 'lucide:badge-percent', title: 'Férová sazba 0,9 % + 1 Kč', text: 'Jasná cena za každou platbu kartou. Žádné skryté řádky ani překvapení na konci měsíce.' },
  { icon: 'lucide:wallet', title: 'Rychlé vyplácení', text: 'Peníze z plateb máte bez zbytečného čekání, s celoevropskou licencí ČNB za zády.' },
  { icon: 'lucide:layers', title: 'Platby a pokladna spolu', text: 'Účtenky i platby kartou běží přes jedno zařízení a jsou přehledně na jednom místě.' },
];

const gear = [
  {
    name: 'Piano Terminál', price: '4 900 Kč', featured: true, badge: 'Doporučujeme',
    text: 'Pokladna Hugo i platby kartou v jednom zařízení — vše přes Piano.',
    note: 'Daňová sleva od státu 5 000 Kč',
  },
  {
    name: 'Samostatná tiskárna', price: '3 900 Kč', featured: false,
    text: 'Účtenková tiskárna pro bar či kuchyň, když chcete tisknout stranou.',
  },
];

const summary = [
  { tag: 'Pokladna', num: '190 Kč', unit: '/ měsíc', note: 'Hugo + Pilot v ceně' },
  { tag: 'Platby kartou', num: '0,9 % + 1 Kč', unit: 'za transakci', note: 'Piano Terminál' },
  { tag: 'Pilot AI', num: '3 měsíce', unit: 'Premium', note: 'poté Freemium, základní AI dál v ceně' },
  { tag: 'Sazebník', num: 'MIF++', unit: '', note: 'transparentní výpočet poplatku' },
];

const faqs = [
  { q: 'Pro koho je Hugo?', a: 'Pro malé provozy — stánky, hospody a pivní bistra, malé bary. Přímočaré řešení pro ty, kdo potřebují spolehlivě účtovat, ne rozsáhlý pokladní systém.' },
  { q: 'Kolik Hugo stojí?', a: 'Pokladna Hugo vyjde na 190 Kč měsíčně a Pilot AI je v ceně. Platby kartou přes Piano Terminál mají férovou sazbu 0,9 % + 1 Kč za transakci.' },
  { q: 'Potřebuju technika nebo instalaci?', a: 'Ne. Hugo si spustíte sami — aktivace zabere pár minut přímo na terminálu, bez obchodníka, bez zásahu technika.' },
  { q: 'Jaký hardware potřebuju?', a: 'Stačí Piano Terminál za 4 900 Kč, na který navíc dostanete daňovou slevu od státu 5 000 Kč. Pokud chcete tisknout stranou, přidáte samostatnou účtenkovou tiskárnu za 3 900 Kč.' },
  { q: 'Co umí Pilot AI?', a: 'Spojí data z pokladny a plateb na jednom místě ve vašem mobilu a s pomocí AI vám ukáže, co se v podniku skutečně děje. První 3 měsíce máte Premium, poté pokračujete ve Freemium se základní AI v ceně.' },
  { q: 'Kdy dostanu peníze z karet?', a: 'Peníze z plateb kartou vyplácíme rychle a bez zbytečného čekání. Vaše tržby jsou v bezpečí, provoz plateb má celoevropskou licenci ČNB.' },
];

const leadProofs = [
  { icon: 'lucide:timer', title: 'Spustíte za pár minut', text: 'Aktivace přímo na terminálu.' },
  { icon: 'lucide:wrench', title: 'Bez technika', text: 'Žádná instalace na provozovně.' },
  { icon: 'lucide:receipt', title: 'Platby i pokladna v jednom', text: 'Vše přehledně přes Piano.' },
  { icon: 'lucide:sparkles', title: 'Pilot AI v ceně', text: '3 měsíce Premium na start.' },
];
---

<Base title="Hugo, jednoduchá pokladna pro malé provozy | Piano"
      description="Hugo je jednoduchá pokladna pro stánky, hospody a malé bary. Spustíte ji sami za pár minut bez technika. Platby kartou přes Piano Terminál za 0,9 % + 1 Kč a Pilot AI v ceně."
      preloadImage="/images/hugo-hero.webp">

  <div class="hugo">

  <!-- HERO -->
  <Hero eyebrow="Pokladna Hugo · malá pokladna" background="gradient"
        lead="Jednoduchá pokladna pro malé provozy — stánky, hospody a pivní bistra, malé bary. Spustíte ji sami během pár minut na terminálu, bez technika a bez instalace. Přímočaré řešení pro ty, kdo potřebují spolehlivě účtovat — ne rozsáhlý systém."
        usp={[{ text: 'Aktivace za pár minut', icon: 'lucide:timer' }, { text: 'Bez technika', icon: 'lucide:wrench' }, { text: '190 Kč / měsíc', icon: 'lucide:tag' }]}>
    <Heading slot="title" as="h1" size="display" color="on-dark">Spolehlivá pokladna pro malé provozy. <em>Spustíte ji sami.</em></Heading>
    <Fragment slot="actions">
      <Button href="#poptavka">Chci Hugo</Button>
      <Button href="#vybaveni" variant="secondary" onDark>Co k tomu potřebuju?</Button>
    </Fragment>
    <div slot="media" class="hero-media">
      <img class="hero-media__device" src="/images/hugo-hero.webp" alt="Piano Terminál s pokladnou Hugo" width="513" height="837" loading="eager" />
      <div class="hero-card">
        <span class="hero-card__dot" aria-hidden="true"></span>
        <div class="hero-card__body">
          <strong class="hero-card__amount">Zaplaceno · 300 Kč</strong>
          <span class="hero-card__meta">kartou · právě teď</span>
        </div>
        <Icon name="lucide:check" size="md" class="hero-card__ico" />
      </div>
    </div>
  </Hero>

  <!-- STATISTIKY -->
  <Section background="default" space="md">
    <ul class="stats">
      {stats.map((s) => (
        <li class="stats__item">
          <span class="stats__num">{s.num}</span>
          <span class="stats__lbl">{s.lbl}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- PRO KOHO / VÝHODY -->
  <USPGrid eyebrow="Malá pokladna, žádné starosti"
           title="Nachystaná dřív, než otevřete"
           lead="Hugo je pokladna, kterou zvládnete sami. Bez schůzek, bez techniků, bez týdenního nasazování."
           items={proc} columns={4} minItemWidth="220px" background="alt" space="lg" />

  <!-- PLATBY KARTOU -->
  <Section id="platby" background="default" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Platby kartou</Text>
      <Heading as="h2" size="h2" align="center">Platby i pokladna v <em>jednom zařízení</em></Heading>
      <Text size="lead" color="muted" align="center" balance>
        Karty přijímáte přes Piano Terminál a účtujete rovnou v Hugovi. Jedna sazba, jedno zařízení, jeden přehled.
      </Text>
    </div>
    <div class="cards">
      {payments.map((p) => (
        <article class="card">
          <span class="card__icon"><Icon name={p.icon} size="md" /></span>
          <Heading as="h3" size="h3">{p.title}</Heading>
          <Text size="small" color="muted">{p.text}</Text>
        </article>
      ))}
    </div>
  </Section>

  <!-- VYBAVENÍ / CENÍK ZAŘÍZENÍ -->
  <Section id="vybaveni" background="warm" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Vyberte si zařízení</Text>
      <Heading as="h2" size="h2" align="center">Vybavení</Heading>
    </div>
    <div class="gear">
      {gear.map((g) => (
        <article class={`gear__card${g.featured ? ' gear__card--featured' : ''}`}>
          {g.badge && <span class="gear__badge">{g.badge}</span>}
          <Heading as="h3" size="h3">{g.name}</Heading>
          <span class="gear__price">{g.price}</span>
          <Text size="small" color="muted">{g.text}</Text>
          {g.note && <span class="gear__note"><Icon name="lucide:badge-check" size="sm" /> {g.note}</span>}
        </article>
      ))}
    </div>
  </Section>

  <!-- PILOT AI -->
  <Section id="pilot" background="invert" space="lg">
    <div class="pilot">
      <figure class="pilot__media">
        <img src="/images/hugo-pilot.webp" alt="Pilot AI: přehled tržeb a doporučení v mobilu" width="470" height="508" loading="lazy" />
      </figure>
      <div class="pilot__text">
        <Text size="label" color="accent">Pilot AI · v ceně pokladny</Text>
        <Heading as="h2" size="h2" color="on-dark">Inteligence vašeho podniku, <em>rovnou v mobilu</em></Heading>
        <Text size="lead" color="on-dark-muted">
          Data z pokladny a plateb na jednom místě. Pilot vám s pomocí AI ukáže, co se v podniku skutečně děje — abyste rozhodovali podle čísel, ne podle pocitu.
        </Text>
        <p class="pilot__badge"><Icon name="lucide:sparkles" size="sm" /> 3 měsíce Premium, poté Freemium — základní AI dál v ceně</p>
        <Button href="/pilot" variant="secondary" onDark>Více o Pilotu</Button>
      </div>
    </div>
  </Section>

  <!-- SOUHRN CENÍKU -->
  <Section background="default" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Ceník na jednom řádku</Text>
      <Heading as="h2" size="h2" align="center">Co platíte a co máte v ceně</Heading>
    </div>
    <ul class="summary">
      {summary.map((s) => (
        <li class="summary__item">
          <span class="summary__tag">{s.tag}</span>
          <span class="summary__num">{s.num} {s.unit && <em>{s.unit}</em>}</span>
          <span class="summary__note">{s.note}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- FAQ -->
  <Section background="alt" space="lg">
    <div class="head head--center">
      <Text size="label" color="accent" align="center">Než se rozhodnete</Text>
      <Heading as="h2" size="h2" align="center">Časté otázky</Heading>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}<Icon name="lucide:chevron-down" size="sm" class="faq__chev" /></summary>
          <div class="faq__a"><Text color="muted">{f.a}</Text></div>
        </details>
      ))}
    </div>
  </Section>

  <!-- POPTÁVKA -->
  <LeadForm id="poptavka" variant="full"
            title="Chci pokladnu Hugo"
            lead="Nechte nám kontakt a ozveme se s nabídkou na míru vašemu provozu. Hugo spustíte sami během pár minut, bez technika a bez závazku na start."
            proofs={leadProofs} />

  </div>

</Base>

<style>
  /* ---- Brand Hugo: přebití palety jen pro obsah této stránky ---- */
  .hugo {
    --color-primary: #14110D;
    --color-primary-hover: #2A2620;
    --color-primary-active: #0A0A0A;
    --color-primary-bg: #14110D;
    --color-primary-bg-hover: #2A2620;
    --color-secondary-yellow: #FFDF2C;
    --color-text-accent: #7A5E00;
    --color-bg-alt: #F3EFE6;
    --color-bg-warm: #FBF9F3;
    --color-bg-invert: #14110D;
    --color-neutral-900: #14110D;
    --color-neutral-200: #ECE6D7;
    --color-border: #ECE6D7;
    --color-border-strong: #E4DDC8;
    --color-border-on-dark: rgba(255, 253, 245, 0.18);
    --color-text-on-dark: #FFFDF5;
    --color-text-on-dark-muted: rgba(255, 253, 245, 0.72);
    --color-bg-gradient: linear-gradient(140deg, #14110D 0%, #1F1B16 55%, #2A2620 100%);
    --radius-sm: 14px;
    --radius-md: 22px;
    --radius-lg: 34px;
    --btn-radius: 999px;
    --field-radius: 999px;
    --shadow-focus: 0 0 0 3px rgba(255, 223, 44, 0.55);
  }

  /* Sdílená hlavička sekce */
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); }
  .head--center { text-align: center; }
  .head > * + * { margin-top: var(--space-3); }

  /* HERO média — terminál + plovoucí karta */
  .hero-media { position: relative; display: flex; justify-content: center; align-items: center; min-height: 440px; }
  /* Vyšší specificita než globální .hero__media img { width:100% } v Hero.astro,
     jinak by se terminál roztáhl do šířky. */
  .hero-media .hero-media__device { width: auto; max-width: 100%; height: auto; max-height: 480px; object-fit: contain; filter: drop-shadow(var(--shadow-lg)); display: block; }
  .hero-card {
    position: absolute; left: 0; top: 22%; z-index: 3;
    display: flex; align-items: center; gap: var(--space-4);
    background: rgba(20, 17, 13, 0.55);
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(8px);
    max-width: 260px;
  }
  @media (max-width: 880px) { .hero-card { left: auto; right: 0; } }
  .hero-card__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--color-secondary-yellow); flex-shrink: 0; box-shadow: 0 0 0 6px rgba(255, 223, 44, 0.18); }
  .hero-card__body { display: flex; flex-direction: column; gap: 2px; margin-right: auto; }
  .hero-card__amount { font-size: var(--font-size-lead); font-weight: var(--font-weight-bold); color: var(--color-text-on-dark); }
  .hero-card__meta { font-size: var(--font-size-small); color: var(--color-text-on-dark-muted); }
  .hero-card__ico { color: var(--color-secondary-yellow); }

  /* Stats band */
  .stats { list-style: none; display: grid; gap: var(--space-5); grid-template-columns: repeat(4, 1fr); text-align: center; }
  .stats__item { display: flex; flex-direction: column; gap: var(--space-2); padding: 0 var(--space-3); }
  .stats__num { font-family: var(--font-serif); font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); line-height: 1; color: var(--color-text); }
  .stats__lbl { font-size: var(--font-size-small); color: var(--color-text-muted); }
  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }

  /* Karty (platby) */
  .cards { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .card { padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .card > * + * { margin-top: var(--space-3); }
  .card__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: var(--radius-md);
    background: rgba(255, 223, 44, 0.16); color: var(--color-text); border: 1px solid rgba(255, 223, 44, 0.35);
  }

  /* Vybavení */
  .gear { display: grid; gap: var(--space-5); grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 780px; margin-inline: auto; }
  .gear__card { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-7) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .gear__card--featured { border-color: transparent; background: #FFFBE8; box-shadow: 0 0 0 2px var(--color-secondary-yellow), var(--shadow-md); }
  .gear__badge { position: absolute; top: var(--space-5); right: var(--space-6); font-size: var(--font-size-caption); font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); background: #14110D; color: #FFFDF5; padding: 4px 12px; border-radius: var(--radius-full); }
  .gear__price { font-family: var(--font-serif); font-size: var(--font-size-h2); font-weight: var(--font-weight-bold); line-height: 1; color: var(--color-text); }
  .gear__note { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-full); background: var(--color-secondary-yellow); color: #14110D; font-size: var(--font-size-small); font-weight: var(--font-weight-semibold); width: fit-content; }
  @media (max-width: 640px) { .gear { grid-template-columns: 1fr; } }

  /* Pilot AI */
  .pilot { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--space-8); align-items: center; }
  .pilot__media { margin: 0; display: flex; justify-content: center; }
  .pilot__media img { width: 100%; max-width: 440px; height: auto; filter: drop-shadow(var(--shadow-lg)); }
  .pilot__text > * + * { margin-top: var(--space-4); }
  .pilot__badge { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; padding: var(--space-3) var(--space-5); border-radius: var(--radius-full); background: rgba(255, 253, 245, 0.06); border: 1px solid var(--color-border-on-dark); color: var(--color-text-on-dark); font-size: var(--font-size-small); width: fit-content; }
  .pilot__badge :global(svg) { color: var(--color-secondary-yellow); }
  @media (max-width: 820px) { .pilot { grid-template-columns: 1fr; gap: var(--space-6); } .pilot__media { order: -1; } }

  /* Souhrn ceníku */
  .summary { list-style: none; display: grid; gap: var(--space-5); grid-template-columns: repeat(4, 1fr); }
  .summary__item { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); text-align: center; align-items: center; }
  .summary__tag { font-size: var(--font-size-caption); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); color: var(--color-text-accent); }
  .summary__num { font-family: var(--font-serif); font-size: var(--font-size-h3); font-weight: var(--font-weight-bold); color: var(--color-text); line-height: 1.1; }
  .summary__num em { font-family: var(--font-sans); font-style: normal; font-size: var(--font-size-small); font-weight: var(--font-weight-medium); color: var(--color-text-muted); }
  .summary__note { font-size: var(--font-size-small); color: var(--color-text-muted); }
  @media (max-width: 820px) { .summary { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .summary { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq { max-width: 760px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-3); }
  .faq__item { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); padding: 0 var(--space-5); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) 0; cursor: pointer; font-weight: var(--font-weight-semibold); list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__chev { transition: transform var(--duration-base) var(--easing); color: var(--color-text-muted); }
  .faq__item[open] .faq__chev { transform: rotate(180deg); }
  .faq__a { padding-bottom: var(--space-5); }
</style>
