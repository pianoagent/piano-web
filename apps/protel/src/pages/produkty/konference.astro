<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="/produkty/konference#rezervace-mistnosti"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Rezervace místností" decoding="async" loading="lazy" src="/files/produkt-rezervace-mistnosti.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Rezervace místností<span class="text-highlight">.</span></h4>
