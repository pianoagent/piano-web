import Novinky from '../../components/blocks/Novinky.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
---
<Base
  title="Room Service | Hotel PMS Protel"
  description="Náš Room Service je naprostá rarita! Stačí načíst QR kód a host má ihned nabídku Room Service ve svém telefonu. Protel sám pozná, ze kterého pokoje host objednává a napojený restaurační systém Septim se postará o vše v kuchyni i na baru. Plně automatizovaně a jednoduše."
  path="/produkty/room-service"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  image="/files/nahled-room-service.jpg"
>
<div class="section height--low align--middle color--default section-width-wide section-has-background" id="uvod"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#grandhotel-pupp" style="padding-bottom:91.14583333333334%"><img alt="Room Service" decoding="async" sizes="(min-width:1459px) 50vw, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-top-room-service.webp" srcset="/files/r/720/hdr-top-room-service.webp 720w, /files/r/1280/hdr-top-room-service.webp 1280w, /files/r/1920/hdr-top-room-service.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p><a href="/produkty"><strong><span class="text-highlight"><span style="font-family: var(--headings-font-family); font-style: var(--headings-text-italic); text-transform: var(--headings-text-transform); text-decoration: var(--headings-text-underline); caret-color: rgb(255, 0, 150);"><font color="#ff0096" size="3">VŠECHNY PRODUKTY</font></span></span></strong></a></p>
<h1>Room Service</h1>
<p class="text-large">Náš Room Service je naprostá rarita! Stačí načíst QR kód a host má ihned nabídku Room Service ve svém telefonu. Protel sám pozná, ze kterého pokoje host objednává a napojený <a href="/napojeni/restauracni-system-septim">restaurační systém Septim</a> se postará o vše v kuchyni i na baru. Plně automatizovaně a jednoduše.</p>
<p class="text-large"><a href="#funkce"><strong><span class="text-highlight"><span style="font-family: var(--headings-font-family); font-style: var(--headings-text-italic); text-transform: var(--headings-text-transform); text-decoration: var(--headings-text-underline); caret-color: rgb(255, 0, 150);"><font color="#ff0096" size="3">ZJISTIT VÍCE →</font></span></span></strong></a></p>
</div><div class="image-btn"><a class="btn btn-default" href="#grandhotel-pupp"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">UKÁZKA</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-inline"><h2 class="center">Jak to děláme v Grandhotelu PUPP?</h2>
</div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-video" id="grandhotel-pupp"><div class="embed-container ratio-widescreen"><iframe allowfullscreen="" frameborder="0" loading="lazy" src="https://www.youtube.com/embed/YGvQ2HNgTHg" title="Externí video"></iframe></div></div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CHCI PODOBNÉ ŘEŠENÍ</span></a></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<Mezera />
<PojdmeToProbrat />
<Mezera />
<div class="section height--low align--middle color--default section-has-background" id="funkce"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="container height--low color--auto container-width-boxed box--benefits"><div class="container-body flex flex--justify-start flex--wrap">
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#objednavky-bez-volani"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Objednávky bez volání" decoding="async" loading="lazy" src="/files/ico-roomservice-objednavky-bez-volani.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Objednávky bez volání<span class="text-highlight">.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#objednavky-bez-volani"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To mě zajímá</span></a></div></div></div></div></div></div>
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#plna-automatizace-systemu"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Plná automatizace systému" decoding="async" loading="lazy" src="/files/ico-roomservice-plna-automatizace-systemu.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Plná automatizace systému</span></font>.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#plna-automatizace-systemu"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To mě zajímá</span></a></div></div></div></div></div></div>
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#mene-prace-vice-kontroly"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Méně práce, více kontroly" decoding="async" loading="lazy" src="/files/ico-hotelovy-system.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Méně práce, více kontroly<span class="text-highlight">.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#mene-prace-vice-kontroly"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To mě zajímá</span></a></div></div></div></div></div></div>
</div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<Mezera />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="objednavky-bez-volani"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="Objednávka bez volání" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-objednavky-bez-volani.webp" srcset="/files/r/720/produkt-objednavky-bez-volani.webp 720w, /files/r/1280/produkt-objednavky-bez-volani.webp 1280w, /files/r/1920/produkt-objednavky-bez-volani.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Objednávka bez volání<span class="text-highlight">.</span></h2>
<p>Online Room Service umožňuje hostům objednávat jídlo a nápoje na pokoj přímo z jejich mobilního telefonu prostřednictvím QR kódu nebo odkazu. Host tak nemusí kontaktovat recepci ani čekat na spojení – celý proces objednávky probíhá rychle a přehledně. Vše zcela digitálně.</p>
<p>Objednávkové rozhraní je vždy aktuální a reflektuje skutečnou nabídku hotelové restaurace nebo baru. Díky tomu se minimalizují chyby v objednávkách a zvyšuje se komfort hosta, který má plnou kontrolu nad svou objednávkou kdykoliv během pobytu.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ZAJÍMÁ MĚ VÍCE</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<Mezera />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="plna-automatizace-systemu"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="Plná automatizace systému" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-plna-automatizace.webp" srcset="/files/r/720/produkt-plna-automatizace.webp 720w, /files/r/1280/produkt-plna-automatizace.webp 1280w, /files/r/1920/produkt-plna-automatizace.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Plná automatizace systému</span></font>.</span></h2>
<p>Room Service je plně automatizovaný díky přímému propojení hotelového systému Protel a <a href="/napojeni/restauracni-system-septim">restauračního systému Septim</a>. Objednávky se okamžitě a bez zásahu personálu propisují přímo do gastronomického provozu.</p>
<p>Recepce není zatěžována přepisováním ani telefonickým předáváním informací mezi kuchyní a barem. Díky této automatizaci je celý proces Room Service rychlejší, přesnější a výrazně méně náchylný k chybám, které běžně vznikají při ruční komunikaci.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ZAJÍMÁ MĚ VÍCE</span></a></div></div></div></div></div></div></div></div></div>
<Mezera />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="mene-prace-vice-kontroly"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="Méně práce, více kontroly" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-mene-prace-vice-kontroly.webp" srcset="/files/r/720/produkt-mene-prace-vice-kontroly.webp 720w, /files/r/1280/produkt-mene-prace-vice-kontroly.webp 1280w, /files/r/1920/produkt-mene-prace-vice-kontroly.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Méně práce, více kontroly<span class="text-highlight">.</span></h2>
<p>Online Room Service přináší hotelu výrazné provozní výhody. Snižuje zátěž recepce, zrychluje obsluhu hostů a zajišťuje lepší přehled nad objednávkami v reálném čase. Personál se může soustředit na služby hostům místo řešení operativních telefonátů.</p>
<p>Řešení je dlouhodobě ověřené v ostrém hotelovém provozu, například v Grandhotel Pupp. Díky automatizaci a přímé integraci systémů získává hotel vyšší efektivitu, lepší kontrolu nad procesy a moderní Room Service odpovídající očekáváním dnešních hostů.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ZAJÍMÁ MĚ VÍCE</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<VyzkousetZdarma />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktni-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/vyhoda-hoteloveho-systemu-protel.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> V Česku výjimečné řešení!<br/>
Nabízíme do Vašeho hotelu plně automatizovaný Online Room Service bez zbytečných mezikroků a telefonické komunikace.</h2>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">SPOJTE SE S NÁMI</span></a></div></div></div></div></div></div></div></div></div>
