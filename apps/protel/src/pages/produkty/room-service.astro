---
// https://www.protelsystems.cz/produkty/room-service (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import Mezera from '../../components/blocks/Mezera.astro';
import PojdmeToProbrat from '../../components/blocks/PojdmeToProbrat.astro';
import VyzkousetZdarma from '../../components/blocks/VyzkousetZdarma.astro';
