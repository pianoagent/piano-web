---
// https://www.protelsystems.cz/protel-pro-skoly (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from './../layouts/Base.astro';
import PojdmeToProbrat from './../components/blocks/PojdmeToProbrat.astro';
import Mezera from './../components/blocks/Mezera.astro';
import DaleByVasMohloZajimat from './../components/blocks/DaleByVasMohloZajimat.astro';
import VyzkousetZdarma from './../components/blocks/VyzkousetZdarma.astro';
import Novinky from './../components/blocks/Novinky.astro';
---
<Base
  title="Protel pro školy | Hotel PMS Protel"
  description="Nyní máte možnost využít špičkový hotelový systém Protel pro Vaši školu zcela ZDARMA a připravit tak své studenty na reálný svět hotelového průmyslu. Studenti si osvojí praktické dovednosti, které jim umožní hladký přechod do praxe a zajistí, že budou na svou budoucí kariéru dokonale připraveni."
  path="/protel-pro-skoly"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  image="/files/nahled-protel-pro-skoly.jpg"
>
<div class="section height--high align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-primary btn-sm" href="/o-protelu"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">O PROTELU</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Protel pro školy.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><p class="text-large">Jmenuji se Protel. Jsem Vaše chytrá asistentka, která pomůže studentům otevřít dveře reálného světa hotelové praxe.</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-default btn-sm" href="/protel-pro-skoly#demo-zdarma"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">JAK TO FUNGUJE?</span></a></div></div></div></div></div><div class="section-background container-fit container-fit--cover fx-background-zoom-out" style="background-color:rgb(255, 0, 150)"><img alt="" decoding="async" sizes="(orientation: portrait) 416.47vw, 100vw" src="/files/r/1280/hdr-protel-pro-skoly.webp" srcset="/files/r/720/hdr-protel-pro-skoly.webp 720w, /files/r/1280/hdr-protel-pro-skoly.webp 1280w, /files/r/1920/hdr-protel-pro-skoly.webp 1920w"/></div></div>
<PojdmeToProbrat />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="demo-zdarma"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/protel-pro-skoly#kontakt" style="padding-bottom:100%"><img alt="Demo ZDARMA" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/protel-pro-skoly-demo.webp" srcset="/files/r/720/protel-pro-skoly-demo.webp 720w, /files/r/1280/protel-pro-skoly-demo.webp 1280w, /files/r/1920/protel-pro-skoly-demo.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Demo ZDARMA<span class="text-highlight">.</span></h2>
<p>Nyní máte možnost využít <a href="/produkty/hotelovy-system">špičkový hotelový systém Protel</a> pro Vaši školu zcela ZDARMA a připravit tak své studenty na reálný svět hotelového průmyslu. Studenti si osvojí praktické dovednosti, které jim umožní hladký přechod do praxe a zajistí, že budou na svou budoucí kariéru dokonale připraveni. </p>
<h3 class="text-large"><span class="text-highlight">1x přístup</span> do sdílené databáze<span class="text-highlight">.</span></h3>
<p>Zcela ZDARMA získáte 1x přístup pro pedagoga do sdílené demo databáze, na které může vyučující prezentovat studentům (např. na dataprojektoru), jak systém funguje.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/protel-pro-skoly#kontakt"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">MÁM ZÁJEM</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<Mezera />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/protel-pro-skoly#kontakt" style="padding-bottom:100%"><img alt="Celá třída jen 650 Kč za měsíc" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/protel-pro-skoly-placeny.webp" srcset="/files/r/720/protel-pro-skoly-placeny.webp 720w, /files/r/1280/protel-pro-skoly-placeny.webp 1280w, /files/r/1920/protel-pro-skoly-placeny.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Celá třída jen 650 Kč za měsíc<span class="text-highlight">.</span></h2>
<p>V rámci demo verze získáte zdarma jeden přístup do sdílené databáze systému Protel. Chcete-li však využít plného potenciálu pro Vaši školu a Vaše studenty, nabízíme za 650 Kč měsíčně 29 plných přístupů pro studenty a přístup pro pedagoga. V této placené verzi nejen že získáte přístup do databáze, ale Vaši studenti si mohou vytvořit a spravovat "vlastní hotel", stejně jako v reálném životě. Vaši studenti tak budou mít možnost pracovat s reálnými scénáři, a nabýt praktické dovednosti již od prvních dnů svého studia, s kterými se pak potkají ve své budoucí praxi. </p>
<h3 class="text-large"><span class="text-highlight">29x plných přístupů pro studenty</span> + 1 plný přístup pro pedagoga<span class="text-highlight">.</span></h3>
<p>Navíc možnost <a href="/produkty/konference">5x konferenční místnost</a> za 150 Kč za měsíc/třída.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/protel-pro-skoly#kontakt"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">MÁM ZÁJEM</span></a></div></div></div></div></div></div></div></div></div>
<Mezera />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/protel-pro-skoly#kontakt" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/vyhoda-hoteloveho-systemu-protel.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Vaši studenti budou od prvních dnů studia pracovat s reálným systémem, který pak potkají ve své hotelové praxi. Díky tomu budou lépe připraveni na svou budoucí kariéru v hotelnictví.</h2>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/protel-pro-skoly#kontakt"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">SPOJTE SE S NÁMI</span></a></div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.youtube.com/@protelsystems/videos" rel="noopener" style="padding-bottom:76.92307692307693%" target="_blank"><img alt="Podívejte se na Protel v praxi" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/videa-na-youtube.webp" srcset="/files/r/720/videa-na-youtube.webp 720w, /files/r/1280/videa-na-youtube.webp 1280w, /files/r/1920/videa-na-youtube.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Podívejte se na Protel v praxi<span class="text-highlight">.</span></h2>
<p>Systém Protel je nejrespektovanější hotelový systém, který používají špičky ve svém oboru. Dozvíte se, jak Protel používat a další novinky.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://www.youtube.com/@protelsystems/videos" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PROHLÉDNOUT SI PROTEL VIDEA</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<div class="section height--normal align--middle color--default col-gaps-bigger section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Co o Protelu říkají odborníci z hotelové praxe?</h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="Marián Madara" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/marian-madara.webp" srcset="/files/r/720/marian-madara.webp 720w, /files/r/1280/marian-madara.webp 1280w, /files/r/1920/marian-madara.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Podiel priameho online predaja neustále zvyšujeme aj vďaka možnostiam dynamickej cenotvorby a prepojenia s CRM, ktoré systém protel umožňuje.
</blockquote><div class="block-quote-author"><span class="quote-decor">–</span> Marián Madara <span class="quote-decor">–</span><span class="block-quote-info">TMR Hotels, PMS Master User | Department management </span></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="Eliška Škubalová" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/eliska-skubalova.webp" srcset="/files/r/720/eliska-skubalova.webp 720w, /files/r/1280/eliska-skubalova.webp 1280w, /files/r/1920/eliska-skubalova.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Protel v našem hotelu využíváme již mnoho let a za tu dobu nám byl vždy oporou v každodenním fungování hotelu. Velmi vstřícný support je velkým bonusem. </blockquote><div class="block-quote-author"><span class="quote-decor">–</span> Eliška Škubalová <span class="quote-decor">–</span><span class="block-quote-info">GRAND HOTEL BOHEMIA, Director of Sales</span></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="Miroslav Bukva" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/miroslav-bukva.webp" srcset="/files/r/720/miroslav-bukva.webp 720w, /files/r/1280/miroslav-bukva.webp 1280w, /files/r/1920/miroslav-bukva.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Vybrat do hotelu vhodný software není jednoduché, protože různé typy hotelů mají odlišné potřeby. Pro velký hotel s konferenčním centrem je robustní řešení PMS PROTEL naprosto ideální. PROTEL je výborný jak z hlediska výkonu, tak ceny a důležitou samozřejmostí je velmi kvalitní podpora.</blockquote><div class="block-quote-author"><span class="quote-decor">–</span> Miroslav Bukva <span class="quote-decor">–</span><span class="block-quote-info">Aquapalace Hotel Prague, General Manager</span></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/nasi-zakaznici"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAŠI ZÁKAZNÍCI</span></a></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--high align--middle color--inverse section-width-boxed section-has-background" id="kontakt"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h2>Zní to pro Vás a Vaši školu zajímavě? Kontaktujte mého kolegu Kamila.</h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h2><a href="tel:+420775890106">+420 775 890 106</a></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><p class="text-large"><a href="mailto:kamil.koncel@protelsystems.cz">kamil.koncel@protelsystems.cz</a></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-default btn-sm" href="/kontakt"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">KONTAKT</span></a></div></div></div></div></div><div class="section-background container-fit container-fit--cover fx-background-zoom-out" style="background-color:rgb(255, 0, 150)"><img alt="" decoding="async" loading="lazy" sizes="(orientation: portrait) 416.47vw, 100vw" src="/files/r/1280/hdr-protel-pro-skoly-kontakt.webp" srcset="/files/r/720/hdr-protel-pro-skoly-kontakt.webp 720w, /files/r/1280/hdr-protel-pro-skoly-kontakt.webp 1280w, /files/r/1920/hdr-protel-pro-skoly-kontakt.webp 1920w" style="object-position:50% 100%"/></div></div>
<DaleByVasMohloZajimat />
<VyzkousetZdarma />
<Novinky />
</Base>
