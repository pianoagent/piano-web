---
// https://www.protelsystems.cz/podpora (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from './../layouts/Base.astro';
import FormularPodpora from './../components/blocks/FormularPodpora.astro';
import ZnalostniDatabaze from './../components/blocks/ZnalostniDatabaze.astro';
import PojdmeToProbrat from './../components/blocks/PojdmeToProbrat.astro';
---
<Base
  title="Podpora | Hotel PMS Protel"
  description="Patříte již do rodiny Protel a nevíte si rady? Zde jsou kontakty pro okamžitou pomoc..."
  path="/podpora"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  image="/files/nahled-kontakt.jpg"
>
<div class="section height--low align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Podpora produktů Protel<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Podpora z ČR, žádné callcentrum v zahraničí. Komunikujte s odborníky, kteří mluví česky.</h3>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--default"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center"><strong style="font-family: var(--base-font-family); font-size: 16px;">VZDÁLENÁ PODPORA <span class="text-highlight">TEAMVIEWER</span></strong><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;"><span class="text-highlight"> </span>WINDOWS</strong></span></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/ico-vzdalena-podpora-windows.svg"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="https://download.teamviewer.com/download/TeamViewerQS_x64.exe" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Mám počítač s Windows</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--default"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center"><strong style="font-family: var(--base-font-family); font-size: 16px;">VZDÁLENÁ PODPORA <span class="text-highlight">TEAMVIEWER</span></strong><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;"><span class="text-highlight"> </span>APPLE MAC</strong></span></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/ico-vzdalena-podpora-apple.svg"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="https://download.teamviewer.com/download/TeamViewerQS.dmg" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Mám Apple macOS</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/cenik-servisnich-sluzeb"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CENÍK SERVISNÍCH SLUŽEB</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center text-large">Patříte již do rodiny Protel a nevíte si rady? Níže naleznete kontakty pro okamžitou pomoc. Připravte si Váš servisní kód.</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-image img-text-info icon-helpdesk"><div><div class="image image-mask ratio-original image-has-caption" style="padding-bottom:66.66666666666666%"><img alt="" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/podpora-helpdesk.webp" srcset="/files/r/720/podpora-helpdesk.webp 720w, /files/r/1280/podpora-helpdesk.webp 1280w, /files/r/1920/podpora-helpdesk.webp 1920w"/></div><div class="image-caption image-caption-bottom"><div class="image-caption-wrapper"><div class="text-block"><p><strong>HELPDESK <span class="text-highlight">V PRACOVNÍ DOBU PO – PÁ: 8:30 - 17:00</span></strong></p>
<h2><a href="tel:+420257011107">+420 257 011 107</a></h2>
<p><u><a href="mailto:help@protelsystems.cz">help@protelsystems.cz</a></u></p>
</div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image img-text-info icon-hotline"><div><div class="image image-mask ratio-original image-has-caption" style="padding-bottom:66.66666666666666%"><img alt="" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/podpora-hotline.webp" srcset="/files/r/720/podpora-hotline.webp 720w, /files/r/1280/podpora-hotline.webp 1280w, /files/r/1920/podpora-hotline.webp 1920w"/></div><div class="image-caption image-caption-bottom"><div class="image-caption-wrapper"><div class="text-block"><p><strong>HOTLINE<span class="text-highlight"> MIMO PRACOVNÍ DOBU</span></strong></p>
<h2><a href="tel:+420778776835">+420 778 776 835</a></h2>
<p><u><a href="mailto:help@protelsystems.cz">help@protelsystems.cz</a></u></p>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default btn-sm" href="/podpora#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">KONTAKTNÍ FORMULÁŘ</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<FormularPodpora />
<ZnalostniDatabaze />
<PojdmeToProbrat />
</Base>
