---
/**
 * Protel: Kontakt. Údaje ze starého webu protelsystems.cz / protel-context.md.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '@piano/ui/components/Section.astro';
import ContactCards from '@piano/ui/components/ContactCards.astro';
import Heading from '@piano/ui/components/Heading.astro';
import Text from '@piano/ui/components/Text.astro';
import Icon from '@piano/ui/components/Icon.astro';
import LeadForm from '@piano/ui/components/LeadForm.astro';
import { protelLeadProofs } from '../config/leadProofs';

const contacts = [
  { icon: 'lucide:briefcase', label: 'Obchod', value: 'sales@protelsystems.cz', href: 'mailto:sales@protelsystems.cz' },
  { icon: 'lucide:phone', label: 'Obchod: telefon', value: '+420 257 011 107', href: 'tel:+420257011107' },
  { icon: 'lucide:life-buoy', label: 'Hotline', value: 'help@protelsystems.cz', href: 'mailto:help@protelsystems.cz' },
  { icon: 'lucide:phone-call', label: 'Hotline: telefon', value: '+420 778 776 835', href: 'tel:+420778776835' },
  { icon: 'lucide:map-pin', label: 'Sídlo', value: 'protel systems s.r.o., Thámova 166/18, 186 00 Praha 8 – Karlín' },
];
---

<Base title="Kontakt | Protel" description="Spojte se s týmem Protel. Obchodní kontakty, hotline pro zákazníky i adresa sídla společnosti protel systems s.r.o.">
  <SiteHeader />

  <main>
    <ContactCards items={contacts} variant="boxed" background="alt" space="lg"
      eyebrow="Kontakt" headingAs="h1"
      titleHtml={'Pojďme to <em>probrat</em>'}
      lead="Co byste u Vás v hotelu rádi zlepšili? Ozvěte se nám, připravíme řešení na míru." />

    <LeadForm proofs={protelLeadProofs} id="poptavka" variant="full" background="default"
              title="Napište nám"
              lead="Nechte nám kontakt, ozveme se a ukážeme Protel přímo ve Vašem hotelu." />
  </main>

  <SiteFooter />
</Base>

<style>
  .head { max-width: 760px; margin-inline: auto; margin-bottom: var(--space-7); }
  .head--center { text-align: center; }
  .head > * + * { margin-top: var(--space-3); }
</style>
