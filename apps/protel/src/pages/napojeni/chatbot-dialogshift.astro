---
// https://www.protelsystems.cz/napojeni/chatbot-dialogshift (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import PojdmeToProbrat from '../../components/blocks/PojdmeToProbrat.astro';
import KolikMeToBudeStat from '../../components/blocks/KolikMeToBudeStat.astro';
import MezeraB from '../../components/blocks/MezeraB.astro';
import NapojeniPartneri from '../../components/blocks/NapojeniPartneri.astro';
import NapojeniVypis from '../../components/blocks/NapojeniVypis.astro';
import CitaceProtel from '../../components/blocks/CitaceProtel.astro';
import DaleByVasMohloZajimat from '../../components/blocks/DaleByVasMohloZajimat.astro';
import VyzkousetZdarma from '../../components/blocks/VyzkousetZdarma.astro';
import Novinky from '../../components/blocks/Novinky.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
---
<Base
  title="Hotel AI DialogShift | Hotel PMS Protel"
  description="AI hotel poháněný Open AI! Hotely všech velikostí spoléhají na generativní umělou inteligenci DialogShift poháněnou GPT, která automaticky odpovídá na opakované dotazy hostů, zlepšuje dostupnost, služby pro hosty a generuje více přímých rezervací."
  path="/napojeni/chatbot-dialogshift"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  image="/files/nahled-napojeni-dialog-shift-new.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/napojeni"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENÍ</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1>Hotel AI - DialogShift.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojeni"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-dialogshift-new.webp" srcset="/files/r/720/hdr-napojeni-dialogshift-new.webp 720w, /files/r/1280/hdr-napojeni-dialogshift-new.webp 1280w, /files/r/1920/hdr-napojeni-dialogshift-new.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> AI hotel poháněný Open AI! Hotely všech velikostí spoléhají na generativní umělou inteligenci DialogShift poháněnou GPT, která automaticky odpovídá na opakované dotazy hostů, zlepšuje dostupnost, služby pro hosty a generuje více přímých rezervací.</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image no-edge-mobile block-image--light-blue mobile-order-reverse"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-middle align-left flexcard-media--stretch"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/case/villa-sandy-resort" style="padding-bottom:50%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/case-study-villa-sandy-resort-hdr.webp" srcset="/files/r/720/case-study-villa-sandy-resort-hdr.webp 720w, /files/r/1280/case-study-villa-sandy-resort-hdr.webp 1280w, /files/r/1920/case-study-villa-sandy-resort-hdr.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Jak AI chatbot DialogShift pomohl ve VILLA SANDY?</span></font></span></h2>
<p><strong style="font-family: var(--base-font-family); font-size: 16px;">CASE STUDY → 2 MINUTY ČTENÍ</strong></p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/case/villa-sandy-resort"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PŘEČÍST CASE STUDY</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo DialogShift" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-dialog-shift-new.svg"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">DialogShift</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">💬 Chatbot AI</h3>
<p>Snadná integrace na Vaše webové stránky, do modulu online check-in (např. Straiv) i do rezervačního systému. Chatbot zodpoví dotazy ohledně dostupnosti pokojů, nabídek a služeb hotelu v reálném čase. Podporuje přímé rezervace – hosty přesměruje na správný krok v rezervačním procesu. Díky centrální znalostní bázi jsou odpovědi vždy aktuální a konzistentní.</p>
<h3>📞 Phone AI</h3>
<p>Umělá inteligence samostatně přijímá hovory a komunikuje s hosty přirozeným hlasem. Umí odpovědět na dotazy v jazyce hosta, zkontrolovat dostupnost, poslat rezervační odkaz přes SMS nebo WhatsApp. Skvělé řešení pro odlehčení recepci – dostupné i mimo pracovní dobu.</p>
<h3>✉️ Email AI</h3>
<p>Chytrá e-mailová asistence vytváří návrhy odpovědí na zprávy hostů (např. přes Outlook plugin). Využívá hotelovou znalostní bázi, respektuje tón vaší značky a umí vložit i personalizované odkazy na rezervace. Zrychluje reakční dobu a zajišťuje profesionální komunikaci.</p>
<h3>🧠 Centrální znalostní databáze</h3>
<p>Všechny AI moduly sdílejí stejnou uzavřenou znalostní databázi, která je plně pod kontrolou hotelu. Jedná se o přesně definovaný soubor informací, které si hotel sám spravuje – AI tedy nečerpá data z internetu, ale výhradně z ověřených interních zdrojů. Díky tomu jsou odpovědi vždy konzistentní, aktuální a plně v souladu s požadavky hotelu.</p>
</div></div></div></div></div></div></div></div></div>
<PojdmeToProbrat />
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, které spoléhají na AI umělou inteligenci v hotelu od DialogShift<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Mövenpick" decoding="async" loading="lazy" src="/files/znacka-moevenpick.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Park Inn" decoding="async" loading="lazy" src="/files/znacka-park-inn.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo The Omnia" decoding="async" loading="lazy" src="/files/znacka-the-omnia.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Empire Riverside Hotel" decoding="async" loading="lazy" src="/files/znacka-empire-riverside-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Upstalsboom" decoding="async" loading="lazy" src="/files/znacka-upstalsboom.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<KolikMeToBudeStat />
<MezeraB />
<NapojeniPartneri />
<NapojeniVypis />
<CitaceProtel />
<KolikMeToBudeStat />
