---
// https://www.protelsystems.cz/napojeni/platebni-reseni-planet (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import PojdmeToProbrat from '../../components/blocks/PojdmeToProbrat.astro';
import KolikMeToBudeStat from '../../components/blocks/KolikMeToBudeStat.astro';
import MezeraB from '../../components/blocks/MezeraB.astro';
import NapojeniPartneri from '../../components/blocks/NapojeniPartneri.astro';
import NapojeniVypis from '../../components/blocks/NapojeniVypis.astro';
import CitaceProtel from '../../components/blocks/CitaceProtel.astro';
import DaleByVasMohloZajimat from '../../components/blocks/DaleByVasMohloZajimat.astro';
import VyzkousetZdarma from '../../components/blocks/VyzkousetZdarma.astro';
import Novinky from '../../components/blocks/Novinky.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
---
<Base
  title="Platební řešení Planet | Hotel PMS Protel"
  description="Platební řešení Planet jsou superflexibilní moderní platební řešení, skvěle fungující. Online i osobně. Dokonale sednou na míru každému provozu!"
  path="/napojeni/platebni-reseni-planet"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  image="/files/nahled-napojeni-planet.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/napojeni"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENÍ</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Platební řešení Planet.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojeni"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-planet.webp" srcset="/files/r/720/hdr-napojeni-planet.webp 720w, /files/r/1280/hdr-napojeni-planet.webp 1280w, /files/r/1920/hdr-napojeni-planet.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Platební řešení Planet jsou superflexibilní moderní platební řešení, skvěle fungující. Online i osobně. Dokonale sednou na míru každému provozu!</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Planet" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-planet.svg"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Planet</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Integrované platební řešení Planet Vám zajistí rychlou a bezchybnou práci s platbami na Vaší recepci či rezervačním oddělení.</h3>
<p>Stažení platby za pobyt u rezervací či platba na recepci bez nutnosti práce s terminálem zrychluje interní procesy a tím získáte více času pro komunikaci s hostem a zajištění plynulejšího provozu Vašeho hotelu.</p>
</div></div></div></div></div></div></div></div></div>
<PojdmeToProbrat />
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, které spoléhají na platební řešení Planet<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Vinice Hnanice" decoding="async" loading="lazy" src="/files/ref-vinice-hnanice.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Cosmopolitan" decoding="async" loading="lazy" src="/files/ref-hotel-cosmopolitan.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Savoy Prague" decoding="async" loading="lazy" src="/files/ref-savoy-hotel-prague.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Imperial" decoding="async" loading="lazy" src="/files/ref-imperial.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Clement Prague" decoding="async" loading="lazy" src="/files/ref-hotel-clement-prague.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Restart" decoding="async" loading="lazy" src="/files/ref-hotel-restart.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<KolikMeToBudeStat />
<MezeraB />
<NapojeniPartneri />
<NapojeniVypis />
<CitaceProtel />
<KolikMeToBudeStat />
<DaleByVasMohloZajimat />
<VyzkousetZdarma />
<Novinky />
<KontaktniFormular />
</Base>
