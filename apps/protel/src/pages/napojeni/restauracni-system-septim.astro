---
// https://www.protelsystems.cz/napojeni/restauracni-system-septim (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import PojdmeToProbrat from '../../components/blocks/PojdmeToProbrat.astro';
import KolikMeToBudeStat from '../../components/blocks/KolikMeToBudeStat.astro';
import MezeraB from '../../components/blocks/MezeraB.astro';
import NapojeniPartneri from '../../components/blocks/NapojeniPartneri.astro';
import NapojeniVypis from '../../components/blocks/NapojeniVypis.astro';
import CitaceProtel from '../../components/blocks/CitaceProtel.astro';
import DaleByVasMohloZajimat from '../../components/blocks/DaleByVasMohloZajimat.astro';
import VyzkousetZdarma from '../../components/blocks/VyzkousetZdarma.astro';
import Novinky from '../../components/blocks/Novinky.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
---
<Base
  title="Restaurační systém Septim | Hotel PMS Protel"
  description="Restaurační systém Septim je nejrespektovanější software pro restaurace v ČR. Michelinské restaurace, přední sítě top restaurací a známí šéfkuchaři používají ve svých provozech právě Septim."
  path="/napojeni/restauracni-system-septim"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  image="/files/nahled-napojeni-septim.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/napojeni"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENÍ</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Restaurační systém Septim.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojeni"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-septim.webp" srcset="/files/r/720/hdr-napojeni-septim.webp 720w, /files/r/1280/hdr-napojeni-septim.webp 1280w, /files/r/1920/hdr-napojeni-septim.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Restaurační systém Septim je nejrespektovanější software pro restaurace v ČR. Michelinské restaurace, přední sítě top restaurací a známí šéfkuchaři používají ve svých provozech právě Septim.</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.cz" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="Logo Septim" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-septim.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Propojení se systémem Septim zajistí, že si hosté mohou snadno nechat zaslat konzumaci na svůj pokoj a vše uhradit následně jednou platbou při odjezdu.</h3>
<p>Napojení se zároveň zajišťuje přenos všech ostatních uzavřených účtů (obratů i plateb) do PMS, čímž zjednodušuje přehled výsledků celého Vašeho hotelu. Dále je možné ověřit platnost resortní karty/karet. V případě prodeje položek (minibar/drobný prodej) se vše odtíží přímo ve skladovém hospodářství Septim.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="https://www.septim.cz" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VÍCE NA SEPTIM.CZ</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.cz/produkty/automaticke-naskladnovani" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="SPOJUJE NÁS LETITÉ PARTNERSTVÍ S PECOSTA" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/partner-pecosta.webp" srcset="/files/r/720/partner-pecosta.webp 720w, /files/r/1280/partner-pecosta.webp 1280w, /files/r/1920/partner-pecosta.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;">SPOJUJE NÁS LETITÉ PARTNERSTVÍ S PECOSTA</strong></span></h3>
<h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim + Pecosta</span></font>.</span></h3>
<h3>Automatické naskladňování systému Pecosta umožňuje zapisovat dodané zboží přímo na sklady restauračního systému Septim. Vy si jen zkontrolujete, jestli je dodací list v pořádku a při prvním naskladnění vyberete, na který sklad patří.</h3>
<p>Největší výhodou automatického naskladňování v provozním systému Septim je úspora času při přepisování. Už nemusíte ručně přepisovat položky, vybírat kam patří, vypisovat jejich cenu a množství. Tato práce proběhne za zlomek času.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://www.septim.cz/produkty/automaticke-naskladnovani" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VÍCE O PECOSTA</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.cz/produkty/platby-objednavky-qr-kodem" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="DOKONALÁ SPOLUPRÁCE SYSTÉMU SEPTIM A QERKO" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/partner-qerko.webp" srcset="/files/r/720/partner-qerko.webp 720w, /files/r/1280/partner-qerko.webp 1280w, /files/r/1920/partner-qerko.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;">DOKONALÁ SPOLUPRÁCE SYSTÉMU SEPTIM A QERKO</strong></span></h3>
<h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim + QERKO</span></font>.</span></h3>
<h3>Díky partnerství se společností Qerko může pokladní systém Septim nabídnout přelomovou funkci placení QR kódem přímo zákazníky. Aplikace ale nabízí mnohem víc a zákazníci ji milují!</h3>
<p>Nesporné výhody jsou dvě. Zákazníci mohou rychle vyřešit svůj účet a nemusí stát nepříjemnou frontu u pokladny, hlavně v obědové špičce. Druhá související výhoda je úspora času personálu. Ten místo rozpočítávání účtu a vyřizování plateb může dělat šťastnými nové hosty.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://www.septim.cz/produkty/platby-objednavky-qr-kodem" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VÍCE O QERKO</span></a></div></div></div></div></div></div></div></div></div>
<PojdmeToProbrat />
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, které spoléhají na restaurační systém Septim<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Field" decoding="async" loading="lazy" src="/files/znacka-field.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Aromi" decoding="async" loading="lazy" src="/files/znacka-aromi.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo CPI Hotels" decoding="async" loading="lazy" src="/files/znacka-cpi-hotels.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Ambiente" decoding="async" loading="lazy" src="/files/znacka-ambiente.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo O2 arena" decoding="async" loading="lazy" src="/files/znacka-02-arena.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<KolikMeToBudeStat />
<MezeraB />
<NapojeniPartneri />
<NapojeniVypis />
<CitaceProtel />
<KolikMeToBudeStat />
<DaleByVasMohloZajimat />
<VyzkousetZdarma />
<Novinky />
<KontaktniFormular />
</Base>
