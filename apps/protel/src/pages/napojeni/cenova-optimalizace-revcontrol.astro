---
// https://www.protelsystems.cz/napojeni/cenova-optimalizace-revcontrol (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import PojdmeToProbrat from '../../components/blocks/PojdmeToProbrat.astro';
import KolikMeToBudeStat from '../../components/blocks/KolikMeToBudeStat.astro';
import MezeraB from '../../components/blocks/MezeraB.astro';
import NapojeniPartneri from '../../components/blocks/NapojeniPartneri.astro';
import NapojeniVypis from '../../components/blocks/NapojeniVypis.astro';
import CitaceProtel from '../../components/blocks/CitaceProtel.astro';
import DaleByVasMohloZajimat from '../../components/blocks/DaleByVasMohloZajimat.astro';
import VyzkousetZdarma from '../../components/blocks/VyzkousetZdarma.astro';
import Novinky from '../../components/blocks/Novinky.astro';
import KontaktniFormular from '../../components/blocks/KontaktniFormular.astro';
---
<Base
  title="Cenová optimalizace RevControl | Hotel PMS Protel"
  description="RevControl pomáhá hotelům optimalizovat ceny a zvýšit ziskovost na základě historických dat, předpovědí, konkurence a zvolené cenové strategie."
  path="/napojeni/cenova-optimalizace-revcontrol"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  image="/files/nahled-napojeni-revcontrol.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/napojeni"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENÍ</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1>Cenová optimalizace RevControl.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojeni"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-revcontrol.webp" srcset="/files/r/720/hdr-napojeni-revcontrol.webp 720w, /files/r/1280/hdr-napojeni-revcontrol.webp 1280w, /files/r/1920/hdr-napojeni-revcontrol.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> RevControl pomáhá hotelům optimalizovat ceny a zvýšit ziskovost na základě historických dat, předpovědí, konkurence a zvolené cenové strategie. Klientela společnosti zahrnuje přes 550 hotelů a rekreačních zařízení v 18 zemích světa.</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image no-edge-mobile block-image--light-blue mobile-order-reverse"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-middle align-left flexcard-media--stretch"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/case/hotel-savoy-prague" style="padding-bottom:50%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/case-study-hotel-savoy-prague-hdr.webp" srcset="/files/r/720/case-study-hotel-savoy-prague-hdr.webp 720w, /files/r/1280/case-study-hotel-savoy-prague-hdr.webp 1280w, /files/r/1920/case-study-hotel-savoy-prague-hdr.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Jak jsme díky RevControl zvýšili hotelu SAVOY tržby o 37 %?</span></font></span></h2>
<p><strong style="font-family: var(--base-font-family); font-size: 16px;">CASE STUDY → 3 MINUTY ČTENÍ</strong></p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/case/hotel-savoy-prague"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PŘEČÍST CASE STUDY</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo RevControl" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-revcontrol.svg"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">RevControl</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Data o rezervaci a finanční data jsou synchronizována s BI v pravidelných intervalech několikrát za den, kde jsou uchovávána pro účely dalšího pokročilého reportingu včetně možnosti pick-up reportů. RMS doporučí nejlepší prodejní cenu, která se může automaticky zapsat do PMS pro další použití.</h3>
<p>RevControl také slibuje časovou úsporu díky automatizaci procesů a potenciální zvýšení příjmů o 17,5 % ročně díky lepšímu přizpůsobení cen tržním podmínkám. Klíčovou filozofií firmy je vývoj produktu založený na praktických zkušenostech a zpětné vazbě od uživatelů.</p>
</div></div></div></div></div></div></div></div></div>
<PojdmeToProbrat />
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, které spoléhají na cenovou optimalizaci v hotelu od RevControl<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Ardenne" decoding="async" loading="lazy" src="/files/znacka-ardenne.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Horizon" decoding="async" loading="lazy" src="/files/znacka-hotel-horizon.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Alizé" decoding="async" loading="lazy" src="/files/znacka-hotel-alize.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Damier" decoding="async" loading="lazy" src="/files/znacka-hotel-damier.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo 1898 The Post" decoding="async" loading="lazy" src="/files/znacka-1898-the-post.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<KolikMeToBudeStat />
<MezeraB />
<NapojeniPartneri />
<NapojeniVypis />
<CitaceProtel />
<KolikMeToBudeStat />
<DaleByVasMohloZajimat />
<VyzkousetZdarma />
<Novinky />
<KontaktniFormular />
</Base>
