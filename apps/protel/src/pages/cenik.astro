---
// https://www.protelsystems.cz/cenik (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from './../layouts/Base.astro';
import VyzkousetZdarma from './../components/blocks/VyzkousetZdarma.astro';
---
<Base
  title="Ceník | Hotel PMS Protel"
  description="Bez velkých vstupních poplatků můžete používat to, co je top pro české a slovenské hoteliéry."
  path="/cenik"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  image="/files/nahled-produkty.jpg"
>
<div class="section height--low align--middle color--default section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Ceník<span class="text-highlight">.</span></h1>
</div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Vyberte velikost vašeho hotelu</h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-box box box--primary"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-lg align-center"><a class="flexcard-media" href="#ihned-zjistit-cenu"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ico-cenik-30.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p><strong>HOTEL<span class="text-highlight"> DO 30 POKOJŮ</span></strong></p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#ihned-zjistit-cenu"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VYBRAT</span></a></div></div></div></div></div></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-box box box--primary"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-lg align-center"><a class="flexcard-media" href="#ihned-zjistit-cenu"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ico-cenik-60.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p><strong>HOTEL<span class="text-highlight"> DO 60 POKOJŮ</span></strong></p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#ihned-zjistit-cenu"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VYBRAT</span></a></div></div></div></div></div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-box box box--primary"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-lg align-center"><a class="flexcard-media" href="#ihned-zjistit-cenu"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/ico-cenik-120.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p><strong>HOTEL<span class="text-highlight"> DO 120 POKOJŮ</span></strong></p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#ihned-zjistit-cenu"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VYBRAT</span></a></div></div></div></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-5-12 grid-4-12">
<form action="https://databridge.pianopos.cz/api/web-lead" autocomplete="off" class="block block-form" data-lead-form="ihned-zjistit-cenu" id="ihned-zjistit-cenu" method="post">
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="block block-inline"><h2 class="center">Zadejte Váš e-mail a okamžitě zjistíte cenu</h2>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_email" id="ihned-zjistit-cenu-field-wrapper-email">
<div class="field-wrapper">
<label class="visually-hidden" for="ihned-zjistit-cenu-field-email" id="ihned-zjistit-cenu-label-email">
            E-mail <span>*</span>
</label>
<input class="field-control" id="ihned-zjistit-cenu-field-email" name="ihned-zjistit-cenu[email]" placeholder="Váš e-mail" required="" type="email" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_button" id="ihned-zjistit-cenu-field-wrapper-ihned-zjistit-cenu">
<div class="field-wrapper">
<div class="center">
<button class="btn btn-a btn-default" id="ihned-zjistit-cenu-field-ihned-zjistit-cenu" name="ihned-zjistit-cenu[ihned-zjistit-cenu]" type="submit" value="submit"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">IHNED ZJISTIT CENU</span></button>
</div>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="block block-inline"><p class="center">Vaše osobní údaje budou zpracovány podle <a href="/podminky-o-zpracovani-osobnich-udaju-formular">Podmínek zpracování osobních údajů</a>.</p>
</div>
</div>
</div>

<input name="form_variant" type="hidden" value="ihned-zjistit-cenu"/><input name="page" type="hidden" value=""/><div aria-hidden="true" class="visually-hidden"><label>Web <input autocomplete="off" name="website" tabindex="-1" type="text"/></label></div></form>
</div></div></div></div>
<VyzkousetZdarma />
</Base>
