---
// https://www.protelsystems.cz/o-protelu (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from './../layouts/Base.astro';
import PojdmeToProbrat from './../components/blocks/PojdmeToProbrat.astro';
import KolikMeToBudeStat from './../components/blocks/KolikMeToBudeStat.astro';
import VyzkousetZdarma from './../components/blocks/VyzkousetZdarma.astro';
import Novinky from './../components/blocks/Novinky.astro';
import KontaktniFormular from './../components/blocks/KontaktniFormular.astro';
---
<Base
  title="O Protelu | Hotel PMS Protel"
  description="Naším cílem je zpříjemnit a zefektivnit provoz hotelů pro všechny, kteří se podílejí na hotelovém chodu. Od hoteliérů, pokojských přes recepční až po kuchaře v hotelové kuchyni. PMS hotelový systém Protel optimalizuje náklady, šetří lidské zdroje a zlepšuje efektivitu práce."
  path="/o-protelu"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  image="/files/nahled-digitalni-recepce.jpg"
>
<div class="section height--low align--middle color--default section-width-narrow no-pb"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center"><strong><span class="text-highlight">HOTEL PMS PROTEL</span></strong></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">O Protelu<font color="#ff0096"><span style="caret-color: rgb(255, 0, 150);">.</span></font></h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center text-large">Naším cílem je zpříjemnit a zefektivnit provoz hotelů pro všechny, kteří se podílejí na hotelovém chodu. Od hoteliérů, pokojských přes recepční až po kuchaře v hotelové kuchyni. PMS hotelový systém Protel optimalizuje náklady, šetří lidské zdroje a zlepšuje efektivitu práce, čímž vytváří příjemnější a produktivnější pracovní prostředí. Jsme partnerem pro každého, kdo chce svůj hotel řídit moderně. Pro všechny, kteří to myslí se svým hotelem vážně a chtějí svým hostům připravit opravdu skvělý zážitek.</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default btn-sm" href="/vyzkouset-zdarma"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">POJĎME PROBRAT DETAILY</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image no-pb"><div class="image image-mask ratio-original" style="padding-bottom:60.416666666666664%"><img alt="" decoding="async" sizes="(min-width:931px) 931px, (min-width:720px) 100.00vw, 100.00vw" src="/files/r/1280/na-miru-dobrym-hotelum.webp" srcset="/files/r/720/na-miru-dobrym-hotelum.webp 720w, /files/r/1280/na-miru-dobrym-hotelum.webp 1280w, /files/r/1920/na-miru-dobrym-hotelum.webp 1920w"/></div></div></div></div></div></div>
<PojdmeToProbrat />
<div class="section height--low align--middle color--default no-pt section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image block-image--light-blue no-edge-mobile mobile-order-reverse"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-middle align-left flexcard-media--stretch"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/kontakt" style="padding-bottom:55.55555555555556%"><img alt="Jsme jedni z Vás!" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/banner-hp.webp" srcset="/files/r/720/banner-hp.webp 720w, /files/r/1280/banner-hp.webp 1280w, /files/r/1920/banner-hp.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Jsme jedni z Vás!</h2>
<p>Naši konzultanti jsou zkušení odborníci z hotelového byznysu, které nakonec zlákal svět softwaru. Dostáváte tak rady od lidí zkušených z reálných hotelových provozů. Neporadí Vám jen jak nainstalovat Protel, ale pomůžou Vám reálně zvýšit výkonnost celého hotelu.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="/kontakt"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">POJĎME PROBRAT DETAILY</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image has-border-bottom no-edge-mobile block-image--white mobile-order-reverse"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-middle align-left flexcard-media--stretch"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:55.55555555555556%"><img alt="Fantastický hotel" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/banner-uspesny-podnik.webp" srcset="/files/r/720/banner-uspesny-podnik.webp 720w, /files/r/1280/banner-uspesny-podnik.webp 1280w, /files/r/1920/banner-uspesny-podnik.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Fantastický hotel<span class="text-highlight">.</span></h2>
<p>Chceme, aby byl Váš hotel úspěšný. Přímo fantastický! Chceme, aby se k Vám lidé rádi vraceli. Proto se postaráme o efektivní provozní zázemí Vašeho provozu, abyste měli čas a prostor se soustředit na to hlavní: spokojeného hosta!</p>
</div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--low align--middle color--default col-gaps-bigger section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Logo CPI Hotels" decoding="async" loading="lazy" src="/files/ref-cpi.svg"/></a></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Logo Hotel Savoy Prague" decoding="async" loading="lazy" src="/files/ref-savoy-hotel-prague.svg"/></a></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Logo Hotel Cosmopolitan" decoding="async" loading="lazy" src="/files/ref-hotel-cosmopolitan.svg"/></a></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Logo Hotel Perla Praha" decoding="async" loading="lazy" src="/files/ref-hotel-perla-praha.svg"/></a></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Logo Hotel Perk" decoding="async" loading="lazy" src="/files/ref-hotel-perk.svg"/></a></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/vyzkouset-zdarma"><img alt="Vaše logo" decoding="async" loading="lazy" src="/files/ref-vase.svg"/></a></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/kontakt">Kontakt<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-4-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/cenik">Ceník</a><a href="/cenik"><span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-7-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/cenik-servisnich-sluzeb">Ceník servisních služeb<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-10-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/podpora">Helpdesk a Hotline<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/produkty">Produkty<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-4-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/napojeni">Napojení<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-7-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/novinky">Novinky<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-10-12 grid-3-12"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/protel-pro-skoly">Protel pro školy<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div></div></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image no-pt no-pb block-image--light-blue"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-middle align-left flexcard-media--stretch"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/novinky-kariera" style="padding-bottom:55.55555555555556%"><img alt="Kariéra v Protelu" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/banner-protel-kariera.webp" srcset="/files/r/720/banner-protel-kariera.webp 720w, /files/r/1280/banner-protel-kariera.webp 1280w, /files/r/1920/banner-protel-kariera.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Kariéra v Protelu<span class="text-highlight">.</span></h2>
<p>Milujete svět hotelů, pohostinství a máte vztah k technologiím a IT? Kariéra v Protelu Vás zavede k jedničce mezi hotelovými systémy v České republice a na Slovensku. Myslíte, že můžete být přínosem pro Protel? Napište nám na <a href="mailto:kariera@protelsystems.cz">sales@protelsystems.cz</a> a my se Vám ozveme.</p>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<KolikMeToBudeStat />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/o-protelu#kontaktni-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/vyhoda-hoteloveho-systemu-protel.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Protel je globálně respektovaný hotelový systém s plnohodnotnou lokální podporou a dokonalým napojením. Snadné používání, přehlednost a množství pokročilých funkcí z něho dělá jedničku na českém a slovenském trhu!</h2>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="/o-protelu#kontaktni-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">SPOJTE SE S NÁMI</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<VyzkousetZdarma />
<Novinky />
<KontaktniFormular />
</Base>
