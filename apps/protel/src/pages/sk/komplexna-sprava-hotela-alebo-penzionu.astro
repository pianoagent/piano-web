</div></div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-vertical size-lg align-center"><a class="flexcard-media" href="/sk/podpora"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/podpora-nonstop.webp"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p class="text-large"><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;">PODPORA 24/7 NONSTOP</strong></span></p>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="/sk/demo-zadarmo"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VYSKÚŠAŤ ZADARMO</span></a></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
