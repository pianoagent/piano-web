<div class="row-main"><div class="col col-5-12 grid-4-12"><div class="block block-image"><a class="image image-mask ratio-original" href="/sk/demo-zadarmo" style="padding-bottom:114.28571428571428%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 463px, (min-width:720px) 33.33vw, 100.00vw" src="/files/r/1280/protel-setri-cas-penize.webp" srcset="/files/r/720/protel-setri-cas-penize.webp 720w, /files/r/1280/protel-setri-cas-penize.webp 1280w, /files/r/1920/protel-setri-cas-penize.webp 1920w"/></a></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="#lead-form"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PREČO JE PROTEL TAKÝ OBLÚBENÝ?</span></a></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
