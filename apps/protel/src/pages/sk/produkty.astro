---
// https://www.protelsystems.cz/sk/produkty (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import VyzkousetZdarmaSk from '../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Produkty | Hotel PMS Protel"
  description="Hotelové produkty pre váš hotelový podnik. Uvažujete o kúpe hotelového systému Protel pre svoju prevádzku a neviete, čo robiť? Snažili sme sa štruktúrovať našu ponuku produktov tak, aby sme vám čo najviac uľahčili výber."
  path="/sk/produkty"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  locale="sk"
  image="/files/nahled-produkty.jpg"
>
<div class="section height--low align--middle color--default section-width-boxed no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Zvyšujeme hotelom ziskovosť<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-inline"><p class="center text-large">Uvažujete o kúpe hotelového systému Protel pre vašu prevádzku a neviete, čo robiť? Snažili sme sa štruktúrovať našu ponuku produktov tak, aby sme vám čo najviac uľahčili výber.</p>
</div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--low align--middle color--inverse section-width-boxed no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="container color--default tab-links"><div class="container-body flex flex--justify-center flex--wrap">
<div class="flex__item"><div class="block block-inline active"><p><a href="#tab-system-protel">SYSTém protel</a></p>
</div></div>
<div class="flex__item"><div class="block block-inline"><p><a href="#tab-online-check-in-out">online check-in/out</a></p>
</div></div>
<div class="flex__item"><div class="block block-inline"><p><a href="#tab-prislusenstvo">PRÍSLUŠENSTVO</a></p>
</div></div>
</div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--normal align--middle color--default tab-content active tab-system-protel"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline tab-link active"><p><a href="#tab-system-protel">Systém protel</a></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-hotelovy-system-protel.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Hotelový systém Protel<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Protel je celosvetovo uznávaný hotelový systém s plnou miestnou podporou. Napriek jeho jednoduchému používaniu a prehľadnosti vás prekvapí množstvo pokročilých funkcií a možnosť riadiť celú hotelovú prevádzku.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/hotelovy-system-protel"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-platebni-reseni-hotelu.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Riešenie platieb v hoteli<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Protel má vlastné plne integrované platobné riešenie. Vďaka tejto integrácii môžete výrazne zefektívniť spracovanie platieb, minimalizovať chyby a znížiť riziko spätných platieb.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/riesenie-platieb-v-hoteli"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-konference.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Konferencie<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Konferenčný modul, ktorý je automatickou súčasťou hotelového systému Protel, vám ponúka mnoho výhod: rezerváciu konferenčných miestností, monitorovanie dostupnosti miestností, vybavenie, správu stravovania a občerstvenia, fakturáciu za prenájom miestností a služby, správu účastníkov a ich požiadaviek, generovanie správ a ďalšie administratívne úlohy spojené s organizáciou podujatí vo vašom hoteli.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/konferencie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-housekeeping.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Housekeeping<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Digitálne riešenia pre upratovanie prinášajú efektivitu a transparentnosť do procesov upratovania a údržby hotelových izieb. Systém umožňuje jednoduché sledovanie a prideľovanie úloh, kontrolu stavu izieb a komunikáciu medzi zamestnancami. Aj upratovanie vo vašom hoteli môže byť úplne digitálne!</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/housekeeping"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default tab-content tab-online-check-in-out"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline tab-link active"><p><a href="#tab-online-check-in-out">ONLINE CHECK-IN/OUT</a></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-online-check-in-out.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Online check-in/out<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Nástroj na online registráciu/odhlásenie na digitálnej recepcii je možné vďaka partnerstvu so spoločnosťou <a href="https://straiv.io/" target="_blank">Straiv</a>. priamo integrovať do hotelového systému Protel. Vďaka pokročilým a sofistikovaným funkciám môžete skrátiť čas čakania hostí na recepcii, znížiť počet recepčných a zvýšiť predaj doplnkových služieb už pred príchodom. Hostia sa môžu prihlásiť a odhlásiť odkiaľkoľvek...</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/online-check-in-out"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-kiosek.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Kiosk<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Kiosk predstavuje pohodlné alternatívne riešenie pre hostí, ktorí uprednostňujú rýchle prihlásenie/odhlásenie bez návštevy recepcie. Poskytnite svojim hosťom pohodlie, ktoré vyžadujú.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/kiosk"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-digitalni-registracni-karta.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Digitálna registračná karta<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Digitálna registračná karta je elegantný spôsob, ako umožniť hosťom pohodlne vyplniť svoje údaje a stráviť minimum času na recepcii. Vyplnenie je úplne jednoduché prostredníctvom mobilného telefónu hosťa.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/digitalna-registracna-karta"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-digitalni-hotelova-kniha.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Digitálna hotelová kniha<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Spolu s naším partnerom, spoločnosťou <a href="https://straiv.io/" target="_blank">Straiv</a> , predstavujeme digitálnu hotelovú informačnú knihu, ktorá úplne nahradí tlačenú verziu. Tento digitálny nástroj nielenže šetrí náklady na tlač a umožňuje flexibilnú aktualizáciu, ale pôsobí aj ako účinný prostriedok na zvýšenie predaja vybraných služieb priamo v hoteli.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/digitalna-hotelova-kniha"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default tab-content tab-prislusenstvo"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline tab-link active"><p><a href="#tab-prislusenstvo">PRÍSLUŠENSTVo</a></p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-webove-rezervace.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Webové rezervácie<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Online webový formulár na vašej webovej stránke umožňuje vašim hosťom kedykoľvek si u vás rezervovať pobyt.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/webove-rezervacie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-automaticky-mailing.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Automatický mailing<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Automatizovaný mailing hotela zabezpečuje, že dôležité informácie, potvrdenia rezervácií alebo oznámenia sú hosťom zasielané včas bez zásahu recepčného. Vďaka možnosti používať pri vytváraní správ filtre si zachováte personalizáciu a môžete sa lepšie zamerať na potreby jednotlivých hostí.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/automaticky-mailing"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-ctecka-dokladu.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Čítačka dokumentov</span></font>.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Pomocou čítačky môžete rýchlo načítať údaje o hotelových hosťoch priamo z ich dokladov do hotelového systému. Tú istú čítačku potom môžete použiť na načítanie údajov o platobných kartách.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/citacka-dokumentov"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--primary box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" loading="lazy" src="/files/hdr-produkt-hotelove-retezce.webp"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center text-large">Hotelové reťazce<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Ak spravujete dva alebo viac hotelov a chcete dosiahnuť efektivitu, môžete si vybrať riešenie určené špeciálne pre hotelové reťazce. Takto môžete svoje hotelové reťazce spravovať efektívnejšie, znížiť náklady a zlepšiť služby pre hostí. Z jedného miesta!</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/produkty/hotelove-retazce"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PRODUKTE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div></div>
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
