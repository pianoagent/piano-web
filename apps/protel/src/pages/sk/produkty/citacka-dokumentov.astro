import KontaktniFormularSk from '../../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Čítačka dokumentov | Hotel PMS Protel"
  description="Pomocou čítačky môžete rýchlo načítať údaje o hotelových hosťoch priamo z ich dokladov do hotelového systému. Tú istú čítačku potom môžete použiť na načítanie údajov o platobných kartách."
  path="/sk/produkty/citacka-dokumentov"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  locale="sk"
  image="/files/nahled-produkt-ctecka-dokladu.jpg"
>
<div class="section height--low align--middle color--default section-width-wide section-has-background" id="uvod"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="/sk/demo-zadarmo" style="padding-bottom:91.14583333333334%"><img alt="Čítačka dokumentov" decoding="async" sizes="(min-width:1459px) 50vw, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-top-ctecka-dokladu.webp" srcset="/files/r/720/hdr-top-ctecka-dokladu.webp 720w, /files/r/1280/hdr-top-ctecka-dokladu.webp 1280w, /files/r/1920/hdr-top-ctecka-dokladu.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><p><a href="/sk/produkty"><strong><span class="text-highlight"><span style="font-family: var(--headings-font-family); font-style: var(--headings-text-italic); text-transform: var(--headings-text-transform); text-decoration: var(--headings-text-underline); caret-color: rgb(255, 0, 150);"><font color="#ff0096" size="3">PRODUKTY</font></span></span></strong></a></p>
<h1>Čítačka dokumentov</h1>
<p class="text-large">Pomocou čítačky môžete rýchlo načítať údaje o hotelových hosťoch priamo z ich dokladov do hotelového systému. Tú istú čítačku potom môžete použiť na načítanie údajov o platobných kartách. </p>
<p class="text-large"><a href="#funkce"><strong><span class="text-highlight"><span style="font-family: var(--headings-font-family); font-style: var(--headings-text-italic); text-transform: var(--headings-text-transform); text-decoration: var(--headings-text-underline); caret-color: rgb(255, 0, 150);"><font color="#ff0096" size="3">ZISTI VIAC →</font></span></span></strong></a></p>
</div><div class="image-btn"><a class="btn btn-default" href="/sk/demo-zadarmo"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ZADARMO VYSKÚŠAŤ</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo TMR Hotels" decoding="async" src="/files/ref-tmr-hotels-black.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hotel Perk" decoding="async" src="/files/ref-hotel-perk-michelin-key-black.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo CPI Hotels" decoding="async" src="/files/ref-cpi-black.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Mamaison" decoding="async" src="/files/ref-mamaison-black.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" src="/files/ref-fantasticky-hotel-black.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/sk/nasi-zakaznici"><img alt="Vaše logo" decoding="async" src="/files/ref-vasa-2025.svg"/></a></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<MezeraSk />
<div class="section height--low align--middle color--default section-has-background" id="funkcie"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="container height--low color--auto container-width-boxed box--benefits"><div class="container-body flex flex--justify-start flex--wrap">
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#rychlost"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Rýchlosť" decoding="async" loading="lazy" src="/files/produkt-rychlost.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Rýchlosť<span class="text-highlight">.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#rychlost"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To ma zaujíma</span></a></div></div></div></div></div></div>
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#bezchybnost"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Bezchybnosť" decoding="async" loading="lazy" src="/files/produkt-bezchybnost.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Bezchybnosť<span class="text-highlight">.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#bezchybnost"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To ma zaujíma</span></a></div></div></div></div></div></div>
<div class="flex__item flex__item--grow-1 grid-col-3"><div class="block block-image block-image--icon"><div class="flexcard flexcard-icon flexcard-horizontal flexcard-media-right valign-middle size-lg"><a class="flexcard-media" href="#citacka-ako-hardver"><div class="image-icon-wrapper"><div class="image-icon"><img alt="Čítačka ako hardvér" decoding="async" loading="lazy" src="/files/produkt-ctecka-jako-hardware.svg"/></div></div></a><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h4>Čítačka ako hardvér<span class="text-highlight">.</span></h4>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#citacka-ako-hardver"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">To ma zaujíma</span></a></div></div></div></div></div></div>
</div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="rychlost"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Rýchlosť" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-rychlost.webp" srcset="/files/r/720/produkt-rychlost.webp 720w, /files/r/1280/produkt-rychlost.webp 1280w, /files/r/1920/produkt-rychlost.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Rýchlosť<span class="text-highlight">.</span></h2>
<p>Čítačka dokladov v hoteli je rýchlym a efektívnym riešením pre registráciu hostí. Zaznamenanie všetkých údajov z hosťovho dokladu trvá iba niekoľko sekúnd, čo uľahčuje <a href="/sk/produkty/kiosk#rychla-identifikacia-hosta">proces check-inu</a> a skracuje dobu čakania.</p>
</div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="bezchybnost"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Bezchybnosť" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-bezchybnost.webp" srcset="/files/r/720/produkt-bezchybnost.webp 720w, /files/r/1280/produkt-bezchybnost.webp 1280w, /files/r/1920/produkt-bezchybnost.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Bezchybnosť<span class="text-highlight">.</span></h2>
<p>Čítačka dokladov do hotela je bezchybným zariadením, ktoré výrazne znižuje riziko chýb pri registrácii hostí. Vďaka automatickému načítaniu údajov z dokladov už recepčný nemusí ručne opisovať čísla či iné informácie, čo eliminuje prípadné chyby spôsobené ľudským faktorom a zaisťuje presnú a spoľahlivú evidenciu údajov.</p>
</div></div></div></div></div></div></div></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="citacka-ako-hardver"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Čítačka ako hardvér" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/produkt-ctecka-jako-hardware.webp" srcset="/files/r/720/produkt-ctecka-jako-hardware.webp 720w, /files/r/1280/produkt-ctecka-jako-hardware.webp 1280w, /files/r/1920/produkt-ctecka-jako-hardware.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Čítačka ako hardvér<span class="text-highlight">.</span></h2>
<p>V hotelovej prevádzke je čítačka dokladov kľúčovým prvkom, ktorý uľahčuje proces registrácie hostí. Tento hardvér umožňuje využitie celostránkového skenera alebo načítanie údajov zo strojovo čitateľnej zóny dokladov, čo zaisťuje rýchlu a spoľahlivú evidenciu informácií o hosťoch.</p>
</div></div></div></div></div></div></div></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktny-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/vyhoda-hoteloveho-systemu-protel.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Čítačka dokladov v hotelovom systéme je základným nástrojom, ktorý dokáže čítať nielen cestovné doklady, ale aj platobné karty, čím zvyšuje efektívnosť a bezpečnosť procesu registrácie hostí.</h2>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktny-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">KONTAKTUJTE NÁS</span></a></div></div></div></div></div></div></div></div></div>
<ProtelVPraxiSk />
<div class="section height--normal align--middle color--default col-gaps-bigger section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Hotelový systém Protel již využívají<span class="text-highlight">...</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="Michaela Bieliková" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/michaela-bielikova.webp" srcset="/files/r/720/michaela-bielikova.webp 720w, /files/r/1280/michaela-bielikova.webp 1280w, /files/r/1920/michaela-bielikova.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Protel je pro CPI Hotels vynikající volba. Jeho intuitivní rozhraní, spolehlivost a efektivita nám umožňují snadno řídit rezervace, spravovat hosty a sledovat statistiky.</blockquote><div class="block-quote-author"><span class="quote-decor">–</span> Michaela Bieliková <span class="quote-decor">–</span><span class="block-quote-info">CPI Hotels, Director Of Training and Development</span></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="František Sedlák" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/frantisek-sedlak.webp" srcset="/files/r/720/frantisek-sedlak.webp 720w, /files/r/1280/frantisek-sedlak.webp 1280w, /files/r/1920/frantisek-sedlak.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Na Protelu si cením především jeho spolehlivosti, podpory a množství nabízených reportů.</blockquote><div class="block-quote-author"><span class="quote-decor">–</span> František Sedlák <span class="quote-decor">–</span><span class="block-quote-info">Grandhotel Brno, General Manager</span></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-quote"><div class="has-icon left block-quote-figure"><div class="block-quote-image"><div class="image-wrapper"><div class="image image-mask ratio-square shape-circle"><img alt="Eliška Škubalová" decoding="async" loading="lazy" sizes="auto" src="/files/r/1280/eliska-skubalova.webp" srcset="/files/r/720/eliska-skubalova.webp 720w, /files/r/1280/eliska-skubalova.webp 1280w, /files/r/1920/eliska-skubalova.webp 1920w"/></div></div></div><i class="icon icon-quote-right"></i><blockquote class="block-quote-text">Protel v našem hotelu využíváme již mnoho let a za tu dobu nám byl vždy oporou v každodenním fungování hotelu. Velmi vstřícný support je velkým bonusem.</blockquote><div class="block-quote-author"><span class="quote-decor">–</span> Eliška Škubalová <span class="quote-decor">–</span><span class="block-quote-info">GRAND HOTEL BOHEMIA, Director of Sales</span></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/nasi-zakaznici"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAŠI ZÁKAZNÍCI</span></a></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<MezeraCSk />
