---
// https://www.protelsystems.cz/sk/automatizacia-rezervacii (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import MezeraSk from '../../components/blocks/MezeraSk.astro';
import DaleByVasMohloZajimatSk from '../../components/blocks/DaleByVasMohloZajimatSk.astro';
import VyzkousetZdarmaSk from '../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Automatizácia rezervácií | Hotel PMS Protel"
  description="Máte obavy z ručného zadávania všetkých rezervácií do hotelového systému? Stojí vás to veľa času a občas sa pomýlite? Prichádzate o možnosť predať izbu, pretože nemáte aktualizovanú dostupnosť izieb vo svojich predajných kanáloch? Protel má riešenie."
  path="/sk/automatizacia-rezervacii"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  locale="sk"
  image="/files/nahled-automatizace-rezervaci.jpg"
>
<div class="section height--low align--middle color--default no-pb col-gaps-bigger" id="prevadzkove-funkcie"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-5-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div> <div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/co-vas-zaujima"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ČO VÁS ZAUJÍMA?</span></a></div></div> <div class="block block-inline no-pb"><h1>Automatizácia rezervácií<span class="text-highlight">.</span></h1>
</div> <div class="block block-inline"><p class="text-large">Máte obavy z ručného zadávania všetkých rezervácií do hotelového systému? Stojí vás to veľa času a občas sa pomýlite? Prichádzate o možnosť predať izbu, pretože nemáte aktualizovanú dostupnosť izieb vo svojich predajných kanáloch?</p>
</div> <div class="block block-button"><div class="left"><a class="btn btn-default btn-sm" href="#automatizujte-svoj-hotel"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PROTEL MÁ RIEŠENIE</span></a></div></div></div> <div class="col col-6-12 grid-7-12"><div class="block block-image no-pb"><div class="image image-mask ratio-original" style="padding-bottom:66.66666666666666%"><img alt="" decoding="async" sizes="(min-width:1390px) 811px, (min-width:720px) 58.33vw, 100.00vw" src="/files/r/1280/hdr-automatizace-rezervaci.webp" srcset="/files/r/720/hdr-automatizace-rezervaci.webp 720w, /files/r/1280/hdr-automatizace-rezervaci.webp 1280w, /files/r/1920/hdr-automatizace-rezervaci.webp 1920w"/></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Automatizáciu rezervácií Protel využívajú títo zákazníci<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Mamaison" decoding="async" loading="lazy" src="/files/ref-mamaison.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Old Town Hotels" decoding="async" loading="lazy" src="/files/ref-old-town-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Imperial" decoding="async" loading="lazy" src="/files/ref-imperial.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo CPI Hotels" decoding="async" loading="lazy" src="/files/ref-cpi.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Buddha-Bar" decoding="async" loading="lazy" src="/files/ref-buddha-bar.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><a class="image image-mask ratio-square image-width-stretch" href="/sk/demo-zadarmo"><img alt="Vaše logo" decoding="async" loading="lazy" src="/files/ref-vase-referencie.svg"/></a></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="automatizujte-svoj-hotel"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#vyhody" style="padding-bottom:100%"><img alt="Riešenie? Automatizujte svoj hotel!" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/2661-automatizace-rezervaci.webp" srcset="/files/r/720/2661-automatizace-rezervaci.webp 720w, /files/r/1280/2661-automatizace-rezervaci.webp 1280w, /files/r/1920/2661-automatizace-rezervaci.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Riešenie? Automatizujte svoj hotel!</h2>
<p>Jednoducho prepojte svoj hotelový systém Protel so všetkými dostupnými <a href="/sk/napojenie/channel-manager-crs">Channel Managermi</a> priamo s rezervačnými portálmi, ako je booking.com, alebo použite integrovaný <a href="/sk/produkty/webove-rezervacie">webový rezervačný systém</a> (booking engine). Vďaka týmto pripojeniam sa rezervácie automaticky registrujú v hotelovom systéme Protel a <a href="/sk/produkty/hotelovy-system-protel#cenova-politika">dostupnosť izieb a predajné ceny</a> sú vždy aktualizované mnoho mesiacov vopred. Automaticky zadaná rezervácia je vždy správna, vrátane všetkých kontaktov na hostí, na správny dátum a za správnu cenu. </p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="#vyhody"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VÝHODY AUTOMATIZÁCIE REZERVÁCIÍ</span></a></div></div></div></div></div></div></div></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image" id="vyhody"><div class="flexcard flexcard-card flexcard-size--small flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="#kontaktny-formular" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/vyhoda-hoteloveho-systemu-protel.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">" </span>Výhodou automatizácie hotelových rezervácií je skrátenie času, minimalizácia chýb a zlepšenie skúseností hostí.</h2>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="#kontaktny-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">KONTAKTUJTE NÁS</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<MezeraSk />
<div class="section height--normal align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Súvisiace s automatizáciou rezervácií<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--secondary box--image"><div class="row"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#ffffff"><span style="caret-color: rgb(255, 255, 255);">Individuálne rezervácie</span></font>.</span></h3>
</div> <div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/produkty/hotelovy-system-protel#individualne-rezervacie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC INFORMÁCIÍ</span></a></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="align-right"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/link-individualni-rezervace.svg"/></div></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--secondary box--image"><div class="row"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#ffffff"><span style="caret-color: rgb(255, 255, 255);">Skupinové rezervácie</span></font>.</span></h3>
</div> <div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/produkty/hotelovy-system-protel#skupinove-rezervacie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC INFORMÁCIÍ</span></a></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="align-right"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/link-skupinove-rezervace.svg"/></div></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--secondary box--image"><div class="row"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h3 class="text-large">Záznamy o rezervácii<span class="text-highlight">.</span></h3>
</div> <div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/produkty/webove-rezervacie#zaznamy-o-rezervacii"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC INFORMÁCIÍ</span></a></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="align-right"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/link-evidence-rezervace.svg"/></div></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--secondary box--image"><div class="row"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h3 class="text-large">Potvrdenie rezervácie<span class="text-highlight">.</span></h3>
</div> <div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/produkty/webove-rezervacie#potvrdenie-rezervacie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC INFORMÁCIÍ</span></a></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image"><div class="align-right"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" src="/files/link-potvrzeni-rezervace.svg"/></div></div></div></div></div></div></div></div></div></div>
<MezeraSk />
<DaleByVasMohloZajimatSk />
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
