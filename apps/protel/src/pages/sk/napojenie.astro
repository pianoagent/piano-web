---
// https://www.protelsystems.cz/sk/napojenie (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';
import VyzkousetZdarmaSk from '../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Napojenie | Hotel PMS Protel"
  description="Prepojenie hotelového systému s rôznymi platformami je kľúčovým a nevyhnutným krokom pre efektívnu prevádzku a poskytovanie služieb na vysokej úrovni. Naša integrácia umožní vášmu hotelu maximalizovať príjmy, optimalizovať náklady a zlepšiť celkový zážitok hostí."
  path="/sk/napojenie"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  locale="sk"
  image="/files/nahled-napojeni.jpg"
>
<div class="section height--low align--middle color--default section-width-boxed no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Napojenie hotelového systému Protel<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-3-12 grid-8-12"><div class="block block-inline"><p class="center text-large">Napojenie hotelového systému s rôznymi platformami je kľúčovým a nevyhnutným krokom pre efektívnu prevádzku a poskytovanie služieb na vysokej úrovni. Naša integrácia umožní vášmu hotelu maximalizovať príjmy, optimalizovať náklady a zlepšiť celkový zážitok hostí.</p>
</div></div></div></div><div class="section-background" style="background-color:rgb(255, 255, 255)"></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/restauracny-system-septim">Reštauračný systém Septim<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-5-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/platobne-riesenie-planet">Platobné riešenie Planet<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-9-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/online-check-in-out-a-kiosk-straiv">Online check-in/out a Kiosk Straiv<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-13-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/chatbot-dialogshift">Chatbot DialogShift<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-17-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/cenova-optimalizacia-revcontrol">Cenová optimalizácia RevControl</a><a href="/sk/napojenie/chatbot-dialogshift"><span class="text-highlight">.</span></a></h3>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/channel-manager-crs">Channel Manager (CRS)<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-5-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/vernostne-programy-crm">Vernostné programy (CRM)<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-9-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/business-intelligence-a-revenue-management">Business Intelligence a Revenue Management<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-13-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/televizne-systemy">Televízne systémy<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-17-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/uzamykacie-systemy">Uzamykacie systémy<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/sprava-budov">Správa budov<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-5-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/wellness-a-sportove-systemy">Wellness a športové systémy<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-9-20 grid-4-20"><div class="block block-box box box--primary box--full-height box-inherit-color"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/automatizacia-prevadzky">Automatizácia prevádzky<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-13-20 grid-4-20"><div class="block block-box box box--primary box-inherit-color box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/uctovne-programy">Účtovné programy<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div> <div class="col col-17-20 grid-4-20"><div class="block block-box box box--primary box-inherit-color box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3><a href="/sk/napojenie/ostatne-napojenie">Ostatné napojenie<span class="text-highlight">.</span></a></h3>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-box box box--secondary"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="center">Kompletný zoznam všetkých systémov a programov pripojených k hotelovému systému Protel<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default btn-sm" href="https://store.protel.io/" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PREJSŤ NA PROTEL MARKET PLACE</span></a></div></div></div></div></div></div></div></div></div>
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
