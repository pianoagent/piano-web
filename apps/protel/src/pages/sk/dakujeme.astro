---
// SK děkovací stránka po odeslání formuláře (konverze = pageview /sk/dakujeme). Noindex, mimo sitemapu.
import Base from '../../layouts/Base.astro';
---
<Base
  title="Ďakujeme | Hotel PMS Protel"
  description="Ďakujeme za správu. Ozveme sa Vám čo najskôr."
  path="/sk/dakujeme"
  locale="sk"
  noindex
>
<div class="section height--normal align--middle color--default">
  <div class="section-body">
    <div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline">
      <h1 class="center">Ďakujeme<span class="text-highlight">.</span></h1>
      <p class="text-large center">Správa k nám dorazila. Ozveme sa Vám čo najskôr.</p>
    </div></div></div>
    <div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
    <div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center">
      <p class="center">Ponáhľate sa? Zavolajte nám na <a href="tel:+420257011107">+420&nbsp;257 011 107</a>.</p>
      <a class="btn btn-default" href="/sk"><span class="btn__icon" aria-hidden="true"></span><span class="btn__label">Späť na hlavnú stránku</span></a>
    </div></div></div></div>
  </div>
</div>
</Base>
