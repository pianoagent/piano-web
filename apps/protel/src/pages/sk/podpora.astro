---
// https://www.protelsystems.cz/sk/podpora (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../layouts/Base.astro';

---
<Base
  title="Podpora | Hotel PMS Protel"
  description="Patríte už do rodiny Protel a neviete si rady? Nájdete kontakty pre okamžitú pomoc..."
  path="/sk/podpora"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed"
  locale="sk"
  image="/files/nahled-kontakt.jpg"
>
<div class="section height--low align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1 class="center">Podpora produktov Protel<span class="text-highlight">.</span></h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-box box box--default"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center"><strong style="font-family: var(--base-font-family); font-size: 16px;">VZDIALENÁ PODPORA <span class="text-highlight">TEAMVIEWER</span></strong><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;"><span class="text-highlight"> </span>WINDOWS</strong></span></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/ico-vzdalena-podpora-windows.svg"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="https://download.teamviewer.com/download/TeamViewerQS_x64.exe" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Mám počítač s Windows</span></a></div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-box box box--default"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center"><strong style="font-family: var(--base-font-family); font-size: 16px;">VZDIALENÁ PODPORA <span class="text-highlight">TEAMVIEWER</span></strong><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;"><span class="text-highlight"> </span>APPLE MAC</strong></span></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-icon flexcard-none size-lg align-center"><div class="flexcard-media"><div class="image-icon-wrapper"><div class="image-icon"><img alt="" decoding="async" src="/files/ico-vzdalena-podpora-apple.svg"/></div></div></div></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default" href="https://download.teamviewer.com/download/TeamViewerQS.dmg" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">Mám Apple macOS</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-inverse btn-sm" href="/sk/cennik-sluzieb"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">CENNÍK SLUŽIEB</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p class="center text-large">Patríte už do rodiny Protel a neviete si rady? Nižšie nájdete kontakty pre okamžitú pomoc. Pripravte si Váš servisný kód.</p>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-image img-text-info icon-helpdesk"><div><div class="image image-mask ratio-original image-has-caption" style="padding-bottom:66.66666666666666%"><img alt="" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/podpora-helpdesk.webp" srcset="/files/r/720/podpora-helpdesk.webp 720w, /files/r/1280/podpora-helpdesk.webp 1280w, /files/r/1920/podpora-helpdesk.webp 1920w"/></div><div class="image-caption image-caption-bottom"><div class="image-caption-wrapper"><div class="text-block"><p><strong>HELPDESK <span class="text-highlight">V PRACOVNÚ DOBU PO – PIA: 8:30 - 17:00</span></strong></p>
<h2><a href="tel:+420257011107">+420 257 011 107</a></h2>
<p><u><a href="mailto:help@protelsystems.cz">help@protelsystems.cz</a></u></p>
</div></div></div></div></div></div> <div class="col col-7-12 grid-6-12"><div class="block block-image img-text-info icon-hotline"><div><div class="image image-mask ratio-original image-has-caption" style="padding-bottom:66.66666666666666%"><img alt="" decoding="async" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/podpora-hotline.webp" srcset="/files/r/720/podpora-hotline.webp 720w, /files/r/1280/podpora-hotline.webp 1280w, /files/r/1920/podpora-hotline.webp 1920w"/></div><div class="image-caption image-caption-bottom"><div class="image-caption-wrapper"><div class="text-block"><p><strong>HOTLINE<span class="text-highlight"> MIMO PRACOVNEJ DOBY</span></strong></p>
<h2><a href="tel:+420778776835">+420 778 776 835</a></h2>
<p><u><a href="mailto:help@protelsystems.cz">help@protelsystems.cz</a></u></p>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="center"><a class="btn btn-default btn-sm" href="#kontaktny-formular"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">KONTAKTNÝ FORMULÁR</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<div class="section height--normal align--middle color--default" id="kontaktny-formular"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Alebo napíšte formulár priamo na našu podporu<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-5-12 grid-4-12">
<form action="https://databridge.pianopos.cz/api/web-lead" autocomplete="off" class="block block-form" data-lead-form="formular-odoslat-formular" id="formular-odoslat-formular" method="post">
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_email" id="formular-odoslat-formular-field-wrapper-email">
<div class="field-wrapper">
<label for="formular-odoslat-formular-field-email" id="formular-odoslat-formular-label-email">
            E-mail <span>*</span>
</label>
<input class="field-control" id="formular-odoslat-formular-field-email" name="formular-odoslat-formular[email]" required="" type="email" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_input_tel" id="formular-odoslat-formular-field-wrapper-telefon">
<div class="field-wrapper">
<label for="formular-odoslat-formular-field-telefon" id="formular-odoslat-formular-label-telefon">
            Telefón
          </label>
<input class="field-control" id="formular-odoslat-formular-field-telefon" name="formular-odoslat-formular[telefon]" type="tel" value=""/>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_textarea" id="formular-odoslat-formular-field-wrapper-s-cim-potrebujete-pomoct">
<div class="field-wrapper">
<label for="formular-odoslat-formular-field-s-cim-potrebujete-pomoct" id="formular-odoslat-formular-label-s-cim-potrebujete-pomoct">
            S čím potrebujete pomôcť?
          </label>
<textarea class="field-control" id="formular-odoslat-formular-field-s-cim-potrebujete-pomoct" name="formular-odoslat-formular[s-cim-potrebujete-pomoct]"></textarea>
</div>
</div>
</div>
</div>
<div class="row">
<div class="col col-1-12 grid-12-12">
<div class="field field-form_button" id="formular-odoslat-formular-field-wrapper-odoslat-formular">
<div class="field-wrapper">
<div class="center">
<button class="btn btn-a btn-default" id="formular-odoslat-formular-field-odoslat-formular" name="formular-odoslat-formular[odoslat-formular]" type="submit" value="submit"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">ODOSLAŤ FORMULÁR</span></button>
</div>
</div>
</div>
</div>
</div>

<input name="form_variant" type="hidden" value="formular-odoslat-formular"/><input name="page" type="hidden" value=""/><div aria-hidden="true" class="visually-hidden"><label>Web <input autocomplete="off" name="website" tabindex="-1" type="text"/></label></div></form>
</div></div></div></div>
<div class="section height--normal align--middle color--default section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://protel.helpjuice.com/en_US" rel="noopener" style="padding-bottom:76.92307692307693%" target="_blank"><img alt="Hľadajte odpovede alebo prechádzajte Protel znalostnú databázu" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/banner-protel-databaze.webp" srcset="/files/r/720/banner-protel-databaze.webp 720w, /files/r/1280/banner-protel-databaze.webp 1280w, /files/r/1920/banner-protel-databaze.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2>Hľadajte odpovede alebo prechádzajte Protel znalostnú databázu<span class="text-highlight">.</span></h2>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://protel.helpjuice.com/en_US" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PREJSŤ NA DATABÁZU ODPOVEDÍ</span></a></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
</Base>
