---
// https://www.protelsystems.cz/sk/napojenie/restauracny-system-septim (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../../layouts/Base.astro';
import MezeraBSk from '../../../components/blocks/MezeraBSk.astro';
import NapojeniPartneriSk from '../../../components/blocks/NapojeniPartneriSk.astro';
import NapojeniVypisSk from '../../../components/blocks/NapojeniVypisSk.astro';
import CitaceProtelSk from '../../../components/blocks/CitaceProtelSk.astro';
import FantastickyHotelSk from '../../../components/blocks/FantastickyHotelSk.astro';
import DaleByVasMohloZajimatSk from '../../../components/blocks/DaleByVasMohloZajimatSk.astro';
import VyzkousetZdarmaSk from '../../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Reštauračný systém Septim | Hotel PMS Protel"
  description="Restaurant System Septim je najuznávanejší reštauračný softvér v krajine. Reštaurácie s michelinskou hviezdou, popredné reťazce špičkových reštaurácií a známi šéfkuchári používajú systém Septim vo svojich prevádzkach."
  path="/sk/napojenie/restauracny-system-septim"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  locale="sk"
  image="/files/nahled-napojeni-septim.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/napojenie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENIE</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Reštauračný systém Septim.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojenie"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-septim.webp" srcset="/files/r/720/hdr-napojeni-septim.webp 720w, /files/r/1280/hdr-napojeni-septim.webp 1280w, /files/r/1920/hdr-napojeni-septim.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Reštauračný systém Septim je najrešpektovanejší softvér pre reštaurácie v SR. Michelinské reštaurácie, popredné siete top reštaurácií a známi šéfkuchári používajú vo svojich prevádzkach práve Septim.</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.sk" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="Logo Septim" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-septim.svg"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Prepojenie so systémom Septim zaistí, že si hostia môžu ľahko nechať zaslať konzumáciu na svoju izbu a všetko uhradiť následne jednou platbou pri odchode.</h3>
<p>Napojenie sa zároveň zaisťuje prenos všetkých ostatných uzavretých účtov (obratov i platieb) do PMS, čím zjednodušuje prehľad výsledkov celého Vášho hotela. Ďalej je možné overiť platnosť rezortnej karty/kariet. V prípade predaja položiek (minibar/drobný predaj) sa všetko odťaží priamo v skladovom hospodárstve Septim.</p>
</div><div class="image-btn"><a class="btn btn-default btn-sm" href="https://www.septim.sk" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC NA SEPTIM.SK</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.cz/sk/produkty/automaticke-naskladnovanie" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="SPOJUJE NÁS LETITÉ PARTNERSTVO S PECOSTA" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/partner-pecosta.webp" srcset="/files/r/720/partner-pecosta.webp 720w, /files/r/1280/partner-pecosta.webp 1280w, /files/r/1920/partner-pecosta.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;">SPOJUJE NÁS LETITÉ PARTNERSTVO S PECOSTA</strong></span></h3>
<h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim + Pecosta</span></font>.</span></h3>
<h3>Automatické naskladňovanie systému Pecosta umožňuje zapisovať dodaný tovar priamo na sklady reštauračného systému Septim. Vy si len skontrolujete, či je dodací list v poriadku a pri prvom naskladnení vyberiete, na ktorý sklad patrí.</h3>
<p>Najväčšou výhodou automatického naskladňovania v prevádzkovom systéme Septim je úspora času pri prepisovaní. Už nemusíte ručne prepisovať položky, vyberať kam patrí, vypisovať ich cenu a množstvo. Táto práca prebehne za zlomok času.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://www.septim.cz/sk/produkty/automaticke-naskladnovanie" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O PECOSTA</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><a class="image image-mask ratio-original" href="https://www.septim.cz/sk/produkty/platby-objednavky-qr-kodom" rel="noopener" style="padding-bottom:100%" target="_blank"><img alt="DOKONALÁ SPOLUPRÁCA SYSTÉMU SEPTIM A QERKO" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/partner-qerko.webp" srcset="/files/r/720/partner-qerko.webp 720w, /files/r/1280/partner-qerko.webp 1280w, /files/r/1920/partner-qerko.webp 1920w"/></a></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><strong style="font-family: var(--base-font-family); font-size: 16px;">DOKONALÁ SPOLUPRÁCA SYSTÉMU SEPTIM A QERKO</strong></span></h3>
<h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Septim + QERKO</span></font>.</span></h3>
<h3>Vďaka partnerstvu so spoločnosťou Qerko môže pokladničný systém Septim ponúknuť prelomovú funkciu platenia QR kódom priamo zákazníkov. Aplikácia ale ponúka oveľa viac a zákazníci ju milujú!</h3>
<p>Nesporné výhody sú dve. Zákazníci môžu rýchlo vyriešiť svoj účet a nemusia stať nepríjemný front pri pokladni, hlavne v obedovej špičke. Druhá súvisiaca výhoda je úspora času personálu. Ten namiesto rozpočítavania účtu a vybavovania platieb môže robiť šťastnými nových hostí.</p>
</div><div class="image-btn"><a class="btn btn-inverse btn-sm" href="https://www.septim.cz/sk/produkty/platby-objednavky-qr-kodom" rel="noopener" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">VIAC O QERKO</span></a></div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, ktoré sa spoliehajú na reštauračný systém Septim<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Field" decoding="async" loading="lazy" src="/files/znacka-field.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Aromi" decoding="async" loading="lazy" src="/files/znacka-aromi.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo CPI Hotels" decoding="async" loading="lazy" src="/files/znacka-cpi-hotels.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Ambiente" decoding="async" loading="lazy" src="/files/znacka-ambiente.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo O2 arena" decoding="async" loading="lazy" src="/files/znacka-02-arena.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<MezeraBSk />
<NapojeniPartneriSk />
<NapojeniVypisSk />
<CitaceProtelSk />
<FantastickyHotelSk />
<DaleByVasMohloZajimatSk />
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
