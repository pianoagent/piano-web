---
// https://www.protelsystems.cz/sk/napojenie/automatizacia-prevadzky (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../../layouts/Base.astro';
import NapojeniPartneriSk from '../../../components/blocks/NapojeniPartneriSk.astro';
import NapojeniVypisSk from '../../../components/blocks/NapojeniVypisSk.astro';
import CitaceProtelSk from '../../../components/blocks/CitaceProtelSk.astro';
import FantastickyHotelSk from '../../../components/blocks/FantastickyHotelSk.astro';
import DaleByVasMohloZajimatSk from '../../../components/blocks/DaleByVasMohloZajimatSk.astro';
import VyzkousetZdarmaSk from '../../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Automatizácia prevádzky | Hotel PMS Protel"
  description="Najčastejšie pripojení partneri pre automatizáciu prevádzky k hotelovému systému Protel."
  path="/sk/napojenie/automatizacia-prevadzky"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  locale="sk"
  image="/files/nahled-napojeni.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/napojenie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENIE</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Automatizácia prevádzky.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--low align--middle color--default"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2>Najčastejšie napojovaní partneri pre Automatizácia prevádzky do hotelového systému Protel<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="straiv-kiosek"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Straiv Kiosk" decoding="async" loading="lazy" src="/files/napojeni-straiv-kiosk-new.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large">Straiv – Kiosek<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Straiv Kiosk umožní hosťovi vyplniť všetky potrebné údaje pre jeho pobyt, zaplatiť, vykonať Check-in online. Všetko sa priamo synchronizuje s PMS. Kiosk vydá hosťovi prístupovú kartu od izby a hosť tak nemusí navštíviť recepciu. Podpísaná registračná karta je uložená v cloudovom úložisku. Účet a informácie o pobyte môže hosť dostať emailom.</p>
</div></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="straiv-digitalni-registracni-karta"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Straiv" decoding="async" loading="lazy" src="/files/napojeni-straiv-new.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large">Straiv – Digitální registrační karta<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Straiv digitálna registračná karta umožní hosťovi vyplniť všetky potrebné údaje pre jeho pobyt a podpísať registračnú kartu. Všetko sa priamo synchronizuje s PMS. Podpísaná registračná karta je uložená v cloudovom úložisku. Účet a informácie o pobyte môže hosť dostať emailom.</p>
</div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="granus"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Granus" decoding="async" loading="lazy" src="/files/napojeni-granus.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large">Granus<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:30px"></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Skenovacie zariadenie firmy Granus umožňuje načítanie informácií z cestovných dokladov hostí priamo do Protelu.</p>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-divider"><hr class="divider divider--normal divider--align-left"/></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="adriascan"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Adria Scan" decoding="async" loading="lazy" src="/files/napojeni-adria-scan.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">AdriaScan</span></font>.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Skenovacie zariadenie firmy AdriaScan umožňuje načítanie informácií z cestovných dokladov hostí priamo do Protelu.</p>
</div></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="hotelkit"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo hotelkit" decoding="async" loading="lazy" src="/files/napojeni-hotelkit.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large">HotelKit<span class="text-highlight">.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>V HotelKit je k dispozícii zoznam všetkých izieb vrátane stavu upratovania, tak sú zadané v PMS. Pokiaľ je stav izby zmenený v HotelKit, údaje sa synchronizujú do PMS. Ďalej je možné účtovať minibar. Ďalej sú v HotelKit vidieť informácie o pobyte a hosťoch (VIP, výmena bielizne).</p>
</div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="omni-software-solution"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo OMNI" decoding="async" loading="lazy" src="/files/napojeni-omni.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Omni Software Solution</span></font>.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>V OmniSoft je k dispozícii zoznam všetkých izieb vrátane stavu upratovania, tak sú zadané v PMS. Pokiaľ je stav izby zmenený v OmniSoft, údaje sa synchronizujú do PMS. Ďalej sú k dispozícii informácie o pobyte a hosťoch (VIP, výmena bielizne).</p>
</div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-divider"><hr class="divider divider--normal divider--align-left"/></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="roomchecking"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Roomchecking" decoding="async" loading="lazy" src="/files/napojeni-room-checking.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">RoomChecking</span></font>.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>V Roomchecking je k dispozícii zoznam všetkých izieb vrátane stavu upratovania, tak sú zadané v PMS. Pokiaľ je stav izby zmenený v Roomchecking, údaje sa synchronizujú do PMS. Ďalej sú k dispozícii informácie o pobyte a hosťoch (VIP, výmena bielizne).</p>
</div></div></div></div></div> <div class="col col-5-12 grid-4-12"><div class="block block-box box box--default box-inherit-color" id="telefonne-ustredne"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Telefonní ústředny" decoding="async" loading="lazy" src="/files/napojeni-telefonni-ustredny.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Telefónne ústredne</span></font>.</span></h3>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><p>Napojenie telefónnej ústredne zasiela do Protelu čiastky za vykonané hovory, ale môže meniť aj statusy izieb, naťažovať položky minibaru či blokovať odchádzajúce hovory v prípade neobsadenej izby. Vlastnosti danej telefónnej ústredne je nutné overiť.</p>
</div></div></div></div></div> <div class="col col-9-12 grid-4-12"><div class="block block-box box box--primary box-inherit-color box--full-height"><div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo protel Store" decoding="async" loading="lazy" src="/files/napojeni-store-protel.svg"/></div></div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h3 class="text-large">A mnoho ďalších partnerov<span class="text-highlight">.</span></h3>
<p>Vďaka každodennej dôvere viac ako 14000 zákazníkov po celom svete je Protel PMS jedným z najlepších poskytovateľov hotelových riešení s ohromným počtom systémových napojení! Kompletný výpis všetkých napájaných partnerov pre Automatizácia prevádzky do hotelového systému Protel nájdete na Protel Market Place.</p>
</div></div></div>
<div class="row"><div class="col col-1-12 grid-12-12"><div class="block block-button"><div class="left"><a class="btn btn-default btn-sm" href="https://store.protel.io/#/" target="_blank"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">PREJSŤ NA PROTEL MARKET PLACE</span></a></div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-divider"><hr class="divider divider--normal divider--align-left"/></div></div></div></div></div>
<NapojeniPartneriSk />
<NapojeniVypisSk />
<CitaceProtelSk />
<FantastickyHotelSk />
<DaleByVasMohloZajimatSk />
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
