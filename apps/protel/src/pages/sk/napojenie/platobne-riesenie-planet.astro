---
// https://www.protelsystems.cz/sk/napojenie/platobne-riesenie-planet (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../../layouts/Base.astro';
import MezeraBSk from '../../../components/blocks/MezeraBSk.astro';
import NapojeniPartneriSk from '../../../components/blocks/NapojeniPartneriSk.astro';
import NapojeniVypisSk from '../../../components/blocks/NapojeniVypisSk.astro';
import CitaceProtelSk from '../../../components/blocks/CitaceProtelSk.astro';
import FantastickyHotelSk from '../../../components/blocks/FantastickyHotelSk.astro';
import DaleByVasMohloZajimatSk from '../../../components/blocks/DaleByVasMohloZajimatSk.astro';
import VyzkousetZdarmaSk from '../../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Platobné riešenie Planet | Hotel PMS Protel"
  description="Platobné riešenia Planet sú superflexibilné moderné platobné riešenia, ktoré skvele fungujú. Online aj osobne. Dokonale prispôsobené každej prevádzke!"
  path="/sk/napojenie/platobne-riesenie-planet"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  locale="sk"
  image="/files/nahled-napojeni-planet.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/napojenie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENIE</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-inline"><h1>Platobné riešenie Planet.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojenie"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-planet.webp" srcset="/files/r/720/hdr-napojeni-planet.webp 720w, /files/r/1280/hdr-napojeni-planet.webp 1280w, /files/r/1920/hdr-napojeni-planet.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> Platobné riešenia Planet sú superflexibilné moderné platobné riešenia, skvele fungujúce. Online aj osobne. Dokonale sadnú na mieru každej prevádzke!</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo Planet" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-planet.svg"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">Planet</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Integrované platobné riešenie Planet Vám zaistí rýchlu a bezchybnú prácu s platbami na Vašej recepcii či rezervačnom oddelení.</h3>
<p>Stiahnutie platby za pobyt pri rezerváciách či platba na recepcii bez nutnosti práce s terminálom zrýchľuje interné procesy a tým získate viac času na komunikáciu s hosťom a zaistenie plynulejšej prevádzky Vášho hotela.</p>
</div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, ktoré sa spoliehajú na platobné riešenie Planet<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Armani" decoding="async" loading="lazy" src="/files/znacka-armani.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Gucci" decoding="async" loading="lazy" src="/files/znacka-gucci.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Hugo Boss" decoding="async" loading="lazy" src="/files/znacka-hugo-boss.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Old Town Hotels" decoding="async" loading="lazy" src="/files/ref-old-town-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Sephora" decoding="async" loading="lazy" src="/files/znacka-sephora.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<MezeraBSk />
<NapojeniPartneriSk />
<NapojeniVypisSk />
<CitaceProtelSk />
<FantastickyHotelSk />
<DaleByVasMohloZajimatSk />
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
