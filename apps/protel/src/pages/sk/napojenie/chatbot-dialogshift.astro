---
// https://www.protelsystems.cz/sk/napojenie/chatbot-dialogshift (Solid Pixels), port 1:1 skriptem port-protel.py
import Base from '../../../layouts/Base.astro';
import MezeraBSk from '../../../components/blocks/MezeraBSk.astro';
import NapojeniPartneriSk from '../../../components/blocks/NapojeniPartneriSk.astro';
import NapojeniVypisSk from '../../../components/blocks/NapojeniVypisSk.astro';
import CitaceProtelSk from '../../../components/blocks/CitaceProtelSk.astro';
import FantastickyHotelSk from '../../../components/blocks/FantastickyHotelSk.astro';
import DaleByVasMohloZajimatSk from '../../../components/blocks/DaleByVasMohloZajimatSk.astro';
import VyzkousetZdarmaSk from '../../../components/blocks/VyzkousetZdarmaSk.astro';
import NovinkySk from '../../../components/blocks/NovinkySk.astro';
import KontaktniFormularSk from '../../../components/blocks/KontaktniFormularSk.astro';
---
<Base
  title="Chatbot DialogShift | Hotel PMS Protel"
  description="Hotel s umelou inteligenciou poháňaný technológiou Open AI! Hotely všetkých veľkostí sa spoliehajú na generatívnu AI spoločnosti DialogShift založenú na GPT, ktorá automaticky reaguje na opakované otázky hostí, zlepšuje dostupnosť, služby pre hostí a generuje viac priamych rezervácií."
  path="/sk/napojenie/chatbot-dialogshift"
  bodyClass="use-header-transparent use-menu-secondary-uppercase use-menu-button-uppercase use-headings-link-plain search-panel-hide-submit-label search-panel-hide-close-label search-panel-hide-open-label use-menu-bar use-header-fixed use-header-fixed-mobile use-header-priority use-header-boxed header-inverse"
  locale="sk"
  image="/files/nahled-napojeni-dialog-shift-new.jpg"
>
<div class="section height--low align--middle color--inverse section-width-boxed section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-6-12"><div class="block block-button"><div class="left"><a class="btn btn-inverse btn-sm" href="/sk/napojenie"><span aria-hidden="true" class="btn__icon"></span><span class="btn__label">NAPOJENIE</span></a></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h1>Chatbot DialogShift.</h1>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-spacer"><div class="block-spacer-element" style="--height:50px"></div></div></div></div></div><div class="section-background" style="background-color:rgb(0, 0, 0)"></div></div>
<div class="section height--normal align--middle color--default" id="napojenie"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-left valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="" decoding="async" loading="lazy" sizes="(min-width:1390px) 695px, (min-width:720px) 50.00vw, 100.00vw" src="/files/r/1280/hdr-napojeni-dialogshift-new.webp" srcset="/files/r/720/hdr-napojeni-dialogshift-new.webp 720w, /files/r/1280/hdr-napojeni-dialogshift-new.webp 1280w, /files/r/1920/hdr-napojeni-dialogshift-new.webp 1920w"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h2><span class="text-highlight">"</span> AI hotel poháňaný Open AI! Hotely všetkých veľkostí spoliehajú na generatívnu umelú inteligenciu DialogShift poháňanú GPT, ktorá automaticky odpovedá na opakované otázky hostí, zlepšuje dostupnosť, služby pre hostí a generuje viac priamych rezervácií.</h2>
</div></div></div></div></div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-image"><div class="flexcard flexcard-card flexcard-size--normal flexcard-media-right valign-center align-left"><div class="flexcard-media"><div class="image-wrapper"><div class="image image-mask ratio-original" style="padding-bottom:100%"><img alt="Logo DialogShift" decoding="async" loading="lazy" src="/files/napojeni-logo-detail-dialog-shift-new.svg"/></div></div></div><div class="flexcard-content"><div class="flexcard-content-wrapper"><div class="text-block"><h3 class="text-large"><span class="text-highlight"><font color="#000000"><span style="caret-color: rgb(0, 0, 0);">DialogShift</span></font>.</span></h3>
<h2><strong style="font-family: var(--base-font-family); font-size: 16px;">FUNKCIE A VLASTNOSTI:</strong></h2>
<h3 class="text-large">Komunikácia s Chatbotom od DialogShift nebola nikdy jednoduchšia. Integrácia tohto riešenia na Vaše internetové stránky, vrátane Check-in modulu Straiv alebo Booking engine, zaručí, že Vaši hostia dostanú všetky informácie o Vašom hoteli okamžite a efektívne.</h3>
<p>Chatbot je navrhnutý tak, aby zodpovedal akékoľvek otázky hostí, poskytol aktuálne informácie o dostupnosti izieb, ponukách a službách hotela, a tým zlepšil celkovú skúsenosť zákazníkov. Vďaka pokročilej technológii DialogShift je komunikácia plynulá a intuitívna, čo ušetrí čas ako hosťom, tak Vášmu personálu, a zvýši celkovú spokojnosť návštevníkov Vášho hotela.</p>
</div></div></div></div></div></div></div></div></div>
<div class="section height--normal align--middle color--default no-pb section-has-background"><div class="section-body"><div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-inline"><h2 class="center">Značky, ktoré spoliehajú na AI umelú inteligenciu v hoteli od DialogShift<span class="text-highlight">.</span></h2>
</div></div></div>
<div class="row-main"><div class="col col-1-12 grid-12-12"><div class="block block-gallery grid-sm-2"><div class="grid gallery-container" style="--gap:40px"><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Mövenpick" decoding="async" loading="lazy" src="/files/znacka-moevenpick.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Park Inn" decoding="async" loading="lazy" src="/files/znacka-park-inn.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Fantastický hotel" decoding="async" loading="lazy" src="/files/ref-fantasticky-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo The Omnia" decoding="async" loading="lazy" src="/files/znacka-the-omnia.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Empire Riverside Hotel" decoding="async" loading="lazy" src="/files/znacka-empire-riverside-hotel.svg"/></div></div></div><div class="gallery-item grid-col-6"><div class="image-wrapper"><div class="image image-mask ratio-square image-width-stretch"><img alt="Logo Upstalsboom" decoding="async" loading="lazy" src="/files/znacka-upstalsboom.svg"/></div></div></div></div></div></div></div></div><div class="section-background" style="background-color:rgb(242, 242, 242)"></div></div>
<MezeraBSk />
<NapojeniPartneriSk />
<NapojeniVypisSk />
<CitaceProtelSk />
<FantastickyHotelSk />
<DaleByVasMohloZajimatSk />
<VyzkousetZdarmaSk />
<NovinkySk />
<KontaktniFormularSk />
</Base>
